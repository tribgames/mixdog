{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "apps/desktop/src/**",
      "apps/desktop/scripts/**",
      "apps/relay/**",
      "scripts/**",
      "!**/vendor/**",
      "!**/native/mixdog-graph/tests/**",
      "!**/benchmarks/**",
      "!**/deliverables/**",
      "!**/output*/**",
      "!!**/dist",
      "!!**/artifacts",
      "!**/.tmp*/**",
      "!**/.tmp*",
      "!**/.mixdog*/**",
      "!**/.mixdog*",
      "!**/.bench*/**",
      "!**/.bench*",
      "!**/node_modules/**",
      "!**/*.min.js",
      "!apps/desktop/src/renderer/public/boot.js",
      "!apps/desktop/src/renderer/public/ui-language.js",
      "!scripts/generate-voice-runtime-manifest.mjs",
      "!scripts/build-voice-runtime-windows.ps1",
      "!scripts/build-voice-runtime-unix.sh",
      "!scripts/build-ffmpeg-runtime.sh",
      "!scripts/voice-runtime-config.json",
      "!scripts/plan-voice-runtime-release.mjs",
      "!scripts/verify-voice-runtime-release.mjs",
      "!scripts/sync-voice-runtime-manifest.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "assist": {
    "enabled": false,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
