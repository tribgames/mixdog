{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "apps/desktop/src/**",
      "apps/desktop/scripts/**",
      "apps/relay/**",
      "scripts/**",
      "apps/mobile/**",
      "packages/**",
      "benchmarks/token-lang/**",
      "!**/vendor",
      "!**/native/mixdog-graph/tests",
      "!benchmarks/token-lang/data",
      "!benchmarks/token-lang/results",
      "!apps/mobile/ios",
      "!apps/mobile/android",
      "!apps/mobile/test-vectors",
      "!packages/protocol-client/conformance",
      "!packages/protocol/src/index.ts",
      "!packages/protocol-client/package-lock.json",
      "!packages/protocol-client/src/actions/method-args.generated.*",
      "!packages/protocol-client/test/live-turn-items.json",
      "!packages/protocol-client/test/rows/tool-card-model.golden.json",
      "!**/deliverables",
      "!**/output*",
      "!!**/dist",
      "!!**/artifacts",
      "!**/.tmp*",
      "!**/.tmp*",
      "!**/.mixdog*",
      "!**/.mixdog*",
      "!**/.bench*",
      "!**/.bench*",
      "!**/node_modules",
      "!**/*.min.js",
      "!apps/desktop/src/renderer/public/boot.js",
      "!src/defaults/skills/pptx/scripts/review-deck.mjs",
      "!apps/desktop/src/renderer/test-support/whole-outcome.mjs",
      "!apps/desktop/src/renderer/test-support/phone-world.mjs",
      "!apps/desktop/src/renderer/remote-protocol-chat-node-export.mjs",
      "!apps/desktop/src/shared/test-recorded/*.recorded.mjs",
      "!apps/desktop/src/renderer/remote-protocol-chat-harness/lib/pg-version.json",
      "!apps/desktop/src/renderer/*.core/*.json",
      "!scripts/rust-core/recorded",
      "!apps/desktop/src/renderer/public/ui-language.js",
      "!scripts/generate-voice-runtime-manifest.mjs",
      "!scripts/build-voice-runtime-windows.ps1",
      "!scripts/build-voice-runtime-unix.sh",
      "!scripts/build-ffmpeg-runtime.sh",
      "!scripts/voice-runtime-config.json",
      "!scripts/plan-voice-runtime-release.mjs",
      "!scripts/verify-voice-runtime-release.mjs",
      "!scripts/sync-voice-runtime-manifest.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.*"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/ci/**", "scripts/**/*.test.*"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/renderer/**/*.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": false,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
