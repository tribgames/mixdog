{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "apps/desktop/src/**",
      "apps/desktop/scripts/**",
      "apps/relay/**",
      "scripts/**",
      "!**/vendor/**",
      "!**/native/mixdog-graph/tests/**",
      "!**/benchmarks/**",
      "!**/deliverables/**",
      "!**/output*/**",
      "!!**/dist",
      "!!**/artifacts",
      "!**/.tmp*/**",
      "!**/.tmp*",
      "!**/.mixdog*/**",
      "!**/.mixdog*",
      "!**/.bench*/**",
      "!**/.bench*",
      "!**/node_modules/**",
      "!**/*.min.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "assist": {
    "enabled": false,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
