+// Sanitize sessionId before using it as a path segment. A raw `..` or slash
+// would let the sidecar dir — and clearOffloadSession's readdir+unlink — escape
+// the tool-results root (arbitrary .txt deletion). Strip to [A-Za-z0-9_-];
+// dropping '.' collapses '..' to '__'. Real ids are sess_<digits>, unaffected.
+export function safeSessionSegment(sessionId) {
+  return (
+    String(sessionId ?? '')
+      .replace(/[^A-Za-z0-9_-]/g, '_')
+      .slice(0, 200) || '_invalid'
+  );
+}
+
+// A session's reference set (`offloadSources`, in its record): the sessions
+// whose sidecars its transcript may name (their path segments), its own left
+// out. A copy of a conversation (a clear's fork, an inheritance's heir) is
+// given its source's set and its source when it is made (`beginOffloadCopy`),
+// so a copy of a copy names the first source directly and no session in
+// between is needed to find it. Every record this version stores carries one
+// (`withOffloadSources`, at its save); a record an earlier version stored has
+// none, and its set is what its transcript names (`tool-results/<segment>/`),
+// which finds a copy made without a link to its source. Null when the
+// transcript cannot be serialized.
+const NAMED_SOURCE = /tool-results[\\/]+([A-Za-z0-9_-]+)[\\/]/g;
+
+// A reference is text anyone may write (a model quoting a path, a user
+// pasting one), not only the product's own exact-case paths: segments are
+// compared as the file system compares the directory names, case-insensitively
+// on Windows (as the prune's own sidecar match folds its text there).
+export function segmentKey(segment) {
+  const text = String(segment ?? '');
+  return process.platform === 'win32' ? text.toLowerCase() : text;
+}
+
+export function offloadSourcesOf(session) {
+  if (Array.isArray(session?.offloadSources)) return session.offloadSources.filter((source) => typeof source === 'string' && source);
+  let text;
+  try {
+    text = JSON.stringify(session?.messages ?? []) ?? '';
+  } catch {
+    return null;
+  }
+  const sources = new Set([...segmentKey(text).matchAll(NAMED_SOURCE)].map(([, segment]) => segment));
+  sources.delete(segmentKey(safeSessionSegment(session?.id)));
+  return [...sources].sort();
+}
+
+/** Whether the set `sources` names the session of path segment `segment`. */
+export function namesSegment(sources, segment) {
+  const key = segmentKey(segment);
+  return Array.isArray(sources) && sources.some((source) => typeof source === 'string' && segmentKey(source) === key);
+}
+
+/** The record about to be saved carries its reference set. */
+export function withOffloadSources(session) {
+  if (session && typeof session === 'object' && !Array.isArray(session.offloadSources)) session.offloadSources = offloadSourcesOf(session) ?? [];
+  return session;
+}
