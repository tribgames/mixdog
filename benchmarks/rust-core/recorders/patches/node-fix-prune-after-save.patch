+// A manual compaction deletes the tool-result sidecars its result no longer names only once that result is stored: a
+// process that stops before the save restarts from the stored transcript, which still names them, and a save that does
+// not store it (dropped by a delete's fence, refused because another writer recorded after this copy, or failed)
+// prunes nothing. The prune keeps its idle check: a turn started before it leaves every sidecar until that turn ends,
+// and then the skipped prune runs, with no second compaction.
+//
+// The point between the compaction and its save is the commit's timing line (`recordCompactionTiming`), written once
+// the compacted transcript is adopted and before `compactSessionMessages` saves it.
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { appendFileSync, existsSync, mkdtempSync, readFileSync, readdirSync, rmSync, utimesSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import test from 'node:test';
+import { fileURLToPath } from 'node:url';
+
+const CHILD = process.env.MIXDOG_PRUNE_AFTER_SAVE_CHILD === '1';
+const dataDir = CHILD ? process.env.MIXDOG_DATA_DIR : mkdtempSync(join(tmpdir(), 'mixdog-prune-after-save-'));
+process.env.MIXDOG_DATA_DIR = dataDir;
+const manager = await import('../manager.mjs');
+const { drainSessionStore, evictLiveSession, fenceSessionWrites, loadSession, saveSessionAsync } = await import('../store.mjs');
+const { persistToolResultArtifactSync } = await import('../tool-result-offload.mjs');
+const { _withRegisteredProviderForTestAsync } = await import('../../providers/registry.mjs');
+const { _settleDeferredPrunesForTest } = await import('./compaction-runner.mjs');
+const { _sessionLogIoForTest } = await import('../store/session-log-writer.mjs');
+const { parseSessionLog } = await import('../store/session-log-reader.mjs');
+const { encodePatch } = await import('../store/session-log-format.mjs');
+
+const HOUR_AGO = new Date(Date.now() - 3_600_000);
+
+function summaryNaming(path) {
+  return [
+    '## Goal',
+    '- keep the work',
+    '## Constraints & Preferences',
+    '- (none)',
+    '## Progress',
+    '### Done',
+    '- older turns summarized',
+    '### In Progress',
+    '- (none)',
+    '### Blocked',
+    '- (none)',
+    '## Key Decisions',
+    '- (none)',
+    '## Next Steps',
+    '- continue',
+    '## Critical Context',
+    `- the kept result is at ${path}`,
+    '## Relevant Files',
+    '- (none)',
+  ].join('\n');
+}
+
+// A stored session with three old sidecars: `kept` the summary will name, `queued` a queued message may name, and
+// `stray` only the first request names (the compaction drops it).
+async function storedSession(tag) {
+  const sessionId = `sess_prune_after_save_${tag}_${process.pid}`;
+  const sidecar = (role) => {
+    const { path } = persistToolResultArtifactSync({ sessionId, toolCallId: `call_${role}`, content: `${role} output of ${tag}` });
+    utimesSync(path, HOUR_AGO, HOUR_AGO);
+    return path;
+  };
+  const files = { kept: sidecar('kept'), queued: sidecar('queued'), stray: sidecar('stray') };
+  const messages = [
+    { role: 'system', content: 'system rules stay exact' },
+    { role: 'user', content: `the first result is at ${files.stray}` },
+    { role: 'assistant', content: 'noted' },
+  ];
+  for (let turn = 0; turn < 30; turn += 1) {
+    messages.push(
+      { role: 'user', content: `request ${turn} ${'context '.repeat(400)}` },
+      { role: 'assistant', content: `answer ${turn} ${'detail '.repeat(400)}` }
+    );
+  }
+  const session = {
+    id: sessionId,
+    provider: 'anthropic',
+    model: 'fake-model',
+    owner: 'agent',
+    contextWindow: 100_000,
+    compactBoundaryTokens: 100_000,
+    messages,
+    tools: [],
+    generation: 0,
+    closed: false,
+    compaction: { conversationThresholdTokens: 1 },
+  };
+  await saveSessionAsync(session);
+  return { sessionId, files };
+}
+
+// `compactSessionMessages` with a summary naming `kept`; `between` runs after the compaction is adopted and before
+// it is saved.
+async function compact({ sessionId, files }, between = () => {}) {
+  const write = process.stderr.write;
+  process.stderr.write = function (chunk, ...rest) {
+    if (String(chunk).startsWith(`compaction session=${sessionId} `)) between();
+    return write.call(this, chunk, ...rest);
+  };
+  const provider = { name: 'anthropic', send: async () => ({ content: summaryNaming(files.kept) }) };
+  try {
+    return await _withRegisteredProviderForTestAsync('anthropic', provider, () => manager.compactSessionMessages(sessionId));
+  } finally {
+    process.stderr.write = write;
+  }
+}
+
+const left = (files) =>
+  Object.entries(files)
+    .filter(([, path]) => existsSync(path))
+    .map(([role]) => role);
+
+if (CHILD) {
+  const seeded = await storedSession('crash');
+  await compact(seeded, () => process.exit(0));
+  process.exit(1);
+} else {
+  test.after(async () => {
+    drainSessionStore();
+    rmSync(dataDir, { recursive: true, force: true });
+  });
+
+  test('a process that stops between the compaction and its save keeps every sidecar the stored transcript names', () => {
+    const child = spawnSync(process.execPath, [fileURLToPath(import.meta.url)], {
+      env: { ...process.env, MIXDOG_PRUNE_AFTER_SAVE_CHILD: '1', MIXDOG_DATA_DIR: dataDir },
+      encoding: 'utf8',
+      timeout: 60_000,
+    });
+    assert.equal(child.status, 0, `the child stopped between the compaction and its save: ${child.stderr}`);
+    const sessionId = `sess_prune_after_save_crash_${child.pid}`;
+    evictLiveSession(sessionId);
+    const stored = loadSession(sessionId);
+    assert.ok(stored, 'the stored session');
+    const dir = join(dataDir, 'tool-results', sessionId);
+    const named = [...new Set(JSON.stringify(stored.messages).match(/\b[a-f0-9]{64}\.txt\b/g) || [])];
+    assert.ok(named.length > 0, 'the stored transcript names a sidecar');
+    assert.deepEqual(
+      named.filter((name) => !readdirSync(dir).includes(name)),
+      [],
+      'sidecars the stored transcript names are missing'
+    );
+  });
+
+  test('a message queued before the save keeps the sidecar it names', async () => {
+    const seeded = await storedSession('queued');
+    const result = await compact(seeded, () => manager.enqueuePendingMessage(seeded.sessionId, { content: `look at ${seeded.files.queued}` }));
+    assert.equal(result.changed, true, JSON.stringify(result));
+    assert.deepEqual(left(seeded.files), ['kept', 'queued']);
+  });
+
+  test('a turn started before the save stops the prune; once the turn ends the skipped prune runs, with no second compaction', async () => {
+    const seeded = await storedSession('turn');
+    const result = await compact(seeded, () => manager.markSessionAskStart(seeded.sessionId));
+    assert.equal(result.changed, true, JSON.stringify(result));
+    assert.deepEqual(left(seeded.files), ['kept', 'queued', 'stray'], 'a session that is not idle is not pruned');
+    manager.markSessionDone(seeded.sessionId);
+    await _settleDeferredPrunesForTest();
+    assert.deepEqual(left(seeded.files), ['kept']);
+  });
+
+  test('a save dropped by a delete fence prunes nothing', async () => {
+    const seeded = await storedSession('dropped');
+    const result = await compact(seeded, () => fenceSessionWrites(seeded.sessionId));
+    assert.equal(result.changed, true, JSON.stringify(result));
+    assert.deepEqual(left(seeded.files), ['kept', 'queued', 'stray']);
+  });
+
+  test('a save refused because another writer recorded after this copy prunes nothing', async () => {
+    const seeded = await storedSession('superseded');
+    // Another writer's header patch, appended after the log's last record (session-writers.test.mjs).
+    const appendForeign = () => {
+      const logPath = join(dataDir, 'sessions', `${seeded.sessionId}.log.jsonl`);
+      const { seq } = parseSessionLog(readFileSync(logPath));
+      appendFileSync(logPath, encodePatch(seq + 1, [['status', JSON.stringify('error')]], []));
+    };
+    await assert.rejects(compact(seeded, appendForeign), { code: 'ESESSIONCHANGED' });
+    assert.deepEqual(left(seeded.files), ['kept', 'queued', 'stray']);
+  });
+
+  test('a save whose write fails prunes nothing', async () => {
+    const seeded = await storedSession('thrown');
+    const io = _sessionLogIoForTest();
+    const fsync = io.fsync;
+    const failOnce = () => {
+      io.fsync = (fd, done) => {
+        io.fsync = fsync;
+        done(Object.assign(new Error('injected fsync failure'), { code: 'EIO' }));
+      };
+    };
+    try {
+      await assert.rejects(compact(seeded, failOnce), { code: 'EIO' });
+    } finally {
+      io.fsync = fsync;
+    }
+    assert.deepEqual(left(seeded.files), ['kept', 'queued', 'stray']);
+  });
+}
