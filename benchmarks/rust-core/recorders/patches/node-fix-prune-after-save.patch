+// A manual compaction deletes the tool-result sidecars its result no longer names only once that result is stored: a
+// process that stops before the save restarts from the stored transcript, which still names them, and a save that does
+// not store it (dropped by a delete's fence, refused because another writer recorded after this copy, or failed)
+// prunes nothing. The prune keeps its idle check: a turn started before it leaves every sidecar until that turn ends,
+// and then the skipped prune runs, with no second compaction. Nothing of a prune is remembered on disk: every resume
+// reconciles the session's tool-result directory with the stored transcript (and the clear forks it names), so a
+// prune a close, a stopped process or an unreadable archive kept from finishing happens at the next resume. The copies
+// of a conversation in other sessions (a clear's fork, an inheritance's heir, and their own copies) keep the sidecars
+// they name, and a session this process let go while its prune ran is left to its next owner. A copy is found from its
+// own reference set (the sessions whose sidecars it may name: its source's set and its source, stored when it is made,
+// or for a session an earlier version stored, what its transcript names, checked once), so a copy of a copy counts
+// with the copy between them deleted; while a copy is being made its source is not pruned. The copies are read only
+// once an old sidecar the session itself does not keep remains, and one that cannot be read keeps everything. A
+// reference is text in the session's own messages (its system prompt included) and its copies': a room row naming a
+// sidecar keeps nothing.
+//
+// The point between the compaction and its save is the commit's timing line (`recordCompactionTiming`), written once
+// the compacted transcript is adopted and before `compactSessionMessages` saves it.
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { appendFileSync, existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, utimesSync, writeFileSync } from 'node:fs';
+import fsp from 'node:fs/promises';
+import { syncBuiltinESMExports } from 'node:module';
+import { tmpdir } from 'node:os';
+import { basename, join } from 'node:path';
+import test from 'node:test';
+import { fileURLToPath } from 'node:url';
+
+const CHILD = process.env.MIXDOG_PRUNE_AFTER_SAVE_CHILD || '';
+const dataDir = CHILD ? process.env.MIXDOG_DATA_DIR : mkdtempSync(join(tmpdir(), 'mixdog-prune-after-save-'));
+process.env.MIXDOG_DATA_DIR = dataDir;
+const manager = await import('../manager.mjs');
+const { drainSessionStore, evictLiveSession, fenceSessionWrites, loadSession, saveSessionAsync } = await import('../store.mjs');
+const { persistToolResultArtifactSync } = await import('../tool-result-offload.mjs');
+const { _withRegisteredProviderForTestAsync } = await import('../../providers/registry.mjs');
+const runner = await import('./compaction-runner.mjs');
+// Settles every deferred prune that has started; a runner without deferred prunes has none to settle.
+const settleDeferredPrunes = async () => {
+  await runner._settleDeferredPrunesForTest?.();
+};
+const { createLifecycleApi } = await import('../../../../../session-runtime/lifecycle-api.mjs');
+const { appendRoomRows } = await import('../../../../../session-runtime/agent-room-delivery.mjs');
+
+// The prune's file system calls on a session's tool-result directory (`readdir`, `stat`, `readFile` of
+// node:fs/promises), counted per call; `hold(path)` may make the listing wait.
+const fsCalls = [];
+let hold = null;
+for (const name of ['readdir', 'stat', 'readFile']) {
+  const real = fsp[name];
+  fsp[name] = function (path, ...rest) {
+    fsCalls.push([name, String(path)]);
+    const held = name === 'readdir' ? hold?.(String(path)) : null;
+    return held ? held.then(() => real.call(this, path, ...rest)) : real.call(this, path, ...rest);
+  };
+}
+syncBuiltinESMExports();
+const { _sessionLogIoForTest } = await import('../store/session-log-writer.mjs');
+const { settleRecorder } = await import('../store/session-writers.mjs');
+const { parseSessionLog } = await import('../store/session-log-reader.mjs');
+const { encodeAppend, encodePatch, messageJson } = await import('../store/session-log-format.mjs');
+
+const HOUR_AGO = new Date(Date.now() - 3_600_000);
+const sidecarName = (content) => `${createHash('sha256').update(content).digest('hex')}.txt`;
+
+function summaryNaming(path) {
+  return [
+    '## Goal',
+    '- keep the work',
+    '## Constraints & Preferences',
+    '- (none)',
+    '## Progress',
+    '### Done',
+    '- older turns summarized',
+    '### In Progress',
+    '- (none)',
+    '### Blocked',
+    '- (none)',
+    '## Key Decisions',
+    '- (none)',
+    '## Next Steps',
+    '- continue',
+    '## Critical Context',
+    `- the kept result is at ${path}`,
+    '## Relevant Files',
+    '- (none)',
+  ].join('\n');
+}
+
+// A stored session with three old sidecars: `kept` the summary will name, `queued` a queued message may name, and
+// `stray` only the first request names (the compaction drops it).
+async function storedSession(tag) {
+  const sessionId = `sess_prune_after_save_${tag}_${process.pid}`;
+  const sidecar = (role) => {
+    const { path } = persistToolResultArtifactSync({ sessionId, toolCallId: `call_${role}`, content: `${role} output of ${tag}` });
+    utimesSync(path, HOUR_AGO, HOUR_AGO);
+    return path;
+  };
+  const files = { kept: sidecar('kept'), queued: sidecar('queued'), stray: sidecar('stray') };
+  const messages = [
+    { role: 'system', content: 'system rules stay exact' },
+    { role: 'user', content: `the first result is at ${files.stray}` },
+    { role: 'assistant', content: 'noted' },
+  ];
+  for (let turn = 0; turn < 30; turn += 1) {
+    messages.push(
+      { role: 'user', content: `request ${turn} ${'context '.repeat(400)}` },
+      { role: 'assistant', content: `answer ${turn} ${'detail '.repeat(400)}` }
+    );
+  }
+  const session = {
+    id: sessionId,
+    provider: 'anthropic',
+    model: 'fake-model',
+    owner: 'agent',
+    contextWindow: 100_000,
+    compactBoundaryTokens: 100_000,
+    messages,
+    tools: [],
+    generation: 0,
+    closed: false,
+    compaction: { conversationThresholdTokens: 1 },
+  };
+  await saveSessionAsync(session);
+  return { sessionId, files };
+}
+
+// `compactSessionMessages(options)` (or `run`, another entry that compacts) with a summary naming `kept`; `between`
+// runs after the compaction is adopted and before it is saved.
+async function compact({ sessionId, files }, between = () => {}, options = {}, run = () => manager.compactSessionMessages(sessionId, options)) {
+  const write = process.stderr.write;
+  process.stderr.write = function (chunk, ...rest) {
+    if (String(chunk).startsWith(`compaction session=${sessionId} `)) between();
+    return write.call(this, chunk, ...rest);
+  };
+  const provider = { name: 'anthropic', send: async () => ({ content: summaryNaming(files.kept) }) };
+  try {
+    return await _withRegisteredProviderForTestAsync('anthropic', provider, run);
+  } finally {
+    process.stderr.write = write;
+  }
+}
+
+const left = (files) =>
+  Object.entries(files)
+    .filter(([, path]) => existsSync(path))
+    .map(([role]) => role);
+
+// What the session's tool-result directory holds: every name, with its mtime.
+const listing = ({ sessionId }) => {
+  const dir = join(dataDir, 'tool-results', sessionId);
+  return readdirSync(dir).map((name) => [name, statSync(join(dir, name)).mtimeMs]);
+};
+
+// A turn that starts once the compaction is adopted, before its save: its prune is left to the turn's end.
+async function compactUnderATurn(seeded) {
+  const result = await compact(seeded, () => manager.markSessionAskStart(seeded.sessionId));
+  assert.equal(result.changed, true, JSON.stringify(result));
+  assert.deepEqual(left(seeded.files), ['kept', 'queued', 'stray'], 'a session that is not idle is not pruned');
+}
+
+// What `run` writes to stderr.
+async function stderrOf(run) {
+  const write = process.stderr.write;
+  let text = '';
+  process.stderr.write = function (chunk, ...rest) {
+    text += String(chunk);
+    return write.call(this, chunk, ...rest);
+  };
+  try {
+    await run();
+  } finally {
+    process.stderr.write = write;
+  }
+  return text;
+}
+
+// The session is resumed from its stored copy, and its reconcile has run.
+async function resume(sessionId) {
+  evictLiveSession(sessionId);
+  assert.ok(await manager.resumeSession(sessionId), 'resumed');
+  await settleDeferredPrunes();
+}
+
+// A stored session, not compacted, holding `sidecars` (role -> content, an hour old) and `messages(files)`, with the
+// record's `fields`.
+async function plainSession(tag, sidecars, messages, fields = {}) {
+  const sessionId = `sess_prune_after_save_${tag}_${process.pid}`;
+  const files = {};
+  for (const [role, content] of Object.entries(sidecars)) {
+    files[role] = persistToolResultArtifactSync({ sessionId, toolCallId: `call_${role}`, content }).path;
+    utimesSync(files[role], HOUR_AGO, HOUR_AGO);
+  }
+  await saveSessionAsync({ id: sessionId, provider: 'anthropic', model: 'fake-model', owner: 'agent', messages: messages(files), tools: [], generation: 0, closed: false, ...fields });
+  return { sessionId, files };
+}
+
+if (CHILD === 'crash' || CHILD === '1') {
+  const seeded = await storedSession('crash');
+  await compact(seeded, () => process.exit(0));
+  process.exit(1);
+} else if (CHILD === 'saved') {
+  // The process stops once the compacted transcript is durable, before the prune runs.
+  const seeded = await storedSession('saved');
+  const io = _sessionLogIoForTest();
+  const fsync = io.fsync;
+  await compact(seeded, () => {
+    io.fsync = (fd, done) => fsync(fd, (error) => (error ? done(error) : process.exit(0)));
+  });
+  process.exit(1);
+} else if (CHILD === 'copying') {
+  // The process stops while a copy of the conversation is being made: its set and its mark are stored, its record is not.
+  const seeded = await plainSession(
+    'copying',
+    { named: 'named output', stray: 'stray output' },
+    (files) => [
+      { role: 'user', content: `the result is at ${files.named}` },
+      { role: 'assistant', content: 'noted' },
+    ],
+    // A boundary the heir's carry is compacted toward.
+    { contextWindow: 100_000, compactBoundaryTokens: 100_000 }
+  );
+  const lifecycle = createLifecycleApi({
+    getSession: () => null,
+    getRoute: () => ({ provider: 'anthropic', model: 'fake-model' }),
+    mgr: manager,
+    invalidateContextStatusCache() {},
+    saveSession() {},
+    compactConversation: async () => process.exit(0),
+  });
+  const provider = { name: 'anthropic', contextWindow: 128_000, send: async () => ({ content: 'no turn runs' }) };
+  await _withRegisteredProviderForTestAsync('anthropic', provider, () => lifecycle.inheritToNewSession(seeded.sessionId, { compact: true }));
+  process.exit(1);
+} else if (CHILD === 'stopped') {
+  // The process stops while the turn that stopped the prune still runs.
+  await compactUnderATurn(await storedSession('stopped'));
+  process.exit(0);
+} else {
+  test.after(async () => {
+    drainSessionStore();
+    rmSync(dataDir, { recursive: true, force: true });
+  });
+
+  test('a process that stops between the compaction and its save keeps every sidecar the stored transcript names', () => {
+    const child = spawnSync(process.execPath, [fileURLToPath(import.meta.url)], {
+      env: { ...process.env, MIXDOG_PRUNE_AFTER_SAVE_CHILD: 'crash', MIXDOG_DATA_DIR: dataDir },
+      encoding: 'utf8',
+      timeout: 60_000,
+    });
+    assert.equal(child.status, 0, `the child stopped between the compaction and its save: ${child.stderr}`);
+    const sessionId = `sess_prune_after_save_crash_${child.pid}`;
+    evictLiveSession(sessionId);
+    const stored = loadSession(sessionId);
+    assert.ok(stored, 'the stored session');
+    const dir = join(dataDir, 'tool-results', sessionId);
+    const named = [...new Set(JSON.stringify(stored.messages).match(/\b[a-f0-9]{64}\.txt\b/g) || [])];
+    assert.ok(named.length > 0, 'the stored transcript names a sidecar');
+    assert.deepEqual(
+      named.filter((name) => !readdirSync(dir).includes(name)),
+      [],
+      'sidecars the stored transcript names are missing'
+    );
+  });
+
+  test('a message queued before the save keeps the sidecar it names', async () => {
+    const seeded = await storedSession('queued');
+    const result = await compact(seeded, () => manager.enqueuePendingMessage(seeded.sessionId, { content: `look at ${seeded.files.queued}` }));
+    assert.equal(result.changed, true, JSON.stringify(result));
+    assert.deepEqual(left(seeded.files), ['kept', 'queued']);
+  });
+
+  test('a turn started before the save stops the prune; once the turn ends the skipped prune runs, with no second compaction', async () => {
+    const seeded = await storedSession('turn');
+    await compactUnderATurn(seeded);
+    manager.markSessionDone(seeded.sessionId);
+    await settleDeferredPrunes();
+    assert.deepEqual(left(seeded.files), ['kept']);
+  });
+
+  test('the automatic compaction (auto-clear: a reduction required) prunes once its result is saved', async () => {
+    const seeded = await storedSession('auto');
+    let leftAtAdoption = null;
+    const result = await compact(seeded, () => (leftAtAdoption = left(seeded.files)), { requireReduction: true });
+    assert.equal(result.changed, true, JSON.stringify(result));
+    assert.deepEqual(leftAtAdoption, ['kept', 'queued', 'stray'], 'nothing is pruned before the save');
+    assert.deepEqual(left(seeded.files), ['kept']);
+  });
+
+  for (const [how, end] of [
+    ['cancelled', (id) => manager.markSessionCancelled(id)],
+    ['failed', (id) => manager.markSessionError(id, 'the provider failed')],
+  ]) {
+    test(`a ${how} turn that stopped the prune lets it run when it ends`, async () => {
+      const seeded = await storedSession(how);
+      await compactUnderATurn(seeded);
+      end(seeded.sessionId);
+      await settleDeferredPrunes();
+      assert.deepEqual(left(seeded.files), ['kept']);
+    });
+  }
+
+  test('a session closed before the turn that stopped the prune ends is pruned when it is resumed', async () => {
+    const seeded = await storedSession('closed');
+    await compactUnderATurn(seeded);
+    assert.equal(await manager.closeSession(seeded.sessionId, 'manual', { tombstone: false }), true, 'closed');
+    await settleDeferredPrunes();
+    assert.deepEqual(left(seeded.files), ['kept', 'queued', 'stray'], 'a close prunes nothing');
+    await resume(seeded.sessionId);
+    assert.deepEqual(left(seeded.files), ['kept']);
+  });
+
+  test('a process stopped before the turn that stopped the prune ends: the session is pruned when it is resumed', async () => {
+    const child = spawnSync(process.execPath, [fileURLToPath(import.meta.url)], {
+      env: { ...process.env, MIXDOG_PRUNE_AFTER_SAVE_CHILD: 'stopped', MIXDOG_DATA_DIR: dataDir },
+      encoding: 'utf8',
+      timeout: 60_000,
+    });
+    assert.equal(child.status, 0, `the child left the prune pending: ${child.stderr}`);
+    const sessionId = `sess_prune_after_save_stopped_${child.pid}`;
+    const files = Object.fromEntries(
+      ['kept', 'queued', 'stray'].map((role) => [role, join(dataDir, 'tool-results', sessionId, sidecarName(`${role} output of stopped`))])
+    );
+    assert.deepEqual(left(files), ['kept', 'queued', 'stray']);
+    await resume(sessionId);
+    assert.deepEqual(left(files), ['kept']);
+  });
+
+  test('a process stopped between the save and the prune: no prune is remembered, and the resume prunes', async () => {
+    const child = spawnSync(process.execPath, [fileURLToPath(import.meta.url)], {
+      env: { ...process.env, MIXDOG_PRUNE_AFTER_SAVE_CHILD: 'saved', MIXDOG_DATA_DIR: dataDir },
+      encoding: 'utf8',
+      timeout: 60_000,
+    });
+    assert.equal(child.status, 0, `the child stopped once the compaction was saved: ${child.stderr}`);
+    const sessionId = `sess_prune_after_save_saved_${child.pid}`;
+    const dir = join(dataDir, 'tool-results', sessionId);
+    const names = Object.fromEntries(['kept', 'queued', 'stray'].map((role) => [sidecarName(`${role} output of saved`), role]));
+    assert.deepEqual(readdirSync(dir).map((name) => names[name] ?? name).sort(), ['kept', 'queued', 'stray'], 'nothing pruned before the save, nothing else written');
+    await resume(sessionId);
+    assert.deepEqual(readdirSync(dir).map((name) => names[name] ?? name), ['kept']);
+  });
+
+  test('an archive unreadable at one resume deletes nothing; the next resume, reading it, prunes', async () => {
+    const archivedContent = 'archived output';
+    const seeded = await plainSession('archive', { archived: archivedContent, archive: `older output is at ${sidecarName(archivedContent)}`, stray: 'stray output' }, (files) => [
+      { role: 'user', content: `the archive is at ${files.archive}` },
+      { role: 'assistant', content: 'noted' },
+    ]);
+    const content = readFileSync(seeded.files.archive, 'utf8');
+    rmSync(seeded.files.archive);
+    mkdirSync(seeded.files.archive);
+    await resume(seeded.sessionId);
+    assert.deepEqual(left(seeded.files), ['archived', 'archive', 'stray'], 'an unreadable archive deletes nothing');
+    assert.equal(await manager.closeSession(seeded.sessionId, 'manual', { tombstone: false }), true, 'closed');
+    rmSync(seeded.files.archive, { recursive: true });
+    persistToolResultArtifactSync({ sessionId: seeded.sessionId, toolCallId: 'call_archive', content });
+    await resume(seeded.sessionId);
+    assert.deepEqual(left(seeded.files), ['archived', 'archive']);
+  });
+
+  test('a resume with nothing to prune deletes and writes nothing', async () => {
+    const seeded = await plainSession('nothing', { named: 'named output', young: 'young output' }, (files) => [
+      { role: 'user', content: `the result is at ${files.named}` },
+      { role: 'assistant', content: 'noted' },
+    ]);
+    utimesSync(seeded.files.young, new Date(), new Date());
+    const before = listing(seeded);
+    const dir = join(dataDir, 'tool-results', seeded.sessionId);
+    fsCalls.length = 0;
+    await resume(seeded.sessionId);
+    assert.deepEqual(listing(seeded), before);
+    // One listing and the unnamed sidecar's age (young: kept); the named sidecar's age and no archive are read.
+    assert.deepEqual(
+      fsCalls.filter(([, path]) => path.startsWith(dir)).map(([name, path]) => [name, basename(path)]),
+      [
+        ['readdir', basename(dir)],
+        ['stat', basename(seeded.files.young)],
+      ]
+    );
+  });
+
+  test("a clear's fork keeps the sidecars it names when the cleared session is resumed", async () => {
+    const seeded = await plainSession('fork', { named: 'named output', stray: 'stray output' }, (files) => [
+      { role: 'user', content: `the result is at ${files.named}` },
+      { role: 'assistant', content: 'noted' },
+    ]);
+    const forkId = `sess_prune_after_save_fork_archive_${process.pid}`;
+    assert.ok(await manager.clearSessionMessages(seeded.sessionId, { archiveAs: forkId }), 'cleared');
+    await settleRecorder(forkId);
+    await settleRecorder(seeded.sessionId);
+    assert.equal(await manager.closeSession(seeded.sessionId, 'manual', { tombstone: false }), true, 'closed');
+    await resume(seeded.sessionId);
+    assert.deepEqual(left(seeded.files), ['named']);
+    assert.match(JSON.stringify(loadSession(forkId).messages), new RegExp(basename(seeded.files.named)));
+  });
+
+  test("an inheritance's heir, and the fork of the heir's clear, keep the source's sidecars they name", async () => {
+    const seeded = await plainSession('heir', { named: 'named output', stray: 'stray output' }, (files) => [
+      { role: 'user', content: `the result is at ${files.named}` },
+      { role: 'assistant', content: 'noted' },
+    ]);
+    const provider = { name: 'anthropic', contextWindow: 128_000, send: async () => ({ content: 'no turn runs' }) };
+    const { sessionId: heirId } = await _withRegisteredProviderForTestAsync('anthropic', provider, () =>
+      createLifecycleApi({ getSession: () => null, getRoute: () => ({ provider: 'anthropic', model: 'fake-model' }), mgr: manager, invalidateContextStatusCache() {}, saveSession() {} }).inheritToNewSession(seeded.sessionId)
+    );
+    // The heir is cleared with a fork (the fork holds the copy), and the source without one.
+    assert.ok(await manager.clearSessionMessages(heirId), 'the heir is cleared');
+    assert.ok(await manager.clearSessionMessages(seeded.sessionId, { fork: false }), 'the source is cleared');
+    await settleRecorder(heirId);
+    await settleRecorder(seeded.sessionId);
+    assert.equal(await manager.closeSession(seeded.sessionId, 'manual', { tombstone: false }), true, 'closed');
+    await resume(seeded.sessionId);
+    assert.deepEqual(left(seeded.files), ['named']);
+  });
+
+  test('a copy an earlier version made (no reference set, no link to its source) keeps the sidecars its transcript names', async () => {
+    const seeded = await plainSession('older', { named: 'named output', stray: 'stray output' }, (files) => [
+      { role: 'user', content: `the result is at ${files.named}` },
+      { role: 'assistant', content: 'noted' },
+    ]);
+    // What a clear's fork made by an earlier version stored: a record (its legacy `<id>.json`) holding the
+    // conversation, and no reference set or anything else naming its source.
+    const heirId = `sess_prune_after_save_older_heir_${process.pid}`;
+    const record = { id: heirId, provider: 'anthropic', model: 'fake-model', owner: 'agent', messages: loadSession(seeded.sessionId).messages, tools: [], generation: 0, closed: false };
+    writeFileSync(join(dataDir, 'sessions', `${heirId}.json`), JSON.stringify(record));
+    assert.equal(loadSession(heirId).offloadSources, undefined, 'the copy holds no reference set');
+    assert.ok(await manager.clearSessionMessages(seeded.sessionId, { fork: false }), 'cleared');
+    await settleRecorder(seeded.sessionId);
+    assert.equal(await manager.closeSession(seeded.sessionId, 'manual', { tombstone: false }), true, 'closed');
+    await resume(seeded.sessionId);
+    assert.deepEqual(left(seeded.files), ['named']);
+  });
+
+  test("a copy whose record cannot be read keeps every sidecar, and the skip says why", async () => {
+    const seeded = await plainSession('unreadable', { named: 'named output', stray: 'stray output' }, (files) => [
+      { role: 'user', content: `the result is at ${files.named}` },
+      { role: 'assistant', content: 'noted' },
+    ]);
+    const forkId = `sess_prune_after_save_unreadable_archive_${process.pid}`;
+    assert.ok(await manager.clearSessionMessages(seeded.sessionId, { archiveAs: forkId }), 'cleared');
+    await settleRecorder(forkId);
+    await settleRecorder(seeded.sessionId);
+    assert.deepEqual(loadSession(forkId).offloadSources, [seeded.sessionId], "the clear's fork holds its reference set in its own record");
+    assert.equal(await manager.closeSession(seeded.sessionId, 'manual', { tombstone: false }), true, 'closed');
+    const forkLog = join(dataDir, 'sessions', `${forkId}.log.jsonl`);
+    const stored = readFileSync(forkLog);
+    writeFileSync(forkLog, 'not a session log\n');
+    const logged = await stderrOf(() => resume(seeded.sessionId));
