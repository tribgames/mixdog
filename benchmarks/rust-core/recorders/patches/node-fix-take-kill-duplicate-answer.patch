--- /dev/null
+++ b/src/runtime/agent/orchestrator/session/manager/ask-turn-loop-options.committed-text.test.mjs
@@ -0,0 +1,35 @@
+// A committed answer is reported again to the host after its commit (keepEndedAnswer, before queued input is taken in): the
+// interruption tracker must not take that text back into its partial buffer, or the recovery of a process killed after
+// the take appends the answer a second time.
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+const { buildAgentLoopOptions } = await import('./ask-turn-loop-options.mjs');
+const { createTurnInterruptionTracker } = await import('./turn-interruption.mjs');
+
+function optionsFor(interruption) {
+  return buildAgentLoopOptions({
+    sessionId: 'sess-committed-text',
+    session: {},
+    outgoing: [],
+    turn: {},
+    askOpts: {},
+    interruption,
+    checkpoint: { schedule() {} },
+  });
+}
+
+test('a committed answer reported again leaves the partial buffer empty', () => {
+  const interruption = createTurnInterruptionTracker();
+  const options = optionsFor(interruption);
+  options.onTextDelta('answer');
+  options.onAssistantMessageCommitted({ role: 'assistant', content: 'answer' });
+  options.onAssistantText('answer', { committed: true });
+  assert.equal(interruption.snapshot().partialAssistantContent, '');
+});
+
+test('a buffered provider segment that is not yet committed is still recorded', () => {
+  const interruption = createTurnInterruptionTracker();
+  optionsFor(interruption).onAssistantText('whole segment', { committed: false });
+  assert.equal(interruption.snapshot().partialAssistantContent, 'whole segment');
+});
