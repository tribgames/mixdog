diff --git a/src/runtime/agent/orchestrator/providers/credential-echo-scrub.test.mjs b/src/runtime/agent/orchestrator/providers/credential-echo-scrub.test.mjs
new file mode 100644
index 0000000..04d1df5
--- /dev/null
+++ b/src/runtime/agent/orchestrator/providers/credential-echo-scrub.test.mjs
@@ -0,0 +1,113 @@
+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import test from 'node:test';
+import { _anthropicSseError } from './anthropic-sse.mjs';
+import { antigravityError } from './antigravity-transport.mjs';
+import { exchangeCursorToken } from './cursor-auth.mjs';
+import { geminiRestError } from './gemini.mjs';
+import { _scrubTokens } from './grok-oauth-tokens.mjs';
+import { credentialForms, scrubHeaders, scrubOAuthSecrets } from './lib/oauth-token-utils.mjs';
+import { attachHandshakeFailureHandlers } from './openai-ws-handshake.mjs';
+
+// A refusal or error event that repeats the credential the request carried, inside ordinary text (no bearer prefix,
+// no token shape, no secret field): only the credential the request carried names it.
+const KEY = 'fixture-opaque-credential';
+const echo = `the credential ${KEY} was refused`;
+
+test('an Anthropic SSE error event redacts the credential the request carried', () => {
+  const err = _anthropicSseError({ type: 'error', error: { type: 'invalid_request_error', message: echo } }, { display: 'Anthropic' }, KEY);
+  assert.equal(err.message, 'Anthropic SSE error invalid_request_error: the credential [REDACTED] was refused');
+});
+
+test('a Gemini refusal redacts the key the request carried', () => {
+  const err = geminiRestError({ status: 400, headers: {} }, echo, 'Gemini REST generateContent', [KEY]);
+  assert.equal(err.message, 'Gemini REST generateContent 400: the credential [REDACTED] was refused');
+});
+
+test('an Antigravity refusal redacts the bearer the request carried', () => {
+  const err = antigravityError({ status: 400, headers: {} }, JSON.stringify({ error: { message: echo } }), 'endpoint', [KEY]);
+  assert.equal(err.message, 'Antigravity 400 (endpoint): the credential [REDACTED] was refused');
+});
+
+test('a Cursor token exchange refusal redacts the token it carried', async () => {
+  const fetchFn = async () => ({ ok: false, status: 400, text: async () => echo, headers: new Headers() });
+  await assert.rejects(exchangeCursorToken(KEY, { fetchFn }), (error) => !error.message.includes(KEY) && error.message.includes('[REDACTED]'));
+});
+
+test('a Grok refresh refusal redacts the tokens it carried', () => {
+  assert.equal(_scrubTokens(echo, [KEY]), 'the credential [REDACTED] was refused');
+});
+
+test('an OpenAI upgrade rejection redacts the credential the upgrade carried', async () => {
+  const socket = new EventEmitter();
+  socket.terminate = () => {};
+  const settled = new Promise((resolve) => {
+    attachHandshakeFailureHandlers({ socket, errLabel: 'OpenAI WS', openStart: 0, isSettled: () => false, settle: (_ok, error) => resolve(error), carriedToken: KEY });
+  });
+  const res = new EventEmitter();
+  res.statusCode = 400;
+  res.headers = {};
+  socket.emit('unexpected-response', {}, res);
+  res.emit('data', Buffer.from(echo));
+  res.emit('end');
+  const error = await settled;
+  assert.equal(error.message, 'OpenAI WS handshake 400: the credential [REDACTED] was refused');
+  assert.equal(error.httpBody, 'the credential [REDACTED] was refused');
+});
+
+// A server repeats the credential it was sent in the form its own text holds it in: a query string percent-encodes it, a
+// Basic header holds `user:key` in base64, a proxy or log the URL-safe base64. Every spelling is redacted, in the text and in
+// the response headers (a `Location` that names the key in its query).
+const ODD = 'fixture/opaque+credential&odd=1';
+const b64 = (text) => Buffer.from(text).toString('base64');
+
+test('a credential is redacted in each spelling a server repeats it in', () => {
+  const spellings = [ODD, encodeURIComponent(ODD), b64(ODD), Buffer.from(ODD).toString('base64url'), b64(ODD).replace(/=+$/, '')];
+  for (const spelling of spellings) {
+    assert.equal(scrubOAuthSecrets(`refused ${spelling} for this account`, [ODD]), 'refused [REDACTED] for this account', spelling);
+  }
+  assert.ok(credentialForms(ODD).includes(encodeURIComponent(ODD)));
+});
+
+test('a Basic credential names its key and the url-safe base64 of its user:key', () => {
+  const header = b64(`user:${ODD}`);
+  const echoed = `${ODD}, ${header}, ${Buffer.from(`user:${ODD}`).toString('base64url')} and ${encodeURIComponent(ODD)}`;
+  assert.equal(scrubOAuthSecrets(echoed, [header]), '[REDACTED], [REDACTED], [REDACTED] and [REDACTED]');
+  assert.equal(scrubOAuthSecrets(`${ODD} ${header}`, [`user:${ODD}`]), '[REDACTED] [REDACTED]');
+});
+
+test('a response header repeating the credential is redacted, whatever shape the headers have', () => {
+  const location = `https://example.test/retry?key=${encodeURIComponent(ODD)}`;
+  assert.equal(scrubHeaders(new Headers({ location, 'x-request-id': 'req_1' }), [ODD]).get('location'), 'https://example.test/retry?key=[REDACTED]');
+  assert.equal(scrubHeaders(new Headers({ 'x-request-id': 'req_1' }), [ODD]).get('x-request-id'), 'req_1');
+  assert.deepEqual(scrubHeaders({ location, 'set-cookie': [`s=${ODD}`] }, [ODD]), { location: 'https://example.test/retry?key=[REDACTED]', 'set-cookie': ['s=[REDACTED]'] });
+});
+
+test('a Gemini refusal redacts the key in its text and its headers in each spelling', () => {
+  const headers = new Headers({ location: `https://example.test/?key=${encodeURIComponent(ODD)}` });
+  const err = geminiRestError({ status: 400, headers }, `key ${encodeURIComponent(ODD)} and ${ODD} refused`, 'Gemini REST generateContent', [ODD]);
+  assert.equal(err.message, 'Gemini REST generateContent 400: key [REDACTED] and [REDACTED] refused');
+  assert.equal(err.headers.get('location'), 'https://example.test/?key=[REDACTED]');
+});
+
+test('an Antigravity refusal redacts the bearer in its headers', () => {
+  const err = antigravityError({ status: 400, headers: new Headers({ 'www-authenticate': `Bearer error="invalid", token="${KEY}"` }) }, '{}', 'endpoint', [KEY]);
+  assert.equal(err.headers.get('www-authenticate'), 'Bearer error="invalid", token="[REDACTED]"');
+});
+
+test('an OpenAI upgrade rejection redacts the credential in its headers and its body in each spelling', async () => {
+  const socket = new EventEmitter();
+  socket.terminate = () => {};
+  const settled = new Promise((resolve) => {
+    attachHandshakeFailureHandlers({ socket, errLabel: 'OpenAI WS', openStart: 0, isSettled: () => false, settle: (_ok, error) => resolve(error), carriedToken: ODD });
+  });
+  const res = new EventEmitter();
+  res.statusCode = 400;
+  res.headers = { location: `https://example.test/?key=${encodeURIComponent(ODD)}` };
+  socket.emit('unexpected-response', {}, res);
+  res.emit('data', Buffer.from(`the credential ${encodeURIComponent(ODD)} was refused`));
+  res.emit('end');
+  const error = await settled;
+  assert.equal(error.message, 'OpenAI WS handshake 400: the credential [REDACTED] was refused');
+  assert.equal(error.headers.location, 'https://example.test/?key=[REDACTED]');
+});
