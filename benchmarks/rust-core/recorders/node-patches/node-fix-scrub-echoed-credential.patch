diff --git a/src/runtime/agent/orchestrator/providers/credential-echo-scrub.test.mjs b/src/runtime/agent/orchestrator/providers/credential-echo-scrub.test.mjs
new file mode 100644
index 000000000..ee1cdc1de
--- /dev/null
+++ b/src/runtime/agent/orchestrator/providers/credential-echo-scrub.test.mjs
@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import test from 'node:test';
+import { _anthropicSseError } from './anthropic-sse.mjs';
+import { antigravityError } from './antigravity-transport.mjs';
+import { exchangeCursorToken } from './cursor-auth.mjs';
+import { geminiRestError } from './gemini.mjs';
+import { _scrubTokens } from './grok-oauth-tokens.mjs';
+import { attachHandshakeFailureHandlers } from './openai-ws-handshake.mjs';
+
+// A refusal or error event that repeats the credential the request carried, inside ordinary text (no bearer prefix,
+// no token shape, no secret field): only the credential the request carried names it.
+const KEY = 'fixture-opaque-credential';
+const echo = `the credential ${KEY} was refused`;
+
+test('an Anthropic SSE error event redacts the credential the request carried', () => {
+  const err = _anthropicSseError({ type: 'error', error: { type: 'invalid_request_error', message: echo } }, { display: 'Anthropic' }, KEY);
+  assert.equal(err.message, 'Anthropic SSE error invalid_request_error: the credential [REDACTED] was refused');
+});
+
+test('a Gemini refusal redacts the key the request carried', () => {
+  const err = geminiRestError({ status: 400, headers: {} }, echo, 'Gemini REST generateContent', [KEY]);
+  assert.equal(err.message, 'Gemini REST generateContent 400: the credential [REDACTED] was refused');
+});
+
+test('an Antigravity refusal redacts the bearer the request carried', () => {
+  const err = antigravityError({ status: 400, headers: {} }, JSON.stringify({ error: { message: echo } }), 'endpoint', [KEY]);
+  assert.equal(err.message, 'Antigravity 400 (endpoint): the credential [REDACTED] was refused');
+});
+
+test('a Cursor token exchange refusal redacts the token it carried', async () => {
+  const fetchFn = async () => ({ ok: false, status: 400, text: async () => echo, headers: new Headers() });
+  await assert.rejects(exchangeCursorToken(KEY, { fetchFn }), (error) => !error.message.includes(KEY) && error.message.includes('[REDACTED]'));
+});
+
+test('a Grok refresh refusal redacts the tokens it carried', () => {
+  assert.equal(_scrubTokens(echo, [KEY]), 'the credential [REDACTED] was refused');
+});
+
+test('an OpenAI upgrade rejection redacts the credential the upgrade carried', async () => {
+  const socket = new EventEmitter();
+  socket.terminate = () => {};
+  const settled = new Promise((resolve) => {
+    attachHandshakeFailureHandlers({ socket, errLabel: 'OpenAI WS', openStart: 0, isSettled: () => false, settle: (_ok, error) => resolve(error), carriedToken: KEY });
+  });
+  const res = new EventEmitter();
+  res.statusCode = 400;
+  res.headers = {};
+  socket.emit('unexpected-response', {}, res);
+  res.emit('data', Buffer.from(echo));
+  res.emit('end');
+  const error = await settled;
+  assert.equal(error.message, 'OpenAI WS handshake 400: the credential [REDACTED] was refused');
+  assert.equal(error.httpBody, 'the credential [REDACTED] was refused');
+});
