+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { redactSensitiveMessages } from './sensitive-projection.mjs';
+import { rememberSensitiveValues } from './sensitive-values.mjs';
+
+test("a marked value in an attachment's or file's name is stored redacted, as in its text and tool results", () => {
+  const session = 'sess_sensitive_names';
+  rememberSensitiveValues(session, [{ name: 'browser', arguments: { action: 'fill', input: { sensitive: true, text: 'hunter2' } } }]);
+  const stored = redactSensitiveMessages(session, [
+    {
+      role: 'user',
+      content: [
+        { type: 'text', text: 'here is hunter2' },
+        { type: 'attachment', attachmentRef: 'att_1', name: 'hunter2-notes.pdf', mimeType: 'application/pdf' },
+        { type: 'file', data: 'AAAA', mimeType: 'application/pdf', filename: 'hunter2.pdf' },
+      ],
+    },
+    { role: 'tool', toolCallId: 'c1', content: 'read hunter2' },
+    { role: 'user', content: 'Conversation summary: hunter2', meta: { source: 'compact-summary' } },
+  ]);
+  assert.deepEqual(stored[0].content, [
+    { type: 'text', text: 'here is [redacted]' },
+    { type: 'attachment', attachmentRef: 'att_1', name: '[redacted]-notes.pdf', mimeType: 'application/pdf' },
+    { type: 'file', data: 'AAAA', mimeType: 'application/pdf', filename: '[redacted].pdf' },
+  ]);
+  assert.equal(stored[1].content, 'read [redacted]');
+  assert.equal(stored[2].content, 'Conversation summary: [redacted]');
+});
+
+test("a marked value in an attached file's name and path is stored redacted in the files note's record", () => {
+  const session = 'sess_sensitive_names';
+  rememberSensitiveValues(session, [{ name: 'browser', arguments: { action: 'fill', input: { sensitive: true, text: 'hunter2' } } }]);
+  const path = 'C:\\attachments\\ab\\hunter2-notes.pdf';
+  const redacted = 'C:\\attachments\\ab\\[redacted]-notes.pdf';
+  const file = (name, at) => ({ attachmentRef: 'a'.repeat(64), name, mimeType: 'application/pdf', sizeBytes: 4, path: at });
+  const [stored] = redactSensitiveMessages(session, [
+    { role: 'user', content: [{ type: 'text', text: `[Attached files on this PC:\n- ${path}\n]`, attachmentReference: { kind: 'files', files: [file('hunter2-notes.pdf', path)] } }] },
+  ]);
+  assert.deepEqual(stored.content, [
+    { type: 'text', text: `[Attached files on this PC:\n- ${redacted}\n]`, attachmentReference: { kind: 'files', files: [file('[redacted]-notes.pdf', redacted)] } },
+  ]);
+});
