-/** Message content with the session's values redacted in its text. */
+// Parts whose file name a person gave: an attachment or a media part. The name
+// (and a path ending in it) can spell the value, and mapContentText leaves these
+// parts as they are. The attached-files note keeps a record of each file
+// (`attachmentReference.files`, attachment-reference.mjs) beside its text: the
+// row stores it and its clients receive it.
+const NAMED_PARTS = new Set(['attachment', 'image', 'image_url', 'input_image', 'file', 'input_file', 'document', 'audio', 'input_audio', 'video']);
+const NAME_KEYS = ['name', 'filename', 'title', 'path'];
+
+function redactNames(sessionId, record) {
+  let next = record;
+  for (const key of NAME_KEYS) {
+    if (typeof record[key] !== 'string') continue;
+    const redacted = redactSensitiveText(sessionId, record[key]);
+    if (redacted === record[key]) continue;
+    if (next === record) next = { ...record };
+    next[key] = redacted;
+  }
+  return next;
+}
+
+function redactPartNames(sessionId, part) {
+  if (!part || typeof part !== 'object') return part;
+  let next = NAMED_PARTS.has(part.type) || part.attachmentRef ? redactNames(sessionId, part) : part;
+  const files = part.attachmentReference?.files;
+  if (Array.isArray(files)) {
+    const named = files.map((file) => (file && typeof file === 'object' ? redactNames(sessionId, file) : file));
+    if (named.some((file, i) => file !== files[i])) {
+      next = { ...next, attachmentReference: { ...part.attachmentReference, files: named } };
+    }
+  }
+  return next;
+}
+
+/** Message content with the session's values redacted in its text and its attachments' names. */
 export function redactSensitiveContent(sessionId, content) {
   if (!sensitiveValuesVersion(sessionId)) return content;
-  return mapContentText(content, (text) => redactTextOrJson(sessionId, text));
+  const mapped = mapContentText(content, (text) => redactTextOrJson(sessionId, text));
+  const parts = Array.isArray(mapped) ? mapped : Array.isArray(mapped?.content) ? mapped.content : null;
+  if (!parts) return mapped;
+  let changed = false;
+  const named = parts.map((part) => {
+    const next = redactPartNames(sessionId, part);
+    if (next !== part) changed = true;
+    return next;
+  });
+  if (!changed) return mapped;
+  return Array.isArray(mapped) ? named : { ...mapped, content: named };
 }
 
