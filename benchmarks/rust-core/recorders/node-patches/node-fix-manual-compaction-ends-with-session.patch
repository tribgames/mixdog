+/**
+ * A manual compaction's hold on its session: a controller of its own that
+ * closeSession aborts with the session's (`entry.compactionController`; it is
+ * not a turn's controller, so the session does not count as running a turn and
+ * the compaction's own commit is not refused as "turn in progress"). The
+ * signal the compaction runs under ends with the first of that controller, the
+ * session's own controller (a parent link's, or a turn's) and `outerSignal`
+ * (the runtime's: its close aborts every active turn).
+ */
+export function beginManualCompaction(sessionId, outerSignal = null) {
+  const entry = _touchRuntime(sessionId);
+  const controller = createAbortController();
+  entry.compactionController = controller;
+  const signals = [controller.signal, entry.controller?.signal, outerSignal].filter(Boolean);
+  return {
+    signal: AbortSignal.any(signals),
+    end() {
+      if (entry.compactionController === controller) entry.compactionController = null;
+    },
+  };
+}
+
 /**
