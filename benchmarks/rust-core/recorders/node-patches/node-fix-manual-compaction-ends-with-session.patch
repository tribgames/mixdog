+// A manual compaction is work its session owns: closing the session (closeSession, which a session delete runs
+// first) or the runtime (quiesce aborts every registered controller) ends it, and the stored result names why.
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+const previous = process.env.MIXDOG_DATA_DIR;
+const root = mkdtempSync(join(tmpdir(), 'mixdog-manual-compaction-close-'));
+process.env.MIXDOG_DATA_DIR = root;
+test.after(() => {
+  if (previous === undefined) delete process.env.MIXDOG_DATA_DIR;
+  else process.env.MIXDOG_DATA_DIR = previous;
+  // The live process still holds the session writer locks under `root`; a temp directory it leaves is the OS's to clear.
+  try {
+    rmSync(root, { recursive: true, force: true });
+  } catch {}
+});
+
+const { compactSessionMessages } = await import('./session-crud.mjs');
+const { closeSession } = await import('./session-close.mjs');
+const { SessionClosedError } = await import('./session-errors.mjs');
+const { saveSessionAsync } = await import('../store.mjs');
+const { _withRegisteredProviderForTestAsync } = await import('../../providers/registry.mjs');
+const { createSessionOps } = await import('../../../../../session-runtime/turn/session-ops.mjs');
+const { activeTurnControls } = await import('../../../../../session-runtime/boot/config.mjs');
+const mgr = await import('../manager.mjs');
+
+const words = (n, w) => Array.from({ length: n }, (_, i) => `${w}${i}`).join(' ');
+const sessionOf = (id) => ({
+  id,
+  provider: 'openai',
+  model: 'gpt-x',
+  contextWindow: 8000,
+  rawContextWindow: 8000,
+  effectiveContextWindowPercent: 100,
+  tools: [],
+  messages: Array.from({ length: 40 }, (_, i) => (i % 2 ? { role: 'user', content: words(80, `u${i}_`) } : { role: 'assistant', content: words(80, `a${i}_`) })),
+  compaction: { auto: true },
+});
+
+/** A summary provider whose send honours the signal it is given and otherwise answers once `release` runs. */
+function summaryProvider() {
+  let started;
+  const sent = new Promise((resolve) => (started = resolve));
+  let release;
+  const released = new Promise((resolve) => (release = resolve));
+  const provider = {
+    name: 'openai',
+    send: (_messages, _model, _tools, opts) => {
+      started(opts?.signal ?? null);
+      return new Promise((resolve, reject) => {
+        opts?.signal?.addEventListener('abort', () => reject(opts.signal.reason), { once: true });
+        released.then(() => resolve({ content: 'SUMMARY', usage: { inputTokens: 1000, outputTokens: 50, cachedTokens: 0 } }));
+      });
+    },
+  };
+  return { provider, sent, release };
+}
+
+test('a manual compaction nobody closes commits: its own hold is no turn in flight', async () => {
+  const live = sessionOf('manual-compaction-commits');
+  await saveSessionAsync(live);
+  const { provider, release } = summaryProvider();
+  release();
+  const result = await _withRegisteredProviderForTestAsync('openai', provider, () => compactSessionMessages(live.id));
+  assert.equal(result.error, undefined);
+  assert.equal(result.changed, true);
+});
+
+test('closing the session ends its running manual compaction with the close as the reason', async () => {
+  const live = sessionOf('manual-compaction-close');
+  await saveSessionAsync(live);
+  const { provider, sent, release } = summaryProvider();
+  const result = await _withRegisteredProviderForTestAsync('openai', provider, async () => {
+    const compacting = compactSessionMessages(live.id);
+    await sent;
+    assert.equal(await closeSession(live.id, 'cli-agent-close'), true);
+    // A provider that ignored the abort would answer now and the compaction would commit.
+    release();
+    return compacting;
+  });
+  assert.equal(result.changed, false);
+  assert.equal(result.error, 'Session "manual-compaction-close" closed: closeSession (reason=cli-agent-close)');
+});
+
+test('closing the runtime ends the manual compaction the session ops registered', async () => {
+  const live = sessionOf('manual-compaction-runtime-close');
+  await saveSessionAsync(live);
+  const rt = { activeTurnAbortControllers: new Set(), closeRequested: false, session: live };
+  const controls = activeTurnControls(rt);
+  const ops = createSessionOps({
+    getSession: () => live,
+    setSession: () => {},
+    getActiveTurnCount: () => 0,
+    mgr,
+    invalidateContextStatusCache: () => {},
+    registerActiveTurnController: controls.registerActiveTurnController,
+  });
+  const { provider, sent, release } = summaryProvider();
+  const result = await _withRegisteredProviderForTestAsync('openai', provider, async () => {
+    const compacting = ops.compact();
+    await sent;
+    assert.equal(controls.abortActiveTurns(new SessionClosedError(live.id, 'runtime close (reason=cli-exit)', 'cli-exit')), true);
+    release();
+    return compacting;
+  });
+  assert.equal(result.changed, false);
+  assert.equal(result.error, 'Session "manual-compaction-runtime-close" closed: runtime close (reason=cli-exit)');
+  assert.equal(rt.activeTurnAbortControllers.size, 0, 'the compaction lets go of its controller');
+});
