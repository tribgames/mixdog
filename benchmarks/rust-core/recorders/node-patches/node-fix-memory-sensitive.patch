   noteSessionTranscript(sessionId, transcriptPath);
 
+  // A value marked after lines holding it were written: the transcript (and its rotated
+  // generation) is rewritten with each line's message redacted, every other line as it was.
+  onSensitiveValuesMarked(sessionId, () => {
+    if (isSessionTranscriptPurged(sessionId)) return;
+    drainPathSync(transcriptPath);
+    for (const path of [transcriptPath, `${transcriptPath}.1`]) {
+      let text;
+      try {
+        text = readFileSync(path, 'utf8');
+      } catch {
+        continue;
+      }
+      const next = text
+        .split('\n')
+        .map((line) => {
+          let entry;
+          try {
+            entry = JSON.parse(line);
+          } catch {
+            return line;
+          }
+          if (!entry || typeof entry !== 'object' || Array.isArray(entry) || !('message' in entry)) return line;
+          const message = redactSensitiveMessage(sessionId, entry.message);
+          return message === entry.message ? line : JSON.stringify({ ...entry, message });
+        })
+        .join('\n');
+      if (next === text) continue;
+      try {
+        writeFileSync(`${path}.redact`, next);
+        renameSync(`${path}.redact`, path);
+      } catch (err) {
+        logOnce(err);
+      }
+    }
+  });
