diff --git a/src/runtime/shared/transcript-writer-sensitive.test.mjs b/src/runtime/shared/transcript-writer-sensitive.test.mjs
new file mode 100644
index 0000000..467cefe
--- /dev/null
+++ b/src/runtime/shared/transcript-writer-sensitive.test.mjs
@@ -0,0 +1,105 @@
+import assert from 'node:assert/strict';
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import test from 'node:test';
+import { drainPathSync, hasInFlightWrite, whenWriteSettled } from './buffered-appender.mjs';
+import { createTranscriptWriter } from './transcript-writer.mjs';
+import { redactSensitiveMessages } from '../agent/orchestrator/session/sensitive-projection.mjs';
+import { redactSensitiveText, redactSettledText, rememberSensitiveValues } from '../agent/orchestrator/session/sensitive-values.mjs';
+import { createMemoryIngest } from '../../session-runtime/lifecycle/memory-ingest.mjs';
+
+const mark = (session, value) =>
+  rememberSensitiveValues(session, [{ name: 'browser', arguments: { action: 'fill', input: { text: value, sensitive: true } } }]);
+
+function withWriter(session, run) {
+  const home = mkdtempSync(join(tmpdir(), 'mixdog-transcript-sensitive-'));
+  try {
+    const writer = createTranscriptWriter({ mixdogHome: home, sessionId: session, cwd: join(home, 'work'), pid: 42 });
+    const texts = () => {
+      drainPathSync(writer.transcriptPath);
+      return readFileSync(writer.transcriptPath, 'utf8')
+        .split('\n')
+        .filter(Boolean)
+        .map((line) => JSON.parse(line).message.content[0].text);
+    };
+    return run(writer, texts);
+  } finally {
+    rmSync(home, { recursive: true, force: true });
+  }
+}
+
+test('a marked value is redacted in an appended line and in the conversation backfill', () => {
+  withWriter('sess_sensitive_lines', (writer, texts) => {
+    mark('sess_sensitive_lines', 'hunter2');
+    writer.ensureConversationBackfill([{ role: 'user', content: 'earlier hunter2' }]);
+    writer.appendUser('the password is hunter2');
+    writer.appendAssistant('typed hunter2');
+    assert.deepEqual(texts(), ['earlier [redacted]', 'the password is [redacted]', 'typed [redacted]']);
+  });
+});
+
+test('a value marked after its lines were written is redacted in those lines, the rest kept', () => {
+  withWriter('sess_sensitive_later', (writer, texts) => {
+    writer.appendUser('my pin is 4711');
+    writer.appendAssistant('noted');
+    mark('sess_sensitive_later', '4711');
+    assert.deepEqual(texts(), ['my pin is [redacted]', 'noted']);
+  });
+});
+
+test('a value marked while an append is in flight is redacted in that line, and no line is lost', async () => {
+  const session = 'sess_sensitive_inflight';
+  const home = mkdtempSync(join(tmpdir(), 'mixdog-transcript-sensitive-'));
+  try {
+    const writer = createTranscriptWriter({ mixdogHome: home, sessionId: session, cwd: join(home, 'work'), pid: 42 });
+    writer.appendUser('first line');
+    // Past the flush size, so the append is handed to the OS at once and is in flight when the value is marked.
+    writer.appendUser(`the pin is 4711 ${'x'.repeat(40_000)}`);
+    assert.equal(hasInFlightWrite(writer.transcriptPath), true);
+    mark(session, '4711');
+    writer.appendUser('and again 4711');
+    await whenWriteSettled(writer.transcriptPath);
+    await new Promise((resolve) => setImmediate(resolve));
+    drainPathSync(writer.transcriptPath);
+    const lines = readFileSync(writer.transcriptPath, 'utf8').split('\n').filter(Boolean).map((line) => JSON.parse(line).message.content[0].text);
+    assert.deepEqual(lines.map((text) => text.slice(0, 20)), ['first line', 'the pin is [redacted', 'and again [redacted]']);
+    assert.equal(lines.some((text) => text.includes('4711')), false);
+  } finally {
+    rmSync(home, { recursive: true, force: true });
+  }
+});
+
+test('a value split across three streamed deltas is held back until it is whole, then replaced', () => {
+  const session = 'sess_sensitive_deltas';
+  mark(session, 'hunter2');
+  let text = '';
+  const settled = ['say hu', 'nte', 'r2 ok'].map((delta) => redactSettledText(session, (text += delta)));
+  assert.deepEqual(settled, ['say ', 'say ', 'say [redacted] ok']);
+  assert.equal(redactSensitiveText(session, text), 'say [redacted] ok');
+});
+
+test('a value in a file path is redacted as spelled: either separator, not another case', () => {
+  const session = 'sess_sensitive_paths';
+  mark(session, 'hunter2');
+  const stored = (path) =>
+    redactSensitiveMessages(session, [
+      { role: 'user', content: [{ type: 'text', text: 'x', attachmentReference: { kind: 'files', files: [{ attachmentRef: 'a'.repeat(64), name: 'n', path }] } }] },
+    ])[0].content[0].attachmentReference.files[0].path;
+  assert.equal(stored('C:\\attachments\\ab\\hunter2-notes.pdf'), 'C:\\attachments\\ab\\[redacted]-notes.pdf');
+  assert.equal(stored('C:/attachments/ab/hunter2-notes.pdf'), 'C:/attachments/ab/[redacted]-notes.pdf');
+  // 1.4.5 matches the exact substring: a value in another case is not the value.
+  assert.equal(stored('C:\\attachments\\ab\\HUNTER2-notes.pdf'), 'C:\\attachments\\ab\\HUNTER2-notes.pdf');
+});
+
+test("a closing session's conversation reaches memory with its marked values redacted", async () => {
+  mark('sess_sensitive_ingest', 's3cret');
+  const calls = [];
+  const ingest = createMemoryIngest({
+    getMemoryModPromise: () => Promise.resolve({ handleToolCall: async (_tool, args) => calls.push(args) }),
+    getCurrentCwd: () => '/work',
+    withTeardownDeadline: (promise) => promise,
+  });
+  await ingest({ id: 'sess_sensitive_ingest', cwd: '/work', messages: [{ role: 'user', content: 'use s3cret' }] });
+  assert.deepEqual(calls[0].messages, [{ role: 'user', content: 'use [redacted]' }]);
+});
