@@ -55,6 +58,51 @@ export function createTranscriptWriter({ mixdogHome, sessionId, cwd, pid, memory
 
   noteSessionTranscript(sessionId, transcriptPath);
 
+  // A value marked after lines holding it were written: the transcript (and its rotated
+  // generation) is rewritten with each line's message redacted, every other line as it was.
+  // An async append already handed to the OS would land in the file after the rewrite read it (the
+  // line unredacted, or lost to the rename), so the rewrite waits until none is in flight, as
+  // rotation.mjs does before it renames; from there it runs synchronously, so no append lands between
+  // its read and its rename. A line appended meanwhile is redacted as it is written.
+  function redactWrittenLines() {
+    if (isSessionTranscriptPurged(sessionId)) return;
+    if (hasInFlightWrite(transcriptPath)) {
+      whenWriteSettled(transcriptPath).then(redactWrittenLines);
+      return;
+    }
+    drainPathSync(transcriptPath);
+    for (const path of [transcriptPath, `${transcriptPath}.1`]) {
+      let text;
+      try {
+        text = readFileSync(path, 'utf8');
+      } catch {
+        continue;
+      }
+      const next = text
+        .split('\n')
+        .map((line) => {
+          let entry;
+          try {
+            entry = JSON.parse(line);
+          } catch {
+            return line;
+          }
+          if (!entry || typeof entry !== 'object' || Array.isArray(entry) || !('message' in entry)) return line;
+          const message = redactSensitiveMessage(sessionId, entry.message);
+          return message === entry.message ? line : JSON.stringify({ ...entry, message });
+        })
+        .join('\n');
+      if (next === text) continue;
+      try {
+        writeFileSync(`${path}.redact`, next);
+        renameSync(`${path}.redact`, path);
+      } catch (err) {
+        logOnce(err);
+      }
+    }
+  }
+  onSensitiveValuesMarked(sessionId, redactWrittenLines);
+
