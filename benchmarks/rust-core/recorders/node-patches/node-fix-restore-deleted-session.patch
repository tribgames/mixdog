diff --git a/src/standalone/channel-transport/remote-binding-restore.test.mjs b/src/standalone/channel-transport/remote-binding-restore.test.mjs
new file mode 100644
index 0000000..42aacc2
--- /dev/null
+++ b/src/standalone/channel-transport/remote-binding-restore.test.mjs
@@ -0,0 +1,47 @@
+import assert from 'node:assert/strict';
+import { existsSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import test from 'node:test';
+import { createChannelTransport } from '../channel-transport.mjs';
+
+function pinned(t, sessionId, exists) {
+  const dir = mkdtempSync(join(tmpdir(), 'remote-restore-'));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  const intentPath = join(dir, 'channel-remote-intent.json');
+  writeFileSync(intentPath, JSON.stringify({ version: 1, sessionId, transcriptPath: `/work/${sessionId}.jsonl`, cwd: '/work', updatedAt: 1 }));
+  const calls = [];
+  const logs = [];
+  const states = [];
+  const transport = createChannelTransport({
+    remoteIntentPath: intentPath,
+    log: (line) => logs.push(line),
+    handleCall: async (name) => {
+      calls.push(name);
+      return { content: [{ type: 'text', text: 'channel bridge activated' }] };
+    },
+    onRemoteStateChange: (state) => states.push({ enabled: state.enabled, sessionId: state.sessionId }),
+    sessionExists: async (id) => id === sessionId && exists,
+  });
+  t.after(() => transport.stop());
+  return { transport, intentPath, calls, logs, states };
+}
+
+test('a pin to a deleted session is dropped at restore, with a log line, and Remote stays off', async (t) => {
+  const { transport, intentPath, calls, logs, states } = pinned(t, 'sess_gone', false);
+  assert.equal(await transport.restoreRemoteIntent(), false);
+  assert.deepEqual(calls, [], 'the bridge is not activated for a session that is gone');
+  assert.equal(transport.remoteSessionId, null);
+  assert.equal(transport.remoteIntentSessionId, null);
+  assert.equal(existsSync(intentPath), false, 'the pin is cleared');
+  assert.ok(logs.includes('remote intent restore skipped session=sess_gone: the session no longer exists'));
+  assert.ok(states.every((state) => state.enabled === false && state.sessionId === null));
+});
+
+test('a pin to a session that still exists is restored as before', async (t) => {
+  const { transport, intentPath, calls } = pinned(t, 'sess_here', true);
+  assert.equal(await transport.restoreRemoteIntent(), true);
+  assert.deepEqual(calls, ['activate_channel_bridge']);
+  assert.equal(transport.remoteSessionId, 'sess_here');
+  assert.equal(existsSync(intentPath), true);
+});
