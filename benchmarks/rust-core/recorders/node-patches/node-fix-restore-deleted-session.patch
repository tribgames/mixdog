+/** What is known of session `id`'s record: 'present' (storedSessionExists),
+ *  'absent' (no record: deleted or never stored), or 'unknown' when it could
+ *  not be read or is ambiguous, invalid or foreign — never proof it is gone. */
+export function storedSessionPresence(id) {
+  const sessionId = String(id || '').trim();
+  if (!isStoredSessionId(sessionId)) return 'unknown';
+  let probe;
+  try {
+    probe = stampedDerivation(
+      'exists',
+      join(dataDir(), 'sessions'),
+      sessionId,
+      (outcome) => Boolean(recordLifecycle(outcome, sessionId)),
+      { messages: false }
+    );
+  } catch {
+    return 'unknown';
+  }
+  if (probe.state === PROBE_ABSENT) return 'absent';
+  return probe.state === PROBE_PRESENT && probe.value === true ? 'present' : 'unknown';
+}
