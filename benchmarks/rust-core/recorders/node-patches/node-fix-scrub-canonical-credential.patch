+// The test's own decoders, each applied wherever it can be, to a fixed point.
+function decoded(text) {
+  let current = Buffer.from(text);
+  for (let round = 0; round < 12; round++) {
+    const out = [];
+    for (let i = 0; i < current.length; ) {
