+    if (name[0] === 0x23 && (name[1] === 0x78 || name[1] === 0x58) && name.length - 2 >= 1 && name.length - 2 <= 8) {
+      value = 0;
+      for (const b of name.subarray(2)) {
+        const digit = hexOf(b);
