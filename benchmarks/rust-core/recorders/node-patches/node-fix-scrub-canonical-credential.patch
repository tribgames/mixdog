index 000000000..4bf5a9470
--- /dev/null
+++ b/src/runtime/agent/orchestrator/providers/lib/credential-canonical.mjs
@@ -0,0 +1,814 @@
+// What a credential is, and how it is found again in text that comes back (the same rule as the Rust core's
+// `oauth/carried.rs`).
+//
+// A credential is what the transport attached to a request (an `Authorization` / `Proxy-Authorization` header's credential,
+// for `Basic` also the `user:key` it holds and the key; a header whose name ends in `api-key` / `apikey` / `api_key`; the
+// URL's userinfo and its `key` / `api_key` / `access_token` / `token` query value; the secret fields of a token request, a
+// body with a top-level `grant_type`), registered as each request is dispatched: every fetch, `node:http(s)` request and
+// HTTP/2 stream of the process is seen through Node's diagnostics channels (a fetch body through `fetch` itself). A
+// credential also becomes one where a provider keeps it: its own sign-in and refresh name what they store
+// (`keepCredentials`). Both land in one process-wide registry under a slot (the origin and position of an exchange, or the
+// account): what a slot holds now is pinned, what it held before is retired and stays a credential, bounded only by
+// RETIRED_CAP, over which the oldest retired value goes first, never a pinned one.
+//
+// The text is read through a canonical view with a map from each byte of the view back to the source bytes it came from:
+// percent-escapes (either hex case) decoded, JSON escapes (`\/`, `\uXXXX` and surrogate pairs, ...), `%uXXXX` escapes and HTML
+// character references (`&#47;`, `&#x2F;`, `&sol;`, ...) unescaped, NUL bytes (the high half of UTF-16 text) dropped, each
+// repeated until nothing changes; then a single line break inside a base64 run (a wrapped line) is removed. In that view
+// every canonical form of every credential is looked for: itself, unescaped, with `+` for a space and a space for a `+`, a
+// JWT's segments, and each of those as base64 and base64url at the three byte alignments (padding optional) and, when not
+// ASCII, as UTF-16. The match is two-stage: each form is indexed by its first eight bytes (a shorter form whole), and a hit
+// is verified against the whole form, so knowing a credential costs its own index entries and nothing is rebuilt. A match
+// redacts the whole source span it came from. A credential shorter than eight bytes counts only as a whole token (the bytes
+// around it are not letters, digits, `_` or `-`). Text in which no credential is found comes back unchanged.
+
+import diagnostics from 'node:diagnostics_channel';
+
+export const REDACTED = '[REDACTED]';
+export const WHOLE_TOKEN_BELOW = 8;
+// Ten accounts refreshing every hour retire 720 values a day (an access token, a rotated refresh token, an id token):
+// 32,768 is 45 days of that.
+export const RETIRED_CAP = 32768;
+const PRINT = 8;
+const MAX_ROUNDS = 8;
+const WRAPPED_RUN = 16;
+const MAX_REFERENCE = 12;
+const MAX_TOKEN_BODY = 64 * 1024;
+const TOKEN_FIELDS = ['refresh_token', 'code', 'code_verifier', 'device_code', 'assertion', 'client_assertion', 'client_secret', 'password', 'subject_token', 'actor_token'];
+const ENTITIES = new Map(
+  Object.entries({
+    amp: '&', lt: '<', gt: '>', quot: '"', apos: "'", sol: '/', bsol: '\\', plus: '+', equals: '=', percnt: '%', num: '#',
+    colon: ':', semi: ';', lowbar: '_', period: '.', comma: ',', excl: '!', quest: '?', dollar: '$', lpar: '(', rpar: ')',
+    ast: '*', commat: '@', lsqb: '[', rsqb: ']', lcub: '{', rcub: '}', verbar: '|', grave: '`', Hat: '^',
+  }).map(([name, char]) => [name, char.charCodeAt(0)])
+);
+
+const hexOf = (b) => (b >= 0x30 && b <= 0x39 ? b - 0x30 : b >= 0x41 && b <= 0x46 ? b - 0x37 : b >= 0x61 && b <= 0x66 ? b - 0x57 : -1);
+const isAlnum = (b) => (b >= 0x30 && b <= 0x39) || (b >= 0x41 && b <= 0x5a) || (b >= 0x61 && b <= 0x7a);
+export const isBase64 = (b) => isAlnum(b) || b === 0x2b || b === 0x2f || b === 0x2d || b === 0x5f;
+const isWord = (b) => isAlnum(b) || b === 0x5f || b === 0x2d || b >= 0x80;
+const isBlank = (b) => b === 0x20 || b === 0x09 || b === 0x0d || b === 0x0a;
+const utf8Of = (codePoint) => [...Buffer.from(String.fromCodePoint(codePoint), 'utf8')];
+const validScalar = (value) => value >= 0 && value <= 0x10ffff && !(value >= 0xd800 && value < 0xe000);
+
+function hex4(bytes, at) {
+  if (at + 4 > bytes.length) return -1;
+  let value = 0;
+  for (let k = at; k < at + 4; k++) {
+    const digit = hexOf(bytes[k]);
+    if (digit < 0) return -1;
+    value = value * 16 + digit;
+  }
+  return value;
+}
+
+// Whether bytes[from..] is a beginning of `\uXXXX`.
+function jsonUnitPrefix(bytes, from) {
+  const len = bytes.length - from;
+  if (len >= 6) return false;
+  if (len > 0 && bytes[from] !== 0x5c) return false;
+  if (len > 1 && bytes[from + 1] !== 0x75) return false;
+  for (let k = from + 2; k < bytes.length; k++) if (hexOf(bytes[k]) < 0) return false;
+  return true;
+}
+
+const NONE = { kind: 'none' };
+const UNFINISHED = { kind: 'unfinished' };
+
+function escapeAt(bytes, i) {
+  const left = bytes.length - i;
+  const first = bytes[i];
+  if (first === 0x25) {
+    // `%uXXXX`, the escape of JavaScript's `escape()`: a UTF-16 unit like a JSON `\uXXXX`.
+    if (bytes[i + 1] === 0x75) {
+      const unit = hex4(bytes, i + 2);
+      if (unit >= 0) return validScalar(unit) ? { kind: 'bytes', len: 6, bytes: utf8Of(unit) } : NONE;
+      return left < 6 && [...bytes.subarray(i + 2)].every((b) => hexOf(b) >= 0) ? UNFINISHED : NONE;
+    }
+    const high = left > 1 ? hexOf(bytes[i + 1]) : null;
+    const low = left > 2 ? hexOf(bytes[i + 2]) : null;
+    if (high !== null && high >= 0 && low !== null && low >= 0) return { kind: 'bytes', len: 3, bytes: [high * 16 + low] };
+    if (high === null || (high >= 0 && low === null)) return UNFINISHED;
+    return NONE;
+  }
+  if (first === 0x5c) {
+    if (left < 2) return UNFINISHED;
+    const second = bytes[i + 1];
+    if (second === 0x75) {
+      const unit = hex4(bytes, i + 2);
+      if (unit < 0) return jsonUnitPrefix(bytes, i) ? UNFINISHED : NONE;
+      if (unit >= 0xd800 && unit < 0xdc00) {
+        const low = bytes[i + 6] === 0x5c && bytes[i + 7] === 0x75 ? hex4(bytes, i + 8) : -1;
+        if (low >= 0xdc00 && low < 0xe000) return { kind: 'bytes', len: 12, bytes: utf8Of(0x10000 + ((unit - 0xd800) << 10) + (low - 0xdc00)) };
+        return jsonUnitPrefix(bytes, i + 6) ? UNFINISHED : NONE;
+      }
+      return validScalar(unit) ? { kind: 'bytes', len: 6, bytes: utf8Of(unit) } : NONE;
+    }
+    const simple = { 0x2f: 0x2f, 0x5c: 0x5c, 0x22: 0x22, 0x62: 0x08, 0x66: 0x0c, 0x6e: 0x0a, 0x72: 0x0d, 0x74: 0x09 }[second];
+    return simple === undefined ? NONE : { kind: 'bytes', len: 2, bytes: [simple] };
+  }
+  if (first === 0x26) {
+    const body = bytes.subarray(i + 1, i + Math.min(left, MAX_REFERENCE));
+    const end = body.indexOf(0x3b);
+    if (end < 0) return left < MAX_REFERENCE && body.every((b) => isAlnum(b) || b === 0x23) ? UNFINISHED : NONE;
+    const name = body.subarray(0, end);
+    let value = null;
+    if (name[0] === 0x23 && (name[1] === 0x78 || name[1] === 0x58) && name.length - 2 >= 1 && name.length - 2 <= 8) {
+      value = 0;
+      for (const b of name.subarray(2)) {
+        const digit = hexOf(b);
+        if (digit < 0) return NONE;
+        value = value * 16 + digit;
+      }
+    } else if (name[0] === 0x23 && name.length - 1 >= 1 && name.length - 1 <= 8) {
+      value = 0;
+      for (const b of name.subarray(1)) {
+        if (b < 0x30 || b > 0x39) return NONE;
+        value = value * 10 + (b - 0x30);
+      }
+    } else {
+      const byte = ENTITIES.get(Buffer.from(name).toString('latin1'));
+      return byte === undefined ? NONE : { kind: 'bytes', len: end + 2, bytes: [byte] };
+    }
+    return validScalar(value) ? { kind: 'bytes', len: end + 2, bytes: utf8Of(value) } : NONE;
+  }
+  return NONE;
+}
+
+// One layer of the view: its bytes and, unless it is the source itself, the source span of each.
+const spanOf = (layer, i) => (layer.spans ? layer.spans[i] : [i, i + 1]);
+
+// The first view position whose source is at or after `hold` (the text from there on is not final).
+function settledOf(layer, hold) {
+  for (let at = 0; at < layer.bytes.length; at++) if (spanOf(layer, at)[0] >= hold) return at;
+  return layer.bytes.length;
+}
+
+class Next {
+  constructor(layer, upto) {
+    this.bytes = Array.from(layer.bytes.subarray(0, upto));
+    this.spans = [];
+    for (let k = 0; k < upto; k++) this.spans.push(spanOf(layer, k));
+    this.droppedFrom = null;
+  }
+  push(bytes, span) {
+    const start = this.droppedFrom === null ? span[0] : Math.min(this.droppedFrom, span[0]);
+    this.droppedFrom = null;
+    for (const b of bytes) {
+      this.bytes.push(b);
+      this.spans.push([start, span[1]]);
+    }
+  }
+  drop(span) {
+    if (this.spans.length) this.spans[this.spans.length - 1] = [this.spans[this.spans.length - 1][0], span[1]];
+    else this.droppedFrom = this.droppedFrom === null ? span[0] : Math.min(this.droppedFrom, span[0]);
+  }
+  layer() {
+    return { bytes: Uint8Array.from(this.bytes), spans: this.spans };
+  }
+}
+
+function unescape(layer, last, state) {
+  const { bytes } = layer;
+  // The bytes an unfinished escape of an earlier round made are not final: an escape that reads into them is unfinished too.
+  const settled = settledOf(layer, state.hold);
+  const head = bytes.subarray(0, settled);
+  let next = null;
+  let i = 0;
+  while (i < bytes.length) {
+    const byte = bytes[i];
+    const escape = byte === 0x25 || byte === 0x5c || byte === 0x26 ? escapeAt(i < settled ? head : bytes, i) : NONE;
+    if (escape.kind === 'bytes') {
+      const span = [spanOf(layer, i)[0], spanOf(layer, i + escape.len - 1)[1]];
+      (next ??= new Next(layer, i)).push(escape.bytes, span);
+      i += escape.len;
+      continue;
+    }
+    if (escape.kind === 'unfinished' && !last) state.hold = Math.min(state.hold, spanOf(layer, i)[0]);
+    if (byte === 0) (next ??= new Next(layer, i)).drop(spanOf(layer, i));
+    else if (next) next.push([byte], spanOf(layer, i));
+    i += 1;
+  }
+  return next ? next.layer() : null;
+}
+
+function wrapPoints(layer, contextRun, last, settled, ends) {
+  const { bytes } = layer;
+  let next = null;
+  let run = contextRun;
+  let i = 0;
+  while (i < bytes.length) {
+    const byte = bytes[i];
+    if (run >= WRAPPED_RUN && isBlank(byte)) {
+      let j = i;
+      let breaks = 0;
+      while (j < bytes.length && isBlank(bytes[j])) {
+        if (bytes[j] === 0x0a || (bytes[j] === 0x0d && bytes[j + 1] !== 0x0a)) breaks += 1;
+        j += 1;
+      }
+      if ((j === bytes.length || j === settled) && !last && breaks <= 1) {
+        ends.push(next ? next.bytes.length : i);
+      } else if (j < bytes.length && breaks === 1 && isBase64(bytes[j])) {
+        next ??= new Next(layer, i);
+        for (let k = i; k < j; k++) next.drop(spanOf(layer, k));
+        i = j;
+        continue;
+      }
+    }
+    run = isBase64(byte) ? run + 1 : 0;
+    if (next) next.push([byte], spanOf(layer, i));
+    i += 1;
+  }
+  return next ? next.layer() : null;
+}
+
+function canonical(source, context, last) {
+  const state = { hold: source.length };
+  let layer = { bytes: source, spans: null };
+  for (let round = 0; round < MAX_ROUNDS; round++) {
+    const next = unescape(layer, last, state);
+    if (!next) break;
+    layer = next;
+  }
+  const ends = [];
+  const joined = wrapPoints(layer, context.run, last, settledOf(layer, state.hold), ends);
+  return { layer: joined ?? layer, ends, hold: state.hold };
+}
+
+// ---- the forms ------------------------------------------------------------------------------------------------------
+
+const base64NoPad = (bytes) => Buffer.from(bytes).toString('base64').replace(/=+$/, '');
+const toUrl = (text) => text.replace(/\+/g, '-').replace(/\//g, '_');
+
+function base64Core(bytes, align, url) {
+  const encoded = base64NoPad([...new Array(align).fill(0), ...bytes]);
+  const core = encoded.slice(Math.ceil((8 * align) / 6), Math.floor((8 * (align + bytes.length)) / 6));
+  return Buffer.from(url ? toUrl(core) : core, 'latin1');
