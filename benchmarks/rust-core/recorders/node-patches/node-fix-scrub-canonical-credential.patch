+    // A match that reaches into the held text waits with it.
+    for (;;) {
+      let crossing = null;
+      for (const [from, to] of spans) if (to > hold && from < hold) crossing = crossing === null ? from : Math.min(crossing, from);
+      if (crossing === null) break;
+      hold = crossing;
+    }
