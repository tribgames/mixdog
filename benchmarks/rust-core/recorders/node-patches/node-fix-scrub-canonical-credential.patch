+      this.#take(value).leases += 1;
+      leased.push(value);
+    }
+    return leased;
+  }
+
+  release(leased) {
+    for (const value of leased) {
+      const held = this.held.get(value);
+      if (held) held.leases -= 1;
+      this.#settle(value);
+    }
+    this.#evict();
+  }
