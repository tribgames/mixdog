+      const held = this.#take(value);
+      held.sources += 1;
+      held.owned = true;
+      now.push(value);
+    }
+    const before = this.sources.get(source) ?? [];
+    if (now.length) this.sources.set(source, now);
+    else this.sources.delete(source);
+    for (const value of before) {
+      const held = this.held.get(value);
+      if (held) held.sources -= 1;
+      this.#settle(value);
+    }
+    this.#evict();
+  }
