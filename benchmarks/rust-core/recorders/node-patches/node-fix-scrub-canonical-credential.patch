+
+// The texts a credential is echoed as before any encoding, each once.
+function plainsOf(secret) {
+  const plain = [secret];
+  const decoded = canonical(Buffer.from(secret, 'utf8'), { byte: null, run: 0 }, true);
+  plain.push(Buffer.from(decoded.layer.bytes).toString('utf8'));
+  // A form encoder writes a space as `+`, and a form decoder reads that `+` back as a space (not for a credential that would
+  // begin or end with one); the view itself keeps a `+` a `+`.
+  if (secret.includes(' ')) plain.push(secret.replaceAll(' ', '+'));
+  if (secret.includes('+') && !secret.startsWith('+') && !secret.endsWith('+')) plain.push(secret.replaceAll('+', ' '));
