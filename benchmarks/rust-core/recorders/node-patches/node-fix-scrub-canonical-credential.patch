+}
+
+/** The index of the given credentials (a caller's own set). */
+export function credentialIndex(secretValues) {
+  const index = new CredentialIndex();
+  for (const secret of new Set(secretValues)) if (typeof secret === 'string' && secret) index.insert(secret);
+  return index;
+}
+
+/** `source` (bytes) with every credential of `index` redacted, as a whole text; null when nothing was. */
+export function redactBytes(source, index) {
+  const redacted = index.redact(Buffer.from(source), { byte: null, run: 0 }, true);
+  return redacted.changed ? redacted.out : null;
+}
+
+/** A text that arrives in chunks, redacted as it arrives against `source` (an index, or a registry as it is at each
+ *  chunk): the end of a chunk that may still become a credential waits for the next chunk, and nothing else does. */
+export class CredentialStream {
+  constructor(source) {
+    this.source = source;
+    this.held = Buffer.alloc(0);
+    this.context = { byte: null, run: 0 };
+  }
+  #index() {
+    return this.source instanceof Registry ? this.source.index : this.source;
+  }
+  push(chunk) {
+    this.held = Buffer.concat([this.held, Buffer.from(chunk)]);
+    const redacted = this.#index().redact(this.held, this.context, false);
+    this.held = this.held.subarray(redacted.consumed);
+    this.context = redacted.context;
+    return redacted.out;
+  }
+  finish() {
+    const redacted = this.#index().redact(this.held, this.context, true);
+    this.held = Buffer.alloc(0);
+    return redacted.out;
+  }
+}
+
+// ---- the registry -----------------------------------------------------------------------------------------------------
+
+/** Every credential the process read out of a source or attached to a request (see the module's rule): a value is
+ *  pinned while a source yields it or a request in flight carries it; nothing holding it, it waits in a line to be
+ *  forgotten, `retired` when a source ever yielded it (the oldest retirement first), `carried` when none did (the least
+ *  recently carried first). */
+export class Registry {
+  constructor(retiredCap = RETIRED_CAP, carriedCap = CARRIED_CAP) {
+    this.index = new CredentialIndex();
+    this.held = new Map();
+    this.sources = new Map();
+    this.lines = { retired: { order: [], head: 0, live: 0, cap: retiredCap }, carried: { order: [], head: 0, live: 0, cap: carriedCap } };
