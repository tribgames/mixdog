+  }
+
+  // The registry's record of `value`, indexed (its own entries only) when new, out of its line when it waited in one.
+  #take(value) {
+    let held = this.held.get(value);
+    if (held) {
+      if (held.queued) {
+        this.lines[held.queued[0]].live -= 1;
+        held.queued = null;
+      }
+      return held;
+    }
+    held = { id: this.index.insert(value), sources: 0, leases: 0, owned: false, queued: null };
+    this.held.set(value, held);
+    return held;
+  }
+
+  // Once nothing holds `value`, it waits in its line: retired when a source ever yielded it, else by its last carry.
+  #settle(value) {
+    const held = this.held.get(value);
+    if (!held || held.sources > 0 || held.leases > 0 || held.queued) return;
+    const name = held.owned ? 'retired' : 'carried';
+    held.queued = [name, ++this.seq];
+    this.lines[name].order.push([this.seq, value]);
+    this.lines[name].live += 1;
+  }
+
+  // Over a line's cap, its oldest values are forgotten; a value a source yields or a request carries never is.
+  #evict() {
+    for (const name of ['retired', 'carried']) {
+      const line = this.lines[name];
+      const current = ([seq, value]) => {
+        const queued = this.held.get(value)?.queued;
+        return Boolean(queued) && queued[0] === name && queued[1] === seq;
+      };
+      while (line.live > line.cap && line.head < line.order.length) {
+        const entry = line.order[line.head++];
+        if (!current(entry)) continue;
+        this.index.remove(this.held.get(entry[1]).id);
+        this.held.delete(entry[1]);
+        line.live -= 1;
+      }
+      if (line.order.length - line.head > 2 * line.live + 64) {
+        line.order = line.order.slice(line.head).filter(current);
+        line.head = 0;
+      }
