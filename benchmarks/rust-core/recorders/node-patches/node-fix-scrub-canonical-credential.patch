+/** Every canonical form of every credential held, by fingerprint (a form's first eight bytes, a shorter form whole). */
+export class CredentialIndex {
+  constructor() {
+    this.creds = new Map();
+    this.nextId = 0;
+    this.buckets = new Map();
+    this.heads = new Map();
+    this.shortLengths = new Array(PRINT).fill(0);
