+  }
+
+  /** { held, retired, carried }: those a source yields or a request carries, the retired ones, the stray carried ones. */
+  counts() {
+    const { retired, carried } = this.lines;
+    return { held: this.held.size - retired.live - carried.live, retired: retired.live, carried: carried.live };
+  }
+}
+
+let registry = new Registry();
+
+/** The process registry (tests, recorders). */
+export function processRegistry() {
+  return registry;
+}
+
+/** The registry empty again (a recorder's cases, a test, each stand alone). */
+export function resetRegistry() {
+  registry = new Registry();
+}
+
+/** `source` (a key variable, a keychain entry, a configured key, an account's credential file, the exchange that handed a
+ *  token over) yields `values` now, read out of it before any request or text can carry them. */
+export function keepCredentials(source, values) {
+  registry.keep(source, values);
+}
+
+/** The value of the key variable `name`, a credential from this read on (its source the variable). */
+export function keyVariable(name) {
+  const value = process.env[name];
+  keepCredentials(`env ${name}`, [value]);
+  return value;
+}
+
+/** Whether the process attached or keeps any credential yet. */
+export function hasRemembered() {
+  return !registry.index.empty;
+}
+
+/** `text` with every given credential, and every credential the process attached or keeps, redacted, however the text
+ *  encodes it. */
+export function redactCredentials(text, secretValues) {
+  let bytes = Buffer.from(text, 'utf8');
+  let changed = false;
+  for (const index of [credentialIndex(secretValues), registry.index]) {
+    if (index.empty) continue;
+    const redacted = index.redact(bytes, { byte: null, run: 0 }, true);
+    if (redacted.changed) {
+      bytes = redacted.out;
+      changed = true;
+    }
+  }
+  return changed ? bytes.toString('utf8') : text;
+}
+
+// ---- what the transport attaches -----------------------------------------------------------------------------------
+
+function addCredential(out, position, value) {
+  const trimmed = typeof value === 'string' ? value.trim() : '';
+  if (trimmed && !out.some(([, known]) => known === trimmed)) out.push([position, trimmed]);
+}
+
+function percentDecode(text) {
+  const bytes = Buffer.from(text, 'utf8');
+  const out = [];
+  for (let i = 0; i < bytes.length; i++) {
+    const high = bytes[i] === 0x25 ? hexOf(bytes[i + 1] ?? -1) : -1;
+    const low = high >= 0 ? hexOf(bytes[i + 2] ?? -1) : -1;
+    if (high >= 0 && low >= 0) {
+      out.push(high * 16 + low);
+      i += 2;
+    } else {
+      out.push(bytes[i]);
+    }
+  }
+  return Buffer.from(out).toString('utf8');
+}
+
+// The `user:key` a Basic credential's base64 holds (either alphabet, unpadded, canonical, UTF-8).
+function basicPair(encoded) {
+  const bare = encoded.replace(/=+$/, '');
+  for (const [alphabet, pattern] of [['base64', /^[A-Za-z0-9+/]*$/], ['base64url', /^[A-Za-z0-9_-]*$/]]) {
+    if (!pattern.test(bare) || bare.length % 4 === 1) continue;
+    const bytes = Buffer.from(bare, alphabet);
+    if (bytes.toString(alphabet).replace(/=+$/, '') !== bare) continue;
+    try {
+      const pair = new TextDecoder('utf-8', { fatal: true }).decode(bytes);
+      if (pair.includes(':')) return pair;
+    } catch {
+      // not UTF-8
+    }
+  }
+  return null;
+}
+
+function ofHeaders(headers, out) {
+  for (const [rawName, rawValue] of headers) {
+    const name = String(rawName).toLowerCase();
+    const value = String(rawValue ?? '');
+    if (name === 'authorization' || name === 'proxy-authorization') {
+      const trimmed = value.trim();
+      const space = trimmed.indexOf(' ');
+      const scheme = space >= 0 ? trimmed.slice(0, space) : '';
+      if (scheme && /^[A-Za-z]+$/.test(scheme)) {
+        const credential = trimmed.slice(space + 1).trim();
+        addCredential(out, name, credential);
+        const pair = scheme.toLowerCase() === 'basic' ? basicPair(credential) : null;
+        if (pair) {
+          addCredential(out, name, pair);
+          addCredential(out, name, pair.slice(pair.indexOf(':') + 1));
+        }
+      } else {
+        addCredential(out, name, trimmed);
+      }
+    } else if (name.endsWith('api-key') || name.endsWith('apikey') || name.endsWith('api_key')) {
+      addCredential(out, name, value);
+    }
+  }
+}
+
+function ofUrl(url, out) {
+  let parsed;
+  try {
+    parsed = new URL(url);
+  } catch {
+    return;
+  }
+  for (const part of [parsed.username, parsed.password]) addCredential(out, 'userinfo', percentDecode(part));
+  for (const [rawName, value] of parsed.searchParams) {
+    const name = rawName.replace(/[_-]/g, '').toLowerCase();
+    if (['key', 'apikey', 'accesstoken', 'token'].includes(name)) addCredential(out, `query ${name}`, value);
+  }
+}
+
+function ofTokenRequest(body, out) {
+  const text = Buffer.isBuffer(body) || body instanceof Uint8Array ? Buffer.from(body).toString('utf8') : String(body);
+  if (!text || Buffer.byteLength(text) > MAX_TOKEN_BODY) return;
+  if (text.startsWith('{')) {
+    let fields;
+    try {
+      fields = JSON.parse(text);
+    } catch {
+      return;
+    }
+    if (!fields || typeof fields !== 'object' || Array.isArray(fields) || typeof fields.grant_type !== 'string') return;
+    for (const name of TOKEN_FIELDS) if (typeof fields[name] === 'string') addCredential(out, `token-request ${name}`, fields[name]);
+    return;
+  }
+  const pairs = [...new URLSearchParams(text)];
+  if (!pairs.some(([name]) => name === 'grant_type')) return;
+  for (const [name, value] of pairs) if (TOKEN_FIELDS.includes(name)) addCredential(out, `token-request ${name}`, value);
+}
+
+/** Registers what the transport attaches to a request (its URL, headers as [name, value] pairs and, for a token request,
+ *  its body), before it is sent, for as long as the request is in flight: returns the function that ends it. A value no
+ *  source yields is kept after that by recency of use; it retires nothing. */
+export function attachRequest(url, headers, body = null) {
+  const attached = [];
+  ofHeaders(headers, attached);
+  ofUrl(url, attached);
+  if (body !== null && body !== undefined) ofTokenRequest(body, attached);
+  const holder = registry;
+  const leased = attached.length ? holder.lease(attached.map(([, value]) => value)) : [];
+  let released = false;
+  return () => {
+    if (released || !leased.length) return;
+    released = true;
+    holder.release(leased);
+  };
+}
+
+function headerPairs(headers) {
+  if (!headers) return [];
+  if (typeof headers === 'string') {
+    return headers
+      .split('\r\n')
+      .filter(Boolean)
+      .map((line) => [line.slice(0, line.indexOf(':')), line.slice(line.indexOf(':') + 1).trim()]);
+  }
+  if (Array.isArray(headers)) {
+    if (headers.length && Array.isArray(headers[0])) return headers.map(([name, value]) => [String(name), String(value)]);
+    const pairs = [];
+    for (let k = 0; k + 1 < headers.length; k += 2) pairs.push([String(headers[k]), String(headers[k + 1])]);
+    return pairs;
+  }
+  if (typeof headers.entries === 'function' && typeof headers.get === 'function') return [...headers.entries()];
+  return Object.entries(headers).flatMap(([name, value]) => (Array.isArray(value) ? value.map((item) => [name, String(item)]) : [[name, String(value)]]));
+}
+
+const bodyText = (body) => (typeof body === 'string' || body instanceof URLSearchParams ? String(body) : Buffer.isBuffer(body) || body instanceof Uint8Array ? body : null);
+
+// The end of each request in flight, by the client's own object: an undici request ends with its trailers or its error,
+// a node:http request and an HTTP/2 stream when they close.
+const inFlight = new WeakMap();
+const ended = (request) => {
+  const release = inFlight.get(request);
+  inFlight.delete(request);
+  release?.();
+};
+
+// Every request of the process, whichever client sends it: fetch and undici, node:http(s) (WebSocket upgrades among them)
+// and HTTP/2 streams. A failure to read one never fails the request.
+diagnostics.subscribe('undici:request:create', ({ request }) => {
+  try {
+    inFlight.set(request, attachRequest(`${request.origin}${request.path}`, headerPairs(request.headers), bodyText(request.body)));
+  } catch {
+    // never the request's failure
+  }
+});
+diagnostics.subscribe('undici:request:trailers', ({ request }) => ended(request));
+diagnostics.subscribe('undici:request:error', ({ request }) => ended(request));
+diagnostics.subscribe('http.client.request.start', ({ request }) => {
+  try {
+    inFlight.set(request, attachRequest(`${request.protocol}//${request.getHeader('host') ?? request.host}${request.path}`, headerPairs(request.getHeaders()), null));
+    request.once('close', () => ended(request));
+  } catch {
+    // never the request's failure
+  }
+});
+diagnostics.subscribe('http2.client.stream.created', ({ stream, headers }) => {
+  try {
+    inFlight.set(stream, attachRequest(`${headers[':scheme']}://${headers[':authority']}${headers[':path']}`, headerPairs(headers).filter(([name]) => !name.startsWith(':')), null));
+    stream.once('close', () => ended(stream));
+  } catch {
+    // never the request's failure
+  }
+});
+
+// A fetch's body reaches undici as a stream: a token request's secret fields are read where the fetch is made, and held
+// until its answer settles.
+const ATTACHING = Symbol.for('mixdog.credential-canonical.fetch');
+if (typeof globalThis.fetch === 'function' && !globalThis.fetch[ATTACHING]) {
+  const fetchOf = globalThis.fetch;
+  const attachingFetch = function fetch(input, init) {
+    let release = () => {};
+    try {
+      const body = bodyText(init?.body);
+      if (body !== null) release = attachRequest(String(input?.url ?? input), [], body);
+    } catch {
+      // never the request's failure
+    }
+    const answer = fetchOf.call(this, input, init);
+    answer.then(release, release);
+    return answer;
+  };
+  attachingFetch[ATTACHING] = true;
+  globalThis.fetch = attachingFetch;
+}
