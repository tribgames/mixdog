+  },
+  json: (r, bytes) =>
+    bytesOf([...bytes].map((b) => (b === 0x22 ? '\\"' : b === 0x5c ? '\\\\' : b === 0x2f && r.chance() ? '\\/' : b < 0x20 || b >= 0x80 || r.below(4) === 0 ? `\\u${b.toString(16).padStart(4, '0')}` : [b]))),
+  html: (r, bytes) =>
