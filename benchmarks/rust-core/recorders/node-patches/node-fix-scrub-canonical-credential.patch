+    let copied = 0;
+    for (const [from, to] of kept) {
+      if (to <= copied) continue;
+      parts.push(source.subarray(copied, Math.max(from, copied)));
+      if (from >= copied) parts.push(Buffer.from(REDACTED, 'latin1'));
