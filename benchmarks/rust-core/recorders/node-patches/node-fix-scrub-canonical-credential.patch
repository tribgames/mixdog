+
+// How many forms one text has: a short one whole and as a whole base64 run in both alphabets; a long one itself, its
+// base64 cores at three alignments in both alphabets and, when not ASCII, its UTF-16 in both byte orders.
+const encodings = (text) => (Buffer.byteLength(text, 'utf8') < WHOLE_TOKEN_BELOW ? 3 : /^[\x00-\x7f]*$/.test(text) ? 7 : 9);
