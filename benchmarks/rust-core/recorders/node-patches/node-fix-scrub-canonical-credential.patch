+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { WHOLE_TOKEN_BELOW, redactBytes, credentialPatterns, redactCredentials } from './credential-canonical.mjs';
+import { scrubHeaders, scrubOAuthSecrets } from './oauth-token-utils.mjs';
+
+const KEY = 'long/key+value';
+const utf16le = (text) => Buffer.from(text, 'utf16le');
+const scrub = (bytes, secrets) => redactBytes(Buffer.from(bytes), credentialPatterns(secrets));
+
+test('every encoding of a credential is redacted whole', () => {
+  const base64 = Buffer.from(KEY).toString('base64');
+  const forms = [
+    'long%252Fkey%252Bvalue',
+    'long%2fkey%2Bvalue',
+    `${base64.slice(0, 16)}\r\n${base64.slice(16)}`,
+    'long\\/key+value',
+    'long\\u002fkey\\u002Bvalue',
+    'long&#47;key&#x2B;value',
+    'long&sol;key&plus;value',
+    utf16le(KEY),
+    'long\\u0026#37;2Fkey+value',
+  ];
+  for (const form of forms) {
+    const text = Buffer.concat([Buffer.from('refused '), Buffer.from(form), Buffer.from(' for this account')]);
+    const clean = scrub(text, [KEY]);
+    assert.ok(clean, String(form));
+    assert.equal(clean.toString('utf8'), 'refused [REDACTED] for this account', String(form));
+  }
+});
+
+test('each segment of a JWT credential is redacted', () => {
+  const jwt = 'eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ1c2VyLTEyMyJ9.c2lnbmF0dXJlLWJ5dGVzLTQ1';
+  const text = 'a eyJzdWIiOiJ1c2VyLTEyMyJ9 b c2lnbmF0dXJlLWJ5dGVzLTQ1 c eyJhbGciOiJIUzI1NiJ9 d';
+  assert.equal(redactCredentials(text, [jwt]), 'a [REDACTED] b [REDACTED] c [REDACTED] d');
+});
+
+test('an encoded credential in a header is redacted', () => {
+  const headers = scrubHeaders(new Headers({ location: 'https://example.test/?key=long%252Fkey%252Bvalue&alt=sse', 'x-request-id': 'req_1' }), [KEY]);
+  assert.equal(headers.get('location'), 'https://example.test/?key=[REDACTED]&alt=sse');
+  assert.equal(headers.get('x-request-id'), 'req_1');
+});
+
+test('a short credential is redacted as a whole token', () => {
+  assert.equal(redactCredentials('Bearer abc1234', ['abc1234']), 'Bearer [REDACTED]');
+  assert.equal(redactCredentials('token abc1234.', ['abc1234']), 'token [REDACTED].');
+  assert.equal(redactCredentials('https://example.test/?key=abc%31234&alt=sse', ['abc1234']), 'https://example.test/?key=[REDACTED]&alt=sse');
+  assert.equal(redactCredentials(`basic ${Buffer.from('abc1234').toString('base64url')}`, ['abc1234']), 'basic [REDACTED]');
+  assert.equal(scrub('abc12345 xabc1234 abc1234x my-abc1234', ['abc1234']), null);
+  // Through the scrub every provider error passes: a short value inside a word stays.
+  assert.equal(scrubOAuthSecrets('{"a":"xabcx"}', ['abc']), '{"a":"xabcx"}');
+});
+
+// ---- the generated test -----------------------------------------------------------------------------------------------
+
+// xorshift64*: a seeded, reproducible stream.
+function rng(seed) {
+  let state = BigInt(seed);
+  const mask = (1n << 64n) - 1n;
+  const next = () => {
+    state ^= state >> 12n;
+    state = (state ^ (state << 25n)) & mask;
+    state ^= state >> 27n;
+    return (state * 0x2545f4914f6cdd1dn) & mask;
+  };
+  return { below: (n) => Number(next() % BigInt(n)), chance: () => (next() & 1n) === 1n };
+}
+
+const ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_./+=:~!*\'()<>"#$,;?@[]^`{|}';
+const credential = (r) => Array.from({ length: 1 + r.below(40) }, () => ALPHABET[r.below(ALPHABET.length)]).join('');
+const bytesOf = (parts) => Buffer.concat(parts.map((part) => (typeof part === 'string' ? Buffer.from(part) : Buffer.from(part))));
+const isWord = (b) => (b >= 0x30 && b <= 0x39) || (b >= 0x41 && b <= 0x5a) || (b >= 0x61 && b <= 0x7a) || b === 0x5f || b === 0x2d || b >= 0x80;
+const isAlnum = (b) => (b >= 0x30 && b <= 0x39) || (b >= 0x41 && b <= 0x5a) || (b >= 0x61 && b <= 0x7a);
+
+const layers = {
+  percent: (r, bytes) => {
+    const lower = r.chance();
+    return bytesOf([...bytes].map((b) => (b === 0x25 || !isAlnum(b) || r.below(4) === 0 ? `%${b.toString(16).padStart(2, '0')[lower ? 'toLowerCase' : 'toUpperCase']()}` : [b])));
+  },
+  json: (r, bytes) =>
+    bytesOf([...bytes].map((b) => (b === 0x22 ? '\\"' : b === 0x5c ? '\\\\' : b === 0x2f && r.chance() ? '\\/' : b < 0x20 || b >= 0x80 || r.below(4) === 0 ? `\\u${b.toString(16).padStart(4, '0')}` : [b]))),
+  html: (r, bytes) =>
+    bytesOf([...bytes].map((b) => (b === 0x26 ? '&amp;' : b === 0x2f && r.chance() ? '&sol;' : b < 0x80 && (!isAlnum(b) || r.below(4) === 0) ? (r.chance() ? `&#${b};` : `&#x${b.toString(16).toUpperCase()};`) : [b]))),
+  utf16: (r, bytes) => {
+    const le = r.chance();
+    return bytesOf([...bytes].map((b) => (le ? [b, 0] : [0, b])));
+  },
+};
+
+function encoded(r, secret) {
+  const names = [];
+  let bytes = Buffer.from(secret);
