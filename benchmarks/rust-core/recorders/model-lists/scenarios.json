  {
    "name": "custom-manual",
    "hold": "statusline-usage-warmup",
    "calls": [
      {
        "action": "listProviderModels",
        "args": [
          {
            "quick": true
          }
        ]
      },
      {
        "action": "listProviderModels",
        "args": [
          {}
        ]
      },
      {
        "action": "listWebSearchModels",
        "args": [
          {}
        ]
      }
    ],
    "agent": {
      "providers": {
        "custom-aaaa": {
          "type": "custom",
          "schemaVersion": 2,
          "name": "Alpha",
          "protocol": "openai-chat",
          "baseURL": "__BASE_URL__/v1",
          "auth": "none",
          "enabled": true,
          "modelOverrides": {
            "m1": {
              "manual": true,
              "name": "Model One",
              "contextWindow": 64000,
              "maxOutputTokens": 4096
            },
            "m2": {
              "manual": true,
              "reasoning": {
                "levels": [
                  "low",
                  "high"
                ]
              }
            },
            "m3": {
              "manual": true,
              "hidden": true
            },
            "m4": {
              "manual": true,
              "supportsVision": false
            }
          }
        }
      },
      "presets": [
        {
          "id": "p1",
          "name": "P1",
          "provider": "custom-aaaa",
          "model": "m1",
          "effort": "high"
        },
        {
          "id": "p2",
          "name": "P2",
          "provider": "custom-aaaa",
          "model": "unlisted"
        }
      ],
      "default": "p1",
      "workflowRoutes": {
        "planner": {
          "provider": "custom-aaaa",
          "model": "m2"
        },
        "search": {
          "provider": "custom-aaaa",
          "model": "m1"
        }
      },
      "agents": {
        "bot": {
          "provider": "custom-aaaa",
          "model": "m4"
        }
      }
    }
  },
