{
  "name": "RFC 6455 close codes: 1007 for undecodable payloads (bad json, bad notification, bad error body), 1002 for sequence violations (unknown response id); an untracked feed is ignored",
  "steps": [
    { "do": "connect" },
    { "do": "handshake", "instance": "s1" },
    { "do": "connected", "instance": "s1" },
    { "do": "serverSendRaw", "text": "{nope" },
    { "do": "expectClientClose", "code": 1007 },
    { "do": "handshake", "instance": "s2" },
    { "do": "expectSleeps", "ms": [125] },
    { "do": "serverSendRaw", "text": "null" },
    { "do": "expectClientClose", "code": 1007 },
    { "do": "handshake", "instance": "s2" },
    { "do": "expectSleeps", "ms": [125] },
    { "do": "serverSendRaw", "text": "[1]" },
    { "do": "expectClientClose", "code": 1007 },
    { "do": "handshake", "instance": "s2" },
    { "do": "expectSleeps", "ms": [125] },
    { "do": "serverSendRaw", "text": "7" },
    { "do": "expectClientClose", "code": 1007 },
    { "do": "handshake", "instance": "s2" },
    { "do": "expectSleeps", "ms": [125] },
    { "do": "serverSend", "frame": { "id": 9999, "result": {}} },
    { "do": "expectClientClose", "code": 1002 },
    { "do": "handshake", "instance": "s3" },
    { "do": "expectSleeps", "ms": [125] },
    { "do": "serverSend", "frame": { "method": "item/completed", "params": { }, "feed": { "id": 5, "epoch": "e1", "seq": "x"}} },
    { "do": "expectClientClose", "code": 1007 },
    { "do": "handshake", "instance": "s4" },
    { "do": "expectSleeps", "ms": [125] },
    { "do": "call", "as": "l", "method": "thread/list", "params": {} },
    { "do": "expectSend", "frame": { "id": "$cap:l", "method": "thread/list", "params": {}} },
    { "do": "serverSend", "frame": { "id": "$cap:l", "error": { "code": "x"}} },
    { "do": "expectClientClose", "code": 1007 },
    { "do": "result", "as": "l", "error": { "kind": "connectionLost"} },
    { "do": "handshake", "instance": "s5" },
    { "do": "expectSleeps", "ms": [125] },
    { "do": "serverSend", "frame": { "method": "item/completed", "params": { "n": 1 }, "feed": { "id": "t1", "epoch": "e1", "seq": 1}} },
    { "do": "expectClientClose", "none": true }
  ]
}
