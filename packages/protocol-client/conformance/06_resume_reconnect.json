{
  "name": "resume snapshot then events; gap closes 1002; ladder with jitter and reset; resumeFrom position; stale instance id",
  "steps": [
    { "do": "connect" },
    { "do": "handshake", "instance": "s1" },
    { "do": "connected", "instance": "s1" },
    { "do": "call", "as": "r", "fn": "resumeThread", "threadId": "t1", "window": { "lastItems": 50 } },
    { "do": "expectSend", "frame": { "id": "$cap:r", "method": "thread/resume", "params": { "threadId": "t1", "window": { "lastItems": 50 } } } },
    { "do": "serverSend", "frame": { "id": "$cap:r", "result": { "thread": { "id": "t1", "preview": "", "title": "T", "updatedAt": 1, "messageCount": 0, "cwd": "/w", "classification": {}, "projectPath": null }, "subscription": { "id": "sub", "mode": "snapshot", "epoch": "e1", "startSeq": 11 } } } },
    { "do": "serverSend", "frame": { "method": "thread/snapshot", "params": { "items": ["a"] }, "feed": { "id": "t1", "epoch": "e1", "seq": 10 } } },
    { "do": "serverSend", "frame": { "method": "item/completed", "params": { "n": 1 }, "feed": { "id": "t1", "epoch": "e1", "seq": 11 } } },
    { "do": "serverSend", "frame": { "method": "item/completed", "params": { "n": 2 }, "feed": { "id": "t1", "epoch": "e1", "seq": 12 } } },
    { "do": "result", "as": "r", "ok": { "thread": { "id": "t1", "preview": "", "title": "T", "updatedAt": 1, "messageCount": 0, "cwd": "/w", "classification": {}, "projectPath": null }, "subscription": { "id": "sub", "mode": "snapshot", "epoch": "e1", "startSeq": 11 } } },
    { "do": "settle" },
    { "do": "expectFeed", "id": "t1", "epoch": "e1", "seq": 12 },
    { "do": "expectThreadState", "thread": "t1", "state": { "snap": { "items": ["a"] }, "log": ["item/completed@11", "item/completed@12"] } },

    { "do": "openFails", "count": 2 },
    { "do": "serverSend", "frame": { "method": "item/completed", "params": { "n": 4 }, "feed": { "id": "t1", "epoch": "e1", "seq": 14 } } },
    { "do": "expectClientClose", "code": 1002 },
    { "do": "handshake", "instance": "s2" },
    { "do": "expectSleeps", "ms": [125, 250, 500] },
    { "do": "expectSend", "frame": { "id": "$cap:r2", "method": "thread/resume", "params": { "threadId": "t1", "window": { "lastItems": 50 }, "resumeFrom": { "epoch": "e1", "seq": 12, "window": { "lastItems": 50 } } } } },
    { "do": "serverSend", "frame": { "id": "$cap:r2", "result": { "thread": { "id": "t1", "preview": "", "title": "T", "updatedAt": 1, "messageCount": 0, "cwd": "/w", "classification": {}, "projectPath": null }, "subscription": { "id": "sub", "mode": "replay", "epoch": "e1", "startSeq": 13 } } } },
    { "do": "serverSend", "frame": { "method": "item/completed", "params": { "n": 3 }, "feed": { "id": "t1", "epoch": "e1", "seq": 13 } } },
    { "do": "settle" },
    { "do": "expectFeed", "id": "t1", "epoch": "e1", "seq": 13 },

    { "do": "serverClose", "code": 1006 },
    { "do": "handshake", "instance": "s3" },
    { "do": "expectSleeps", "ms": [125] },
    { "do": "expectSend", "frame": { "id": "$cap:r3", "method": "thread/resume", "params": { "threadId": "t1", "window": { "lastItems": 50 }, "resumeFrom": { "epoch": "e1", "seq": 13, "window": { "lastItems": 50 } } } } },
    { "do": "serverSend", "frame": { "id": "$cap:r3", "result": { "thread": { "id": "t1", "preview": "", "title": "T", "updatedAt": 1, "messageCount": 0, "cwd": "/w", "classification": {}, "projectPath": null }, "subscription": { "id": "sub", "mode": "snapshot", "epoch": "e9", "startSeq": 3 } } } },
    { "do": "serverSend", "frame": { "method": "thread/snapshot", "params": { "items": ["z"] }, "feed": { "id": "t1", "epoch": "e9", "seq": 2 } } },
    { "do": "settle" },
    { "do": "expectFeed", "id": "t1", "epoch": "e9", "seq": 2 },
    { "do": "expectThreadState", "thread": "t1", "state": { "snap": { "items": ["z"] }, "log": [] } },
    { "do": "call", "as": "u", "fn": "unsubscribeThread", "threadId": "t1" },
    { "do": "expectSend", "frame": { "id": "$cap:u", "method": "thread/unsubscribe", "params": { "threadId": "t1" } } },
    { "do": "serverSend", "frame": { "id": "$cap:u", "result": {} } },
    { "do": "result", "as": "u", "ok": null },
    { "do": "expectNoThread", "thread": "t1" }
  ]
}
