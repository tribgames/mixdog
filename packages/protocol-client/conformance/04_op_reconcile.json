{
  "name": "mutations: opId, no auto-retry, one op/status per scope sent at once, every outcome and every op-scope rule",
  "steps": [
    { "do": "connect" },
    { "do": "handshake", "instance": "s1" },
    { "do": "connected", "instance": "s1" },
    { "do": "expectStatus", "states": ["ready"] },
    { "do": "call", "as": "m1", "method": "config/value/write", "params": { "path": "a", "value": 1 } },
    { "do": "expectSend", "frame": { "id": "$cap:m1", "method": "config/value/write", "params": { "path": "a", "value": 1, "opId": "op-1" } } },
    { "do": "call", "as": "m2", "method": "thread/name/set", "params": { "threadId": "t1", "name": "n" } },
    { "do": "expectSend", "frame": { "id": "$cap:m2", "method": "thread/name/set", "params": { "threadId": "t1", "name": "n", "opId": "op-2" } } },
    { "do": "call", "as": "m3", "method": "agent/home/open", "params": { "x": 1 } },
    { "do": "expectSend", "frame": { "id": "$cap:m3", "method": "agent/home/open", "params": { "x": 1, "opId": "op-3" } } },
    { "do": "call", "as": "m4", "method": "account/refreshProviderSetup", "params": {} },
    { "do": "expectSend", "frame": { "id": "$cap:m4", "method": "account/refreshProviderSetup", "params": { "opId": "op-4" } } },
    { "do": "call", "as": "m5", "method": "thread/setCwd", "params": { "cwd": "/w" } },
    { "do": "expectSend", "frame": { "id": "$cap:m5", "method": "thread/setCwd", "params": { "cwd": "/w", "opId": "op-5" } } },
    { "do": "call", "as": "m6", "method": "project/touch", "params": { "id": "p" } },
    { "do": "expectSend", "frame": { "id": "$cap:m6", "method": "project/touch", "params": { "id": "p", "opId": "op-6" } } },
    { "do": "call", "as": "r", "method": "thread/list", "params": {} },
    { "do": "expectSend", "frame": { "id": "$cap:r", "method": "thread/list", "params": {} } },
    { "do": "serverClose", "code": 1006 },
    { "do": "result", "as": "r", "error": { "kind": "connectionLost" } },
    { "do": "expectStatus", "states": ["reconnecting:0"] },
    { "do": "handshake", "instance": "s1" },
    { "do": "expectSleeps", "ms": [125] },
    { "do": "expectSend", "frame": { "id": "$cap:s1", "method": "op/status", "params": { "scope": "config", "opIds": ["op-1"], "fence": true } } },
    { "do": "expectSend", "frame": { "id": "$cap:s2", "method": "op/status", "params": { "scope": "thread:t1", "opIds": ["op-2"], "fence": true } } },
    { "do": "expectSend", "frame": { "id": "$cap:s3", "method": "op/status", "params": { "scope": "agent", "opIds": ["op-3"], "fence": true } } },
    { "do": "expectSend", "frame": { "id": "$cap:s4", "method": "op/status", "params": { "scope": "account", "opIds": ["op-4"], "fence": true } } },
    { "do": "expectSend", "frame": { "id": "$cap:s5", "method": "op/status", "params": { "scope": "thread", "opIds": ["op-5"], "fence": true } } },
    { "do": "expectSend", "frame": { "id": "$cap:s6", "method": "op/status", "params": { "scope": "project", "opIds": ["op-6"], "fence": true } } },
    { "do": "serverSend", "frame": { "id": "$cap:s1", "result": { "ops": [{ "opId": "op-1", "state": "applied", "result": { "ok": true } }] } } },
    { "do": "serverSend", "frame": { "id": "$cap:s2", "result": { "ops": [{ "opId": "op-2", "state": "rejected", "error": { "code": -32600, "message": "x", "data": { "reason": "connectionClosed" } } }] } } },
    { "do": "serverSend", "frame": { "id": "$cap:s3", "result": { "ops": [{ "opId": "op-3", "state": "notApplied" }] } } },
    { "do": "serverSend", "frame": { "id": "$cap:s4", "result": { "ops": [{ "opId": "op-4", "state": "expired" }] } } },
    { "do": "serverSend", "frame": { "id": "$cap:s5", "result": { "ops": [{ "opId": "op-5", "state": "externalUnknown", "effect": "shell", "target": "x" }] } } },
    { "do": "serverSend", "frame": { "id": "$cap:s6", "result": { "ops": [{ "opId": "op-6", "state": "inProgress" }] } } },
    { "do": "expectSend", "frame": { "id": "$cap:m6b", "method": "project/touch", "params": { "id": "p", "opId": "op-6" } } },
    { "do": "serverSend", "frame": { "id": "$cap:m6b", "result": { "done": 1 } } },
    { "do": "result", "as": "m1", "ok": { "ok": true } },
    { "do": "result", "as": "m2", "error": { "kind": "rpc", "reason": "connectionClosed" } },
    { "do": "result", "as": "m3", "error": { "kind": "opNotApplied" } },
    { "do": "result", "as": "m4", "error": { "kind": "opOutcomeUnknown" } },
    { "do": "result", "as": "m5", "error": { "kind": "opOutcomeUnknown" } },
    { "do": "result", "as": "m6", "ok": { "done": 1 } },
    { "do": "expectStatus", "states": ["ready"] }
  ]
}
