# Normalize line endings: LF in repo, auto on checkout
* text=auto
.gitattributes text eol=lf

# Always LF for shell scripts
*.sh text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
# Uploaded to the Linux VPS and rendered there by bash.
apps/relay/deploy/coturn/* text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Published benchmark artifacts are evidence: keep every byte exactly as the
# harness wrote it, with no end-of-line normalization on checkout or commit.
# Covers every run folder records/<harness>/<model>/<date>/, including new harnesses.
benchmarks/terminal-bench-2.1/records/*/*/*/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol conflict-marker-size=1024

# Rust core: sources, fixtures and goldens are compared byte-for-byte by tests and
# by benchmarks/rust-core/recorders/verify-manifests.mjs (sha256 per file), so they
# must check out as LF on every platform. text=auto keeps binary fixtures untouched.
native/core/** text=auto eol=lf

# Node fixes a recording is made with (lib/common.mjs exactPatchedIdentity): applied with git apply and named by sha256.
benchmarks/rust-core/recorders/node-patches/*.patch text eol=lf

# Recorded evidence hashed by a fixture MANIFEST in the exact bytes it was recorded
# with (CRLF / mixed line endings): keep verbatim, no end-of-line conversion.
native/core/fixtures/agent/compact/record.mjs -text
native/core/fixtures/agent/record-compact-marker.mjs -text
native/core/fixtures/providers/oracles/openai-codex-metadata-golden.json -text
native/core/fixtures/providers/oracles/openai-models-golden.json -text
native/core/fixtures/providers/oracles/openai-retry-policy-golden.json -text
native/core/fixtures/providers/oracles/openai-transport-switch-golden.json -text
native/core/fixtures/providers/oracles/openai-ws-delta-golden.json -text

# Binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.node binary
