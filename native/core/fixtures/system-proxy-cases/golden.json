    {
      "case": "an attached app routes the daemon per origin; when it leaves the fallback applies again",
      "observed": {
        "registry": {
          "proxyEnable": "0x1",
          "proxyServer": "127.0.0.1:7890",
          "proxyOverride": "<local>"
        },
        "pac": {
          "api.openai.com": "PROXY proxy.corp:8080",
          "intranet.corp.example": "DIRECT"
        },
        "otherwise": "PROXY other.corp:3128",
        "chromiumAskedFor": [
          "https://api.openai.com",
          "https://intranet.corp.example",
          "https://api.anthropic.com"
        ],
        "log": [
          {
            "step": "before attach, registry fallback",
            "origin": "https://api.openai.com",
            "route": {
              "proxy": "http://127.0.0.1:7890"
            }
          },
          {
            "step": "attached",
            "origin": "https://api.openai.com",
            "route": {
              "proxy": "http://proxy.corp:8080"
            }
          },
          {
            "step": "attached",
            "origin": "https://intranet.corp.example",
            "route": {
              "proxy": null
            }
          },
          {
            "step": "attached",
            "origin": "https://api.anthropic.com",
            "route": {
              "proxy": "http://other.corp:3128"
            }
          },
          {
            "step": "released, fallback again",
            "origin": "https://intranet.corp.example",
            "route": {
              "proxy": "http://127.0.0.1:7890"
