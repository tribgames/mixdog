{
  "domain": "lsp",
  "entries": [
    {
      "args": [
        "<WORK>\\project",
        "<WORK>\\project",
        {
          "languageId": "plaintext",
          "relPath": "a.xyz",
          "text": "x",
          "version": 1
        }
      ],
      "op": "lspDocument",
      "result": {
        "available": false,
        "server": "",
        "status": "unsupported"
      }
    },
    {
      "args": [
        "<WORK>\\project",
        "<WORK>\\project",
        {
          "languageId": "rust",
          "relPath": "a.rs",
          "text": "fn main(){}",
          "version": 1
        }
      ],
      "error": {
        "message": "recorder timeout after 20s",
        "name": "Error"
      },
      "op": "lspDocument"
    },
    {
      "args": [
        "<WORK>\\project",
        "<WORK>\\project",
        "a.xyz",
        "plaintext",
        "textDocument/hover",
        {
          "position": {
            "character": 0,
            "line": 0
          }
        }
      ],
      "op": "lspRequest",
      "result": {
        "available": false,
        "server": "",
        "status": "unsupported"
      }
    },
    {
      "args": [
        "<WORK>\\project"
      ],
      "op": "lspDisposeUnder",
      "result": []
    },
    {
      "args": [
        "a.tsx",
        "typescriptreact"
      ],
      "op": "lspDocumentLanguageId",
      "result": "typescriptreact"
    },
    {
      "args": [
        "Dockerfile",
        "plaintext"
      ],
      "op": "lspDocumentLanguageId",
      "result": "plaintext"
    },
    {
      "args": [],
      "op": "SERVER_BY_LANGUAGE",
      "result": {
        "c": {
          "args": [
            "--background-index"
          ],
          "command": "clangd",
          "id": "clangd"
        },
        "cpp": {
          "args": [
            "--background-index"
          ],
          "command": "clangd",
          "id": "clangd"
        },
        "go": {
          "args": [],
          "command": "gopls",
          "id": "gopls"
        },
        "javascript": {
          "args": [
            "--stdio"
          ],
          "command": "typescript-language-server",
          "id": "typescript-language-server"
        },
        "objective-c": {
          "args": [
            "--background-index"
          ],
          "command": "clangd",
          "id": "clangd"
        },
        "python": {
          "args": [
            "--stdio"
          ],
          "command": "pyright-langserver",
          "id": "pyright"
        },
        "ruby": {
          "args": [],
          "command": "ruby-lsp",
          "id": "ruby-lsp"
        },
        "rust": {
          "args": [],
          "command": "rust-analyzer",
          "id": "rust-analyzer"
        },
        "typescript": {
          "args": [
            "--stdio"
          ],
          "command": "typescript-language-server",
          "id": "typescript-language-server"
        }
      }
    },
    {
      "events": [
        {
          "name": "lsp-status",
          "value": {
            "available": false,
            "languageId": "rust",
            "projectPath": "<WORK>\\project",
            "server": "rust-analyzer",
            "status": "starting"
          }
        },
        {
          "name": "terminal-data",
          "value": {
            "data": "\u001b[?25l\u001b[2J\u001b[m\u001b[H\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[H\u001b]0;C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\u0007\u001b[?25h",
            "id": "term_54960_1"
          }
        },
        {
          "name": "terminal-data",
          "value": {
            "data": "\u001b[?9001l\u001b[?1004l",
            "id": "term_54960_1"
          }
        },
        {
          "name": "terminal-data",
          "value": {
            "data": "\r\n[process exited with code -1073741510]\r\n",
            "id": "term_54960_1"
          }
        }
      ],
      "op": "<emitted events>"
    }
  ],
  "recorder": "record-desktop-services.mjs"
}
