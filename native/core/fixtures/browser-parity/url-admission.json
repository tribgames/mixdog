[
  {
    "case": "public name",
    "input": {
      "mode": "url",
      "url": "https://example.test/",
      "policy": {},
      "lookup": {
        "example.test": [
          "93.184.216.34"
        ]
      }
    },
    "expect": {
      "ok": true
    }
  },
  {
    "case": "rebinding to lan",
    "input": {
      "mode": "url",
      "url": "https://rebind.example.test/private",
      "policy": {},
      "lookup": {
        "example.test": [
          "93.184.216.34"
        ],
        "rebind.example.test": [
          "192.168.1.10"
        ]
      }
    },
    "expect": {
      "error": "navigation to rebind.example.test resolved to blocked private or internal address 192.168.1.10"
    }
  },
  {
    "case": "lan name allowed in a local session",
    "input": {
      "mode": "url",
      "url": "https://nas.example.test/",
