{
  "note": "Node's inline host agent dispatch at b6f10295a2f698afc85332467192de28500bd146, per case of benchmarks/rust-core/recorders/record-inline-dispatch-cases.mjs",
  "test": "src/standalone/session-runtime-inline-host.dispatch.test.mjs",
  "cases": [
    {
      "case": "agentDispatch rejects a missing or already-running dispatch id and aborts with the caller signal",
      "recorded": {
        "calls": [
          {
            "call": "no id",
            "payload": {
              "agent": "worker"
            },
            "outcome": {
              "error": "agent dispatch id is required"
            }
          },
          {
            "call": "duplicate while running",
            "payload": {
              "dispatchId": "dup",
              "agent": "w",
              "params": {}
            },
            "outcome": {
              "error": "agent dispatch dup is already running"
            }
          },
          {
            "call": "running, its caller aborted \"caller gave up\"",
            "payload": {
              "dispatchId": "dup",
              "agent": "w",
              "params": {}
            },
            "outcome": {
              "error": "caller gave up"
            }
          }
        ]
      }
    },
    {
      "case": "agentDispatch caches one dispatcher per agent and forwards the call parameters",
      "recorded": {
        "calls": [
          {
            "payload": {
              "dispatchId": "d1",
              "agent": "worker",
              "params": {
                "prompt": "hello",
                "preset": "p1",
                "cwd": "D:/proj",
                "idleTimeoutMs": 5000
              }
            },
            "outcome": {
              "ok": "answer for hello"
            }
          },
          {
            "payload": {
              "dispatchId": "d2",
              "agent": "worker",
              "params": {
                "prompt": "again",
                "idleTimeoutMs": -1
              }
            },
            "outcome": {
              "ok": "answer for again"
            }
          }
        ],
        "handed": [
          {
            "prompt": "hello",
            "preset": "p1",
            "cwd": "D:/proj",
            "idleTimeoutMs": 5000,
            "parentSignal": true
          },
          {
            "prompt": "again",
            "preset": null,
            "cwd": null,
            "idleTimeoutMs": null,
            "parentSignal": true
          }
        ]
      }
    },
    {
      "case": "agent graph loading retries after a failure and shares the successful graph",
      "recorded": {
        "calls": [
          {
            "payload": {
              "dispatchId": "failed",
              "agent": "worker"
            },
            "outcome": {
              "error": "graph import failed"
            }
          },
          {
            "payload": {
              "dispatchId": "retried",
              "agent": "worker",
              "params": {
                "prompt": "retried"
              }
            },
            "outcome": {
              "ok": "answer for retried"
            }
          },
          {
            "payload": {
              "dispatchId": "cached",
              "agent": "worker",
              "params": {
                "prompt": "cached"
              }
            },
            "outcome": {
              "ok": "answer for cached"
            }
          }
        ]
      }
    },
    {
      "case": "notifySessionCompletion routes to the runtime that owns the session, hinted or discovered",
      "recorded": {
        "answers": [
          {
            "call": "hinted owner",
            "owner": "sess_hint",
            "text": "done",
            "meta": {
              "kind": "task"
            },
            "answer": true
          },
          {
            "call": "discovered owner",
            "owner": "sess_found",
            "text": "done 2",
            "meta": {},
            "answer": true
          },
          {
            "call": "missing owner",
            "owner": "sess_missing",
            "text": "x",
            "meta": {},
            "answer": false
          },
          {
            "call": "owner whose runtime was disposed",
            "owner": "sess_hint",
            "text": "late",
            "meta": {},
            "answer": false
          },
          {
            "call": "after the host closed",
            "owner": "sess_found",
            "text": "after close",
            "meta": {},
            "answer": false
          }
        ],
        "delivered": [
          [
            "sess_hint",
            "done",
            {
              "kind": "task"
            }
          ],
          [
            "sess_found",
            "done 2",
            {}
          ]
        ]
      }
    }
  ]
}
