          "body": "{\"model\":\"m1\",\"messages\":[{\"role\":\"system\",\"content\":\"You are a fixture assistant.\"},{\"role\":\"user\",\"content\":\"Before.\"},{\"role\":\"assistant\",\"content\":null,\"tool_calls\":[{\"id\":\"call_a\",\"type\":\"function\",\"function\":{\"name\":\"lookup\",\"arguments\":\"{\\\"key\\\":\\\"a\\\"}\"}}],\"reasoning_content\":\" \"},{\"role\":\"tool\",\"tool_call_id\":\"call_a\",\"content\":\"1\"},{\"role\":\"assistant\",\"content\":\"Earlier answer.\",\"reasoning_content\":\"Earlier thought.\"},{\"role\":\"user\",\"content\":\"Look up the answer.\"}],\"stream\":true,\"stream_options\":{\"include_usage\":true}}",
          "answer": {
            "status": 200,
