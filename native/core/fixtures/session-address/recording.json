{
  "domain": "session-address",
  "recorder": "benchmarks/rust-core/recorders/record-session-address.mjs",
  "testFile": "src/session-runtime/session-address.test.mjs",
  "cases": [
    {
      "name": "address-binds-once-is-idempotent-and-refuses-a-re-key",
      "testLine": 24,
      "input": {
        "initialRt": {
          "addressedSessionId": null,
          "admission": "open",
          "lifecycleGeneration": 0
        }
      },
      "result": {
        "steps": [
          {
            "step": "bindSessionAddress(sess_a)",
            "ok": "sess_a",
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "open",
              "lifecycleGeneration": 0
            }
          },
          {
            "step": "bindSessionAddress(sess_a) again",
            "ok": "sess_a",
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "open",
              "lifecycleGeneration": 0
            }
          },
          {
            "step": "bindSessionAddress(sess_b)",
            "error": {
              "name": "SessionAddressError",
              "message": "runtime is addressed as sess_a; it cannot be re-keyed to sess_b (use a new session entry)",
              "instanceOf": {
                "SessionAddressError": true,
                "SessionClosedError": false
              },
              "own": {
                "name": "SessionAddressError",
                "sessionId": "sess_a"
              }
            },
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "open",
              "lifecycleGeneration": 0
            }
          },
          {
            "step": "assertNotAddressed(newSession)",
            "error": {
              "name": "SessionAddressError",
              "message": "newSession would re-key addressed session sess_a; create a new session entry instead",
              "instanceOf": {
                "SessionAddressError": true,
                "SessionClosedError": false
              },
              "own": {
                "name": "SessionAddressError",
                "sessionId": "sess_a"
              }
            },
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "open",
              "lifecycleGeneration": 0
            }
          },
          {
            "step": "assertResumeTarget(sess_b)",
            "error": {
              "name": "SessionAddressError",
              "message": "runtime is addressed as sess_a; it cannot resume sess_b (use a new session entry)",
              "instanceOf": {
                "SessionAddressError": true,
                "SessionClosedError": false
              },
              "own": {
                "name": "SessionAddressError",
                "sessionId": "sess_a"
              }
            },
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "open",
              "lifecycleGeneration": 0
            }
          },
          {
            "step": "assertResumeTarget(sess_a)",
            "ok": null,
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "open",
              "lifecycleGeneration": 0
            }
          }
        ]
      }
    },
    {
      "name": "close-fences-before-the-manager-close-and-goes-terminal-after-a-durable-close",
      "testLine": 35,
      "input": {
        "session": {
          "id": "sess_a"
        },
        "manager": "closeSession returns true"
      },
      "result": {
        "steps": [
          {
            "step": "closeCanonicalSession",
            "ok": true,
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "terminal",
              "lifecycleGeneration": 1
            },
            "currentSession": null,
            "managerCalls": [
              {
                "admission": "closing",
                "args": [
                  "sess_a",
                  "canonical-session-close",
                  {
                    "tombstone": true
                  }
                ]
              }
            ]
          },
          {
            "step": "closeCanonicalSession again (terminal)",
            "ok": true,
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "terminal",
              "lifecycleGeneration": 1
            },
            "currentSession": null,
            "managerCalls": [
              {
                "admission": "closing",
                "args": [
                  "sess_a",
                  "canonical-session-close",
                  {
                    "tombstone": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "failed-durable-close-restores-admission-and-keeps-the-session",
      "testLine": 65,
      "input": {
        "session": {
          "id": "sess_a"
        },
        "manager": [
          "closeSession returns false",
          "closeSession throws Error(boom)"
        ]
      },
      "result": {
        "steps": [
          {
            "step": "closeCanonicalSession (manager returns false)",
            "ok": false,
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "open",
              "lifecycleGeneration": 0
            },
            "currentSession": {
              "id": "sess_a"
            },
            "managerCalls": [
              {
                "admission": "closing",
                "args": [
                  "sess_a",
                  "canonical-session-close",
                  {
                    "tombstone": true
                  }
                ]
              }
            ]
          },
          {
            "step": "closeCanonicalSession (manager throws boom)",
            "error": {
              "name": "Error",
              "message": "boom",
              "instanceOf": {
                "SessionAddressError": false,
                "SessionClosedError": false
              },
              "own": {}
            },
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "open",
              "lifecycleGeneration": 0
            },
            "currentSession": {
              "id": "sess_a"
            },
            "managerCalls": [
              {
                "admission": "closing",
                "args": [
                  "sess_a",
                  "canonical-session-close",
                  {
                    "tombstone": true
                  }
                ]
              },
              {
                "admission": "closing",
                "args": [
                  "sess_a",
                  "canonical-session-close",
                  {
                    "tombstone": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
