    {
      "name": "completion-wake-refuses-a-fenced-owner-at-request-time-and-in-the-delayed-callback",
      "testLine": 160,
      "input": {
        "sessionId": "sess_a",
        "executionIds": [
          "x1",
          "x2"
        ],
        "turnApi": "ask records its arguments"
      },
      "result": {
        "steps": [
          {
            "step": "wake({sessionId: sess_a, executionId: x1})",
            "ok": true,
            "immediateArmed": 1
          },
          {
            "step": "beginCanonicalClose",
            "ok": "open",
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "closing",
              "lifecycleGeneration": 0
            }
          },
          {
            "step": "run the delayed callback",
            "ok": null,
            "asks": []
          },
          {
            "step": "wake({sessionId: sess_a, executionId: x2})",
            "ok": false,
            "immediateArmed": 0
          }
        ],
        "asks": []
      }
    },
    {
      "name": "fenced-admission-raises-session-closed-error",
      "testLine": 178,
      "input": {
        "sessionId": "sess_a"
      },
      "result": {
        "steps": [
          {
            "step": "assertAdmissionOpen (open)",
            "ok": null,
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "open",
              "lifecycleGeneration": 0
            }
          },
          {
            "step": "beginCanonicalClose",
            "ok": "open",
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "closing",
              "lifecycleGeneration": 0
            }
          },
          {
            "step": "assertAdmissionOpen (closing)",
            "error": {
              "name": "SessionClosedError",
              "message": "Session \"sess_a\" closed: session is closed to new work",
              "instanceOf": {
                "SessionAddressError": false,
                "SessionClosedError": true
              },
              "own": {
                "cancelled": true,
                "name": "SessionClosedError",
                "reason": "canonical-close",
                "sessionId": "sess_a"
              }
            },
            "rt": {
              "addressedSessionId": "sess_a",
              "admission": "closing",
              "lifecycleGeneration": 0
            }
          }
        ]
      }
