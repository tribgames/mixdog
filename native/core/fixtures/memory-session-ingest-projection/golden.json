{
  "domain": "memory-session-ingest-projection",
  "source": "src/runtime/memory/lib/session-ingest-projection.test.mjs",
  "cases": [
    {
      "name": "session ingest projection preserves every text block in a user message",
      "projections": [
        {
          "name": "every text block of a user message is kept, images dropped",
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "type": "text",
                  "text": "<system-reminder>runtime context</system-reminder>"
                },
                {
                  "type": "text",
                  "text": "actual user instruction"
                },
                {
                  "type": "image",
                  "source": "ignored-binary"
                },
                {
                  "type": "text",
                  "text": "pasted continuation"
                }
              ]
            }
          ],
          "result": [
            {
              "role": "user",
              "content": "<system-reminder>runtime context</system-reminder>\nactual user instruction\npasted continuation"
            }
          ]
        }
      ]
    },
    {
      "name": "session ingest projection excludes Compact active-turn continuation rows",
      "projections": [
        {
          "name": "compact active-turn continuation rows are excluded",
          "messages": [
            {
              "role": "user",
              "content": "actual user instruction"
            },
            {
              "role": "user",
              "content": "<system-reminder>\n<active-turn-continuation>\ncontinue without repeating completed tool calls\n</active-turn-continuation>\n</system-reminder>",
              "meta": {
                "source": "compact-active-turn-continuation",
                "synthetic": true
              }
            }
          ],
          "result": [
            {
              "role": "user",
              "content": "actual user instruction"
            }
          ]
        }
      ]
    },
