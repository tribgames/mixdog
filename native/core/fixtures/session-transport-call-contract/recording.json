          "anthropic-oauth",
          "openai"
        ]
      },
      "result": {
        "steps": [
          {
            "step": "register({provider: anthropic-oauth, manualUrl, completeCode: code === 'code-123'})",
            "status": {
              "flowId": "oauth_<ms>_1",
              "provider": "anthropic-oauth",
              "url": null,
              "manualUrl": "https://example.test/oauth",
              "userCode": null,
              "state": "pending",
              "completed": false,
              "error": null,
              "manualCodeSupported": true
            },
            "structuredCloneOk": true
          },
          {
            "step": "complete(flowId, 'code-123')",
            "status": {
              "flowId": "oauth_<ms>_1",
              "provider": "anthropic-oauth",
              "url": null,
              "manualUrl": "https://example.test/oauth",
              "userCode": null,
              "state": "complete",
              "completed": true,
              "error": null,
              "manualCodeSupported": true
            }
          },
          {
            "step": "register({provider: openai, cancel})",
            "status": {
              "flowId": "oauth_<ms>_2",
              "provider": "openai",
              "url": null,
              "manualUrl": null,
              "userCode": null,
              "state": "pending",
              "completed": false,
              "error": null,
              "manualCodeSupported": false
            }
          },
          {
            "step": "cancel(second flowId)",
            "status": {
              "flowId": "oauth_<ms>_2",
              "provider": "openai",
              "url": null,
              "manualUrl": null,
              "userCode": null,
              "state": "cancelled",
              "completed": false,
              "error": null,
              "manualCodeSupported": false
            },
            "cancelCallbackCalls": 1
          },
          {
            "step": "status(second flowId) after cancel",
            "status": {
              "flowId": "oauth_<ms>_2",
              "provider": "openai",
              "url": null,
              "manualUrl": null,
              "userCode": null,
              "state": "cancelled",
              "completed": false,
              "error": null,
              "manualCodeSupported": false
            }
          }
