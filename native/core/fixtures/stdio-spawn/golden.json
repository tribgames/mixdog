    {
      "name": "cmd-shim-double-escape",
      "command": "<ROOT>\\work\\node_modules\\.bin\\shim.cmd",
      "args": [
        "a&b",
        "say \"hi\"",
        "plain"
      ],
      "cwd": null,
      "path": "<ROOT>\\bin",
      "processPath": null,
      "launch": {
        "kind": "shell",
        "file": "C:\\Windows\\System32\\cmd.exe",
        "args": [
          "/d",
          "/s",
          "/c",
          "\"<ROOT>\\work\\node_modules\\.bin\\shim.cmd ^^^\"a^^^&b^^^\" ^^^\"say^^^ \\^^^\"hi\\^^^\"^^^\" ^^^\"plain^^^\"\""
