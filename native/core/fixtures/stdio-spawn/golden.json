    {
      "name": "pathext-order-picks-com",
      "command": "both",
      "args": [],
      "cwd": null,
      "path": "<ROOT>\\bin",
      "processPath": null,
      "launch": {
        "kind": "direct",
        "shown": "both",
        "args": [],
        "program": "<ROOT>\\bin\\both.COM"
      }
    },
    {
      "name": "cmd-script",
      "command": "shimmed",
      "args": [
        "x"
      ],
      "cwd": null,
      "path": "<ROOT>\\bin",
      "processPath": null,
      "launch": {
        "kind": "shell",
        "file": "C:\\Windows\\System32\\cmd.exe",
        "args": [
          "/d",
          "/s",
          "/c",
          "\"shimmed ^\"x^\"\""
        ]
      }
    },
    {
      "name": "unresolved",
      "command": "harness-no-such-command",
      "args": [],
      "cwd": null,
      "path": "<ROOT>\\bin",
      "processPath": null,
      "launch": {
        "kind": "shell",
        "file": "C:\\Windows\\System32\\cmd.exe",
        "args": [
          "/d",
          "/s",
          "/c",
          "\"harness-no-such-command\""
        ]
      }
    },
    {
      "name": "unresolved-with-arguments",
      "command": "harness-no-such-command",
      "args": [
        "--flag",
        "a b",
        "say \"hi\"",
        "C:\\dir\\",
        "back\\\"slash",
        "%PATH%",
        "^&|<>",
        "",
        "trail\\\\",
        "x\"",
        "\\\"",
        "(paren)!",
        "tick`",
        "wild*?",
        "semi;comma,"
      ],
      "cwd": null,
      "path": "<ROOT>\\bin",
      "processPath": null,
      "launch": {
        "kind": "shell",
        "file": "C:\\Windows\\System32\\cmd.exe",
        "args": [
          "/d",
          "/s",
          "/c",
          "\"harness-no-such-command ^\"--flag^\" ^\"a^ b^\" ^\"say^ \\^\"hi\\^\"^\" ^\"C:\\dir\\\\^\" ^\"back\\\\\\^\"slash^\" ^\"^%PATH^%^\" ^\"^^^&^|^<^>^\" ^\"^\" ^\"trail\\\\\\^\" ^\"x\\^\"^\" ^\"\\\\\\^\"^\" ^\"^(paren^)^!^\" ^\"tick^`^\" ^\"wild^*^?^\" ^\"semi^;comma^,^\"\""
        ]
      }
    },
    {
      "name": "extensionless-file",
      "command": "plain",
      "args": [
        "x"
      ],
      "cwd": null,
      "path": "<ROOT>\\bin",
      "processPath": null,
      "launch": {
        "kind": "shell",
        "file": "C:\\Windows\\System32\\cmd.exe",
        "args": [
          "/d",
          "/s",
          "/c",
          "\"plain ^\"x^\"\""
        ]
      }
    },
    {
