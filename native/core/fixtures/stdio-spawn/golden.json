    {
      "path": "other/local.exe",
      "text": ""
    },
    {
      "path": "work/here.exe",
      "text": ""
    },
    {
      "path": "work/node_modules/.bin/shim.cmd",
      "text": ""
    }
  ],
  "parse": [
