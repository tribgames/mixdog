      "path": "bin/tool.exe",
      "text": ""
    },
    {
      "path": "bin/tool.cmd",
      "text": ""
    },
    {
      "path": "bin/both.cmd",
      "text": ""
    },
    {
      "path": "bin/both.com",
      "text": ""
    },
    {
      "path": "bin/shimmed.cmd",
      "text": ""
    },
    {
