{
  "domain": "stdio-spawn",
  "recorder": "benchmarks/rust-core/recorders/record-stdio-spawn.mjs",
  "host": {
    "pathext": ".COM;.EXE;.BAT;.CMD",
    "comspec": "C:\\Windows\\System32\\cmd.exe",
    "processCwd": "<ROOT>/work"
