      "name": "exe-by-name",
      "command": "tool",
      "args": [
        "a"
      ],
      "cwd": null,
      "path": "<ROOT>\\bin",
      "processPath": null,
      "launch": {
        "kind": "direct",
        "shown": "tool",
        "args": [
          "a"
        ],
        "program": "<ROOT>\\bin\\tool.EXE"
      }
    },
    {
      "name": "exe-with-extension",
      "command": "tool.exe",
      "args": [
        "a b"
      ],
      "cwd": null,
      "path": "<ROOT>\\bin",
      "processPath": null,
      "launch": {
        "kind": "direct",
        "shown": "tool.exe",
        "args": [
          "a b"
        ],
        "program": "<ROOT>\\bin\\tool.exe"
