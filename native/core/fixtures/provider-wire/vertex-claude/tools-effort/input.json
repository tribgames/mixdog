{
  "provider": "vertex-ai-adc",
  "config": {
    "authMode": "adc",
    "projectId": "fixture-project",
    "location": "global"
  },
  "credential": {
    "file": "adc.json",
    "document": {
      "type": "authorized_user",
      "client_id": "fixture-client",
      "client_secret": "fixture-secret",
      "refresh_token": "fixture-refresh-token"
    }
  },
  "clientVersion": "1.4.5",
  "model": "claude-sonnet-4-6",
  "messages": [
    {
      "role": "system",
      "content": "You are a fixture assistant."
    },
    {
      "role": "user",
      "content": "Hello"
    }
  ],
  "tools": [
    {
      "name": "glob",
      "description": "Find files",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ]
      }
    }
  ],
  "opts": {
    "effort": "high"
  },
  "callbacks": [
    "onToolCall",
    "onStageChange",
    "onStreamDelta",
    "onTextDelta",
    "onTextReset",
    "onReasoningDelta",
    "onStreamItemStart"
  ]
}
