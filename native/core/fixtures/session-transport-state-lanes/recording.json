              "cwd": null,
              "daemonPid": "<pid>",
              "updatedAt": "<ms>"
            },
            "stateCount": 5
          }
        ],
        "states": [
          {
            "enabled": false,
            "sessionId": null,
            "cwd": null,
            "daemonPid": "<pid>",
            "updatedAt": "<ms>"
          },
          {
            "enabled": false,
            "sessionId": null,
            "cwd": "<cwd>",
            "daemonPid": "<pid>",
            "updatedAt": "<ms>"
          },
          {
            "enabled": true,
            "sessionId": "null",
            "cwd": "<cwd>",
            "daemonPid": "<pid>",
            "updatedAt": "<ms>"
          },
          {
            "enabled": true,
            "sessionId": "session_remote",
            "cwd": "<cwd>",
            "daemonPid": "<pid>",
            "updatedAt": "<ms>"
          },
          {
            "enabled": false,
            "sessionId": null,
            "cwd": null,
            "daemonPid": "<pid>",
            "updatedAt": "<ms>"
          }
        ],
        "hostCalls": [
          {
            "name": "activate_channel_bridge",
            "args": {
              "active": true,
              "sessionId": "session_remote"
            }
          },
          {
            "name": "activate_channel_bridge",
            "args": {
              "active": false,
              "sessionId": "session_remote"
            }
          }
        ]
      }
    },
    {
      "name": "every-attached-client-observes-the-same-session-snapshot-stream",
      "testLine": 365,
      "input": {
        "clients": [
          "terminal",
          "desktop",
          "unrelated"
        ],
        "steps": [
          "terminal session.create",
          "desktop session.subscribe",
          "terminal submit \"from terminal\"",
          "desktop submit \"from desktop\""
        ]
      },
      "result": {
        "steps": [
          {
            "step": "terminal session.create",
            "sessionIdMatches": true,
            "reservedOnly": true
          },
          {
            "step": "desktop session.subscribe",
            "subscribed": true
          },
          {
            "step": "terminal session.submit \"from terminal\"; desktop view folded items",
            "items": [
              {
                "id": 1,
                "text": "from terminal"
              }
            ]
          },
          {
            "step": "desktop session.submit \"from desktop\"; terminal view folded items",
            "items": [
              {
                "id": 1,
                "text": "from terminal"
              },
              {
                "id": 2,
                "text": "from desktop"
              }
            ]
          },
          {
            "step": "unrelated client frames for the session",
            "count": 0
          }
        ],
        "serviceCalls": [
          {
            "name": "session.create",
            "args": {
              "cwd": "<cwd>"
            },
            "context": {
              "clientToken": "<client 1>",
              "leadPid": "<pid>",
              "cwd": "<cwd>",
              "revision": 6
            },
            "error": null
          },
          {
            "name": "session.subscribe",
            "args": {
              "sessionId": "<daemon session 1>"
            },
            "context": {
              "clientToken": "<client 2>",
              "leadPid": "<pid>",
              "cwd": "<cwd>",
              "revision": 6
            },
            "error": null
          },
          {
            "name": "session.submit",
            "args": {
              "sessionId": "<daemon session 1>",
              "prompt": "from terminal"
            },
            "context": {
              "clientToken": "<client 1>",
              "leadPid": "<pid>",
              "cwd": "<cwd>",
              "revision": 6
            },
            "error": null
          },
          {
            "name": "session.submit",
            "args": {
              "sessionId": "<daemon session 1>",
              "prompt": "from desktop"
            },
            "context": {
              "clientToken": "<client 2>",
              "leadPid": "<pid>",
              "cwd": "<cwd>",
              "revision": 6
            },
            "error": null
          }
        ]
      }
    },
    {
      "name": "in-daemon-transport-connection-receives-frames-without-owning-daemon-lifetime",
      "testLine": 428,
      "input": {
        "attach": [
          {
            "lifecycle": true
          },
          {
            "lifecycle": false
          }
        ],
        "close": "the external client"
      },
      "result": {
        "steps": [
          {
            "step": "attach an external client and an in-daemon (lifecycle:false) client",
            "clientCount": 1,
            "connectionCount": 2,
            "clientsEmpty": null
          },
          {
            "step": "external client closed",
            "clientCount": 0,
            "connectionCount": 1,
            "clientsEmpty": "empty"
          }
        ]
      }
    }
  ],
  "notRecorded": [
    {
      "testLine": 19,
      "name": "wire-safe runtime state crosses the daemon without a transcript clone",
      "reason": "asserts object identity (result.full === state, same items array) of a Node in-memory snapshot: a memory property with no wire-visible value"
    },
    {
      "testLine": 192,
      "name": "a live daemon SSE stream reconnects in place with the same client registration",
      "reason": "the Node HTTP/SSE stream client itself; the Rust core serves the app-server WebSocket, no counterpart"
    },
    {
      "testLine": 275,
      "name": "a disconnected client receives bounded session resync markers instead of a huge backlog",
      "reason": "SSE backlog budget and resyncRequired markers of the Node transport; removed in the Rust protocol (no resync markers)"
    },
    {
      "testLine": 446,
      "name": "a local attachment keeps a silent stream: only the socket closing ends it",
      "reason": "SSE stream-liveness timers of the Node client (mock clock on its own HTTP server); no Rust counterpart"
    },
    {
      "testLine": 493,
      "name": "a silent SSE is reconnected and a continuous reconnect storm exhausts its budget",
      "reason": "SSE liveness timeout and reconnect budget of the Node client; no Rust counterpart"
    }
  ]
}
