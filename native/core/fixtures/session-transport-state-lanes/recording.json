            "args": {
              "active": false,
              "sessionId": "session_remote"
            }
          }
        ]
      },
      "result": {
        "steps": [
          {
            "call": {
              "name": "activate_channel_bridge",
              "args": {
                "active": true,
                "sessionId": "session_remote"
              }
            },
            "response": {
              "ok": {
                "result": {
                  "ok": true
                }
              }
            },
            "lastState": {
              "enabled": true,
