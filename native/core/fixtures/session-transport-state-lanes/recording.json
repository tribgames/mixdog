{
  "domain": "session-transport-state-lanes",
  "recorder": "benchmarks/rust-core/recorders/record-session-transport-state-lanes.mjs",
  "testFile": "scripts/session-transport/state-lanes.test.mjs",
  "cases": [
    {
      "name": "tool-card-update-sends-only-the-changed-transcript-suffix",
      "testLine": 48,
      "input": {
        "generator": "2000 items {id: item-<i>, kind: message (tool for i=1999), status: settled, text: row-<i>}; next = same with item 1999 {status: completed, text: tool result} and busy true->false",
        "previous": {
          "sessionId": "suffix-test",
          "busy": true,
          "itemCount": 2000
        },
        "next": {
          "sessionId": "suffix-test",
          "busy": false,
          "itemCount": 2000
        }
      },
      "result": {
        "patch": {
          "set": {
            "busy": false
          },
          "remove": [],
          "itemsAppend": {
            "from": 1999,
            "values": [
              {
                "id": "item-1999",
                "kind": "tool",
                "status": "completed",
                "text": "tool result"
              }
            ]
          }
        },
        "patchHasItemsInSet": false,
        "patchJsonLength": 148,
        "appliedEqualsNext": true
      }
    },
    {
      "name": "unknown-session-subscription-is-rejected-before-a-runtime-is-created",
      "testLine": 67,
      "input": {
        "call": [
          "session.subscribe",
          {
            "sessionId": "missing_session"
          },
          {
            "clientToken": "stale_pane"
          }
        ],
        "sessionExists": "always false"
      },
      "result": {
        "outcome": {
          "error": {
            "message": "session missing_session is not available",
            "code": null
          }
        },
        "runtimeCreations": 0,
        "sessionExistsCalls": [
          "missing_session"
        ],
        "serviceSize": 0
      }
    },
    {
      "name": "agent-session-publishes-through-the-subscribed-session-state-lane",
      "testLine": 94,
      "input": {
        "client": {
          "clientToken": "desktop-pane"
        },
        "storedSession": {
          "items": [
            {
              "id": "brief",
              "kind": "user",
              "text": "worker brief"
            }
          ]
        }
      },
      "result": {
        "steps": [
          {
            "step": "session.subscribe(agent_child)",
            "ok": {
              "sessionId": "agent_child",
              "reservedOnly": false,
              "projection": true,
              "revision": "<epoch revision>+0",
              "full": {
                "sessionId": "agent_child",
                "queued": [],
                "items": [
                  {
                    "id": "brief",
                    "kind": "user",
                    "text": "worker brief"
                  }
                ]
              },
              "subscribed": true
            }
          },
          {
            "step": "external publish (brief, tool-1; busy)",
            "frames": [
              {
                "frame": {
                  "type": "session-state",
                  "key": "session-state:agent_child",
                  "sessionId": "agent_child",
                  "revision": "<epoch revision>+1",
                  "full": {
                    "sessionId": "agent_child",
                    "items": [
                      {
                        "id": "brief",
                        "kind": "user",
                        "text": "worker brief"
                      },
                      {
                        "id": "tool-1",
                        "kind": "tool",
                        "text": "read source"
                      }
                    ],
                    "queued": [],
                    "busy": true
                  }
                },
                "targets": [
                  "desktop-pane"
                ]
              }
            ],
            "pendingViewerSessions": 0,
            "runtimeCreations": 0
          },
          {
            "step": "session.read(agent_child)",
            "ok": {
              "sessionId": "agent_child",
              "reservedOnly": false,
              "revision": "<epoch revision>+1",
              "full": {
                "sessionId": "agent_child",
                "items": [
                  {
                    "id": "brief",
                    "kind": "user",
                    "text": "worker brief"
                  },
                  {
                    "id": "tool-1",
                    "kind": "tool",
                    "text": "read source"
                  }
                ],
                "queued": [],
                "busy": true
              }
            }
          },
          {
            "step": "session.unsubscribe(agent_child)",
            "ok": {
              "sessionId": "agent_child",
              "unsubscribed": true
            }
          },
          {
            "step": "external publish after unsubscribe (ignored item)",
            "publisherStillRegistered": true,
            "newFrames": 0
          }
        ],
        "readStoredSessionCalls": [
          "agent_child"
        ],
        "runtimeCreations": 0,
        "totalFrames": 1
      }
    },
    {
      "name": "disconnected-channel-remote-state-churn-keeps-only-the-latest-frame",
      "testLine": 303,
      "input": {
        "register": {
          "leadPid": "<pid>",
          "passive": true
        },
        "writes": "remote state \"state-0\" .. \"state-9999\" in order, client has no SSE stream"
      },
      "result": {
        "clientFound": true,
        "pendingRemoteStateFrame": "{\"type\":\"notify\",\"method\":\"notifications/mixdog/remote\",\"params\":{\"state\":\"state-9999\"}}",
        "hasPendingQueue": false
      }
    },
    {
