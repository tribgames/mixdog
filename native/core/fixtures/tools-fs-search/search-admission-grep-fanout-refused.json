{
  "name": "search-admission-grep-fanout-refused",
  "standin": true,
  "env": {
    "MIXDOG_SEARCH_CANCEL_GRACE_MS": "1000"
  },
  "files": {
    "t/a.ts": "needle one\n",
    "u/d.ts": "needle four\n"
  },
  "warmup": [
    {
      "tool": "grep",
      "input": {
        "pattern": "warmup-none"
      }
    }
  ],
  "admission": [
    {
      "start": "holder",
      "call": {
        "tool": "glob",
        "input": {
          "pattern": "*.ts",
          "path": "t"
        }
      },
      "until": "server",
      "requests": 1
    },
    {
      "start": "waiter",
      "call": {
        "tool": "grep",
        "input": {
          "pattern": [
            "needle",
            "other"
          ],
          "path": "t",
          "context": 0
        }
      },
      "until": "queued",
      "requests": 1
    },
    {
      "script": "observe"
    },
    {
      "tick": 17500
    },
    {
      "settle": "holder",
      "answer": {
        "text": "Error: rg failed for t: native file inventory search timed out after 17500ms.",
        "isError": true
      }
    },
    {
      "settle": "waiter",
      "requests": 4,
      "answer": {
        "text": "# grep pattern:\"needle\"\nt/a.ts:1:needle one\n\n(no matches) patterns=[\"other\"]",
        "isError": false
      }
    }
  ],
  "answeredOrder": [
    "holder",
    "waiter"
  ]
}
