    },
    {
      "settle": "A1",
      "answer": {
        "text": "d.ts",
        "isError": false
      }
    },
    {
      "settle": "B2",
      "answer": {
        "text": "e.ts",
        "isError": false
      }
    },
    {
      "settle": "B3",
      "requests": 5,
      "answer": {
        "text": "f.ts",
        "isError": false
      }
