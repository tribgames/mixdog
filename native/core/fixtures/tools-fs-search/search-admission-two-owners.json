      "owner": "H",
      "requests": 1
    },
    {
      "start": "A0",
      "call": {
        "tool": "find",
        "input": {
          "query": "a",
          "path": "t"
        }
      },
      "until": "queued",
      "owner": "A",
      "requests": 1
    },
    {
      "start": "A1",
      "call": {
        "tool": "find",
        "input": {
          "query": "d",
          "path": "u"
        }
      },
      "until": "queued",
      "owner": "A",
      "requests": 1
    },
    {
      "start": "B2",
      "call": {
        "tool": "find",
        "input": {
          "query": "e",
          "path": "u"
        }
      },
      "until": "queued",
      "owner": "B",
      "requests": 1
    },
    {
      "start": "B3",
      "call": {
        "tool": "find",
        "input": {
          "query": "f",
          "path": "u"
        }
      },
      "until": "queued",
      "owner": "B",
      "requests": 1
    },
    {
      "script": "observe"
    },
    {
      "abort": "holder"
    },
    {
      "settle": "holder",
