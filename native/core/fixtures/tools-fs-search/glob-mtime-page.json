    },
    {
      "tool": "glob",
      "input": {
        "pattern": "*.txt",
        "limit": 5
      },
      "text": "newest.txt\na-tie.txt\nb-tie.txt\nmiddle.txt\nfailed-first.txt\n[entries 1-5 of 7; offset:5 for more]",
      "isError": false
    }
