              "body": "{\"leadPid\":41001,\"passive\":true}"
            },
            "response": {
              "head": [
                "HTTP/1.1 200 OK",
                "Content-Type: application/json; charset=utf-8",
                "Content-Length: 67",
                "Cache-Control: no-store",
                "X-Content-Type-Options: nosniff",
                "Date: <date>",
                "Connection: keep-alive",
                "Keep-Alive: timeout=5"
              ],
              "body": "{\"token\":\"<client-token-1>\",\"pid\":\"<pid-self>\"}"
            }
          },
          {
            "step": "call same-call",
            "request": {
              "head": [
                "POST /call HTTP/1.1",
