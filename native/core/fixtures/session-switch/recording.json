  "cases": [
    {
      "name": "deleted-session-hands-its-worktree-to-the-autocleanup-policy",
      "testLine": 116,
      "input": {
        "runs": [
          {
            "current": {
              "id": "other"
            },
            "rows": [
              {
                "id": "parent",
                "owner": "cli",
                "sourceType": "lead",
                "messages": [
                  {
                    "role": "user",
                    "content": "hi"
                  }
                ]
              }
            ],
            "cwd": "C:\\one",
            "delete": "parent"
          },
          {
            "current": {
              "id": "parent",
              "messages": [
                {
                  "role": "user",
                  "content": "hi"
                }
              ],
              "workspace": {
                "projectPath": "C:\\project",
                "repoCommonDir": "C:\\project\\.git",
                "cwd": "C:\\worktrees\\fix",
                "worktreeId": "fix",
                "branch": "mixdog/fix",
                "baseCommit": null,
                "mergeTarget": "main",
                "revision": 2,
                "transition": {
                  "state": "idle",
                  "txId": null
                }
              }
            },
            "rows": [
              {
                "id": "parent",
                "owner": "cli",
                "sourceType": "lead",
                "messages": [
                  {
                    "role": "user",
                    "content": "hi"
                  }
                ]
              }
            ],
            "cwd": "C:\\worktrees\\fix",
            "delete": "parent"
          }
        ],
        "steps": "deleteSession, then one setImmediate turn, then read the cleanup arguments"
      },
      "result": [
        {
          "label": "other session is current",
          "deleted": true,
          "calls": [
            [
              "close",
              "parent",
              "desktop-session-delete",
              {
                "tombstone": false,
                "isSessionLive": {
                  "function": "isSessionLive",
                  "result": false
                }
              }
            ],
            [
              "cancelTasks",
              {
                "reason": "desktop-session-delete",
                "notify": false,
                "executionSessionId": "parent"
              }
            ],
            [
              "clearRoute",
              "parent"
            ],
            [
              "delete",
              "parent"
            ]
          ],
          "cleaned": [
            [
              "parent",
              "other",
              "C:\\one"
            ]
          ],
          "forgotten": [
            "parent"
          ],
          "state": {
            "session": {
              "id": "other"
            },
            "route": {
              "provider": "p",
              "model": "m",
              "effort": "low"
            },
            "desktop": null,
            "cwd": "C:\\one"
          }
        },
        {
          "label": "a bound current session is deleted",
          "deleted": true,
          "calls": [
            [
              "cancelTasks",
              {
                "reason": "desktop-session-delete",
                "notify": false,
                "executionSessionId": "parent"
              }
            ],
            [
              "clearRoute",
              "parent"
            ],
            [
              "close",
              "parent",
              "desktop-session-delete",
              {
                "tombstone": true
              }
            ],
            [
              "cwd",
              "C:\\project"
            ],
            [
              "invalidateContext"
            ],
            [
              "invalidateTools"
            ],
            [
              "create"
            ]
          ],
          "cleaned": [
            [
              "parent",
              "fresh",
              "C:\\project"
            ]
          ],
          "forgotten": [
            "parent"
          ],
          "state": {
            "session": {
              "id": "fresh",
              "messages": []
            },
            "route": {
              "provider": "p",
              "model": "m",
              "effort": "low"
            },
            "desktop": null,
            "cwd": "C:\\project"
          }
        }
      ]
