        { "args": { "action": "batch", "session": "<session>", "operations": [{ "op": "set_cell", "cell": "A1", "value": "=cmd()" }] } },
        { "args": { "action": "batch", "session": "<session>", "operations": [{ "op": "insert_rows", "row": 2, "count": 1 }, { "op": "delete_columns", "column": "B", "count": 1 }] } },
        { "args": { "action": "snapshot", "session": "<session>" } },
        { "args": { "action": "save", "session": "<session>" } },
        { "args": { "action": "close", "session": "<session>" } },
        { "args": { "action": "snapshot", "path": "plain-out.tsv" }, "cancelled": true },
        { "args": { "action": "secure", "path": "plain.tsv", "output": "locked.tsv", "security": "encrypt" } }
      ],
      "outputs": ["plain.tsv", "plain-out.tsv"]
    }
  ]
}
