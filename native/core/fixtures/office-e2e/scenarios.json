    {
      "name": "xlsx: cells, ranges, formulas, styles, sheets",
      "suites": ["office-runtime-portable", "office-assurance"],
      "calls": [
        { "args": { "action": "create", "path": "book.xlsx", "mode": "portable", "operations": [
          { "op": "set_range", "range": "A1:B3", "values": [["name", "score"], ["alpha", 1], ["beta", 2]] },
          { "op": "set_formula", "cell": "B4", "formula": "=SUM(B2:B3)" },
          { "op": "set_style", "range": "A1:B1", "properties": { "bold": true, "fillColor": "EEF2F7", "borders": { "bottom": { "style": "thin", "color": "C9CED6" } } } },
          { "op": "freeze_panes", "cell": "A2" }
        ] } },
        { "args": { "action": "batch", "session": "<session>", "operations": [{ "op": "add_sheet", "name": "Calc" }, { "op": "set_cell", "sheet": "Calc", "cell": "A1", "value": "x" }, { "op": "append_row", "sheet": "Calc", "values": ["tail", 5] }, { "op": "rename_sheet", "sheet": "Calc", "name": "Summary" }] } },
        { "args": { "action": "snapshot", "session": "<session>" } },
        { "args": { "action": "issues", "session": "<session>" } },
        { "args": { "action": "batch", "session": "<session>", "operations": [{ "op": "rename_sheet", "sheet": "Summary", "name": "Bad/Name" }] } },
        { "args": { "action": "batch", "session": "<session>", "operations": [{ "op": "delete_sheet", "sheet": "Missing" }] } },
        { "args": { "action": "get", "session": "<session>", "target": "/sheet[Sheet1]/cell[B4]" } },
        { "args": { "action": "close", "session": "<session>" } }
      ],
      "outputs": ["book.xlsx"]
    },
    {
      "name": "xlsx: open a minimal workbook to an output and edit it",
      "suites": ["office-runtime-portable"],
      "setup": [
        { "file": "source.xlsx", "zip": {
          "[Content_Types].xml": "<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"/>",
          "xl/workbook.xml": "<?xml version=\"1.0\"?><workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\"><sheets><sheet name=\"Data\" sheetId=\"1\" r:id=\"rId1\"/></sheets><definedNames><definedName name=\"InputRange\">Data!$B$1:$C$2</definedName></definedNames></workbook>",
          "xl/_rels/workbook.xml.rels": "<?xml version=\"1.0\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"worksheets/sheet1.xml\"/></Relationships>",
          "xl/worksheets/sheet1.xml": "<?xml version=\"1.0\"?><worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><sheetData><row r=\"1\"><c r=\"A1\" t=\"inlineStr\"><is><t>Old</t></is></c></row></sheetData><dataValidations count=\"1\"><dataValidation type=\"list\" allowBlank=\"1\" showInputMessage=\"1\" showErrorMessage=\"1\" sqref=\"E1:E3\"><formula1>\"Yes,No\"</formula1></dataValidation></dataValidations></worksheet>"
        } }
      ],
      "calls": [
        { "args": { "action": "open", "path": "source.xlsx", "output": "edited.xlsx", "mode": "portable" } },
        { "args": { "action": "batch", "session": "<session>", "operations": [
          { "op": "set_cell", "sheet": "Data", "cell": "A1", "value": "New" },
