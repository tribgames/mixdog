{
  "note": "Ordered Office call sequences run through Node's executeOfficeTool (record-office-e2e.mjs) and through mixdog_office::engine::Engine::execute (tests/twin_e2e.rs). Paths are relative to the call's folder. Every create/open of a docx, xlsx or pptx names mode portable so no Microsoft Office is reached. A string argument <session> is the latest session id any answer named, <session:NAME> the one a call marked as:NAME named, <reviewToken> the latest reviewToken any answer held. setup puts files in the folder before the first call (text, hex, or zip: entry name to text). outputs names the files compared after the last call; data:true compares the data folder's journal JSON. A call with cancelled:true is made with a signal that is already aborted.",
  "scenarios": [
    {
      "name": "contract: describe, refusals and unknown names",
      "suites": ["office-runtime-contract"],
      "calls": [
        { "args": { "action": "describe" } },
        { "args": { "action": "describe", "format": "docx", "backend": "mixdog-ooxml" } },
        { "args": { "action": "describe", "format": "xlsx", "backend": "mixdog-ooxml", "operation": "set_cell" } },
        { "args": { "action": "describe", "format": "pptx", "backend": "mixdog-ooxml", "operation": "add_textbox" } },
        { "args": { "action": "describe", "format": "pdf", "operation": "add_text" } },
        { "args": { "action": "describe", "format": "docx", "operation": "no_such_operation" } },
        { "args": { "action": "describe", "format": "nowhere" } },
        { "args": { "action": "frobnicate" } },
        { "args": { "action": "create", "path": "x.docx", "mode": "portable", "operations": [{ "op": "compress", "alowNoChange": true }] } },
        { "args": { "action": "create", "path": "x.pptx", "mode": "portable", "operations": [{ "op": "add_textbox", "slide": 1, "text": "Title", "boldish": true }] } },
        { "args": { "action": "create", "path": "x.docx", "mode": "unsupported-mode" } },
        { "args": { "action": "snapshot", "session": "office_missing" } },
        { "args": { "action": "batch" } },
        { "args": { "action": "close", "session": "office_missing" } },
        { "args": { "action": "author" } }
      ],
      "outputs": []
    },
    {
      "name": "docx: create, edit, snapshot, issues, validate, save, close",
      "suites": ["office-runtime-portable", "office-authoring"],
      "calls": [
        { "args": { "action": "create", "path": "memo.docx", "mode": "portable", "operations": [{ "op": "append_text", "text": "Quarterly memo for the US office." }, { "op": "append_text", "text": "Second paragraph with a tab\tand more words to read." }] } },
        { "args": { "action": "batch", "session": "<session>", "operations": [{ "op": "replace_text", "find": "Quarterly memo", "replace": "Annual memo" }, { "op": "set_paragraph_text", "paragraph": 2, "text": "Total\t42" }] } },
        { "args": { "action": "snapshot", "session": "<session>" } },
        { "args": { "action": "get", "session": "<session>", "target": "/body/p[1]" } },
        { "args": { "action": "query", "session": "<session>", "query": "Total" } },
        { "args": { "action": "issues", "session": "<session>" } },
        { "args": { "action": "validate", "session": "<session>" } },
        { "args": { "action": "save", "session": "<session>" } },
        { "args": { "action": "close", "session": "<session>" } },
        { "args": { "action": "snapshot", "path": "memo.docx", "mode": "portable" } }
      ],
      "outputs": ["memo.docx"]
    },
    {
      "name": "docx: tables, fonts, lists, header, footer, page, numbers",
      "suites": ["office-runtime-portable", "office-runtime-design"],
      "calls": [
        { "args": { "action": "create", "path": "report.docx", "mode": "portable", "operations": [
          { "op": "append_text", "text": "Region report" },
          { "op": "append_text", "text": "Point one" },
          { "op": "append_text", "text": "Point two" },
          { "op": "add_table", "values": [["Region", "Revenue"], ["North", "120"], ["South", "95"]], "properties": { "columnWidths": [3000, 2000], "headerBold": true } },
          { "op": "set_table_cell", "table": 1, "row": 2, "col": 2, "text": "130" },
          { "op": "set_list", "paragraph": 2, "kind": "bullet", "level": 1 },
          { "op": "set_list", "paragraph": 3, "kind": "number", "level": 1 },
          { "op": "set_header_footer", "kind": "footer", "text": "Internal use" },
          { "op": "add_page_numbers", "alignment": "right" },
          { "op": "set_page", "properties": { "orientation": "landscape", "pageSize": "A4" } }
        ] } },
        { "args": { "action": "batch", "session": "<session>", "operations": [{ "op": "set_table_cell_style", "table": 1, "row": 1, "col": 1, "properties": { "fillColor": "EEF2F7", "bold": true } }, { "op": "set_paragraph_format", "paragraph": 1, "properties": { "alignment": "center", "spacingAfter": 12 } }, { "op": "insert_table_row", "table": 1, "row": 3 }] } },
        { "args": { "action": "snapshot", "session": "<session>" } },
        { "args": { "action": "issues", "session": "<session>" } },
        { "args": { "action": "batch", "session": "<session>", "operations": [{ "op": "delete_table_row", "table": 1, "row": 9 }] } },
        { "args": { "action": "close", "session": "<session>" } }
      ],
      "outputs": ["report.docx"]
    },
    {
      "name": "docx: tracked changes, comments and revisions",
      "suites": ["office-runtime-portable", "office-assurance"],
      "calls": [
        { "args": { "action": "create", "path": "review.docx", "mode": "portable", "operations": [{ "op": "append_text", "text": "Keep this sentence." }, { "op": "append_text", "text": "Doomed paragraph to remove." }, { "op": "append_text", "text": "Survivor stays." }] } },
        { "args": { "action": "batch", "session": "<session>", "operations": [{ "op": "track_changes", "enabled": true }, { "op": "replace_text", "find": "Keep this", "replace": "Retain this", "author": "Reviewer" }, { "op": "remove_paragraph", "paragraph": 2, "author": "Reviewer" }, { "op": "add_comment", "find": "Survivor", "text": "Keep", "author": "Reviewer" }] } },
        { "args": { "action": "snapshot", "session": "<session>" } },
        { "args": { "action": "issues", "session": "<session>" } },
        { "args": { "action": "batch", "session": "<session>", "operations": [{ "op": "add_comment_reply", "comment": 1, "text": "Agreed", "author": "Author" }, { "op": "set_comment_resolved", "comment": 1, "resolved": true }] } },
        { "args": { "action": "batch", "session": "<session>", "operations": [{ "op": "resolve_revisions", "resolution": "accept" }] } },
        { "args": { "action": "snapshot", "session": "<session>" } },
        { "args": { "action": "close", "session": "<session>" } }
      ],
      "outputs": ["review.docx"]
    },
