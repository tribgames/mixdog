    {
      "name": "placeholder-metadata-keeps-saved-fast",
      "testLine": 10,
      "input": {
        "route": {
          "provider": "openai-oauth",
          "model": "gpt-6-astra",
          "effort": "high",
          "fast": true
        },
        "baseConfig": {
          "modelSettings": {
            "openai-oauth/gpt-6-astra": {
              "effort": "high",
              "fast": true
            }
          }
        },
        "metas": [
          {
            "id": "gpt-6-astra",
            "provider": "openai-oauth"
          },
          {
            "id": "gpt-6-astra",
            "provider": "openai-oauth",
            "serviceTiers": [
              {
                "id": "priority"
              }
            ]
          },
          {
            "id": "gpt-6-astra",
            "provider": "openai-oauth",
            "serviceTiers": []
          }
        ]
      },
      "result": [
        {
          "fastCapable": true,
          "saved": {
            "effort": "high",
            "fast": true
          }
        },
        {
          "fastCapable": true,
          "saved": {
            "effort": "high",
            "fast": true
          }
        },
        {
          "fastCapable": false,
          "saved": {
            "effort": "high",
            "fast": false
          }
        }
      ]
    },
