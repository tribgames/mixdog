{
  "id": "renderer_release_reported_live_and_persisted",
  "description": "a desktop reporting its version on its leg changes the release its device is served, and the version survives a restart before the desktop redials",
  "files": {
    "releases": {
      "index.json": "{\"schemaVersion\":1,\"releases\":[{\"id\":\"legacy\",\"desktopVersion\":\"\",\"shellVersion\":\"1111111111111111111111111111111111111111111111111111111111111111\",\"addedAt\":1,\"legacy\":true},{\"id\":\"2.0.0-new\",\"desktopVersion\":\"2.0.0\",\"shellVersion\":\"2222222222222222222222222222222222222222222222222222222222222222\",\"addedAt\":2,\"legacy\":false}]}",
      "legacy/index.html": "<!doctype html><head><meta name=\"mixdog-shell-version\" content=\"1111111111111111111111111111111111111111111111111111111111111111\"><meta name=\"mixdog-shell-assets\" content=\"assets/main-12345678.js\"><script type=\"module\" src=\"./assets/main-12345678.js\"></script></head><body>legacy</body>",
      "legacy/assets/main-12345678.js": "export const label = 'legacy';",
      "legacy/boot.js": "void 0;",
      "legacy/manifest.webmanifest": "{\"start_url\":\"/\",\"icons\":[{\"src\":\"./icon.svg\"}]}",
      "legacy/icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\"><title>legacy</title></svg>",
      "legacy/sw.js": "// worker legacy",
      "2.0.0-new/index.html": "<!doctype html><head><meta name=\"mixdog-shell-version\" content=\"2222222222222222222222222222222222222222222222222222222222222222\"><meta name=\"mixdog-shell-assets\" content=\"assets/main-12345678.js\"><script type=\"module\" src=\"./assets/main-12345678.js\"></script></head><body>new</body>",
      "2.0.0-new/assets/main-12345678.js": "export const label = 'new';",
      "2.0.0-new/boot.js": "void 0;",
      "2.0.0-new/manifest.webmanifest": "{\"start_url\":\"/\",\"icons\":[{\"src\":\"./icon.svg\"}]}",
      "2.0.0-new/icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\"><title>new</title></svg>",
      "2.0.0-new/sw.js": "// worker new"
    },
    "renderer": {
      "index.html": "<!doctype html><head><meta name=\"mixdog-shell-version\" content=\"2222222222222222222222222222222222222222222222222222222222222222\"><meta name=\"mixdog-shell-assets\" content=\"assets/main-12345678.js\"><script type=\"module\" src=\"./assets/main-12345678.js\"></script></head><body>new</body>",
      "assets/main-12345678.js": "export const label = 'new';",
      "boot.js": "void 0;",
      "manifest.webmanifest": "{\"start_url\":\"/\",\"icons\":[{\"src\":\"./icon.svg\"}]}",
      "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\"><title>new</title></svg>",
      "sw.js": "// worker new"
    },
    "data": {
      "devices.json": "{\n  \"aaaaaaaa-0000-4000-8000-000000000002\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"\",\n    \"clients\": {}\n  }\n}"
    }
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "silent",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "aaaaaaaa-0000-4000-8000-000000000002",
        "0123456789abcdef"
      ]
    },
    {
      "do": "http",
      "label": "before any report: legacy",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000002/",
      "expect_status": 200
    },
    {
      "do": "send",
      "conn": "silent",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"desktop-version\",\"appVersion\":\"2.0.1\"}"
      }
    },
    {
      "do": "wait",
      "ms": 400
    },
    {
      "do": "http",
      "label": "after the report: the new release",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000002/",
      "expect_status": 200
    },
    {
      "do": "send",
      "conn": "silent",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"desktop-version\",\"appVersion\":\"../evil path\"}"
      }
    },
    {
      "do": "wait",
      "ms": 200
    },
    {
      "do": "http",
      "label": "a junk report changes nothing",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000002/",
      "expect_status": 200
    },
    {
      "do": "send",
      "conn": "silent",
      "frame": {
        "kind": "close",
        "code": 1000
      }
    },
    {
      "do": "expect",
      "conn": "silent",
      "close": true
    },
    {
      "do": "restart"
    },
    {
      "do": "http",
      "label": "after a restart, before a redial",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000002/",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "readiness",
      "path": "/readyz",
      "expect_status": 200
    }
  ]
}
