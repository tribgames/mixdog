{
  "id": "static_inline_boot_csp_hash",
  "description": "the CSP names the hash of boot.js only when the served index document inlines exactly that source",
  "files": {
    "data": {
      "devices.json": "{\n  \"11111111-2222-4333-8444-555555555555\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"\",\n    \"clients\": {\n      \"bbbbbbbb\": {\n        \"tokenHash\": \"3490f80401886d12f3861ec190f5c16419b26345497a92bc4530e22f5d8b4295\",\n        \"name\": \"Phone\",\n        \"platform\": \"ios\",\n        \"browser\": \"safari\",\n        \"createdAt\": 1700000000000,\n        \"lastSeenAt\": 1700000000000\n      }\n    }\n  }\n}"
    },
    "renderer": {
      "index.html": "<!doctype html><script>window.mixdogBoot = true;\n</script>",
      "boot.js": "window.mixdogBoot = true;\n",
      "other.html": "<!doctype html><script>window.mixdogBoot = true;\n</script>"
    }
  },
  "steps": [
    {
      "do": "http",
      "label": "inlined boot",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "inlined boot, root",
      "path": "/",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "another document keeps the base policy",
      "path": "/other.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "device route",
      "path": "/d/11111111-2222-4333-8444-555555555555/index.html",
      "expect_status": 200
    }
  ]
}
