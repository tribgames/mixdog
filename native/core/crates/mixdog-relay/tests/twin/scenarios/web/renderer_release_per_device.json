{
  "id": "renderer_release_per_device",
  "description": "each device is served the renderer release for the desktop version it reported; an old desktop that never reported keeps the legacy one; root assets follow the device cookie and vary on it; validators never cross releases",
  "files": {
    "releases": {
      "index.json": "{\"schemaVersion\":1,\"releases\":[{\"id\":\"legacy\",\"desktopVersion\":\"\",\"shellVersion\":\"1111111111111111111111111111111111111111111111111111111111111111\",\"addedAt\":1,\"legacy\":true},{\"id\":\"2.0.0-new\",\"desktopVersion\":\"2.0.0\",\"shellVersion\":\"2222222222222222222222222222222222222222222222222222222222222222\",\"addedAt\":2,\"legacy\":false}]}",
      "legacy/index.html": "<!doctype html><head><meta name=\"mixdog-shell-version\" content=\"1111111111111111111111111111111111111111111111111111111111111111\"><meta name=\"mixdog-shell-assets\" content=\"assets/main-12345678.js\"><script type=\"module\" src=\"./assets/main-12345678.js\"></script></head><body>legacy</body>",
      "legacy/assets/main-12345678.js": "export const label = 'legacy';",
      "legacy/boot.js": "void 0;",
      "legacy/manifest.webmanifest": "{\"start_url\":\"/\",\"icons\":[{\"src\":\"./icon.svg\"}]}",
      "legacy/icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\"><title>legacy</title></svg>",
      "legacy/sw.js": "// worker legacy",
      "2.0.0-new/index.html": "<!doctype html><head><meta name=\"mixdog-shell-version\" content=\"2222222222222222222222222222222222222222222222222222222222222222\"><meta name=\"mixdog-shell-assets\" content=\"assets/main-12345678.js\"><script type=\"module\" src=\"./assets/main-12345678.js\"></script></head><body>new</body>",
      "2.0.0-new/assets/main-12345678.js": "export const label = 'new';",
      "2.0.0-new/boot.js": "void 0;",
      "2.0.0-new/manifest.webmanifest": "{\"start_url\":\"/\",\"icons\":[{\"src\":\"./icon.svg\"}]}",
      "2.0.0-new/icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\"><title>new</title></svg>",
      "2.0.0-new/sw.js": "// worker new"
    },
    "renderer": {
      "index.html": "<!doctype html><head><meta name=\"mixdog-shell-version\" content=\"2222222222222222222222222222222222222222222222222222222222222222\"><meta name=\"mixdog-shell-assets\" content=\"assets/main-12345678.js\"><script type=\"module\" src=\"./assets/main-12345678.js\"></script></head><body>new</body>",
      "assets/main-12345678.js": "export const label = 'new';",
      "boot.js": "void 0;",
      "manifest.webmanifest": "{\"start_url\":\"/\",\"icons\":[{\"src\":\"./icon.svg\"}]}",
      "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\"><title>new</title></svg>",
      "sw.js": "// worker new"
    },
    "data": {
      "devices.json": "{\n  \"aaaaaaaa-0000-4000-8000-000000000001\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"\",\n    \"clients\": {},\n    \"appVersion\": \"2.0.0\",\n    \"versionSeenAt\": 1700000000000\n  },\n  \"aaaaaaaa-0000-4000-8000-000000000002\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"\",\n    \"clients\": {}\n  },\n  \"aaaaaaaa-0000-4000-8000-000000000003\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"\",\n    \"clients\": {},\n    \"appVersion\": \"1.0.0\",\n    \"versionSeenAt\": 1700000000000\n  }\n}"
    }
  },
  "steps": [
    {
      "do": "http",
      "label": "modern desktop shell",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000001/",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "silent desktop shell",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000002/",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "stale desktop shell",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000003/",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "modern icon",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000001/icon.svg",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "silent icon",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000002/icon.svg",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "silent hashed asset",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000002/assets/main-12345678.js",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "root worker by the modern device cookie",
      "path": "/sw.js",
      "headers": [
        [
          "Cookie",
          "mixdog_device=aaaaaaaa-0000-4000-8000-000000000001"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "root worker by the silent device cookie",
      "path": "/sw.js",
      "headers": [
        [
          "Cookie",
          "mixdog_device=aaaaaaaa-0000-4000-8000-000000000002"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "root hashed asset by the modern cookie keeps no Cookie vary",
      "path": "/assets/main-12345678.js",
      "headers": [
        [
          "Cookie",
          "mixdog_device=aaaaaaaa-0000-4000-8000-000000000001"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "root icon by the silent cookie",
      "path": "/icon.svg",
      "headers": [
        [
          "Cookie",
          "mixdog_device=aaaaaaaa-0000-4000-8000-000000000002"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "modern worker validator",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000001/sw.js",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "silent worker validator",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000002/sw.js",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "modern manifest",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000001/manifest.webmanifest",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "silent manifest",
      "path": "/d/aaaaaaaa-0000-4000-8000-000000000002/manifest.webmanifest",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "readiness reports every retained release",
      "path": "/readyz",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "readiness HEAD",
      "method": "HEAD",
      "path": "/readyz",
      "expect_status": 200
    }
  ]
}
