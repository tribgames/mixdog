{
  "id": "static_gate_public_assets",
  "description": "installability assets bypass the pairing gate; the app shell, other files and unknown tokens never do",
  "files": {
    "data": {
      "devices.json": "{\n  \"11111111-2222-4333-8444-555555555555\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"\",\n    \"clients\": {\n      \"bbbbbbbb\": {\n        \"tokenHash\": \"3490f80401886d12f3861ec190f5c16419b26345497a92bc4530e22f5d8b4295\",\n        \"name\": \"Phone\",\n        \"platform\": \"ios\",\n        \"browser\": \"safari\",\n        \"createdAt\": 1700000000000,\n        \"lastSeenAt\": 1700000000000\n      }\n    }\n  }\n}"
    },
    "renderer": {
      "index.html": "<!doctype html><meta name=\"mixdog-shell-version\" content=\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"><meta name=\"mixdog-shell-assets\" content=\"boot.js,manifest.webmanifest,sw.js\"><link rel=\"manifest\" href=\"manifest.webmanifest\"><script src=\"boot.js\"></script>",
      "boot.js": "window.mixdogBoot = true;\n",
      "manifest.webmanifest": "{\"id\":\"/\",\"name\":\"Mixdog\",\"start_url\":\"/\",\"scope\":\"/\",\"share_target\":{\"action\":\"/share-target\",\"method\":\"POST\"},\"icons\":[]}",
      "sw.js": "self.addEventListener(\"fetch\", () => {});\n",
      "mixdog-192.png": {
        "base64": "cG5n"
      },
      "mixdog-512.png": {
        "base64": "cG5nMg=="
      },
      "mixdog.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\"/>",
      "mixdog-logo-titanium.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\"/>"
    }
  },
  "steps": [
    {
      "do": "http",
      "label": "manifest",
      "path": "/manifest.webmanifest",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "icon 192",
      "path": "/mixdog-192.png",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "icon 512",
      "path": "/mixdog-512.png",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "svg",
      "path": "/mixdog.svg",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "titanium logo",
      "path": "/mixdog-logo-titanium.svg",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "root",
      "path": "/",
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "index",
      "path": "/index.html",
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "boot",
      "path": "/boot.js",
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "worker",
      "path": "/sw.js",
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "trailing slash on an exempt path",
      "path": "/mixdog-192.png/",
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "upper case exempt path",
      "path": "/MIXDOG-192.png",
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "HEAD manifest",
      "method": "HEAD",
      "path": "/manifest.webmanifest",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "HEAD index",
      "method": "HEAD",
      "path": "/index.html",
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "unknown query token",
      "path": "/index.html?token=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "unknown cookie token",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
        ]
      ],
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "known cookie token",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "known query token",
      "path": "/index.html?token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "an unknown query token beats a known cookie token",
      "path": "/index.html?token=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "bearer authorization is not a static credential",
      "path": "/index.html",
      "headers": [
        [
          "Authorization",
          "Bearer a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 401
    }
  ]
}
