{
  "id": "static_device_route",
  "description": "the device route opens the shell for a known desktop only, redirects to the trailing slash, scopes the manifest to the route and keeps escapes out",
  "files": {
    "data": {
      "devices.json": "{\n  \"11111111-2222-4333-8444-555555555555\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"\",\n    \"clients\": {\n      \"bbbbbbbb\": {\n        \"tokenHash\": \"3490f80401886d12f3861ec190f5c16419b26345497a92bc4530e22f5d8b4295\",\n        \"name\": \"Phone\",\n        \"platform\": \"ios\",\n        \"browser\": \"safari\",\n        \"createdAt\": 1700000000000,\n        \"lastSeenAt\": 1700000000000\n      }\n    }\n  },\n  \"66666666-7777-4888-8999-aaaaaaaaaaaa\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"\",\n    \"clients\": {}\n  }\n}"
    },
    "renderer": {
      "index.html": "<!doctype html><meta name=\"mixdog-shell-version\" content=\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"><meta name=\"mixdog-shell-assets\" content=\"boot.js,manifest.webmanifest,sw.js\"><link rel=\"manifest\" href=\"manifest.webmanifest\"><script src=\"boot.js\"></script>",
      "boot.js": "window.mixdogBoot = true;\n",
      "manifest.webmanifest": "{\"id\":\"/\",\"name\":\"Mixdog\",\"start_url\":\"/\",\"scope\":\"/\",\"share_target\":{\"action\":\"/share-target\",\"method\":\"POST\"},\"icons\":[]}",
      "sw.js": "self.addEventListener(\"fetch\", () => {});\n"
    }
  },
  "steps": [
    {
      "do": "http",
      "label": "no trailing slash redirects",
      "path": "/d/11111111-2222-4333-8444-555555555555",
      "expect_status": 301
    },
    {
      "do": "http",
      "label": "HEAD no trailing slash",
      "method": "HEAD",
      "path": "/d/11111111-2222-4333-8444-555555555555",
      "expect_status": 301
    },
    {
      "do": "http",
      "label": "a desktop this relay never registered",
      "path": "/d/cccccccc/",
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "unregistered, no trailing slash",
      "path": "/d/cccccccc",
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "the bare app shell",
      "path": "/",
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "the shell",
      "path": "/d/11111111-2222-4333-8444-555555555555/",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "index.html under the route",
      "path": "/d/11111111-2222-4333-8444-555555555555/index.html",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "boot.js under the route",
      "path": "/d/11111111-2222-4333-8444-555555555555/boot.js",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "manifest aimed at the route",
      "path": "/d/11111111-2222-4333-8444-555555555555/manifest.webmanifest",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "manifest HEAD",
      "method": "HEAD",
      "path": "/d/11111111-2222-4333-8444-555555555555/manifest.webmanifest",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "manifest with a query",
      "path": "/d/11111111-2222-4333-8444-555555555555/manifest.webmanifest?x=1",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "another desktop manifest",
      "path": "/d/66666666-7777-4888-8999-aaaaaaaaaaaa/manifest.webmanifest",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "a missing file under the route",
      "path": "/d/11111111-2222-4333-8444-555555555555/missing.js",
      "expect_status": 404
    },
    {
      "do": "http",
      "label": "an extension-less deep link is the shell",
      "path": "/d/11111111-2222-4333-8444-555555555555/deep/link",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "encoded escape under the route",
      "path": "/d/11111111-2222-4333-8444-555555555555/%2e%2e%2f%2e%2e%2fsecret",
      "expect_status": 403
    },
    {
      "do": "http",
      "label": "encoded slash escape",
      "path": "/d/11111111-2222-4333-8444-555555555555/..%2fsecret.txt",
      "expect_status": 403
    },
    {
      "do": "http",
      "label": "malformed percent-encoding",
      "path": "/d/11111111-2222-4333-8444-555555555555/%",
      "expect_status": 400
    },
    {
      "do": "http",
      "label": "not a routing id",
      "path": "/d/zz/",
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "upper-case hex is not a routing id",
      "path": "/d/ABCDEF12/",
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "POST to the route",
      "method": "POST",
      "path": "/d/11111111-2222-4333-8444-555555555555/",
      "body": "x",
      "expect_status": 405
    },
    {
      "do": "http",
      "label": "route with a known token cookie",
      "path": "/d/11111111-2222-4333-8444-555555555555/",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "route index, br offered",
      "path": "/d/11111111-2222-4333-8444-555555555555/index.html",
      "headers": [
        [
          "Accept-Encoding",
          "br, gzip"
        ]
      ],
      "expect_status": 200
    }
  ]
}
