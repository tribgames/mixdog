{
  "id": "static_path_escapes_and_percent_encoding",
  "description": "a path that leaves the renderer is a 403, a malformed percent-encoding is a 400 and the relay keeps serving",
  "files": {
    "data": {
      "devices.json": "{\n  \"11111111-2222-4333-8444-555555555555\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"\",\n    \"clients\": {\n      \"bbbbbbbb\": {\n        \"tokenHash\": \"3490f80401886d12f3861ec190f5c16419b26345497a92bc4530e22f5d8b4295\",\n        \"name\": \"Phone\",\n        \"platform\": \"ios\",\n        \"browser\": \"safari\",\n        \"createdAt\": 1700000000000,\n        \"lastSeenAt\": 1700000000000\n      }\n    }\n  }\n}"
    },
    "renderer": {
      "index.html": "<!doctype html><meta name=\"mixdog-shell-version\" content=\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"><meta name=\"mixdog-shell-assets\" content=\"boot.js,manifest.webmanifest,sw.js\"><link rel=\"manifest\" href=\"manifest.webmanifest\"><script src=\"boot.js\"></script>",
      "boot.js": "window.mixdogBoot = true;\n",
      "manifest.webmanifest": "{\"id\":\"/\",\"name\":\"Mixdog\",\"start_url\":\"/\",\"scope\":\"/\",\"share_target\":{\"action\":\"/share-target\",\"method\":\"POST\"},\"icons\":[]}",
      "sw.js": "self.addEventListener(\"fetch\", () => {});\n",
      "café.txt": "latte"
    }
  },
  "steps": [
    {
      "do": "http",
      "label": "encoded slash",
      "path": "/..%2fsecret.txt",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 403
    },
    {
      "do": "http",
      "label": "encoded dots and slash",
      "path": "/%2e%2e%2fsecret.txt",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 403
    },
    {
      "do": "http",
      "label": "encoded escape from a subdirectory",
      "path": "/assets/..%2f..%2fsecret.txt",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 403
    },
    {
      "do": "http",
      "label": "upper-case encoded slashes",
      "path": "/..%2F..%2F..%2Fetc%2Fpasswd",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 403
    },
    {
      "do": "http",
      "label": "dot segments are normalised by the request parser",
      "path": "/../secret.txt",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 404
    },
    {
      "do": "http",
      "label": "encoded dot segments",
      "path": "/%2e%2e/secret.txt",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 404
    },
    {
      "do": "http",
      "label": "dot segment inside the root",
      "path": "/assets/../index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "NUL byte in an extension-less path",
      "path": "/a%00b",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "NUL byte in a file name",
      "path": "/a%00.js",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 404
    },
    {
      "do": "http",
      "label": "lone percent",
      "path": "/%",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 400
    },
    {
      "do": "http",
      "label": "non-hex escape",
      "path": "/%ZZ",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 400
    },
    {
      "do": "http",
      "label": "truncated multibyte escape",
      "path": "/%E0%A4%A",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 400
    },
    {
      "do": "http",
      "label": "malformed without credentials",
      "path": "/%",
      "expect_status": 400
    },
    {
      "do": "http",
      "label": "media, lone percent",
      "path": "/media/%",
      "expect_status": 400
    },
    {
      "do": "http",
      "label": "media, non-hex escape",
      "path": "/media/%ZZ",
      "expect_status": 400
    },
    {
      "do": "http",
      "label": "trailing slash after a file",
      "path": "/index.html/",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 404
    },
    {
      "do": "http",
      "label": "a directory is the shell",
      "path": "/assets",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "a directory with a slash is the shell",
      "path": "/assets/",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "scheme-relative request target",
      "path": "//index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "scheme-relative request target with a host",
      "path": "//evil.example/x",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "encoded file name",
      "path": "/%69ndex.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "multibyte file name that does not exist",
      "path": "/%C3%A9.txt",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 404
    },
    {
      "do": "http",
      "label": "multibyte file name that exists",
      "path": "/caf%C3%A9.txt",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "still serving",
      "path": "/healthz",
      "expect_status": 200
    }
  ]
}
