{
  "id": "static_cookie_issue_and_refresh",
  "description": "the pairing cookie is issued only for a token the relay knows; the device cookie follows the route and is refreshed; cookies authenticate only same-origin, browser-initiated or top-level navigations and never an Origin: null request",
  "files": {
    "data": {
      "devices.json": "{\n  \"11111111-2222-4333-8444-555555555555\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"\",\n    \"clients\": {\n      \"bbbbbbbb\": {\n        \"tokenHash\": \"3490f80401886d12f3861ec190f5c16419b26345497a92bc4530e22f5d8b4295\",\n        \"name\": \"Phone\",\n        \"platform\": \"ios\",\n        \"browser\": \"safari\",\n        \"createdAt\": 1700000000000,\n        \"lastSeenAt\": 1700000000000\n      }\n    }\n  }\n}"
    },
    "renderer": {
      "index.html": "<!doctype html><meta name=\"mixdog-shell-version\" content=\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"><meta name=\"mixdog-shell-assets\" content=\"boot.js,manifest.webmanifest,sw.js\"><link rel=\"manifest\" href=\"manifest.webmanifest\"><script src=\"boot.js\"></script>",
      "boot.js": "window.mixdogBoot = true;\n",
      "manifest.webmanifest": "{\"id\":\"/\",\"name\":\"Mixdog\",\"start_url\":\"/\",\"scope\":\"/\",\"share_target\":{\"action\":\"/share-target\",\"method\":\"POST\"},\"icons\":[]}",
      "sw.js": "self.addEventListener(\"fetch\", () => {});\n"
    }
  },
  "steps": [
    {
      "do": "http",
      "label": "known token on a public asset sets the pairing cookie",
      "path": "/manifest.webmanifest?token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "unknown token on a public asset sets nothing",
      "path": "/manifest.webmanifest?token=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "empty token",
      "path": "/manifest.webmanifest?token=",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "cookie token sets nothing",
      "path": "/manifest.webmanifest",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "known token on the shell",
      "path": "/index.html?token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "known device cookie refreshes the device cookie",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_device=11111111-2222-4333-8444-555555555555"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "unknown device cookie",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_device=99999999-8888-4777-8666-555555555555"
        ]
      ],
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "device cookie that is not an id",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_device=nope"
        ]
      ],
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "both cookies in one answer",
      "path": "/index.html?token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
      "headers": [
        [
          "Cookie",
          "mixdog_device=11111111-2222-4333-8444-555555555555"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "cookie among others",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "foo=1; mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1; bar=2"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "percent-encoded cookie value",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=%611a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "malformed percent-encoding in the cookie",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=%E0%A4%A"
        ]
      ],
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "cookie name with different case",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "MIXDOG_TOKEN=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "an unknown cookie token",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
        ]
      ],
      "expect_status": 401
    },
    {
      "do": "http",
      "label": "the query token wins over an unknown cookie token",
      "path": "/index.html?token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
      "headers": [
        [
          "Cookie",
          "mixdog_token=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "cookie, no Fetch Metadata",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "cookie, same-origin cors",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ],
        [
          "Sec-Fetch-Site",
          "same-origin"
        ],
        [
          "Sec-Fetch-Mode",
          "cors"
        ],
        [
          "Sec-Fetch-Dest",
          "empty"
        ]
      ],
      "expect_status": 200
    },
    {
      "do": "http",
      "label": "cookie, browser-initiated navigation",
      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ],
        [
          "Sec-Fetch-Site",
          "none"
        ],
        [
          "Sec-Fetch-Mode",
          "navigate"
        ],
        [
          "Sec-Fetch-Dest",
          "document"
        ]
      ],
      "expect_status": 200
    },
