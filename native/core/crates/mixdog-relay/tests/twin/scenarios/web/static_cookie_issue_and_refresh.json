      "path": "/index.html",
      "headers": [
        [
          "Cookie",
          "mixdog_token=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        ],
        [
          "Origin",
          "null"
        ],
        [
          "Sec-Fetch-Site",
          "cross-site"
        ],
        [
          "Sec-Fetch-Mode",
          "cors"
        ],
        [
          "Sec-Fetch-Dest",
          "empty"
        ]
