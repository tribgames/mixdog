{
  "id": "ws_same_origin_closed_4005",
  "description": "/ws with the relay's own Origin upgrades and is closed 4005 (the pairing gate verify-release asserts)",
  "steps": [
    {
      "do": "ws_open",
      "path": "/ws",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "close": true,
      "close_code": 4005
    }
  ]
}
