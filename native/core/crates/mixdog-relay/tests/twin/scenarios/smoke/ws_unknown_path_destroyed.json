{
  "id": "ws_unknown_path_destroyed",
  "description": "an upgrade on a path the relay does not serve is destroyed without an answer",
  "steps": [
    {
      "do": "ws_open",
      "path": "/no-such-leg",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ]
    }
  ]
}
