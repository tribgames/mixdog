{
  "id": "ws_foreign_origin_refused",
  "description": "/ws with a foreign Origin is refused 403 (verify-release asserts it)",
  "steps": [
    {
      "do": "ws_open",
      "path": "/ws",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "https://deployment-probe.invalid"
        ]
      ],
      "expect_status": 403
    }
  ]
}
