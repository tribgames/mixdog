{
  "id": "a_close_the_relay_cannot_attribute_accuses_no_client",
  "description": "when the desktop leg closes 1009 after large frames from two phones, neither phone is accused and both are told only that the PC is gone",
  "knobs": {
    "maxFrameBytes": 1048576
  },
  "files": {
    "data": {
      "devices.json": "{\n  \"7c1f3a52-9b0e-4d6a-8e21-3f4c5d6e7a80\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"\",\n    \"clients\": {\n      \"aa000001\": {\n        \"tokenHash\": \"279cd67b2bd0b996ba5a22fae687eb6ccd06adcbcaa07fea061d6258afb81c5e\",\n        \"createdAt\": 1700000000000,\n        \"lastSeenAt\": 1700000000000\n      },\n      \"aa000002\": {\n        \"tokenHash\": \"186c2de72b30f5b52c97c52314c09da0e11898394b3edd6c412f418b99675dc2\",\n        \"createdAt\": 1700000000000,\n        \"lastSeenAt\": 1700000000000\n      }\n    }\n  }\n}"
    }
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "d",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "7c1f3a52-9b0e-4d6a-8e21-3f4c5d6e7a80",
        "0123456789abcdef"
      ]
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"desktop-lanes\",\"media\":false,\"maxPayloadBytes\":131072}"
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "ws_open",
      "conn": "p1",
      "path": "/ws?token=fe6159d6440d4f5592d04cebfd8cd527c86e60dea0a4b333666334f17023ca62",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ]
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1,
      "capture": [
        {
          "var": "c1",
          "from": "frame_json",
          "path": "clientId"
        }
      ]
    },
    {
      "do": "ws_open",
      "conn": "p2",
      "path": "/ws?token=e34199e1666994394f8d1f1a16e9824f404519c49b10df12541ee459bec4b81e",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ]
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1,
      "capture": [
        {
          "var": "c2",
          "from": "frame_json",
          "path": "clientId"
        }
      ]
    },
    {
      "do": "send",
      "conn": "p1",
      "frame": {
        "kind": "oversize",
        "op": "binary",
        "declared": 71680,
        "send": 71680
      }
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "send",
      "conn": "p2",
      "frame": {
        "kind": "oversize",
        "op": "binary",
        "declared": 102400,
        "send": 102400
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "close",
        "code": 1009
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 0,
      "close": true
    },
    {
      "do": "expect",
      "conn": "p1",
      "frames": 1
    },
    {
      "do": "expect",
      "conn": "p2",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "p1",
      "frame": {
        "kind": "text",
        "text": "{\"ping\":1}"
      }
    },
    {
      "do": "send",
      "conn": "p2",
      "frame": {
        "kind": "text",
        "text": "{\"ping\":1}"
      }
    },
    {
      "do": "expect",
      "conn": "p1",
      "frames": 1
    },
    {
      "do": "expect",
      "conn": "p2",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "p1",
      "frame": {
        "kind": "close",
        "code": 1000
      }
    },
    {
      "do": "expect",
      "conn": "p1",
      "frames": 0,
      "close": true
    },
    {
      "do": "wait",
      "ms": 60
    },
    {
      "do": "send",
      "conn": "p2",
      "frame": {
        "kind": "close",
        "code": 1000
      }
    },
    {
      "do": "expect",
      "conn": "p2",
      "frames": 0,
      "close": true
    }
  ]
}
