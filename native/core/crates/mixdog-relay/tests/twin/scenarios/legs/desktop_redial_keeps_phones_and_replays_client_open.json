{
  "id": "desktop_redial_keeps_phones_and_replays_client_open",
  "description": "the phone socket survives its desktop leg: it is told desktop-gone once, the replacement leg gets client-open again for the same id, and the challenge it sends re-arms the phone",
  "files": {
    "data": {
      "devices.json": "{\n  \"7c1f3a52-9b0e-4d6a-8e21-3f4c5d6e7a80\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"\",\n    \"clients\": {\n      \"bbbbbbbb\": {\n        \"tokenHash\": \"38298baa833bf3396a90bc4e29361fb2a84134e2b849e81945bc06d50cfa3bb6\",\n        \"createdAt\": 1700000000000,\n        \"lastSeenAt\": 1700000000000\n      }\n    }\n  }\n}"
    }
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "d1",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "7c1f3a52-9b0e-4d6a-8e21-3f4c5d6e7a80",
        "0123456789abcdef"
      ]
    },
    {
      "do": "expect",
      "conn": "d1",
      "frames": 2
    },
    {
      "do": "ws_open",
      "conn": "p",
      "path": "/ws?token=bd53b130de67fa56d48baf23e1992c3e0bc3e0c1d8e5183858dc10e77d7147f7",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ]
    },
    {
      "do": "expect",
      "conn": "d1",
      "frames": 1,
      "capture": [
        {
          "var": "cid",
          "from": "frame_json",
          "path": "clientId"
        }
      ]
    },
    {
      "do": "send",
      "conn": "d1",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"frame\",\"clientId\":\"${cid}\",\"data\":\"{\\\"challenge\\\":\\\"one\\\"}\"}"
      }
    },
    {
      "do": "expect",
      "conn": "p",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "d1",
      "frame": {
        "kind": "close",
        "code": 1000
      }
    },
    {
      "do": "expect",
      "conn": "d1",
      "frames": 0,
      "close": true
    },
    {
      "do": "expect",
      "conn": "p",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "p",
      "frame": {
        "kind": "text",
        "text": "{\"ping\":1}"
      }
    },
    {
      "do": "expect",
      "conn": "p",
      "frames": 1
    },
    {
      "do": "ws_open",
      "conn": "d2",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "7c1f3a52-9b0e-4d6a-8e21-3f4c5d6e7a80",
        "0123456789abcdef"
      ]
    },
    {
      "do": "expect",
      "conn": "d2",
      "frames": 3
    },
    {
      "do": "send",
      "conn": "d2",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"frame\",\"clientId\":\"${cid}\",\"data\":\"{\\\"challenge\\\":\\\"two\\\"}\"}"
      }
    },
    {
      "do": "expect",
      "conn": "p",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "p",
      "frame": {
        "kind": "text",
        "text": "{\"hello\":2}"
      }
    },
    {
      "do": "expect",
      "conn": "d2",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "d2",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"frame\",\"clientId\":\"${cid}\",\"data\":\"{\\\"ready\\\":2}\"}"
      }
    },
    {
      "do": "expect",
      "conn": "p",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "p",
      "frame": {
        "kind": "close",
        "code": 1000
      }
    },
    {
      "do": "expect",
      "conn": "p",
      "frames": 0,
      "close": true
    },
    {
      "do": "expect",
      "conn": "d2",
      "frames": 1
    },
    {
      "do": "wait",
      "ms": 60
    }
  ]
}
