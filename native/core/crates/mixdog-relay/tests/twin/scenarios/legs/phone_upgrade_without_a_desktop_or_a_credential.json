{
  "id": "phone_upgrade_without_a_desktop_or_a_credential",
  "description": "a device-wide or unknown token closes 4005 (rescan); a real credential with the desktop offline closes 4002 (retry); neither is a refused upgrade",
  "files": {
    "data": {
      "devices.json": "{\n  \"7c1f3a52-9b0e-4d6a-8e21-3f4c5d6e7a80\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"3eb1bd439947eb762998e566ccc2e099c791118b2f40579cc4f7da2b5061b7f9\",\n    \"clients\": {\n      \"bbbbbbbb\": {\n        \"tokenHash\": \"38298baa833bf3396a90bc4e29361fb2a84134e2b849e81945bc06d50cfa3bb6\",\n        \"createdAt\": 1700000000000,\n        \"lastSeenAt\": 1700000000000\n      }\n    }\n  }\n}"
    }
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "device_wide",
      "path": "/ws?token=0123456789abcdef0123456789abcdef",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ]
    },
    {
      "do": "expect",
      "conn": "device_wide",
      "frames": 0,
      "close": true,
      "close_code": 4005
    },
    {
      "do": "ws_open",
      "conn": "unknown",
      "path": "/ws?token=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ]
    },
    {
      "do": "expect",
      "conn": "unknown",
      "frames": 0,
      "close": true,
      "close_code": 4005
    },
    {
      "do": "ws_open",
      "conn": "none",
      "path": "/ws",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ]
    },
    {
      "do": "expect",
      "conn": "none",
      "frames": 0,
      "close": true,
      "close_code": 4005
    },
    {
      "do": "ws_open",
      "conn": "offline",
      "path": "/ws?token=bd53b130de67fa56d48baf23e1992c3e0bc3e0c1d8e5183858dc10e77d7147f7",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ]
    },
    {
      "do": "expect",
      "conn": "offline",
      "frames": 0,
      "close": true,
      "close_code": 4002
    },
    {
      "do": "ws_open",
      "conn": "foreign",
      "path": "/ws?token=bd53b130de67fa56d48baf23e1992c3e0bc3e0c1d8e5183858dc10e77d7147f7",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "http://evil.example"
        ]
      ]
    }
  ]
}
