{
  "id": "routing_both_ways_and_ping_answered_locally",
  "description": "text and binary routed phone to desktop and desktop to phone, broadcasts, unknown ids ignored, and a ping answered by the relay itself",
  "files": {
    "data": {
      "devices.json": "{\n  \"7c1f3a52-9b0e-4d6a-8e21-3f4c5d6e7a80\": {\n    \"secretHash\": \"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\",\n    \"clientTokenHash\": \"\",\n    \"clients\": {\n      \"bbbbbbbb\": {\n        \"tokenHash\": \"38298baa833bf3396a90bc4e29361fb2a84134e2b849e81945bc06d50cfa3bb6\",\n        \"createdAt\": 1700000000000,\n        \"lastSeenAt\": 1700000000000\n      }\n    }\n  }\n}"
    }
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "d",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "7c1f3a52-9b0e-4d6a-8e21-3f4c5d6e7a80",
        "0123456789abcdef"
      ]
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "ws_open",
      "conn": "p",
      "path": "/ws?token=bd53b130de67fa56d48baf23e1992c3e0bc3e0c1d8e5183858dc10e77d7147f7",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ]
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1,
      "capture": [
        {
          "var": "cid",
          "from": "frame_json",
          "path": "clientId"
        }
      ]
    },
    {
      "do": "send",
      "conn": "p",
      "frame": {
        "kind": "text",
        "text": "hello from the phone"
      }
    },
    {
      "do": "send",
      "conn": "p",
      "frame": {
        "kind": "binary",
        "data": "bin-from-phone"
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"frame\",\"clientId\":\"${cid}\",\"data\":\"hello from the desktop\"}"
      }
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"frame\",\"clientId\":\"00000000-0000-4000-8000-0000000000aa\",\"data\":\"nobody\"}"
      }
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "binary",
        "data": "MXR\u0001\u0000$${cid}bin-from-desktop"
      }
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "binary",
        "data": "MXR\u0001\u0001$${cid}bin-droppable"
      }
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"broadcast\",\"data\":\"to everyone\"}"
      }
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"broadcast\",\"critical\":true,\"data\":\"snapshot\"}"
      }
    },
    {
      "do": "expect",
      "conn": "p",
      "frames": 5
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"frame\",\"clientId\":\"x\",\"data\":5}"
      }
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "not json"
      }
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"mystery\"}"
      }
    },
    {
      "do": "send",
      "conn": "p",
      "frame": {
        "kind": "text",
        "text": "{\"ping\":1}"
      }
    },
    {
      "do": "send",
      "conn": "p",
      "frame": {
        "kind": "text",
        "text": "{\"ping\":2,\"extra\":\"field\"}"
      }
    },
    {
      "do": "send",
      "conn": "p",
      "frame": {
        "kind": "ping",
        "data": "pp"
      }
    },
    {
      "do": "expect",
      "conn": "p",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "p",
      "frame": {
        "kind": "text",
        "text": "after the ping"
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "p",
      "frame": {
        "kind": "close",
        "code": 1000
      }
    },
    {
      "do": "expect",
      "conn": "p",
      "frames": 0,
      "close": true
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "wait",
      "ms": 60
    }
  ]
}
