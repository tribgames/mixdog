{
  "id": "devices_across_runtimes",
  "description": "devices.json written by one runtime (a desktop, two browsers, a reported version) authenticates the same desktop and browsers in the other, and a browser revoked there stays revoked",
  "knobs": {
    "handshakeStallMs": 600000,
    "livenessProbeMs": 600000
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "d",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1",
        "secret-for-desktop-one-0001"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"set-client-token\",\"token\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}"
      }
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"desktop-version\",\"appVersion\":\"2.4.1\",\"rendererRelease\":\"3333333333333333333333333333333333333333333333333333333333333333\"}"
      }
    },
    {
      "do": "wait",
      "ms": 300
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register",
      "headers": [
        [
          "Origin",
          "${origin}"
        ],
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb1\",\"name\":\"Pixel 9\",\"platform\":\"Android\",\"browser\":\"Chrome\"}",
      "expect_status": 200,
      "capture": [
        {
          "var": "tokenP1",
          "from": "body_json",
          "path": "token"
        }
      ]
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register",
      "headers": [
        [
          "Origin",
          "${origin}"
        ],
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb2\",\"name\":\"NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN\",\"platform\":\"iOS\",\"browser\":\"Safari\"}",
      "expect_status": 200,
      "capture": [
        {
          "var": "tokenP2",
          "from": "body_json",
          "path": "token"
        }
      ]
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register",
      "headers": [
        [
          "Origin",
          "${origin}"
        ],
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer ${tokenP1}"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb1\",\"name\":\"Pixel 9 renamed\"}",
      "expect_status": 200
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register",
      "headers": [
        [
          "Origin",
          "${origin}"
        ],
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb3\"}",
      "expect_status": 401
    },
    {
      "do": "wait",
      "ms": 400
    },
    {
      "do": "crossover"
    },
    {
      "do": "http",
      "path": "/pair-code/support?deviceId=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1",
      "expect_status": 200
    },
    {
      "do": "ws_open",
      "conn": "d",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1",
        "secret-for-desktop-one-0001"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "ws_open",
      "conn": "w",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1",
        "another-secret-00000000"
      ],
      "expect_status": 401
    },
    {
      "do": "http",
      "path": "/pair-code/support?deviceId=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1",
      "expect_status": 200
    },
    {
      "do": "ws_open",
      "conn": "p1",
      "path": "/ws?token=${tokenP1}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "wait",
      "ms": 30
    },
    {
      "do": "ws_open",
      "conn": "p2",
      "path": "/ws?token=${tokenP2}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"list-clients\",\"requestId\":\"list-1\"}"
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"revoke-client\",\"requestId\":\"revoke-1\",\"clientId\":\"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb2\"}"
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "expect",
      "conn": "p2",
      "frames": 0,
      "close": true,
      "close_code": 4003
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register",
      "headers": [
        [
          "Origin",
          "${origin}"
        ],
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer ${tokenP2}"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb2\"}",
      "expect_status": 401
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register",
      "headers": [
        [
          "Origin",
          "${origin}"
        ],
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer ${tokenP1}"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb1\"}",
      "expect_status": 200
    },
    {
      "do": "ws_open",
      "conn": "p2b",
      "path": "/ws?token=${tokenP2}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "p2b",
      "frames": 0,
      "close": true,
      "close_code": 4005
    }
  ]
}
