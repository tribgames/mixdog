{
  "id": "device_revocation_across_runtimes",
  "description": "a device revoked in the runtime that did not register it is gone from devices.json for the runtime that starts next: its browser credential no longer registers or connects",
  "knobs": {
    "handshakeStallMs": 600000,
    "livenessProbeMs": 600000
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "d",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1",
        "secret-for-desktop-one-0001"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"set-client-token\",\"token\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}"
      }
    },
    {
      "do": "wait",
      "ms": 300
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register",
      "headers": [
        [
          "Origin",
          "${origin}"
        ],
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb1\",\"name\":\"Laptop\",\"platform\":\"Windows\",\"browser\":\"Edge\"}",
      "expect_status": 200,
      "capture": [
        {
          "var": "tokenP1",
          "from": "body_json",
          "path": "token"
        }
      ]
    },
    {
      "do": "crossover"
    },
    {
      "do": "ws_open",
      "conn": "d",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1",
        "secret-for-desktop-one-0001"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "ws_open",
      "conn": "p1",
      "path": "/ws?token=${tokenP1}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"revoke-device\"}"
      }
    },
    {
      "do": "expect",
      "conn": "p1",
      "frames": 0,
      "close": true,
      "close_code": 4003
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1,
      "close": true,
      "close_code": 4003
    },
    {
      "do": "restart"
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register",
      "headers": [
        [
          "Origin",
          "${origin}"
        ],
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer ${tokenP1}"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb1\"}",
      "expect_status": 401
    },
    {
      "do": "ws_open",
      "conn": "p1b",
      "path": "/ws?token=${tokenP1}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "p1b",
      "frames": 0,
      "close": true,
      "close_code": 4005
    },
    {
      "do": "ws_open",
      "conn": "d",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1",
        "secret-for-desktop-one-0001"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    }
  ]
}
