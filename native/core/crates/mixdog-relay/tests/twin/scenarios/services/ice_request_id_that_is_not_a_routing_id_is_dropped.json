{
  "id": "ice_request_id_that_is_not_a_routing_id_is_dropped",
  "description": "a request whose id is not a routing id, or is absent, gets no answer and is never truncated or echoed",
  "knobs": {
    "turnEnv": {
      "TURN_AUTH_SECRET": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "TURN_HOST": "relay.example.com",
      "TURN_TLS_PORT": "5349",
      "TURN_ISSUE_LIMIT": "3"
    }
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "d",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "dddddddd-1111-4111-8111-000000000001",
        "0123456789abcdef"
      ],
      "expect_status": 101,
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "coalesced",
        "frames": [
          {
            "kind": "text",
            "text": "{\"type\":\"ice-servers-request\",\"requestId\":\"\"}"
          },
          {
            "kind": "text",
            "text": "{\"type\":\"ice-servers-request\",\"requestId\":\"not a routing id\"}"
          },
          {
            "kind": "text",
            "text": "{\"type\":\"ice-servers-request\",\"requestId\":5}"
          },
          {
            "kind": "text",
            "text": "{\"type\":\"ice-servers-request\"}"
          },
          {
            "kind": "text",
            "text": "{\"type\":\"list-clients\",\"requestId\":\"barrier\"}"
          }
        ]
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    }
  ]
}
