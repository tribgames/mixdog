{
  "id": "hook_forwarded_frame_and_agent_timeout",
  "description": "a webhook is replayed to the agent as one http frame (method, path and query, headers minus the hop-by-hop ones, base64 body) and an agent that never answers is 504 after 30 s",
  "steps": [
    {
      "do": "ws_open",
      "conn": "h",
      "path": "/hookleg",
      "role": "hook",
      "basic": [
        "dddddddd-1111-4111-8111-000000000001",
        "0123456789abcdef"
      ],
      "expect_status": 101,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/hook/dddddddd-1111-4111-8111-000000000001/github/push?delivery=1&x=%20y",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "X-Hub-Signature-256",
          "sha256=0123abcd"
        ],
        [
          "X-Custom",
          "kept"
        ],
        [
          "Keep-Alive",
          "timeout=5"
        ],
        [
          "TE",
          "trailers"
        ]
      ],
      "body": "{\"zen\":\"Keep it logically awesome.\",\"bytes\":\"é\"}",
      "expect_status": 504,
      "close_probe_ms": 100,
      "timeout_ms": 40000
    },
    {
      "do": "expect",
      "conn": "h",
      "frames": 1
    }
  ]
}
