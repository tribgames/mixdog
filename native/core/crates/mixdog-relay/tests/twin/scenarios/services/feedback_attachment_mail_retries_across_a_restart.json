{
  "id": "feedback_attachment_mail_retries_across_a_restart",
  "description": "a record whose send failed is on disk with its attachment and attempt count; the relay that starts next sends it with identical bytes once it is due",
  "knobs": {
    "feedbackOptions": {
      "baseDelayMs": 150,
      "maxDelayMs": 300
    }
  },
  "fakes": {
    "feedbackSender": {
      "answers": [
        {
          "throw": "smtp down"
        },
        {}
      ]
    }
  },
  "steps": [
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \",\"attachments\":[{\"name\":\"shot.png\",\"mimeType\":\"image/png\",\"data\":\"iVBORw0KGgoHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBw==\"}]}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "wait",
      "ms": 60
    },
    {
      "do": "restart"
    },
    {
      "do": "wait",
      "ms": 1200
    },
    {
      "do": "http",
      "label": "the id is still known",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \",\"attachments\":[{\"name\":\"shot.png\",\"mimeType\":\"image/png\",\"data\":\"iVBORw0KGgoHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBw==\"}]}",
      "expect_status": 202,
      "close_probe_ms": 100
    }
  ]
}
