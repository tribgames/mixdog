{
  "id": "feedback_rate_limit_per_address",
  "description": "the address that has used its allowance is 429 rate_limited, valid or not",
  "knobs": {
    "feedbackOptions": {
      "ipLimit": 3,
      "globalLimit": 1000
    }
  },
  "fakes": {
    "feedbackSender": {
      "answers": []
    }
  },
  "steps": [
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"22222222-2222-4222-8222-222222222222\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"33333333-3333-4333-8333-333333333333\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"44444444-4444-4444-8444-444444444444\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 429,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "not json",
      "expect_status": 429,
      "close_probe_ms": 100
    },
    {
      "do": "wait",
      "ms": 150
    }
  ]
}
