{
  "id": "ice_unpaired_device_is_refused",
  "description": "a desktop with no paired phone is refused not-paired with only the public STUN list and no credential; the relay advertises ice",
  "knobs": {
    "turnEnv": {
      "TURN_AUTH_SECRET": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "TURN_HOST": "relay.example.com",
      "TURN_TLS_PORT": "5349",
      "TURN_ISSUE_LIMIT": "3"
    }
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "d",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "dddddddd-1111-4111-8111-000000000001",
        "0123456789abcdef"
      ],
      "expect_status": 101,
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"ice-servers-request\",\"requestId\":\"00000000-0000-4000-8000-000000000001\"}"
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"ice-servers-request\",\"requestId\":\"00000000-0000-4000-8000-000000000002\"}"
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    }
  ]
}
