{
  "id": "feedback_validation_refusals",
  "description": "bodies that are not valid feedback are 400 invalid_feedback and store nothing; other methods are 405 and other content types 415",
  "knobs": {
    "feedbackOptions": {
      "ipLimit": 100
    }
  },
  "fakes": {
    "feedbackSender": {
      "answers": []
    }
  },
  "steps": [
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "not json",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "[]",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "null",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"nope\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"x\",\"message\":\"  it broke  \"}",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"   \"}",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":5}",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"\"}",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \",\"replyTo\":\"not-an-email\"}",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \",\"replyTo\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@b.co\"}",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \",\"replyTo\":5}",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \",\"replyTo\":null}",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "label": "8000 characters is the ceiling",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"\"}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "path": "/feedback",
      "expect_status": 405,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "PUT",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{}",
      "expect_status": 405,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "DELETE",
      "path": "/feedback",
      "expect_status": 405,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "text/plain"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 415,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "label": "no content type",
      "method": "POST",
      "path": "/feedback",
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 415,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "label": "the media type is matched without case and with parameters",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "Application/JSON ; charset=utf-8"
        ]
      ],
      "body": "{\"id\":\"22222222-2222-4222-8222-222222222222\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "wait",
      "ms": 150
    }
  ]
}
