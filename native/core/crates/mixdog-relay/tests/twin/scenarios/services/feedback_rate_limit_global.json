{
  "id": "feedback_rate_limit_global",
  "description": "the global allowance applies across clients",
  "knobs": {
    "feedbackOptions": {
      "ipLimit": 100,
      "globalLimit": 2
    }
  },
  "fakes": {
    "feedbackSender": {
      "answers": []
    }
  },
  "steps": [
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"22222222-2222-4222-8222-222222222222\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"33333333-3333-4333-8333-333333333333\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 429,
      "close_probe_ms": 100
    },
    {
      "do": "wait",
      "ms": 150
    }
  ]
}
