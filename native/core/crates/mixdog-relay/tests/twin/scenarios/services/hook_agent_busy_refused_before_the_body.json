{
  "id": "hook_agent_busy_refused_before_the_body",
  "description": "a leg that holds as many webhooks as the relay allows is answered 503 agent busy with Retry-After 1, the body unread",
  "knobs": {
    "maxHookPending": 0
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "h",
      "path": "/hookleg",
      "role": "hook",
      "basic": [
        "dddddddd-1111-4111-8111-000000000001",
        "0123456789abcdef"
      ],
      "expect_status": 101,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/hook/dddddddd-1111-4111-8111-000000000001/x",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{}",
      "expect_status": 503,
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "h",
      "frames": 0
    }
  ]
}
