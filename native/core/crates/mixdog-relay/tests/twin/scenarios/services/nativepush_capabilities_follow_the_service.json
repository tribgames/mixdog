{
  "id": "nativepush_capabilities_follow_the_service",
  "description": "the capabilities frame announces native push and its platforms only when the relay can deliver",
  "fakes": {
    "nativePush": {
      "platforms": [
        "apns"
      ],
      "answers": []
    }
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "d",
