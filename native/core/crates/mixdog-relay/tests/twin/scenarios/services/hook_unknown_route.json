{
  "id": "hook_unknown_route",
  "description": "a /hook path that names no routing id is 404 before any leg or limiter is consulted",
  "steps": [
    {
      "do": "http",
      "path": "/hook/nope",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "path": "/hook/",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "path": "/hook/ABCDEF12-0000-4000-8000-000000000000/x",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "label": "a short hexadecimal id is a routing id",
      "path": "/hook/aaaaaaaa/",
      "expect_status": 503,
      "close_probe_ms": 100
    }
  ]
}
