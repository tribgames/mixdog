{
  "id": "media_refusals_before_the_desktop_is_asked",
  "description": "a media request is refused by the relay itself: method, malformed path, unknown variant, malformed session label or scheme marker, no credential",
  "steps": [
    {
      "do": "ws_open",
      "conn": "d",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "dddddddd-1111-4111-8111-000000000001",
        "0123456789abcdef"
      ],
      "expect_status": 101,
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/claim",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"deviceId\":\"dddddddd-1111-4111-8111-000000000001\",\"clientId\":\"cccccccc-1111-4111-8111-000000000001\",\"publicKey\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"}",
      "expect_status": 202,
      "capture": [
        {
          "var": "claimId",
          "from": "body_json",
          "path": "claimId"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"claim-approve\",\"claimId\":\"${claimId}\"}"
      }
    },
    {
      "do": "wait",
      "ms": 200
    },
    {
      "do": "http",
      "path": "/claim/${claimId}",
      "expect_status": 200,
      "capture": [
        {
          "var": "token",
          "from": "body_json",
          "path": "token"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"desktop-lanes\",\"media\":true}"
      }
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/media/0123456789abcdef",
      "expect_status": 405,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "PUT",
      "path": "/media/0123456789abcdef",
      "expect_status": 405,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "label": "percent decoding fails",
      "path": "/media/%",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "label": "no credential",
      "path": "/media/0123456789abcdef?variant=display",
      "expect_status": 401,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "label": "unknown credential",
      "path": "/media/0123456789abcdef?variant=display&token=ffffffffffffffffffffffffffffffff",
      "expect_status": 401,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "path": "/media/0123456789abcdef?variant=bogus&token=${token}",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "path": "/media/nothex?variant=display&token=${token}",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "path": "/media/0123456789abcdef?variant=display&sid=short&token=${token}",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "path": "/media/0123456789abcdef?variant=display&enc=%20%20&token=${token}",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "path": "/media/0123456789abcdef?variant=display&sid=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA&enc=toolongenoughtobeinvalid&token=${token}",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 0
    }
  ]
}
