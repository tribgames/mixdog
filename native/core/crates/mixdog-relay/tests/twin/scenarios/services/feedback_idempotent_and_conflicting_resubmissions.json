{
  "id": "feedback_idempotent_and_conflicting_resubmissions",
  "description": "the same id with the same payload is 202 again, a different message or kind is 409 conflict, nothing is mailed twice",
  "fakes": {
    "feedbackSender": {
      "answers": []
    }
  },
  "steps": [
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "wait",
      "ms": 250
    },
    {
      "do": "http",
      "label": "the text is trimmed before it is compared",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"it broke\"}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"other\"}",
      "expect_status": 409,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"other\",\"message\":\"  it broke  \"}",
      "expect_status": 409,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \",\"replyTo\":\"a@b.co\"}",
      "expect_status": 409,
      "close_probe_ms": 100
    },
    {
      "do": "wait",
      "ms": 150
    }
  ]
}
