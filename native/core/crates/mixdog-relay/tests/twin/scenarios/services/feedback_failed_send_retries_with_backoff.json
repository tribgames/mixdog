{
  "id": "feedback_failed_send_retries_with_backoff",
  "description": "a failed send is retried after the backoff and the record keeps its attempt count until it is mailed",
  "knobs": {
    "feedbackOptions": {
      "baseDelayMs": 40,
      "maxDelayMs": 80
    }
  },
  "fakes": {
    "feedbackSender": {
      "answers": [
        {
          "throw": "smtp down",
          "code": "ECONNREFUSED"
        },
        {
          "throw": "smtp down"
        },
        {}
      ]
    }
  },
  "steps": [
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "wait",
      "ms": 900
    }
  ]
}
