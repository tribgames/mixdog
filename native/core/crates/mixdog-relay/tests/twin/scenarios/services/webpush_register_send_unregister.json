{
  "id": "webpush_register_send_unregister",
  "description": "a browser registers with its PC, the PC is told the set and sends through it: the relay signs with its VAPID key and forwards the ciphertext; a send for a binding the PC does not hold is refused",
  "files": {
    "data": {
      "webpush-vapid.json": "{\n  \"version\": 1,\n  \"publicKey\": \"BPxBd1ahXCTe-q001mNPhEU8JcDwByuASgyDRlPeGD5Czy9B3-OCgRyM8qqfFmm7DESpc87614NOR1pRVEVxEmY\",\n  \"privateKeyJwk\": {\n    \"kty\": \"EC\",\n    \"x\": \"_EF3VqFcJN76rTTWY0-ERTwlwPAHK4BKDINGU94YPkI\",\n    \"y\": \"zy9B3-OCgRyM8qqfFmm7DESpc87614NOR1pRVEVxEmY\",\n    \"crv\": \"P-256\",\n    \"d\": \"2QZwDAiit22CA2-vF9GmfcwkMpQMfisVKdk_ujisRgc\"\n  }\n}"
    }
  },
  "fakes": {
    "webPushFetch": {
      "answers": [
        {
          "status": 201
        }
      ]
    }
  },
  "keys": {
    "vapid_public": [
      "BPxBd1ahXCTe-q001mNPhEU8JcDwByuASgyDRlPeGD5Czy9B3-OCgRyM8qqfFmm7DESpc87614NOR1pRVEVxEmY"
    ]
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "d",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "dddddddd-1111-4111-8111-000000000001",
        "0123456789abcdef"
      ],
      "expect_status": 101,
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/claim",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"deviceId\":\"dddddddd-1111-4111-8111-000000000001\",\"clientId\":\"cccccccc-1111-4111-8111-000000000001\",\"publicKey\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"}",
      "expect_status": 202,
      "capture": [
        {
          "var": "claimId",
          "from": "body_json",
          "path": "claimId"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"claim-approve\",\"claimId\":\"${claimId}\"}"
      }
    },
    {
      "do": "wait",
      "ms": 200
    },
    {
      "do": "http",
      "path": "/claim/${claimId}",
      "expect_status": 200,
      "capture": [
        {
          "var": "token",
          "from": "body_json",
          "path": "token"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"webpush-ready\"}"
      }
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "http",
      "label": "a PC that delivers through the relay",
      "method": "POST",
      "path": "/webpush/status",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer ${token}"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/webpush/register",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer ${token}"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"endpoint\":\"https://fcm.googleapis.com/fcm/send/subscription-1\",\"sealed\":{\"version\":1,\"ephemeralPublicKey\":\"Baaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"nonce\":\"nnnnnnnnnnnnnnnn\",\"ciphertext\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/webpush/status",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer ${token}"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"endpoint\":\"https://fcm.googleapis.com/fcm/send/subscription-1\"}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "label": "an unchanged registration announces nothing",
      "method": "POST",
      "path": "/webpush/register",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer ${token}"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"endpoint\":\"https://fcm.googleapis.com/fcm/send/subscription-1\",\"sealed\":{\"version\":1,\"ephemeralPublicKey\":\"Baaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"nonce\":\"nnnnnnnnnnnnnnnn\",\"ciphertext\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"webpush-send\",\"endpoint\":\"https://fcm.googleapis.com/fcm/send/subscription-1\",\"clientId\":\"cccccccc-1111-4111-8111-000000000001\",\"payload\":\"Y2lwaGVydGV4dC1mcm9tLWE\",\"ttl\":60,\"urgency\":\"low\",\"topic\":\"turn-1\"}"
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"webpush-send\",\"endpoint\":\"https://fcm.googleapis.com/fcm/send/subscription-1\",\"clientId\":\"cccccccc-2222-4222-8222-000000000002\",\"payload\":\"Y2lwaGVydGV4dC1mcm9tLWE\"}"
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"webpush-send\",\"endpoint\":\"https://fcm.googleapis.com/fcm/send/other\",\"clientId\":\"cccccccc-1111-4111-8111-000000000001\",\"payload\":\"Y2lwaGVydGV4dC1mcm9tLWE\"}"
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/webpush/unregister",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer ${token}"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"endpoint\":\"https://fcm.googleapis.com/fcm/send/subscription-1\"}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"webpush-send\",\"endpoint\":\"https://fcm.googleapis.com/fcm/send/subscription-1\",\"clientId\":\"cccccccc-1111-4111-8111-000000000001\",\"payload\":\"Y2lwaGVydGV4dC1mcm9tLWE\"}"
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "http",
      "label": "already removed",
      "method": "POST",
      "path": "/webpush/unregister",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer ${token}"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"endpoint\":\"https://fcm.googleapis.com/fcm/send/subscription-1\"}",
      "expect_status": 200,
      "close_probe_ms": 100
    }
  ]
}
