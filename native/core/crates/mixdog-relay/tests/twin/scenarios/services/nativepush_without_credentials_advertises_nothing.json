{
  "id": "nativepush_without_credentials_advertises_nothing",
  "description": "a relay with no APNs or FCM credentials advertises no native push and ignores its frames without an answer",
  "knobs": {
    "nativePushEnv": {}
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "d",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "dddddddd-1111-4111-8111-000000000001",
        "0123456789abcdef"
      ],
      "expect_status": 101,
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/claim",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"deviceId\":\"dddddddd-1111-4111-8111-000000000001\",\"clientId\":\"cccccccc-1111-4111-8111-000000000001\",\"publicKey\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"}",
      "expect_status": 202,
      "capture": [
        {
          "var": "claimId",
          "from": "body_json",
          "path": "claimId"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"claim-approve\",\"claimId\":\"${claimId}\"}"
      }
    },
    {
      "do": "wait",
      "ms": 200
    },
    {
      "do": "http",
      "path": "/claim/${claimId}",
      "expect_status": 200,
      "capture": [
        {
          "var": "token",
          "from": "body_json",
          "path": "token"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "coalesced",
        "frames": [
          {
            "kind": "text",
            "text": "{\"type\":\"native-push-bind\",\"clientId\":\"cccccccc-1111-4111-8111-000000000001\",\"platform\":\"apns\",\"token\":\"abababababababababababababababababababababababababababababababab\"}"
          },
          {
            "kind": "text",
            "text": "{\"type\":\"native-push\",\"platform\":\"apns\",\"token\":\"abababababababababababababababababababababababababababababababab\",\"mx\":\"bXg\",\"reason\":\"turn-finished\",\"collapseKey\":\"c1\",\"sandbox\":false}"
          }
        ]
      }
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"list-clients\",\"requestId\":\"barrier\"}"
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    }
  ]
}
