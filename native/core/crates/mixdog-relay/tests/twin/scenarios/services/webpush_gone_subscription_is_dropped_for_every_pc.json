      "body": "{\"endpoint\":\"https://fcm.googleapis.com/fcm/send/subscription-1\",\"sealed\":{\"version\":1,\"ephemeralPublicKey\":\"Bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"nonce\":\"nnnnnnnnnnnnnnnn\",\"ciphertext\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "a",
      "frames": 1
    },
    {
      "do": "expect",
      "conn": "b",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "a",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"webpush-send\",\"endpoint\":\"https://fcm.googleapis.com/fcm/send/subscription-1\",\"clientId\":\"cccccccc-1111-4111-8111-000000000001\",\"payload\":\"Y2lwaGVydGV4dC1mcm9tLWE\"}"
      }
    },
    {
      "do": "expect",
      "conn": "a",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "a",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"webpush-send\",\"endpoint\":\"https://fcm.googleapis.com/fcm/send/subscription-1\",\"clientId\":\"cccccccc-2222-4222-8222-000000000002\",\"payload\":\"Y2lwaGVydGV4dC1mcm9tLWE\"}"
      }
    },
    {
      "do": "expect",
      "conn": "a",
      "frames": 1
