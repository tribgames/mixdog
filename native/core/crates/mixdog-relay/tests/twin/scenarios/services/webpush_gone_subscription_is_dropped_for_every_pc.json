    {
      "do": "http",
      "method": "POST",
      "path": "/webpush/register",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Authorization",
          "Bearer ${tokenB}"
        ],
        [
          "Origin",
          "${origin}"
        ]
