{
  "id": "feedback_pending_attachment_bytes_are_capped",
  "description": "undelivered attachment bytes are bounded: a submission that would exceed the bound is 503 feedback_busy, one without attachments is not",
  "knobs": {
    "feedbackOptions": {
      "maxPendingAttachmentBytes": 100,
      "baseDelayMs": 600000,
      "maxDelayMs": 600000
    }
  },
  "fakes": {
    "feedbackSender": {
      "answers": [
        {
          "throw": "smtp down"
        }
      ]
    }
  },
  "steps": [
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \",\"attachments\":[{\"name\":\"a.png\",\"mimeType\":\"image/png\",\"data\":\"iVBORw0KGgoHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBw==\"}]}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "wait",
      "ms": 200
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"22222222-2222-4222-8222-222222222222\",\"kind\":\"bug\",\"message\":\"  it broke  \",\"attachments\":[{\"name\":\"b.png\",\"mimeType\":\"image/png\",\"data\":\"iVBORw0KGgoHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBw==\"}]}",
      "expect_status": 503,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"33333333-3333-4333-8333-333333333333\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 202,
      "close_probe_ms": 100
    }
  ]
}
