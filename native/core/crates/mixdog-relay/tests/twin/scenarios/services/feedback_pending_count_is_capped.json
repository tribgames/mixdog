{
  "id": "feedback_pending_count_is_capped",
  "description": "a relay holding as many undelivered records as it allows answers 503 feedback_busy, and a known id is still 202",
  "knobs": {
    "feedbackOptions": {
      "maxPending": 2,
      "baseDelayMs": 600000,
      "maxDelayMs": 600000
    }
  },
  "fakes": {
    "feedbackSender": {
      "answers": [
        {
          "throw": "smtp down"
        }
      ]
    }
  },
  "steps": [
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"22222222-2222-4222-8222-222222222222\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 202,
      "close_probe_ms": 100
    },
    {
      "do": "wait",
      "ms": 200
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"33333333-3333-4333-8333-333333333333\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 503,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "label": "a known id is not a new record",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 202,
      "close_probe_ms": 100
    }
  ]
}
