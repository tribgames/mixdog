{
  "id": "feedback_storage_unavailable_is_503",
  "description": "a feedback directory that cannot be created leaves the relay serving and every submission 503",
  "files": {
    "data": {
      "feedback": "a file where the directory belongs"
    }
  },
  "fakes": {
    "feedbackSender": {
      "answers": []
    }
  },
  "steps": [
    {
      "do": "http",
      "method": "POST",
      "path": "/feedback",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "body": "{\"id\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"bug\",\"message\":\"  it broke  \"}",
      "expect_status": 503,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "path": "/healthz",
      "expect_status": 200,
      "close_probe_ms": 100
    }
  ]
}
