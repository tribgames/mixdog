{
  "id": "media_health_follows_the_desktop_lane",
  "description": "/media/healthz answers for the desktop that would produce the bytes: ok with the lane, unsupported without it",
  "steps": [
    {
      "do": "ws_open",
      "conn": "d",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "dddddddd-1111-4111-8111-000000000001",
        "0123456789abcdef"
      ],
      "expect_status": 101,
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 2
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/claim",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"deviceId\":\"dddddddd-1111-4111-8111-000000000001\",\"clientId\":\"cccccccc-1111-4111-8111-000000000001\",\"publicKey\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"}",
      "expect_status": 202,
      "capture": [
        {
          "var": "claimId",
          "from": "body_json",
          "path": "claimId"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "d",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"claim-approve\",\"claimId\":\"${claimId}\"}"
      }
    },
    {
      "do": "wait",
      "ms": 200
    },
    {
      "do": "http",
      "path": "/claim/${claimId}",
      "expect_status": 200,
      "capture": [
        {
          "var": "token",
          "from": "body_json",
          "path": "token"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "label": "a desktop that never declared the lane",
      "path": "/media/healthz?token=${token}",
      "expect_status": 503,
      "close_probe_ms": 100
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"desktop-lanes\",\"media\":true}"
      }
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "http",
      "label": "the lane declared",
      "path": "/media/healthz?token=${token}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "send",
      "conn": "d",
      "frame": {
        "kind": "close",
        "code": 1000
      }
    },
    {
      "do": "expect",
      "conn": "d",
      "close": true
    },
    {
      "do": "http",
      "label": "the desktop gone",
      "path": "/media/healthz?token=${token}",
      "expect_status": 503,
      "close_probe_ms": 100
    }
  ]
}
