{
  "id": "ws_gate_credentials",
  "description": "/ws needs a same-origin upgrade and a per-browser credential: the desktop pairing token, an unknown token and no token are closed 4005, a foreign or missing Origin is 403, a real credential joins the desktop that is online and is closed 4002 when it is offline",
  "knobs": {
    "handshakeStallMs": 600000,
    "livenessProbeMs": 600000
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "dA",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-00000000000a",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"set-client-token\",\"token\":\"fedcba9876543210\"}"
      }
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register?token=fedcba9876543210",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb\",\"name\":\"Android · Chrome\",\"platform\":\"Android\",\"browser\":\"Chrome\"}",
      "expect_status": 200,
      "capture": [
        {
          "var": "browser",
          "from": "body_json",
          "path": "token"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "ws_open",
      "conn": "legacy",
      "path": "/ws?token=fedcba9876543210",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "legacy",
      "close": true,
      "close_code": 4005
    },
    {
      "do": "ws_open",
      "conn": "unknown",
      "path": "/ws?token=0123456789abcdef0123456789abcdef",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "unknown",
      "close": true,
      "close_code": 4005
    },
    {
      "do": "ws_open",
      "conn": "none",
      "path": "/ws",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "none",
      "close": true,
      "close_code": 4005
    },
    {
      "do": "ws_open",
      "conn": "foreign",
      "path": "/ws?token=${browser}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "https://deployment-probe.invalid"
        ]
      ],
      "expect_status": 403
    },
    {
      "do": "ws_open",
      "conn": "deep",
      "path": "/ws?token=${browser}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}/x"
        ]
      ],
      "expect_status": 403
    },
    {
      "do": "ws_open",
      "conn": "noorigin",
      "path": "/ws?token=${browser}",
      "role": "phone",
      "expect_status": 403
    },
    {
      "do": "ws_open",
      "conn": "joined",
      "path": "/ws?token=${browser}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "close",
        "code": 1000
      }
    },
    {
      "do": "expect",
      "conn": "dA",
      "close": true
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "ws_open",
      "conn": "offline",
      "path": "/ws?token=${browser}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "offline",
      "close": true,
      "close_code": 4002
    }
  ]
}
