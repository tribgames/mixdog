{
  "id": "desktop_registration_rate_limit",
  "description": "only five new ids are minted per source in the window; a known device redialing is free",
  "steps": [
    {
      "do": "ws_open",
      "conn": "n1",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-000000000011",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "ws_open",
      "conn": "n2",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-000000000021",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "ws_open",
      "conn": "n3",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-000000000031",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "ws_open",
      "conn": "n4",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-000000000041",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "ws_open",
      "conn": "n5",
      "path": "/desktop",
