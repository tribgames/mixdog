{
  "id": "pair_code_resolve_bad_requests",
  "description": "oversize bodies are 400, a malformed code 404, a foreign Origin 403; the phone app origins (https://localhost, capacitor://localhost) get their CORS headers and nobody else; /connect is the pairing page with its CSP",
  "steps": [
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/resolve",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"code\":\"\"}",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/resolve",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/resolve",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"code\":\"abc\"}",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/resolve",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{}",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/resolve",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "https://evil.example"
        ]
      ],
      "body": "{\"code\":\"123456\"}",
      "expect_status": 403,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/resolve",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "capacitor://localhost"
        ]
      ],
      "body": "{\"code\":\"123456\"}",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/resolve",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "https://localhost"
        ]
      ],
      "body": "{\"code\":\"123456\"}",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "OPTIONS",
      "path": "/pair-code/resolve",
      "headers": [
        [
          "Origin",
          "https://localhost"
        ]
      ],
      "expect_status": 204,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "OPTIONS",
      "path": "/pair-code/resolve",
      "headers": [
        [
          "Origin",
          "capacitor://localhost"
        ]
      ],
      "expect_status": 204,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "OPTIONS",
      "path": "/pair-code/resolve",
      "headers": [
        [
          "Origin",
          "https://evil.example"
        ]
      ],
      "expect_status": 204,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "OPTIONS",
      "path": "/pair-code/resolve",
      "expect_status": 204,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/pair-code/resolve",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/unknown",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{}",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/connect",
      "expect_status": 200,
      "close_probe_ms": 100
    }
  ]
}
