{
  "id": "browser_credentials_isolated_and_revocable",
  "description": "browser credentials are per desktop and individually revocable: each desktop lists and revokes only its own browsers, a revoked credential is refused at /ws and /client/register, the others and a restart keep the rest",
  "knobs": {
    "handshakeStallMs": 600000,
    "livenessProbeMs": 600000
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "dA",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-00000000000a",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 2
    },
    {
      "do": "ws_open",
      "conn": "dB",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "b1b2c3d4-0000-4000-8000-00000000000b",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dB",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"set-client-token\",\"token\":\"fedcba9876543210\"}"
      }
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "send",
      "conn": "dB",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"set-client-token\",\"token\":\"0123456789fedcba\"}"
      }
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register?token=fedcba9876543210",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb\",\"name\":\"Android · Chrome\",\"platform\":\"Android\",\"browser\":\"Chrome\"}",
      "expect_status": 200,
      "capture": [
        {
          "var": "a1",
          "from": "body_json",
          "path": "token"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register?token=fedcba9876543210",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"clientId\":\"cccccccc\",\"name\":\"Android · Chrome\",\"platform\":\"Android\",\"browser\":\"Chrome\"}",
      "expect_status": 200,
      "capture": [
        {
          "var": "a2",
          "from": "body_json",
          "path": "token"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register?token=0123456789fedcba",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"clientId\":\"dddddddd\",\"name\":\"Android · Chrome\",\"platform\":\"Android\",\"browser\":\"Chrome\"}",
      "expect_status": 200,
      "capture": [
        {
          "var": "b1",
          "from": "body_json",
          "path": "token"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "ws_open",
      "conn": "pA1",
      "path": "/ws?token=${a1}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1
    },
    {
      "do": "wait",
      "ms": 50
    },
    {
      "do": "ws_open",
      "conn": "pA2",
      "path": "/ws?token=${a2}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1
    },
    {
      "do": "ws_open",
      "conn": "pB1",
      "path": "/ws?token=${b1}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dB",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"list-clients\",\"requestId\":\"list-a\"}"
      }
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "dB",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"list-clients\",\"requestId\":\"list-b\"}"
      }
    },
    {
      "do": "expect",
      "conn": "dB",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "dB",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"revoke-client\",\"requestId\":\"foreign\",\"clientId\":\"bbbbbbbb\"}"
      }
    },
    {
      "do": "expect",
      "conn": "dB",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"revoke-client\",\"requestId\":\"own\",\"clientId\":\"bbbbbbbb\"}"
      }
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1
    },
    {
      "do": "expect",
      "conn": "pA1",
      "close": true,
      "close_code": 4003
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1
    },
    {
      "do": "ws_open",
      "conn": "pA3",
      "path": "/ws?token=${a1}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "pA3",
      "close": true,
      "close_code": 4005
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ],
        [
          "Authorization",
          "Bearer ${a1}"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb\"}",
      "expect_status": 401,
      "close_probe_ms": 100
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"list-clients\",\"requestId\":\"list-a2\"}"
      }
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"revoke-client\",\"requestId\":\"none\",\"clientId\":\"eeeeeeee\"}"
      }
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"revoke-client\",\"clientId\":\"cccccccc\"}"
      }
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"revoke-client\",\"requestId\":7,\"clientId\":\"cccccccc\"}"
      }
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "restart"
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ],
        [
          "Authorization",
          "Bearer ${a2}"
        ]
      ],
      "body": "{\"clientId\":\"cccccccc\"}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ],
        [
          "Authorization",
          "Bearer ${b1}"
        ]
      ],
      "body": "{\"clientId\":\"dddddddd\"}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ],
        [
          "Authorization",
          "Bearer ${a1}"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb\"}",
      "expect_status": 401,
      "close_probe_ms": 100
    }
  ]
}
