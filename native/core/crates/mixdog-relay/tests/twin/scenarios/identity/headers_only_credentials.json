{
  "id": "headers_only_credentials",
  "description": "device credentials are read only from a Basic Authorization header: the query string, a Bearer header, a header without a colon and an empty secret all fail; a lower-case scheme and a hook leg open",
  "steps": [
    {
      "do": "ws_open",
      "conn": "first",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-00000000000a",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "ws_open",
      "conn": "query",
      "path": "/desktop?device=a1b2c3d4-0000-4000-8000-00000000000a&deviceId=a1b2c3d4-0000-4000-8000-00000000000a&secret=0123456789abcdef",
      "role": "desktop",
      "expect_status": 401
    },
    {
      "do": "ws_open",
      "conn": "bearer",
      "path": "/desktop",
      "role": "desktop",
      "headers": [
        [
          "Authorization",
          "Bearer 0123456789abcdef"
        ]
      ],
      "expect_status": 401
    },
    {
      "do": "ws_open",
      "conn": "nocolon",
      "path": "/desktop",
      "role": "desktop",
      "headers": [
        [
          "Authorization",
          "Basic YTFiMmMzZDQtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDBh"
        ]
      ],
      "expect_status": 401
    },
    {
      "do": "ws_open",
      "conn": "emptysecret",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-00000000000a",
        ""
      ],
      "expect_status": 401
    },
    {
      "do": "ws_open",
      "conn": "lower",
      "path": "/desktop",
      "role": "desktop",
      "headers": [
        [
          "Authorization",
          "basic YTFiMmMzZDQtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDBhOjAxMjM0NTY3ODlhYmNkZWY="
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "ws_open",
      "conn": "hook",
      "path": "/hookleg",
      "role": "hook",
      "basic": [
        "b1b2c3d4-0000-4000-8000-00000000000b",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "ws_open",
      "conn": "hookwrong",
      "path": "/hookleg",
      "role": "hook",
      "basic": [
        "b1b2c3d4-0000-4000-8000-00000000000b",
        "wrong-secret-value"
      ],
      "expect_status": 401
    },
    {
      "do": "ws_open",
      "conn": "hookquery",
      "path": "/hookleg?device=b1b2c3d4-0000-4000-8000-00000000000b&secret=0123456789abcdef",
      "role": "hook",
      "expect_status": 401
    }
  ]
}
