{
  "id": "pair_code_redial",
  "description": "a code lives only as long as the leg that asked for it: it dies with its socket, a new lease replaces the old code, a withdrawn code resolves nowhere, and a redial gets a fresh one",
  "steps": [
    {
      "do": "ws_open",
      "conn": "first",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-00000000000a",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "first",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "first",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"pair-code-request\",\"lease\":\"lease-first-1\",\"name\":\"Home\"}"
      }
    },
    {
      "do": "expect",
      "conn": "first",
      "frames": 1,
      "capture": [
        {
          "var": "c1",
          "from": "frame_json",
          "path": "code"
        }
      ]
    },
    {
      "do": "send",
      "conn": "first",
      "frame": {
        "kind": "close",
        "code": 1000
      }
    },
    {
      "do": "expect",
      "conn": "first",
      "close": true
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/resolve",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"code\":\"${c1}\"}",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "ws_open",
      "conn": "second",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-00000000000a",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "second",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "second",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"pair-code-request\",\"lease\":\"lease-second-1\",\"name\":\"Home\"}"
      }
    },
    {
      "do": "expect",
      "conn": "second",
      "frames": 1,
      "capture": [
        {
          "var": "c2",
          "from": "frame_json",
          "path": "code"
        }
      ]
    },
    {
      "do": "send",
      "conn": "second",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"pair-code-request\",\"lease\":\"lease-second-2\",\"name\":\"Home\"}"
      }
    },
    {
      "do": "expect",
      "conn": "second",
      "frames": 1,
      "capture": [
        {
          "var": "c3",
          "from": "frame_json",
          "path": "code"
        }
      ]
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/resolve",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"code\":\"${c2}\"}",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "send",
      "conn": "second",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"pair-code-clear\"}"
      }
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/resolve",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"code\":\"${c3}\"}",
      "expect_status": 404,
      "close_probe_ms": 100
    }
  ]
}
