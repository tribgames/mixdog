{
  "id": "app_install_page",
  "description": "/app is the same parameterless install page whatever it is asked with, and only GET reads it",
  "steps": [
    {
      "do": "http",
      "method": "GET",
      "path": "/app",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/app?d=a1b2c3d4-0000-4000-8000-00000000000a&x=1",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/app",
      "expect_status": 405,
      "close_probe_ms": 100
    }
  ]
}
