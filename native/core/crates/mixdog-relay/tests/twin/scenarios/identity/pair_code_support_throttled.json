{
  "id": "pair_code_support_throttled",
  "description": "/pair-code/support never names the host and is throttled per source: after sixty answers it is 429 with Retry-After",
  "steps": [
    {
      "do": "ws_open",
      "conn": "dA",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-00000000000a",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"desktop-name\",\"name\":\"Secret Host\"}"
      }
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"pair-code-request\",\"lease\":\"lease-name-01\",\"name\":\"Secret Host\"}"
      }
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1,
      "capture": [
        {
          "var": "code",
          "from": "frame_json",
          "path": "code"
        }
      ]
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/pair-code/support?deviceId=a1b2c3d4-0000-4000-8000-00000000000a",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/pair-code/support?deviceId=a1b2c3d4-0000-4000-8000-00000000000a",
      "expect_status": 200,
      "close_probe_ms": 100
