{
  "id": "pair_code_support_and_presence",
  "description": "support says whether a desktop is online and whether it declared pairing v2; presence answers per id for known routes only (first sixteen ids, valid ids), and goes offline when the leg closes",
  "steps": [
    {
      "do": "ws_open",
      "conn": "old",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-00000000000a",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "old",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "old",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"desktop-lanes\",\"media\":true,\"e2ee\":1}"
      }
    },
    {
      "do": "wait",
      "ms": 100
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/pair-code/support?deviceId=a1b2c3d4-0000-4000-8000-00000000000a",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/presence",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"ids\":[\"a1b2c3d4-0000-4000-8000-00000000000a\",\"b1b2c3d4-0000-4000-8000-00000000000b\",\"nope\",7,null]}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "ws_open",
      "conn": "new",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "b1b2c3d4-0000-4000-8000-00000000000b",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "new",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "new",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"desktop-lanes\",\"media\":true,\"e2ee\":1,\"pairV2\":1}"
      }
    },
    {
      "do": "wait",
      "ms": 100
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/pair-code/support?deviceId=b1b2c3d4-0000-4000-8000-00000000000b",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/presence",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"ids\":[\"a1b2c3d4-0000-4000-8000-00000000000a\",\"b1b2c3d4-0000-4000-8000-00000000000b\"]}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/presence",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"ids\":\"not a list\"}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/presence",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{",
      "expect_status": 400,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/pair-code/support?deviceId=nope",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/pair-code/support",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "send",
      "conn": "old",
      "frame": {
        "kind": "close",
        "code": 1000
      }
    },
    {
      "do": "expect",
      "conn": "old",
      "close": true
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/pair-code/support?deviceId=a1b2c3d4-0000-4000-8000-00000000000a",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/pair-code/presence",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"ids\":[\"a1b2c3d4-0000-4000-8000-00000000000a\",\"b1b2c3d4-0000-4000-8000-00000000000b\"]}",
      "expect_status": 200,
      "close_probe_ms": 100
    }
  ]
}
