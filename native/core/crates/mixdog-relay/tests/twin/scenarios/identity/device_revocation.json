{
  "id": "device_revocation",
  "description": "a desktop that revokes its device is told so, its leg and its browsers are closed 4003, the device and its credentials are gone for good (after a restart too) and the id registers afresh",
  "knobs": {
    "handshakeStallMs": 600000,
    "livenessProbeMs": 600000
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "dA",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-00000000000a",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 2
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"set-client-token\",\"token\":\"fedcba9876543210\"}"
      }
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register?token=fedcba9876543210",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb\",\"name\":\"Android · Chrome\",\"platform\":\"Android\",\"browser\":\"Chrome\"}",
      "expect_status": 200,
      "capture": [
        {
          "var": "browser",
          "from": "body_json",
          "path": "token"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "ws_open",
      "conn": "p",
      "path": "/ws?token=${browser}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"revoke-device\"}"
      }
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1,
      "close": true,
      "close_code": 4003
    },
    {
      "do": "expect",
      "conn": "p",
      "close": true,
      "close_code": 4003
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/pair-code/support?deviceId=a1b2c3d4-0000-4000-8000-00000000000a",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "ws_open",
      "conn": "p2",
      "path": "/ws?token=${browser}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "p2",
      "close": true,
      "close_code": 4005
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register?token=fedcba9876543210",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb\"}",
      "expect_status": 401,
      "close_probe_ms": 100
    },
    {
      "do": "restart"
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/pair-code/support?deviceId=a1b2c3d4-0000-4000-8000-00000000000a",
      "expect_status": 404,
      "close_probe_ms": 100
    },
    {
      "do": "ws_open",
      "conn": "dA2",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-00000000000a",
        "a-completely-new-secret"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dA2",
      "frames": 2
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/pair-code/support?deviceId=a1b2c3d4-0000-4000-8000-00000000000a",
      "expect_status": 200,
      "close_probe_ms": 100
    }
  ]
}
