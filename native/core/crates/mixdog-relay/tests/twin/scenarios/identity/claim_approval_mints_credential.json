{
  "id": "claim_approval_mints_credential",
  "description": "a claim is routed to the desktop it names, stays pending until that desktop (and no other) approves, then the sealed answer and the new credential can be read again until the browser registers with it",
  "knobs": {
    "handshakeStallMs": 600000,
    "livenessProbeMs": 600000
  },
  "steps": [
    {
      "do": "ws_open",
      "conn": "dA",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-00000000000a",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 2
    },
    {
      "do": "ws_open",
      "conn": "dB",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "b1b2c3d4-0000-4000-8000-00000000000b",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dB",
      "frames": 2
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/claim",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ]
      ],
      "body": "{\"deviceId\":\"a1b2c3d4-0000-4000-8000-00000000000a\",\"clientId\":\"bbbbbbbb\",\"publicKey\":\"kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk\",\"name\":\"iPhone · Web app\"}",
      "expect_status": 202,
      "capture": [
        {
          "var": "claim",
          "from": "body_json",
          "path": "claimId"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/claim/${claim}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "send",
      "conn": "dB",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"claim-approve\",\"claimId\":\"${claim}\",\"sealed\":{\"box\":\"foreign\"}}"
      }
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"claim-approve\",\"sealed\":{\"box\":\"no id\"}}"
      }
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"claim-approve\",\"claimId\":\"not-this-claim\",\"sealed\":{\"box\":\"other\"}}"
      }
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/claim/${claim}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"claim-approve\",\"claimId\":\"${claim}\",\"sealed\":{\"box\":\"opaque\"}}"
      }
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/claim/${claim}",
      "expect_status": 200,
      "capture": [
        {
          "var": "minted",
          "from": "body_json",
          "path": "token"
        }
      ],
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/claim/${claim}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/claim/a1b2c3d4-9999-4999-8999-999999999999",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "ws_open",
      "conn": "p",
      "path": "/ws?token=${minted}",
      "role": "phone",
      "headers": [
        [
          "Origin",
          "${origin}"
        ]
      ],
      "expect_status": 101
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1
    },
    {
      "do": "http",
      "method": "POST",
      "path": "/client/register",
      "headers": [
        [
          "Content-Type",
          "application/json"
        ],
        [
          "Origin",
          "${origin}"
        ],
        [
          "Authorization",
          "Bearer ${minted}"
        ]
      ],
      "body": "{\"clientId\":\"bbbbbbbb\"}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/claim/${claim}",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "send",
      "conn": "dA",
      "frame": {
        "kind": "text",
        "text": "{\"type\":\"list-clients\",\"requestId\":\"after\"}"
      }
    },
    {
      "do": "expect",
      "conn": "dA",
      "frames": 1
    }
  ]
}
