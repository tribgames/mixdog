{
  "id": "tofu_registration_and_restart",
  "description": "a UUID id and a 32-hex id register on first use, and the registration is on disk before it authenticates: after a restart the same secret still opens and another secret is refused",
  "steps": [
    {
      "do": "ws_open",
      "conn": "uuid",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-00000000000a",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "ws_open",
      "conn": "hex",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "0123456789abcdef0123456789abcdef",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "restart"
    },
    {
      "do": "ws_open",
      "conn": "again",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "a1b2c3d4-0000-4000-8000-00000000000a",
        "0123456789abcdef"
      ],
      "expect_status": 101
    },
    {
      "do": "ws_open",
      "conn": "wrong",
      "path": "/desktop",
      "role": "desktop",
      "basic": [
        "0123456789abcdef0123456789abcdef",
        "not-the-same-secret"
      ],
      "expect_status": 401
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/pair-code/support?deviceId=a1b2c3d4-0000-4000-8000-00000000000a",
      "expect_status": 200,
      "close_probe_ms": 100
    },
    {
      "do": "http",
      "method": "GET",
      "path": "/pair-code/support?deviceId=b1b2c3d4-0000-4000-8000-00000000000b",
      "expect_status": 404,
      "close_probe_ms": 100
    }
  ]
}
