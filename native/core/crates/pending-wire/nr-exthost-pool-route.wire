# nr-exthost-pool-route: apply AFTER nr-exthost-worker-methods-docimage's .wire (this one calls its
# `mixdog_exthost_worker::native_methods()`, the list of method names the Rust worker serves, as
# `impl Iterator<Item = &'static str>` or any `IntoIterator<Item: Into<String>>`) and after
# nr-exthost-worker-loop's `ext-worker` subcommand of mixdogd (the Rust pool's program is the running
# executable with args ["ext-worker"]). The pool itself: `mixdog_exthost::RoutedExtPool`
# (new(native_config, node_config, native_methods), with_pools, render_browser, browser_launches, close,
# outstanding_window_bytes under test-support) and the constant NODE_WORKER_ID_OFFSET (1 << 16).
# No environment variable or setting chooses the route: the method list does.

## Cargo.toml (mixdog-app-server-daemon), [dependencies], next to `mixdog-exthost`
mixdog-exthost-worker = { workspace = true }
# The same edge for mixdog-cli (it builds the migration's pool and takes native_methods()).
## Cargo.toml (mixdog-cli), [dependencies], next to `mixdog-exthost`
mixdog-exthost-worker = { workspace = true }
# (the lead runs cargo to refresh Cargo.lock and mixdog-workspace-hack; no new registry crate.)

## mixdog-app-server-daemon/src/compose.rs
# 1. imports: replace `use mixdog_exthost::ExtHostPool;` with `use mixdog_exthost::RoutedExtPool;`
#    (keep ExtHostConfig, RenderBrowserConfig, DEFAULT_PENDING_CAP, worker_count).
# 2. REPLACE `pub(crate) fn ext_host_config(js, data_dir, tokens) -> ExtHostConfig` by a pair; the Node
#    half keeps today's body unchanged (renamed node), the Rust half is new:
#
#    /// The two halves of the extension host of this install: the Rust worker (this executable run as
#    /// `mixdogd ext-worker`) and the Node worker (today's `ExtHostConfig`). The Rust half's
#    /// `render_browser` is the one both pools use.
#    #[derive(Clone, Debug)]
#    pub struct ExtHostConfigs { pub native: ExtHostConfig, pub node: ExtHostConfig }
#
#    pub(crate) fn ext_host_config(js: &JsRuntime, data_dir: &Path, tokens: &LaneTokens) -> Result<ExtHostConfigs, std::io::Error> {
#        let node = <today's ExtHostConfig { program: js.program.clone(), args: [worker.mjs], electron: js.electron, ... }>;
#        let native = ExtHostConfig {
#            program: std::env::current_exe()?,
#            args: vec!["ext-worker".into()],
#            electron: false,
#            ..node.clone()
#        };
#        Ok(ExtHostConfigs { native, node })
#    }
#
#    /// The one constructor of the routing pool: compose, the migration (`boot`, `mixdogd migrate`) use it.
#    pub(crate) fn ext_host_pool(configs: ExtHostConfigs) -> Result<RoutedExtPool, mixdog_exthost::ExtHostError> {
#        RoutedExtPool::new(configs.native, configs.node, mixdog_exthost_worker::native_methods())
#    }
# 3. line ~185 field `ext_host: Arc<ExtHostPool>` -> `ext_host: Arc<RoutedExtPool>`.
# 4. line ~351 `render_browser()` body unchanged (RoutedExtPool::render_browser has the same signature).
# 5. line ~390 `pub fn ext_host(&self) -> &Arc<ExtHostPool>` -> `&Arc<RoutedExtPool>`.
# 6. line ~729 the construction: `Arc::new(ExtHostPool::new(ext_host_config(js, data_dir, tokens)).map_err(ComposeError::ExtHost)?)`
#    -> `Arc::new(ext_host_pool(ext_host_config(js, data_dir, tokens).map_err(ComposeError::StateDir)?).map_err(ComposeError::ExtHost)?)`
#    (use whichever ComposeError variant carries an io::Error for a missing current executable; add
#    `ExtHostExe(std::io::Error)` with Display "the running executable cannot be found: {0}" if none fits).
#    `ExecHosts { ext_pool: ext_host.clone() ... }` (line ~751) and `ext_host: ext_host.clone()` coerce unchanged.
# 7. `close_ext_host` (line ~362) `self.ext_host.close().await` is unchanged: RoutedExtPool::close closes the Node pool,
#    then the Rust pool and the shared browser.

