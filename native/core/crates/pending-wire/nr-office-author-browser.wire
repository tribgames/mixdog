# nr-office-author-browser: what the lead applies (nothing here is a protocol row; no SERVICE_PENDING name changes).

[modules]
# native/core/crates/mixdog-office-author/src/lib.rs: after `pub mod brief;` add (alphabetical with the other tasks' lines)
#   pub mod cdp;
#   pub mod geometry;
#   pub mod html_browser;
#   pub mod icons;
#   pub mod measure_deck;
#   pub mod page;
# and add to the crate doc: the browser session the HTML routes lay out in (`html_browser`, over `cdp` and `page`), the
# deck measurement (`measure_deck`, `geometry`) and the offline icon set (`icons`).

[cargo-lock]
# mixdog-office-author's own Cargo.toml is already edited. Cargo.lock, [[package]] "mixdog-office-author", `dependencies`
# gains (all already in the lock, nothing is fetched; the lock names a crate with its version only where two versions exist):
#   "base64 0.22.1", "futures", "mixdog-core-api", "mixdog-fsio", "mixdog-raster", "mixdog-rt", "tokio",
#   "tokio-tungstenite", "url"
# and, as dev-dependencies (listed in the same array): "async-trait", "mixdog-testkit".
# Layering: mixdog-office-author -> mixdog-raster, mixdog-core-api, mixdog-rt, mixdog-fsio; none of them depends on it.
# mixdog-workspace-hack/Cargo.toml: no change expected (tokio features sync/macros/rt/time/net, futures "sink" and
# tokio-tungstenite "connect" are already unified there); re-run `cargo hakari generate` to confirm.

[workspace-members]
# no change: mixdog-office-author is already a member.

[fixtures]
# native/core/fixtures/office-measure-deck/ (golden.json + MANIFEST.json) is added by this task. native/core/fixtures/MANIFEST.json
# gets this entry in `sets`, after the "office-measure" entry:
#   {
#     "command": "node benchmarks/rust-core/recorders/record-office-measure-deck.mjs --tree <tree>",
#     "fileCount": 1,
#     "manifest": "office-measure-deck/MANIFEST.json",
#     "manifestSha256": "848218ecb3ce99bc0b85e88a955c3ee6ba9e459180e254fcfca87d64df05d9bc",
#     "recorder": "benchmarks/rust-core/recorders/record-office-measure-deck.mjs",
#     "set": "office-measure-deck",
#     "totalBytes": 1817138
#   }
# (re-check with benchmarks/rust-core/recorders/verify-manifests.mjs; the golden holds the decks as the recording machine's
# browser laid them out, so `twin_live_measure_deck` is the replay of those on a machine with Chrome or Edge.)

[consumers]
# What the engine tasks that follow (the pptx html runner, pdf-html, docx-html and xlsx-html routes, the author actions)
# call. Everything is async, takes the lanes of the process through `AuthorLanes::new(LaneTokens)`, and reports a failure as
# the text Node's error carried.
#
#   mixdog_office_author::html_browser::{AuthorLanes, HtmlBrowser, RunError, LAYOUT_TIMEOUT, run_in_browser, html_failure,
#                                        photograph_captures}
#     HtmlBrowser::launch(&dyn BrowserEndpoint) -> Result<Arc<HtmlBrowser>, String>   (the lease of the shared render browser
#       plus a browser context of the run's own; the engine passes the Arc<dyn BrowserEndpoint> the wiring gives it, which
#       is mixdog-exthost's RenderBrowser)
#     run_in_browser(browser, &CancellationToken, timeout, |browser| async { ... Result<T, String> }) -> Result<T, RunError>
#       (deadline "HTML layout exceeded <ms> ms", Cancelled, closes the browser on every exit; a route returns Cancelled
#       to its caller as Node rethrew when `signal.aborted`, and answers `html_failure(message, started_at, extra)` otherwise)
#     AuthorLanes::{write_file, make_scratch_dir(prefix), remove_dir_all, compute}   (file writes on the durability lane,
#       the `mkdtemp(join(tmpdir(), prefix))` the docx and xlsx routes make, image work on the bulk compute lane)
#     photograph_captures(page, lanes, note, "data-docx-capture", count, scratch) -> BTreeMap<index, PathBuf>
#   mixdog_office_author::page::{Page, Element, Rect, Viewport, WaitUntil, ScreenshotOptions, PdfOptions, Length, Margin,
#                                page_function}
#     what the routes called on a puppeteer Page: set_viewport, emulate_media_type, goto(file URL, WaitUntil::Load),
#     set_content, evaluate(function source, args), evaluate_expression, wait_for_function, add_style_tag, title, count,
#     query, query_all, screenshot(clip, omit_background), pdf(PdfOptions { prefer_css_page_size, print_background, tagged,
#     outline, margin, scale, ... }), Element::{bounding_box, screenshot}. `page_function(script, name)` runs a function of a
#     page-script extract (the in-page JavaScript, unchanged) with its own arguments.
#   mixdog_office_author::measure_deck::{measure_html_deck, MeasureOptions, Measured, Canvas, HTML_CANVAS, inject_icons,
#                                        unknown_icons_error, file_url, paint_of_photograph, place_captures}
#     `prepare` is the canvas override of the pdf frame and xlsx routes (`MeasureOptions.prepare`); `inject_icons(page)` and
#     `file_url(path)` are what the docx, pdf and xlsx routes call on their own pages (`injectIcons` with the offline table).
#   mixdog_office_author::geometry::{read_geometry, slide_findings, GEOMETRY_TOLERANCE_PX, NEAR_MISS_PX}
#   mixdog_office_author::icons::{icons, IconSet, SvgOptions}    (`ICON(name)`, `ICON.svg`, `ICON.names`, `ICON.source`)
#
# The shared render browser must be started with --font-render-hinting=none (mixdog-exthost browser.rs browser_args already
# has it); HtmlBrowser::launch takes the browser the endpoint leases as it is.

[known-gaps]
# mixdog-raster `ops::trim` does not apply libvips' 3x3 median filter before it looks for the box (sharp's trim does, so a
# feature narrower than 3 px, such as a 1 px line, does not count there). measure_deck::paint_of_photograph uses it for the
# trim of a photographed decoration; the recording has no such case (a 4x4 block is not removed by the filter), a 1 px mark
# trims to 1x1 in Rust and to the whole picture in Node. Owner: the raster track (nr-office-raster-image).
