# 1. A turn that did not complete reaches the engine as aborted (the TS path passed aborted=true from markSessionError and
#    markSessionCancelled; task-lifecycle.finish then closed the disposable pages the turn opened). `TurnSnapshots::turn_settled` carries no
#    outcome and the engine's `TurnEvents::turn_ended(thread, aborted)` already takes one, so the session actor says it before it settles:
#
#    file: native/core/crates/mixdog-core-session/src/session/turn_snapshots.rs, in `pub trait TurnSnapshots`, before `turn_settled`:
#        /// The turn that settles next did not complete (it failed or was stopped): said on `SessionDeps.snapshots` itself, right before
#        /// `turn_settled`. A decorator that holds another `TurnSnapshots` forwards it when the one it holds needs it.
#        fn turn_aborted(&self, _thread: &ThreadId) {}
#
#    file: native/core/crates/mixdog-core-session/src/session/actor.rs, the settle of a run, immediately before
#        `self.deps.snapshots.turn_settled(&self.id);`
#    add:
#        if !matches!(outcome, RunOutcome::Completed(_)) {
#            self.deps.snapshots.turn_aborted(&self.id);
#        }
#
