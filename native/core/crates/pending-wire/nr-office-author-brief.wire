##    `office-brief` sorts: before "office-capability-tables"):
    {
      "command": "node benchmarks/rust-core/recorders/record-office-brief.mjs --tree <tree>",
      "fileCount": 1,
      "manifest": "office-brief/MANIFEST.json",
