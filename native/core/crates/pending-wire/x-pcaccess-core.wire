# mixdog-remote: Roster gains the one method legacy_revokes::fold calls (roster.rs has no owner this wave and its state is private to it)
file: native/core/crates/mixdog-remote/src/identity/roster.rs
place: in `impl Roster`, directly after `pub fn owed_access(&self) -> OwedAccess { ... }`
add:
    /// Takes over revocations another store owed (the desktop's old pending-revokes file): the keys join the owed
    /// access; past the cap, or with `unknown`, the revocations count as unknown (at least 1, so folding the same
    /// record twice owes nothing twice). Nothing is written when all of it is held already; a failed write keeps
    /// the state as it was.
    pub fn owe_access<L: WriteLane>(&mut self, lane: &InLane<L>, keys: &[String], unknown: bool) -> Result<(), SecretError> {
        let before = (self.state.owed_access_keys.clone(), self.state.owed_access_unknown);
        let mut lost = unknown;
        for key in keys {
            if self.state.owed_access_keys.contains(key) {
                continue;
            }
            if self.state.owed_access_keys.len() >= MAX_OWED_KEYS {
                lost = true;
            } else {
                self.state.owed_access_keys.push(key.clone());
            }
        }
        if lost && self.state.owed_access_unknown == 0 {
            self.state.owed_access_unknown = 1;
        }
        if before == (self.state.owed_access_keys.clone(), self.state.owed_access_unknown) {
            return Ok(());
        }
        if let Err(error) = self.persist(lane) {
            (self.state.owed_access_keys, self.state.owed_access_unknown) = before;
            return Err(error);
        }
        Ok(())
    }

# mixdog-remote access/runtime.rs: the single call site, at remote runtime start (CORE-WIRE-G1 applies it; runtime.rs is not owned by this task)
file: native/core/crates/mixdog-remote/src/access/runtime.rs
place: `async fn roster(&self)`, the lane job inside the `get_or_try_init` closure
edit:  replace `let loaded = self.durable(move |lane| Roster::load(lane, &dir)).await??;` with
         let loaded = self
             .durable(move |lane| {
                 let mut roster = Roster::load(lane, &dir)?;
                 // The desktop's old pending revokes join the owed access, once (the file is renamed to `.folded`).
                 // `dir` is `<data dir>/remote` (compose_flip.rs: `b.data_dir.join("remote")`); the record is under `<data dir>/desktop`.
                 if let Some(data_dir) = dir.parent() {
                     crate::access::legacy_revokes::fold(data_dir, &mut roster, lane)?;
                 }
                 Ok::<_, SecretError>(roster)
             })
             .await??;

