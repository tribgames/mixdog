# 3. For the later tasks of the track (the design library caller, the office actions batch, the PDF session, the review
#    that reads a batch's compositions): the modules export
#      composition::resolve_office_composition_context(format, &input, recent: Option<&Value>) -> tokens::CompositionContext
#        (what tokens::resolve_office_design takes; callers that start from a request use design_system::resolve_office_design);
#      composition::plan_office_composition(format, &operation, &design, &mut CompositionUsage) -> Value
#        (CompositionUsage = HashMap<String, usize>: one per operation batch);
#      composition::summarize_office_compositions(format, Option<&Value>) -> Value;
#      composition::review_office_composition_sequence(format, compositions, recent, allow_repetition) -> Value;
#      design_system::{resolve_office_design(format, &request, library), expand_office_design_operations(&ExpandRequest),
#        apply_pdf_design(&blocks, &design_request, library), office_design_catalog};
#      native_design::{uses_native_office_design, native_office_design, native_design_receipt}.
#    expand_office_design_operations answers { operations, semantic, design, content, composition } as Node's
#    expandOfficeDesignOperations does; ExpandRequest.snapshot_version is `Number(snapshotVersion || 0)` (the caller
#    applies the `|| 0`), and a non-array `operations` is an empty list.
