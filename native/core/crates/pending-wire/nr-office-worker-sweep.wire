# nr-office-worker-sweep: what the lead applies (core only; no protocol row, no SERVICE_PENDING name changes: office.sweepJournals
# is a worker-side method of the pool, called by the daemon's office_startup.rs, which stays unchanged with its 600 s bound).

## mixdog-exthost-worker/Cargo.toml
# [dependencies], in name order, add:
mixdog-js = { workspace = true }
mixdog-office-base = { workspace = true }
# [[test]] table, after the pool_e2e one, add:
#   [[test]]
#   name = "office_journal"
#   path = "tests/office_journal.rs"
#   required-features = ["test-support"]
# (the test only uses crates the crate already lists as dev-dependencies, plus serde_json/tempfile.)

## mixdog-exthost-worker/src/methods/mod.rs
# 1. next to `mod media_office;` add:                  mod office_journal;
# 2. in register_document_methods, after `media_office::register(registry);` add:   office_journal::register(registry);
# 3. update its doc comment's list of methods to include `office.sweepJournals`.
# 4. main_entry.rs test `the_names_come_from_the_registry_and_an_extension_adds_to_them`: the expected sorted names become
#    ["image.jpeg", "image.probe", "image.validate", "media.officeText", "office.sweepJournals", "ooxml.text"].
#    native_methods() reads the registry, so the routing pool of nr-exthost-pool-route sends office.sweepJournals to the Rust worker
#    with no further list to edit.

## native/core/Cargo.lock
# package "mixdog-exthost-worker" `dependencies` gains "mixdog-js" and "mixdog-office-base" (both already in the lock); the lead's
# cargo run refreshes it and mixdog-workspace-hack.

## Verify after applying
# cargo test -p mixdog-exthost-worker --features test-support --offline; cargo test -p mixdog-app-server-daemon --offline office_startup
