# nr-office-design-library: what the wiring applies for the design library (module `library` of crate mixdog-office-design).
# (No protocol rows, no daemon service, no SERVICE_PENDING change: the module is a library with no caller yet.)

# 1. native/core/crates/mixdog-office-design/src/lib.rs: add after the line `pub mod discipline;`
pub mod library;
#    and the line  `//! ... and the one reading of a preset table (`table_input`).`  of the crate doc gains
#    ", and the design library (`library`: signed packs, template index and state files, per-document bindings, composition history)".
#    The module is named `library::core` (file core.rs): inside library/mod.rs it is reached as `self::core`.

# 2. native/core/crates/mixdog-office-design/Cargo.toml (the crate's own file, written by nr-office-design-discipline):
#    [dependencies] add
mixdog-fsio = { workspace = true }
mixdog-rt = { workspace = true }
mixdog-statefile = { workspace = true }
# Ed25519 check of a pack's signature (the workspace's ring 0.17.14; no new crate, ed25519-dalek is not used).
ring = { workspace = true }
# The pack server: HTTPS GET with redirects, driven on a current-thread runtime inside the lane job that syncs
# (mixdog_rt::time::timeout bounds the wait for the response headers).
reqwest = { workspace = true }
tokio = { workspace = true, features = ["rt", "time", "net"] }
# The URL of a pack's template: scheme, path, href (WHATWG, as `new URL`).
url = { workspace = true }
# The names of the staging and replaced pack folders.
uuid = { workspace = true, features = ["v4"] }
#    [dev-dependencies] add (the twin test runs its lane job on the inline test backend and serves packs from the recording)
base64 = { workspace = true }
tempfile = { workspace = true }
tokio = { workspace = true, features = ["rt"] }
mixdog-rt = { workspace = true, features = ["test-support", "virtual-clock"] }

# 3. native/core/Cargo.lock: the package "mixdog-office-design" `dependencies` gains, besides the ones the discipline wire listed,
#      "base64", "mixdog-fsio", "mixdog-rt", "mixdog-statefile", "reqwest", "ring", "tempfile", "tokio", "url", "uuid"
#    (all already in the lock: reqwest, ring, tokio, url, uuid, base64, tempfile, sha2 are used by other members; no new package).
#    native/core/crates/mixdog-workspace-hack/Cargo.toml: re-run `cargo hakari generate` (reqwest, tokio rt/time/net and uuid v4 are
#    already unified by other members, so it should only touch the dependency list of the new package).

