# nr-office-author-review-artifacts: what the lead applies (no protocol row; no SERVICE_PENDING name changes).

[crate-manifest]
# native/core/crates/mixdog-office-author/Cargo.toml (not owned by this task: the dependency edges are written here).
# [dependencies] gains (all workspace entries already exist, base64 = "0.22.1" included):
#     base64 = { workspace = true }
#     mixdog-fonts = { workspace = true }
#     mixdog-fsio = { workspace = true }
#     mixdog-raster = { workspace = true }
# [dev-dependencies] gains:
#     tempfile = { workspace = true }
# (the tests of src/review_artifacts.rs and tests/twin_review_artifacts.rs write the sheet into a temporary directory.)

[cargo-lock]
# native/core/Cargo.lock, [[package]] "mixdog-office-author": `dependencies` gains
#   "base64", "mixdog-fonts", "mixdog-fsio", "mixdog-raster", "tempfile"
# (all of them are in the lock already; nothing is fetched). mixdog-workspace-hack: re-run cargo hakari generate if it reports a
# feature unification change for base64 or tempfile.

[fixtures]
# native/core/fixtures/office-review-artifacts/ (golden.json + MANIFEST.json) is added by this task. native/core/fixtures/MANIFEST.json
# gains this entry in its list, in the position that keeps the set names sorted (after "office-quality"-style names, i.e. where
# "office-review-artifacts" falls between "office-raster"/"office-quality" and "office-sharp"):
#   {
#     "command": "node benchmarks/rust-core/recorders/record-office-review-artifacts.mjs --tree <tree>",
#     "fileCount": 1,
#     "manifest": "office-review-artifacts/MANIFEST.json",
#     "manifestSha256": "5977cf77d91ab7e144d78bb5f37fc35c71bbac5b9a689a065d8f98c68b44ed69",
#     "recorder": "benchmarks/rust-core/recorders/record-office-review-artifacts.mjs",
#     "set": "office-review-artifacts",
#     "totalBytes": 341553
#   }
# The recorder needs a tree with node_modules (@napi-rs/canvas): `--tree <product tree>`; `twin_live_review_artifacts` passes
# MIXDOG_NODE_TREE (or this checkout).

[consumers]
# The seam the engine and the wiring use (module paths in mixdog_office_author):
#   contact_sheet::write_contact_sheet(&proof, &Registry, &dyn WriteNote, &[Value] page images, output, width) -> Result<Option<ContactSheet>, String>
#     Registry must hold a default family (the sheet's labels are set in 15px sans-serif; an empty registry makes the sheet fail,
#     and the review then goes without one). The sheet file is reported to the WriteNote before it is written.
#   review_artifacts::pptx_review_artifacts(&proof, &Registry, &dyn WriteNote, &ReviewSession, &dyn Receipts, &Value preview) -> Value
#     ReviewSession { authored_frame, frame_receipt, authored } mirrors the session fields the Node code reads.
#     trait Receipts is implemented by the task that ports pptx-receipt.mjs (nr-office-author-receipt) and the session snapshot:
#       composition_receipt()  = readCompositionReceipt(session) (snapshot with styles, compositionReceipt; None on failure)
#       attach_rendered_air()  = renderedAirByPage(images) then attachRenderedAir (unchanged receipt when the air cannot be measured)
#       for_delivery()         = receiptForDelivery(receipt, session)
#   source_drift::HtmlSource { source, edits } is the session's `htmlSource` / `htmlSourceEdits`: mark_authored_from_html(path),
#     note_batch_against_html(&batch) -> Option<Value> (the batch result's notice), and the free fn edits_replaced_by_author(Option<&HtmlSource>).
