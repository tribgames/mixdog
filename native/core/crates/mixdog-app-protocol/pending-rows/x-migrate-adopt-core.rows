# x-migrate-adopt-core: migrate/profile/status and migrate/profile/adopt. Header: add `pub mod migrate_profile;` to src/v2/mod.rs (after `pub mod host;`/alphabetical).

[methods]
# Paste after the row `PcAccessApprove => "pcAccess/approve"` in client_request_definitions!.
    /// The desktop-profile move's state: its generation, and the profile directory the core has recorded (Local only).
    MigrateProfileStatus => "migrate/profile/status" {
        params: v2::migrate_profile::MigrateProfileStatusParams,
        result: v2::migrate_profile::MigrateProfileStatus,
        scope: none,
        class: C2,
        mutation: none,
        origins: [Local],
    },
    /// Adopts the Electron profile for a core started without it: moves the profile files of generation 2 into the data dir (idempotent; only the profile recorded already may be named again). Local only.
    MigrateProfileAdopt => "migrate/profile/adopt" {
        params: v2::migrate_profile::MigrateProfileAdoptParams,
        result: v2::migrate_profile::MigrateProfileAdopted,
        scope: none,
        class: C2,
        mutation: none,
        origins: [Local],
    },

[server_requests]
none

[notifications]
none

[inventory]
none: the inventory is the frozen 1.4.5 list; these are new methods.

[free_text]
# Every string field of the schema must be in exactly one class of tests/it/free_text_fields.json. All are class refused
# (a path the core looks up and compares with the files it reads, or a file name the journal compares): a lone surrogate there
# refuses the frame. Use the reason text of the existing class that holds path strings (e.g. the one of cwd):
#   migrate/profile/adopt /userData
#   answer of migrate/profile/status /profile
#   answer of migrate/profile/adopt /moved/*
# No FREE_TEXT row (none of them is free).

[type_edits]
none

[remove]
none

[window]
migrate/profile/status deny host-role: the desktop main process asks which profile the core recorded; no renderer lane reaches it
migrate/profile/adopt deny host-role: the core reads and moves files from the directory named; only the desktop main process names the profile
