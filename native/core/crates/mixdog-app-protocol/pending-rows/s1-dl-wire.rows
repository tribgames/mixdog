[window]
# window_methods.json "methods" (sorted place, after "process/writeStdin" would put them out of order: insert in alphabetical order among the transfer/ names or at the end of the list as the file sorts): add
#   transfer/serverDownload/abort, transfer/serverDownload/begin, transfer/serverDownload/check, transfer/serverDownload/finish, transfer/serverDownload/step
# and the host-role list in src/boundary/window_scope.rs as for desktop/launchVersion/record.
transfer/serverDownload/begin deny: only the desktop's main process downloads (it holds the window's server id and this PC's download folder); the renderer goes through its main-process handlers
transfer/serverDownload/step deny: same
transfer/serverDownload/finish deny: same
transfer/serverDownload/abort deny: same
transfer/serverDownload/check deny: same
