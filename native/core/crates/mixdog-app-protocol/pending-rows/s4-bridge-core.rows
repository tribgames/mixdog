# s4-bridge-core: browser/bridge/run, browser/bridge/turn and browser/bridge/abort (desktop -> core). The desktop's loopback browser
# bridge, which the Node-hosted runtime's `browser` tool still talks to, runs each command it accepts through the core's browser command
# path (the engine where the connected desktop serves it). Internal: only the connection that is the host claimant may call them (the
# service answers PermissionDenied to any other; ctx.host_claimant), and a window-scoped connection never reaches them. Served by
# mixdog-tools desktop::browser_bridge_run::BrowserBridgeRun (see pending-wire/s4-bridge-core.wire).

[methods]
# Paste after the ComputerBridgeAbort row in src/methods.rs (symbol: ComputerBridgeAbort => "computer/bridge/abort").
    /// One command the desktop's loopback browser bridge accepted (the bridge's wire shape: the `browser` tool's fields beside `action`, `session_id`, `turn_id` and the runtime-set `unattended_run`, `unattended_agent`, `session_life` and `mail_link`), run through the core's browser command path with the bridge's own semantics: the tool's validation, the allowance of 32 concurrent commands, the runtime-only secret, saved-login and handoff actions, `begin_turn` and `finish_turn`, a card raised through the session's approval gate (an unattended run asks nothing, a session allowance is read by its life mark), redaction of the secrets of the session. `signalId` names the call for `browser/bridge/abort`.
    BrowserBridgeRun => "browser/bridge/run" {
        params: v2::host::BrowserBridgeRunParams,
        result: v2::host::BrowserBridgeRunResult,
        scope: none,
        class: C2,
        mutation: none,
        origins: [Local],
    },
    /// A turn of a bridge session starts or ends (what `begin_turn` and `finish_turn` commands do): an end waits for the session's commands still running, then closes the temporary pages the turn opened for itself.
    BrowserBridgeTurn => "browser/bridge/turn" {
        params: v2::host::BrowserBridgeTurnParams,
        result: v2::host::BrowserBridgeRunResult,
        scope: none,
        class: C2,
        mutation: none,
        origins: [Local],
    },
    /// Ends the work of one bridge call (`signalId`: its caller's connection dropped).
    BrowserBridgeAbort => "browser/bridge/abort" {
        params: v2::host::BrowserBridgeAbortParams,
        result: v2::host::BrowserBridgeAbortResult,
        scope: none,
        class: C2,
        mutation: none,
        origins: [Local],
    },

[server_requests]
# none

[notifications]
# none

[inventory]
# none. The inventory is the frozen 1.4.5 list (tests/fixtures/parity-inventory.json); the bridge was an HTTP surface of the desktop,
# never a daemon operation, so these get no row.

[free_text]
# src/free_text.rs FREE_TEXT, next to the computer/bridge/run row:
#   // The browser command the desktop's bridge forwards (browser/bridge/run): its text, selectors and scripts are what the model typed.
#   (Kind::Request, "browser/bridge/run", &["/command/**"]),
# tests/it/free_text_fields.json:
#   - `classes`, the free class (where "request computer/bridge/run /command/**" is): "request browser/bridge/run /command/**"
#   - `classes`, the refused class whose reason starts "an id, cursor, revision or digest the core, a client or a service generated:":
#       "request browser/bridge/abort /signalId", "request browser/bridge/run /signalId", "request browser/bridge/turn /sessionId"
#   - `payloads` -> request: next to "computer/bridge/run": { "/command": { "source": "native/core/crates/mixdog-tools/src/desktop/browser_bridge_run.rs (the desktop bridge's browser command)", "open": { "": { "class": "free", "reason": "the bridge's browser command: its text, selectors and scripts are what the model typed" } } } }

[type_edits]
# In v2/host.rs, after ComputerBridgeAbortResult (derives and attrs exactly as ComputerBridgeRunParams: Debug, Clone, PartialEq, Serialize, Deserialize,
# cfg_attr(codegen) JsonSchema+TS, camelCase, ts(optional_fields)). JsonValue and ComputerBridgeImage are already in scope there.

/// Params of `browser/bridge/run` (desktop -> core): one command of the loopback browser bridge.
pub struct BrowserBridgeRunParams {
    /// The bridge's wire command: an object with `action`, the action's fields, `session_id` (`browser` when absent), `turn_id` and the runtime-set `unattended_run`, `unattended_agent`, `session_life` and `mail_link`.
    pub command: JsonValue,
    /// Names this call for `browser/bridge/abort`.
    pub signal_id: String,
}

/// A bridge reply: what the browser command answered.
pub struct BrowserBridgeValue {
    pub text: String,
    /// The image of the reply (the same shape as a computer bridge reply's).
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub image: Option<ComputerBridgeImage>,
    /// `blocked` when the command ended inconclusively.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub outcome: Option<String>,
    /// The command's `BrowserCommandTiming`: diagnostics, never model text.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub timing: Option<JsonValue>,
}

/// Result of `browser/bridge/run` and `browser/bridge/turn`: the bridge's own answer.
pub struct BrowserBridgeRunResult {
    pub ok: bool,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub value: Option<BrowserBridgeValue>,
    /// The redacted message of why the command failed.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub error: Option<String>,
    /// The failed command's `BrowserCommandTiming`.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub timing: Option<JsonValue>,
    /// The HTTP status the bridge answers when it is not 200: 400 (invalid request) or 429 (the allowance of concurrent commands is spent).
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub status: Option<u16>,
}

/// Which end of a turn `browser/bridge/turn` marks.
#[serde(rename_all = "camelCase")]
pub enum BrowserBridgeTurnPhase {
    Begin,
    Finish,
}

/// Params of `browser/bridge/turn` (desktop -> core).
pub struct BrowserBridgeTurnParams {
    pub phase: BrowserBridgeTurnPhase,
    /// The session; `browser` when absent.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub session_id: Option<String>,
    /// The runtime's turn number: a positive safe integer.
    pub turn_id: u64,
    /// A turn that ended badly: its temporary pages are closed.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub aborted: Option<bool>,
}

/// Params of `browser/bridge/abort` (desktop -> core).
pub struct BrowserBridgeAbortParams {
    pub signal_id: String,
}

/// Result of `browser/bridge/abort`.
pub struct BrowserBridgeAbortResult {
    /// How many running commands were stopped.
    pub cancelled: u32,
}

[window]
# src/boundary/window_methods.json "methods" (alphabetical: insert "browser/bridge/abort", "browser/bridge/run", "browser/bridge/turn" in order) and the host-role list in src/boundary/window_scope.rs next to "computer/bridge/run":
browser/bridge/run deny: a window never drives the desktop's browser bridge; only the desktop's main process (the host claimant) does
browser/bridge/turn deny: same
browser/bridge/abort deny: same
