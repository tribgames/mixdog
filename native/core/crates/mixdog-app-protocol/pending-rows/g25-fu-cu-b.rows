[type_edits]
# g25-fu-cu-b (s3-10 zoom). native/core/crates/mixdog-app-protocol/src/v2/computer_host.rs, struct HostComputerPixelsParams:
# one field appended after `quality`. The part of the display to capture, in physical pixels of the screen (the display's origin
# included): the core's display zoom (computer_zoom.rs zoom_display) asks the desktop for the region at full resolution and answers
# `source` with the rectangle delivered, which must equal the region. Absent = the whole display. The desktop's host/computer/pixels
# handler (s3-22) crops to it; regenerate schema/*.json and packages/protocol/src/index.ts.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub region: Option<HostComputerPixelsRegion>,
# and, after the struct, a new type:
/// A rectangle of a display in physical pixels of the screen.
#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[cfg_attr(feature = "codegen", derive(schemars::JsonSchema, ts_rs::TS))]
#[serde(rename_all = "camelCase")]
pub struct HostComputerPixelsRegion {
    pub x: i32,
    pub y: i32,
    pub width: u32,
    pub height: u32,
}
# A literal `HostComputerPixelsParams { .. }` elsewhere needs `region: None` (grep the struct name; the round-trip test in
# computer_host.rs parses JSON and needs no edit). No free_text line: the region holds numbers only.
