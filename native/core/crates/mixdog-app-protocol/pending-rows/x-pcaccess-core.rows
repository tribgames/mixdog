# x-pcaccess-core: PC access readiness and approve (Local only, no Relay: the person is at the PC and the elevation prompt is theirs).
# Types live in src/v2/pc_access.rs (new, owned by this task). PROTO-WIRE adds `pub mod pc_access;` to src/v2/mod.rs
# (alphabetical among its neighbours) and nothing to the methods.rs imports: the rows name the types as
# `v2::pc_access::...` (methods.rs already has `use crate::v2;`).

[methods]
# Paste after the RemoteAccessState row in src/methods.rs (symbol: RemoteAccessState => "remoteAccess/state").
    /// PC access readiness: the secure-desktop service install state, the paired phones' keys it holds or lacks, and the revocations owed (Node's `PcAccess.readiness`, pc-access.ts). Local only.
    PcAccessReadiness => "pcAccess/readiness" {
        params: v2::pc_access::PcAccessReadinessParams,
        result: v2::pc_access::PcAccessReadiness,
        scope: none,
        class: C2,
        mutation: none,
        origins: [Local],
    },
    /// PC access Approve: one UAC install-or-enroll of every paired phone's key, applying the owed revocations in the same call (Node's `PcAccess.approve`, pc-access.ts). Local only.
    PcAccessApprove => "pcAccess/approve" {
        params: v2::pc_access::PcAccessApproveParams,
        result: v2::pc_access::PcAccessApproval,
        scope: none,
        class: C2,
        mutation: none,
        origins: [Local],
    },

[server_requests]
# none

[notifications]
# none

[inventory]
# none. The inventory is the frozen 1.4.5 list (tests/fixtures/parity-inventory.json) and holds no PC access operation
# (pc-access.ts was desktop-only, never a daemon operation), so these methods get no row; a name outside the fixture fails
# ds_all_1_every_inventory_name_is_mapped_once.

[free_text]
# none: neither method takes a string.

[type_edits]
# file: src/v2/mod.rs, the `pub mod` list (alphabetical among its neighbours)
pub mod pc_access;

[remove]
# none

[window]
pcAccess/readiness deny Local-only: main reads it for the readiness row; a window reaches it only through the main IPC
pcAccess/approve deny Local-only: main runs the Approve; a window reaches it only through the main IPC
