#   (Kind::Request, "thread/rememberPromptHistory", &["/text"]),
# tests/it/free_text_fields.json, in sorted place: "request thread/setProgressHint /text" and "request thread/rememberPromptHistory /text" beside
# "request thread/pushNotice /text"; in the identifier lists: "request thread/rememberPromptHistory /opId", "request thread/rememberPromptHistory /threadId",
# "request thread/setProgressHint /threadId", "request thread/restoreNewerTranscript /threadId", "request thread/restoreOlderTranscript /threadId",
# "request config/getSettingsSnapshot /threadId"; "request thread/setProgressHint /tone" beside "request thread/pushNotice /level".

