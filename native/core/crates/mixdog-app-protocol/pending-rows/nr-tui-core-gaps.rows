# nr-tui-core-gaps: five methods of the terminal client's session surface. Served by mixdog-core-session session/tui_client_methods.rs
# (TuiClientService: all but rememberPromptHistory; the thread actor: rememberPromptHistory, see the .wire). The params types are written
# here as text for the lead to place in src/v2/params.rs (a hot file); the handlers read the params as JSON, so a field name here is the wire name.

[methods]
Beside ThreadPushNotice (methods.rs):

    /// Today's session configure action `setProgressHint`: the sticky hint line of the input row (the runtime section's `progressHint`); an empty text clears it.
    ThreadSetProgressHint => "thread/setProgressHint" {
        params: ThreadSetProgressHintParams,
        result: JsonValue,
        scope: thread_or_none(thread_id),
        class: C2,
        mutation: none,
        origins: [Local, Ssh],
    },
    /// Today's session configure action `rememberPromptHistory`: the text joins the up-arrow history of the thread's folder; answers whether there was a text to keep.
    ThreadRememberPromptHistory => "thread/rememberPromptHistory" {
        params: ThreadRememberPromptHistoryParams,
        result: JsonValue,
        scope: thread(thread_id),
        class: C2,
        mutation: op(Thread),
        origins: [Local, Ssh],
    },
    /// Today's session configure action `restoreOlderTranscript`: answers false, the core keeps the whole log (page with `thread/items/list`).
    ThreadRestoreOlderTranscript => "thread/restoreOlderTranscript" {
        params: ThreadRestoreTranscriptParams,
        result: JsonValue,
        scope: thread_or_none(thread_id),
        class: C1,
        mutation: none,
        origins: [Local, Ssh],
    },
    /// Today's session configure action `restoreNewerTranscript`: as `thread/restoreOlderTranscript`.
    ThreadRestoreNewerTranscript => "thread/restoreNewerTranscript" {
        params: ThreadRestoreTranscriptParams,
        result: JsonValue,
        scope: thread_or_none(thread_id),
        class: C1,
        mutation: none,
        origins: [Local, Ssh],
    },
    /// Today's session read action `getSettingsSnapshot`: every row of the settings picker in one read (including `voice: { enabled }`); a row that cannot be read is null.
    ConfigGetSettingsSnapshot => "config/getSettingsSnapshot" {
        params: ConfigGetSettingsSnapshotParams,
        result: JsonValue,
        scope: thread_or_shared_read(thread_id, "config"),
        class: C1,
        mutation: none,
        origins: [Local, Ssh],
    },

[params]
# src/v2/params.rs, each beside the params type of the same family (ThreadPushNoticeParams, ConfigGetSystemShellParams):

/// Params of `thread/setProgressHint`.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[cfg_attr(feature = "codegen", derive(schemars::JsonSchema, ts_rs::TS))]
#[serde(rename_all = "camelCase")]
#[cfg_attr(feature = "codegen", ts(optional_fields))]
pub struct ThreadSetProgressHintParams {
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub thread_id: Option<ThreadId>,
    /// Absent or empty: the hint is cleared.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub text: Option<String>,
    /// `info` when not sent.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub tone: Option<String>,
    /// A finite number is rounded and held in 0..=100.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub percent: Option<f64>,
}

/// Params of `thread/rememberPromptHistory`.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[cfg_attr(feature = "codegen", derive(schemars::JsonSchema, ts_rs::TS))]
#[serde(rename_all = "camelCase")]
pub struct ThreadRememberPromptHistoryParams {
    pub thread_id: ThreadId,
    pub op_id: OpId,
    pub text: String,
}

impl crate::common::HasOpId for ThreadRememberPromptHistoryParams {
    fn op_id(&self) -> &OpId {
        &self.op_id
    }
}

/// Params of `thread/restoreOlderTranscript` and `thread/restoreNewerTranscript`.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[cfg_attr(feature = "codegen", derive(schemars::JsonSchema, ts_rs::TS))]
#[serde(rename_all = "camelCase")]
#[cfg_attr(feature = "codegen", ts(optional_fields))]
pub struct ThreadRestoreTranscriptParams {
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub thread_id: Option<ThreadId>,
}

/// Params of `config/getSettingsSnapshot`: `options` is `{ heavy }` (default on: adds the MCP, plugin and skill status).
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[cfg_attr(feature = "codegen", derive(schemars::JsonSchema, ts_rs::TS))]
#[serde(rename_all = "camelCase")]
#[cfg_attr(feature = "codegen", ts(optional_fields))]
pub struct ConfigGetSettingsSnapshotParams {
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub thread_id: Option<ThreadId>,
    #[serde(default)]
    pub options: Option<JsonValue>,
}

[server_requests]
# none

[notifications]
# none

[inventory]
# src/inventory.rs, the five rows now Target::Deleted("caller-less action (DS §17.1)") (the terminal client calls them):
#   getSettingsSnapshot     -> Target::Method("config/getSettingsSnapshot")
#   rememberPromptHistory   -> Target::Method("thread/rememberPromptHistory")
#   restoreNewerTranscript  -> Target::Method("thread/restoreNewerTranscript")
#   restoreOlderTranscript  -> Target::Method("thread/restoreOlderTranscript")
#   setProgressHint         -> Target::Method("thread/setProgressHint")
