#   request connections/ssh/serverLoginComplete /flowId
#   request connections/ssh/serverLoginCancel /id
#   request connections/ssh/serverLoginCancel /flowId
#   request connections/ssh/serverLoginSaveKey /id
#   request connections/ssh/serverLoginLogout /id
#   request connections/ssh/serverLoginRemoveCustom /id
#   request connections/link/get /connectionId
#   request connections/link/retry /connectionId
