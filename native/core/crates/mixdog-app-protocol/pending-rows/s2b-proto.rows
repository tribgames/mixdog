# The fields [type_edits] adds to existing client-sent params (host/claim `resources`, host/state/set `windowFocus`,
# host/notification/clicked `connectionId`) are strings of the schema too: the three id lines above, and
# class "a path, or a file, command or record name compared with what is on disk or in a store ...":
#   request host/claim /resources/serverCoresDir
# class "an executable path run as a process: a path, not text":
#   request host/claim /resources/askpassHelper
# The answers of host/window/open, close and focus hold no string (`{opened}` and `{}`): no answer entry.
# The contract test that reads the schema goldens (every_string_field_is_classed_once_and_free_text_is_listed_free) sees
# these fields only after schema/*.json is regenerated (MIXDOG_UPDATE_PROTOCOL_GOLDEN=1); the lines above must then be in.

[type_edits]
# 1. file: src/v1.rs, struct HostCapabilities: add after `computer`:
    /// Window objects of the desktop: `host/window/open`, `host/window/close`, `host/window/focus`; sends `host/window/closed`.
    #[serde(default)]
    pub windows: bool,
#    HostCapabilities derives Default and is built by field nowhere else (read: grep over native/core/crates).
# 2. file: crates/mixdog-core-api/src/host.rs, enum HostCapability: add after `Computer`:
    /// `host/window/open`, `host/window/close` and `host/window/focus`: the windows of server connections.
    Windows,
#    and in `HostCapability::deadline` add `Self::Windows` to the arm returning None:
#      Self::Browser | Self::Visualize | Self::Files | Self::Updater | Self::Power | Self::ModelProxy | Self::Windows => None,
# 3. file: crates/mixdog-app-server/src/outgoing.rs, fn serves: add after the `computer` row:
        (declared.windows, HostCapability::Windows),
# 4. file: src/v2/host.rs, struct HostClaimParams (it derives Eq; HostClaimResources does too): add after `host_id`, and add
#    `#[cfg_attr(feature = "codegen", ts(optional_fields))]` to the struct:
    /// Where the desktop keeps the server cores and the askpass helper the core launches.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub resources: Option<crate::v2::connections::HostClaimResources>,
#    Coordinate with x-proto-gating-core, which also adds an optional field to this struct.
# 5. file: src/v2/host.rs, enum HostStateSetParams: add after `DisplayPreferences(JsonValue),`:
