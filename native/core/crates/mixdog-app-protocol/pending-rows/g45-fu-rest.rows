# g45-fu-rest: what the Rust browser engine needs of the protocol to carry over everything the TypeScript engine did (the wave-4 review findings
# of s4-engine-target-points, s4-engine-reply and s4-engine-settle). Four additions, all optional on the wire except the new method:
#   1. host/browser/ref/mint: refs for the nodes a CSS selector names that the snapshot does not list (target-resolve.ts selectorCandidates, the
#      accessibility-ref branch: DOM.querySelectorAll + DOM.describeNode, registered in the host's accessibility ref table).
#   2. HostBrowserRefCallResult.frameOffset: the offset of the cross-origin frame the ref lives in (frameOffsetForSession of ref-point-probe.ts and
#      ref-rect-probe.ts), which the core adds to the point and the rectangle it measures.
#   3. HostBrowserSnapshotResult.observation: the whole observation revision (documents.ts browserDocumentChanged), for the "no observable change"
#      judgement (a new document, the viewport, the scroll position, nested scrollers).
#   4. BrowserPageReadOptions.offset: a text read starts at a character offset, so a postcondition reads a page text longer than one read returns
#      in parts (settle.ts read up to 1,000,000 characters; the wire read returns 120,000).
# The Rust code that uses them is in mixdog-browser-engine (refs/target_resolve.rs, refs/access.rs, refs/points.rs, reply/reply.rs, refs/ref_set.rs,
# settle/reply_wait.rs, port.rs `ref_mint`); the desktop side is apps/desktop/src/main/host/browser-engine/{ref-mint,ref-call,snapshot,page}.ts. The crate
# does not compile until these edits are applied.

[methods]
# none (host methods are server requests)

[server_requests]
Beside HostBrowserRefCall (after it):

    /// Mint refs for the nodes a CSS selector names in the top document.
    HostBrowserRefMint => "host/browser/ref/mint" {
        params: HostBrowserRefMintParams,
        result: HostBrowserRefMintResult,
        requires: Some("host.browserEngine"),
    },

[notifications]
# none

[inventory]
# none

[free_text]
# native/core/crates/mixdog-app-protocol/src/free_text.rs: beside the (Kind::Answer, "host/browser/ref/call", ...) entry add
#     (Kind::Answer, "host/browser/ref/mint", &["/matches/*/role", "/matches/*/name", "/invalid", "/facts/title", "/facts/fault", "/facts/pendingDialog/message", "/facts/pendingDialog/defaultPrompt", "/facts/dismissedDialog/message"]),
# and the same paths in tests/it/free_text_fields.json (the role and name are page text: attributes of the node; `invalid` is the page's own message).

[type_edits]
# file: native/core/crates/mixdog-app-protocol/src/v2/browser_engine.rs
# 1. After HostBrowserRefCallResult add (derives and attrs exactly as HostBrowserRefCallParams):

    /// `host/browser/ref/mint` (core to host): the refs of the top-document nodes a CSS selector names, on a page whose refs come from the accessibility
    /// tree. A node the snapshot lists keeps its ref; any other gets one minted in the host's ref table, bound like a listed one, so `ref/call` and the
    /// pointer resolve it the same way.
    pub struct HostBrowserRefMintParams {
        pub page_id: String,
        pub snapshot_id: String,
        pub selector: String,
        /// More matches than this answer only their count.
        pub limit: u32,
        #[serde(default, skip_serializing_if = "Option::is_none")]
        pub expect: Option<Precondition>,
    }

    pub struct HostBrowserRefMintResult {
        /// How many nodes the selector matched.
        pub count: u32,
        /// In document order; empty past the limit.
        #[serde(default)]
        pub matches: Vec<BrowserMintedRef>,
        /// The page's own message when the selector is not valid CSS.
        #[serde(default, skip_serializing_if = "Option::is_none")]
        pub invalid: Option<String>,
        pub facts: PageFacts,
    }

    pub struct BrowserMintedRef {
        #[serde(rename = "ref")]
        #[cfg_attr(feature = "codegen", ts(rename = "ref"))]
        pub ref_id: String,
        pub role: String,
        pub name: String,
    }

# 2. HostBrowserRefCallResult: add after `exception`:

    /// Where the cross-origin frame the ref lives in sits in the top viewport (absent in the top document, whose points need no offset).
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub frame_offset: Option<BrowserFrameOffset>,

#    and, beside it (derives and attrs as HostBrowserRefCallParams):
    pub struct BrowserFrameOffset { pub x: f64, pub y: f64 }

# 3. HostBrowserSnapshotResult: add after `revision`:

    /// The whole observation revision of the page (every frame's document, viewport, scroll position, DOM-change counter and scroller counters,
    /// `|`-separated); the core judges "no observable change" by it. Absent from an older host.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub observation: Option<String>,

# 4. BrowserPageReadOptions: add after `include_hidden`:

    /// Where a text read starts, in UTF-16 units: a text longer than one read returns is read in parts.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub offset: Option<u32>,

# 5. Doc only: the `geometry` answer of `desktopPet/placement/resolve` also carries `pinInset` (how far inside the composer card's right edge the pinned sprite
#    box sits, the core's PIN_INSET): in v2/desktop_pet.rs and the same text of packages/protocol/src/index.ts write `{ window, sprite, coreWidth, pinInset }`.
# After the change the generated schema files and packages/protocol/src/index.ts carry the new types and fields (and the client method table the new request).

[remove]
# none

[window]
# none (host/* requests are served by the desktop host, not a window method)
