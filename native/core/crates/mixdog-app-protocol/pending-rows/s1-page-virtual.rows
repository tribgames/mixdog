# s1-page-virtual: one client method, `projectFs/localPage/virtual`, that leases an in-memory page (visualize) from the core page server.
# Params: files (index.html required) and the window that asked; result {"url": "http://127.0.0.1:<port>/<token>/index.html"} (JsonValue; unlike projectFs/localPageUrl, which answers a bare string).
# No server request, notification or inventory row (the inventory is the frozen 1.4.5 list; this method has no 1.4.5 name).
# The wiring task regenerates schema/*.json and packages/protocol/src/index.ts, and the method-args files of packages/protocol-client.

[methods]
# after `ProjectFsLocalPageUrl => "projectFs/localPageUrl"`:
#     /// Lease a page held in memory (`index.html` and sibling files) from the core page server, for the visualize pane and its exports (Node's `localVirtualPageUrl`, local-page-server.ts).
#     ProjectFsLocalPageVirtual => "projectFs/localPage/virtual" {
#         params: v2::desktop_files::ProjectFsLocalPageVirtualParams,
#         result: JsonValue,
#         scope: none,
#         class: C1,
#         mutation: none,
#         origins: [Local],
#     },

[server_requests]
[notifications]
[inventory]

[free_text]
# src/free_text.rs FREE_TEXT: add
#     (Kind::Request, "projectFs/localPage/virtual", &["/files/*/text"]),
# tests/it/free_text_fields.json, in the existing classes (by their reason text), add the fields:
#   class "free", reason "File content being written: ...": "request projectFs/localPage/virtual /files/*/text"
#   class "refused", reason "a path, or a file, command or record name compared with what is on disk or in a store: ...": "request projectFs/localPage/virtual /files/*/path"
#   class "refused", reason "encoded bytes or a media type (base64, data URL, SDP), decoded, not text": "request projectFs/localPage/virtual /files/*/dataBase64" and "request projectFs/localPage/virtual /files/*/type"
#   class "refused", reason "an id, cursor, revision or digest the core, a client or a service generated: ...": "request projectFs/localPage/virtual /ownerId"

