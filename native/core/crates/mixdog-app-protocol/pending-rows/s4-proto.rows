[type_edits]
# file: src/v1.rs, struct HostCapabilities: add after `computer` (a host that does not declare it keeps parsing and serializing as today):
    /// The browser engine lane (`host/browser/*`, version 1); absent = the `host/browser/command` forward path.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    #[cfg_attr(feature = "codegen", ts(optional))]
    pub browser_engine: Option<crate::v2::browser_engine::BrowserEngineCapability>,
# HostCapabilities derives Default, so struct literals with `..Default::default()` keep compiling; PROTO-WIRE greps `HostCapabilities {`
# and adds `browser_engine: None` to a literal that names every field.
# file: native/core/crates/mixdog-core-api/src/host.rs, enum HostCapability: add after `Computer`:
    /// `host/browser/*`: the browser engine lane (declared by `capabilities.host.browserEngine`).
    BrowserEngine,
# and in `deadline` add `Self::BrowserEngine` to the `None` arm (`Self::Browser | Self::Visualize | ... | Self::ModelProxy` -> add `| Self::BrowserEngine`);
