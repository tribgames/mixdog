# g35-fu-x: desktopPet/placement/resolve (the pet window's placement rules, no state). The params types are in
# src/v2/desktop_pet.rs already (DesktopPetPlacementResolveParams and the Placement* parts); nothing to create.

[methods]
# Paste after the row `DesktopPetStateWrite => "desktopPet/state/write"` in client_request_definitions!.
    /// One of the rules that place the desktop pet's window (desktop-pet-store.ts: `desktopPetGeometry`, `pinnedPetPosition`, `clampPetPosition`, `clampFreePetPosition`, `petHereAnchor`, `petHerePosition`, `displayForPetPosition`, `petPositionOn`), named by `op`, over the rectangles and displays the window controller read from Electron. Answers a point, an anchor, a display id (null for none) or the geometry.
    DesktopPetPlacementResolve => "desktopPet/placement/resolve" {
        params: v2::desktop_pet::DesktopPetPlacementResolveParams,
        result: JsonValue,
        scope: none,
        class: C2,
        mutation: none,
        origins: [Local],
    },

[server_requests]
none

[notifications]
none

[inventory]
none: a new method.

[free_text]
# Only `op` is a string field (a tag with fixed values); no FREE_TEXT row unless the generated-schema test lists it, then class it
# like the other tag fields. `prefs` of the positionOn op is a typed DesktopPetPrefs (its `positions` keys are display ids, classed
# already by the desktopPet/state/write rows).

[type_edits]
none

[remove]
none

[window]
# Host-role: the desktop's main process only (the pet window controller); a renderer window has no use for it. Add the method to the
# window deny list the way desktopPet/state/write is classed, if that one is listed.
