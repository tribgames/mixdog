# s3-13: dev/computer/run, a test hook (mixdog-app-server-daemon feature test-hooks, env MIXDOGD_TEST_HOOKS=1).
# The daemon service (dev_computer.rs) parses the params with its own serde shape. The wiring task puts the types below into a new
# src/v2/dev_computer.rs (with `use crate::v2::dev_computer::*;`), camelCase, the usual codegen derives:
#   DevComputerRunParams { session_thread_id: String, command: JsonValue (an object), timeout_ms: Option<u32> (1..=120000, default 45000) }
#   DevComputerRunResult { ok: bool, text: Option<String>, image_blob: Option<DevComputerImageBlob { digest: BlobDigest, byte_length: u64, mime_type: String }>,
#                          error: Option<DevComputerError { code: String, message: String }>, helper_pid: Option<u32> }
[methods]
# after the row TestBrowserEngineRun => "test/browserEngine/run"
    /// Run one `computer` command through the live helper pool outside a model turn (test hook, MIXDOGD_TEST_HOOKS=1 only).
    DevComputerRun => "dev/computer/run" {
        params: DevComputerRunParams,
        result: DevComputerRunResult,
        scope: none,
        class: C2,
        mutation: none,
        origins: [Local],
    },
[free_text]
# DevComputerRunParams: sessionThreadId is an id; `command` is an untyped object (a `payloads` entry `dev/computer/run /command/**`, the harness's command fields).
[window]
dev/computer/run deny a test hook for the live harness; a renderer never calls it
