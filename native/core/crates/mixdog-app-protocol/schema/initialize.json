{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CapabilityState": {
      "oneOf": [
        {
          "properties": {
            "state": {
              "enum": [
                "available"
              ],
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "detail": {
              "type": "string"
            },
            "state": {
              "enum": [
                "unavailable"
              ],
              "type": "string"
            }
          },
          "required": [
            "detail",
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "ConnectionInfo": {
      "description": "What the core knows about this connection.",
      "properties": {
        "device": {
          "description": "Host-stamped device name used on submits, aborts and decisions (today's `viewerDevice`).",
          "type": "string"
        },
        "origin": {
          "$ref": "#/definitions/Origin"
        },
        "window": {
          "description": "The id of the desktop window this connection is the socket of (`Mixdog-Window`); absent for any other connection.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "device",
        "origin"
      ],
      "type": "object"
    },
    "CoreState": {
      "oneOf": [
        {
          "properties": {
            "state": {
              "enum": [
                "serving"
              ],
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "done": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "kind": {
              "type": "string"
            },
            "state": {
              "enum": [
                "migrating"
              ],
              "type": "string"
            },
            "total": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            }
          },
          "required": [
            "done",
            "kind",
            "state",
            "total"
          ],
          "type": "object"
        },
        {
          "properties": {
            "reason": {
              "$ref": "#/definitions/DrainReason"
            },
            "state": {
              "enum": [
                "draining"
              ],
              "type": "string"
            }
          },
          "required": [
            "reason",
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "DefaultsSeparation": {
      "description": "How this core start's one-time `desktop` defaults separation ended (Node's app-ready `separateDefaults`). A failure never stops the core; the desktop records it in its own diagnostics log as `defaults-separation-failed` with `{ message }`, and the next start tries again.",
      "properties": {
        "message": {
          "description": "The failure's `error.message`, as Node's catch received it; absent when `ok`.",
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    },
    "DrainReason": {
      "description": "Why the core is winding down (LR §5, SPEC R22). Shared by core-api and the wire.",
      "enum": [
        "update",
        "quit",
        "restart",
        "noClients"
      ],
      "type": "string"
    },
    "Limits": {
      "properties": {
        "appRingBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "controlReserveBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "eventBudgetBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "heartbeatTickMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxBlobPageBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxBlobPutChunkBytes": {
          "description": "Raw `blob/put` chunk bound, so the frame stays under `maxInboundFrameBytes` after base64.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxConnections": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxFrameBytes": {
          "description": "Outbound non-snapshot frame bound.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxInboundFrameBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxItemFieldBytes": {
          "description": "`INLINE_MAX`.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxMediaFrameBytes": {
          "description": "Host role only (X17): raw BGRA bound of the pinned live-view size.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxProcesses": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxSnapshotBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "orderedQueueBytes": {
          "description": "The ordered class's event room (events never dropped, P §6.5), apart from `queueBytes`: one event of any size enters an empty room; behind it, events queue while the queued bytes stay within this bound, and the connection closes 4000 when the peer has not drained them.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "queueBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "ringBytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "terminalInputBufferBytes": {
          "description": "Per-terminal input buffer before socket reads pause (P §7.3).",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "terminalRingChars": {
          "description": "Terminal feed replay ring, in characters (`REPLAY_BUFFER_LIMIT`).",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "appRingBytes",
        "controlReserveBytes",
        "eventBudgetBytes",
        "heartbeatTickMs",
        "maxBlobPageBytes",
        "maxBlobPutChunkBytes",
        "maxConnections",
        "maxFrameBytes",
        "maxInboundFrameBytes",
        "maxItemFieldBytes",
        "maxMediaFrameBytes",
        "maxProcesses",
        "maxSnapshotBytes",
        "orderedQueueBytes",
        "queueBytes",
        "ringBytes",
        "terminalInputBufferBytes",
        "terminalRingChars"
      ],
      "type": "object"
    },
    "Origin": {
      "description": "Who issued a call: the connection origin (P §4.1, DS §4.2). Shared by core-api (`PermissionDenied.origin`) and the method table.",
      "oneOf": [
        {
          "description": "Loopback WebSocket (desktop, TUI, CLI on this machine).",
          "enum": [
            "local"
          ],
          "type": "string"
        },
        {
          "description": "The same WebSocket through an SSH port forward.",
          "enum": [
            "ssh"
          ],
          "type": "string"
        },
        {
          "description": "A paired phone through the E2E relay.",
          "enum": [
            "relay"
          ],
          "type": "string"
        }
      ]
    },
    "RemoteCapabilities": {
      "description": "The features Node's relay announced to a phone in its challenge, each true when this core serves it. Node offered every flag but `nativePush` always; `nativePush` only while the relay could deliver a native push (`relayNativePlatforms().length > 0`).",
      "properties": {
        "browserDrive": {
          "description": "The remote browser pane may send the `viewport` control.",
          "type": "boolean"
        },
        "browserFit": {
          "description": "A take-over's fit is honored and frames are marked.",
          "type": "boolean"
        },
        "browserSessionTabs": {
          "description": "A conversation browser's tabs ride its frames and its tab controls are accepted.",
          "type": "boolean"
        },
        "browserWebrtc": {
          "description": "The WebRTC live view's version (Node's `REMOTE_WEBRTC_VERSION`); 0 when it is not served.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "fileDownloads": {
          "description": "The host file download lane (`transfer/*`).",
          "type": "boolean"
        },
        "hostDirectories": {
          "description": "The host folder browser (`projectFs/browseDirs`).",
          "type": "boolean"
        },
        "mediaE2ee": {
          "description": "The encrypted HTTP media lane.",
          "type": "boolean"
        },
        "nativePush": {
          "description": "`remoteAccess/registerNativePush`: the relay this core's leg is on delivers native pushes.",
          "type": "boolean"
        },
        "projectRecovery": {
          "description": "Project file recovery (`projectFs/recovery`).",
          "type": "boolean"
        },
        "remoteParity": {
          "description": "The update, trash, browser-page release, deduplicated submit, preview and pull-request calls (`remoteParity`).",
          "type": "boolean"
        },
        "routeAutoEffort": {
          "description": "`autoEffort` in model selections.",
          "type": "boolean"
        },
        "secretInput": {
          "description": "A handoff secret typed on the phone (`approval/provideSecret`).",
          "type": "boolean"
        },
        "termSizeOwner": {
          "description": "Terminal resizes follow the size-owner claim.",
          "type": "boolean"
        },
        "usageRequests": {
          "description": "The usage ledger's request list.",
          "type": "boolean"
        },
        "visualize": {
          "description": "The agent visualize panel.",
          "type": "boolean"
        }
      },
      "required": [
        "browserDrive",
        "browserFit",
        "browserSessionTabs",
        "browserWebrtc",
        "fileDownloads",
        "hostDirectories",
        "mediaE2ee",
        "nativePush",
        "projectRecovery",
        "remoteParity",
        "routeAutoEffort",
        "secretInput",
        "termSizeOwner",
        "usageRequests",
        "visualize"
      ],
      "type": "object"
    },
    "ServerCapabilities": {
      "description": "Core capabilities (D6: office and JS skills are unavailable without Node).",
      "properties": {
        "browser": {
          "$ref": "#/definitions/CapabilityState"
        },
        "computer": {
          "$ref": "#/definitions/CapabilityState"
        },
        "jsSkills": {
          "$ref": "#/definitions/CapabilityState"
        },
        "office": {
          "$ref": "#/definitions/CapabilityState"
        },
        "remote": {
          "allOf": [
            {
              "$ref": "#/definitions/RemoteCapabilities"
            }
          ],
          "default": {
            "browserDrive": false,
            "browserFit": false,
            "browserSessionTabs": false,
            "browserWebrtc": 0,
            "fileDownloads": false,
            "hostDirectories": false,
            "mediaE2ee": false,
            "nativePush": false,
            "projectRecovery": false,
            "remoteParity": false,
            "routeAutoEffort": false,
            "secretInput": false,
            "termSizeOwner": false,
            "usageRequests": false,
            "visualize": false
          },
          "description": "What a paired phone may use: Node's relay challenge flags (`remote-relay-client-lifecycle.ts:117-151` at b6f10295a). Absent from a core that predates it; read that as every flag off."
        },
        "voice": {
          "$ref": "#/definitions/CapabilityState"
        },
        "windowScope": {
          "default": 0,
          "description": "The version of the window method table the server holds a window-scoped connection to (`boundary::window_scope`); 0 from a core that has none.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "browser",
        "computer",
        "jsSkills",
        "office",
        "voice"
      ],
      "type": "object"
    }
  },
  "properties": {
    "capabilities": {
      "$ref": "#/definitions/ServerCapabilities"
    },
    "connection": {
      "$ref": "#/definitions/ConnectionInfo"
    },
    "coreState": {
      "$ref": "#/definitions/CoreState"
    },
    "defaultsSeparation": {
      "anyOf": [
        {
          "$ref": "#/definitions/DefaultsSeparation"
        },
        {
          "type": "null"
        }
      ],
      "description": "Set once per core start, before any connection is served. Absent from a core that predates it; read that as `ok`."
    },
    "limits": {
      "$ref": "#/definitions/Limits"
    },
    "platformFamily": {
      "type": "string"
    },
    "platformOs": {
      "type": "string"
    },
    "serverBuild": {
      "type": "string"
    },
    "serverInstanceId": {
      "description": "Changes on every core start; a different value means every held epoch is stale.",
      "type": "string"
    },
    "serverVersion": {
      "type": "string"
    },
    "userAgent": {
      "type": "string"
    }
  },
  "required": [
    "capabilities",
    "connection",
    "coreState",
    "limits",
    "platformFamily",
    "platformOs",
    "serverBuild",
    "serverInstanceId",
    "serverVersion",
    "userAgent"
  ],
  "title": "InitializeResponse",
  "type": "object"
}
