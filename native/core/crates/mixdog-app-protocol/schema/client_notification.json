{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ClientActivityParams": {
      "description": "`client/activity`: sent on user input, at most once per 60 s (client-side rate).",
      "properties": {
        "at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "at"
      ],
      "type": "object"
    },
    "ClientPerfLogParams": {
