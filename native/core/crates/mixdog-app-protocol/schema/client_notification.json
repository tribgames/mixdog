{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "BrowserStreamAckParams": {
      "description": "`browser/streamAck` (phone → core notification, Node's `browserRemoteStreamAck([sessionId, seq])`): the phone painted the `browser/frame` of `seq`, so its next (newest) frame of the session may go out.",
      "properties": {
        "seq": {
          "format": "double",
          "type": "number"
        },
        "sessionId": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "sessionId"
      ],
      "type": "object"
    },
    "ClientActivityParams": {
      "description": "`client/activity`: sent on user input, at most once per 60 s (client-side rate).",
      "properties": {
        "at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "at"
      ],
      "type": "object"
    },
    "ClientPerfLogParams": {
      "properties": {
        "line": {
          "type": "string"
        }
      },
      "required": [
        "line"
      ],
      "type": "object"
    },
    "HostBrowserFrameParams": {
      "description": "`host/browser/frame` (host → core notification, Node's `browserRemoteFrame` desktop operation): a frame of a viewed session (`DesktopRemoteBrowserStreamFrame`) without its picture bytes. When `frame.image` is present (`{mimeType: \"image/jpeg\"}`, no `data`), the picture is the next X17 frame of the session's stream on the same connection, and the core sends the frame once it has the picture; a frame without `image` carries facts only.",
      "properties": {
        "frame": true,
        "tabId": {
          "description": "The session, as in `host/browser/viewFrames`.",
          "type": "string"
        }
      },
      "required": [
        "frame",
        "tabId"
      ],
      "type": "object"
    },
    "HostBrowserPageParams": {
      "description": "`host/browser/page` (host → core notification): what a viewed browser page shows now — the document and the geometry its stream locked (Node's `source.page()` and `remoteMedia.geometryChanged`). `geometry` is `null` when the stream ended. The core's X17 frames carry pixels only; the phone's input coordinates need this.",
      "properties": {
        "documentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "geometry": {
          "description": "`{generation, cssWidth, cssHeight, deviceScaleFactor, pixelWidth, pixelHeight}`."
        },
        "tabId": {
          "description": "The browser session a phone streams (`sessionId` of its `browser/stream`; the source `browser:<id>` of its live-view signals), as in `host/browser/viewFrames`.",
          "type": "string"
        }
      },
      "required": [
        "tabId"
      ],
      "type": "object"
    },
    "HostBrowserSurfaceParams": {
      "description": "`host/browser/surface` (host → core notification): the window process's browser host asked its window to reveal or hide a session's browser surface (`browserRemoteOpen`). The core publishes it as `ui/openRequested { kind: \"browser\" }` so every attached client, paired phones included, opens the same surface. Fields are `UiOpenBrowser`'s.",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "handoff": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "hide": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reveal": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sessionId": {
          "type": "string"
        },
        "tabId": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "sessionId"
      ],
      "type": "object"
    },
    "HostNotificationClickedParams": {
      "properties": {
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId"
      ],
      "type": "object"
    },
    "HostPowerParams": {
      "properties": {
        "event": {
          "$ref": "#/definitions/PowerEvent"
        }
      },
      "required": [
        "event"
      ],
      "type": "object"
    },
    "HostUpdateReportParams": {
      "description": "Today's `DesktopUpdaterState`.",
      "properties": {
        "state": true
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "ModelProxyEventParams": {
      "description": "Electron → server core: one streamed event of a `model/proxy/execute` request.",
      "properties": {
        "event": {
          "$ref": "#/definitions/ProxyEvent"
        },
        "requestId": {
          "$ref": "#/definitions/RequestId"
        }
      },
      "required": [
        "event",
        "requestId"
      ],
      "type": "object"
    },
    "ModelProxyHeartbeatParams": {
      "description": "Electron → server core: these `model/proxy/execute` requests are still being run; the first beat of a request claims it, each renews its lease.",
      "properties": {
        "requestIds": {
          "items": {
            "$ref": "#/definitions/RequestId"
          },
          "type": "array"
        }
      },
      "required": [
        "requestIds"
      ],
      "type": "object"
    },
    "ModelProxyRunCancelParams": {
      "description": "Electron → its local core: stop the `modelProxy/run` run `run_id` (the abort of a `model/proxy/cancel`).",
      "properties": {
        "runId": {
          "type": "string"
        }
      },
      "required": [
        "runId"
      ],
      "type": "object"
    },
    "PowerEvent": {
      "enum": [
        "suspend",
        "resume"
      ],
      "type": "string"
    },
    "ProcessInputParams": {
      "properties": {
        "bytesB64": {
          "type": "string"
        },
        "processHandle": {
          "type": "string"
        }
      },
      "required": [
        "bytesB64",
        "processHandle"
      ],
      "type": "object"
    },
    "ProxyEvent": {
      "description": "One stream event of an attempt (`StreamEvent`).",
      "oneOf": [
        {
          "properties": {
            "item": {
              "$ref": "#/definitions/ProxyItemKind"
            },
            "phase": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ProxyPhase"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "enum": [
                "itemStart"
              ],
              "type": "string"
            }
          },
          "required": [
            "item",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "enum": [
                "textDelta"
              ],
              "type": "string"
            }
          },
          "required": [
            "text",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "enum": [
                "reasoningDelta"
              ],
              "type": "string"
            }
          },
          "required": [
            "text",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "replay": {
              "$ref": "#/definitions/ProxyReplay"
            },
            "type": {
              "enum": [
                "reasoningReplay"
              ],
              "type": "string"
            }
          },
          "required": [
            "replay",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "toolCallStart"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "delta": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "toolCallArgsDelta"
              ],
              "type": "string"
            }
          },
          "required": [
            "delta",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "call": {
              "$ref": "#/definitions/ProxyToolCall"
            },
            "type": {
              "enum": [
                "toolCallDone"
              ],
              "type": "string"
            }
          },
          "required": [
            "call",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "usage"
              ],
              "type": "string"
            },
            "usage": {
              "$ref": "#/definitions/ProxyUsage"
            }
          },
          "required": [
            "type",
            "usage"
          ],
          "type": "object"
        },
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "enum": [
                "refusal"
              ],
              "type": "string"
            }
          },
          "required": [
            "text",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "citation"
              ],
              "type": "string"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "serverToolBlock"
              ],
              "type": "string"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "providerKeepalive"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Semantic progress of the stream that has no delta event of its own (`StreamEvent::Progress`).",
          "properties": {
            "kind": {
              "$ref": "#/definitions/ProxyProgress"
            },
            "type": {
              "enum": [
                "progress"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "What one wire chunk reports for everything it carries; `null`: transport only (`StreamEvent::ChunkProgress`).",
          "properties": {
            "kind": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ProxyProgress"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "enum": [
                "chunkProgress"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The assistant text the turn returns when it is not what the deltas folded to (`StreamEvent::FinalContent`).",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "enum": [
                "finalContent"
              ],
              "type": "string"
            }
          },
          "required": [
            "text",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The tool calls the turn returns when they are not the ones dispatched live (`StreamEvent::ReturnedCalls`).",
          "properties": {
            "calls": {
              "items": {
                "$ref": "#/definitions/ProxyToolCall"
              },
              "type": "array"
            },
            "type": {
              "enum": [
                "returnedCalls"
              ],
              "type": "string"
            }
          },
          "required": [
            "calls",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Anthropic extended-thinking blocks, verbatim and ordered (`StreamEvent::ThinkingBlocks`).",
          "properties": {
            "type": {
              "enum": [
                "thinkingBlocks"
              ],
              "type": "string"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": true,
            "type": {
              "enum": [
                "providerState"
              ],
              "type": "string"
            }
          },
          "required": [
            "state",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A display-only transcript notice raised while preparing the request (`StreamEvent::Notice`).",
          "properties": {
            "message": {
              "type": "string"
            },
            "type": {
              "enum": [
                "notice"
              ],
              "type": "string"
            },
            "warn": {
              "type": "boolean"
            }
          },
          "required": [
            "message",
            "type",
            "warn"
          ],
          "type": "object"
        },
        {
          "description": "The model that answered when it is not the one the request named (`StreamEvent::ServedModel`).",
          "properties": {
            "model": {
              "type": "string"
            },
            "type": {
              "enum": [
                "servedModel"
              ],
              "type": "string"
            }
          },
          "required": [
            "model",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Provider facts the committed assistant turn keeps, Anthropic's fallback record (`StreamEvent::ProviderMetadata`).",
          "properties": {
            "type": {
              "enum": [
                "providerMetadata"
              ],
              "type": "string"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "The id the provider gave the response, which the usage ledger books the send under (`StreamEvent::ResponseId`).",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "responseId"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The roster account that served the answer (`StreamEvent::AccountRouting`, Node `providerMetadata.accountRouting`).",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "sessionAccountId": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "enum": [
                "accountRouting"
              ],
              "type": "string"
            }
          },
          "required": [
            "accountId",
            "provider",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The account pool moves on to the next account (`StreamEvent::AccountStage`, Node `onStageChange('reconnecting')`).",
          "properties": {
            "message": {
              "type": "string"
            },
            "type": {
              "enum": [
                "accountSwitching"
              ],
              "type": "string"
            }
          },
          "required": [
            "message",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A fallback account became the selected one (`StreamEvent::AccountStage`, Node `onStageChange('account-changed')`).",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "at": {
              "format": "int64",
              "type": "integer"
            },
            "provider": {
              "type": "string"
            },
            "type": {
              "enum": [
                "accountChanged"
              ],
              "type": "string"
            }
          },
          "required": [
            "accountId",
            "at",
            "provider",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The send went out once more on another wire after a refusal; the session's new `wireRoute`, whole (`StreamEvent::WireRerouted`, Node `wireReroute`).",
          "properties": {
            "route": true,
            "type": {
              "enum": [
                "wireRerouted"
              ],
              "type": "string"
            }
          },
          "required": [
            "route",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The model began its output, which the usage ledger times the first-output wait from (`StreamEvent::OutputStarted`, Node `firstOutputAt`).",
          "properties": {
            "type": {
              "enum": [
                "outputStarted"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "`pricing_model`: the catalog model the send bills as when it differs from the one sent. `request_ms`: the request's wall time as the usage ledger measured it (Node `usageDurationMs`).",
          "properties": {
            "pricingModel": {
              "type": [
                "string",
                "null"
              ]
            },
            "requestMs": {
              "format": "uint64",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "stop": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ProxyStop"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "enum": [
                "completed"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The attempt failed and a retry begins: everything its events showed is dropped.",
          "properties": {
            "type": {
              "enum": [
                "attemptDiscarded"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A retried attempt reported usage before it died; it is billed once, here.",
          "properties": {
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "enum": [
                "attemptAbandoned"
              ],
              "type": "string"
            },
            "usage": {
              "$ref": "#/definitions/ProxyUsage"
            }
          },
          "required": [
            "type",
            "usage"
          ],
          "type": "object"
        }
      ]
    },
    "ProxyItemKind": {
      "enum": [
        "text",
        "reasoning",
        "tool"
      ],
      "type": "string"
    },
    "ProxyPhase": {
      "enum": [
        "commentary",
        "finalAnswer"
      ],
      "type": "string"
    },
    "ProxyProgress": {
      "enum": [
        "semantic",
        "reasoning",
        "text",
        "tool"
      ],
      "type": "string"
    },
    "ProxyReplay": {
      "properties": {
        "items": true,
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "items",
        "owner"
      ],
      "type": "object"
    },
    "ProxyStop": {
      "oneOf": [
        {
          "properties": {
            "kind": {
