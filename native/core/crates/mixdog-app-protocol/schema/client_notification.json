                "endTurn"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "toolUse"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "maxTokens"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "stopSequence"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "contentFilter"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "refusal"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "continueTurn"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "other"
              ],
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "ProxyToolCall": {
      "properties": {
        "arguments": true,
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nativeType": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "arguments",
        "id",
        "name"
      ],
      "type": "object"
    },
    "ProxyUsage": {
      "properties": {
        "cacheReadTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "cacheWrite1hTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "cacheWriteTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "costTicks": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "inputTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "outputTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "raw": true,
        "reasoningIncomplete": {
          "default": false,
          "description": "`reasoningTokensComplete === false` on an aggregate.",
          "type": "boolean"
        },
        "reasoningTokens": {
          "description": "Absent when the provider reported none; an explicit 0 stays 0.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "cacheReadTokens",
        "cacheWrite1hTokens",
        "cacheWriteTokens",
        "inputTokens",
        "outputTokens"
      ],
      "type": "object"
    },
    "RemoteConnectionTimelineParams": {
      "description": "Client notification `remote/connectionTimeline` (paired phone → core): the phone's own account of a slow reconnect (phase, state and issue tokens with ms offsets), Node's `reportConnectionTimeline`. The core writes it to its log as Node's PC did (`remote-relay-client-calls.ts:181-186`): the first 1500 UTF-16 units, without any character outside `[A-Za-z0-9_=@:. -]`, as `[mixdog-remote-timeline] client=<the relay client id's first 8 units> <text>`, nothing when that leaves no text. Only an attached relay connection is heard. No response.",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "RequestId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "format": "int64",
          "type": "integer"
        }
      ]
