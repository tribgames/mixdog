        "requestId"
      ],
      "type": "object"
    },
    "PowerEvent": {
      "enum": [
        "suspend",
        "resume"
      ],
      "type": "string"
    },
    "ProcessInputParams": {
      "properties": {
        "bytesB64": {
          "type": "string"
        },
        "processHandle": {
          "type": "string"
        }
      },
      "required": [
        "bytesB64",
        "processHandle"
      ],
      "type": "object"
    },
    "RequestId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "format": "int64",
          "type": "integer"
        }
