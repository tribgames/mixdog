        "rows": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "tabId": {
          "type": "string"
        }
      },
      "required": [
        "cols",
        "rows",
        "tabId"
      ],
      "type": "object"
    }
