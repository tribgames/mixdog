        "sessionId"
      ],
      "type": "object"
    },
    "LiveControlKind": {
      "description": "What `host/browser/liveControl` carries to the viewed page.",
      "oneOf": [
        {
          "description": "A phone's `resize-request`: `request` is its `resize` object (`{mode: \"page\"}` or `{mode: \"fit-client\", cssWidth, cssHeight, deviceScaleFactor}`); the host resizes the page (Node's `remote.resize(sessionId, request)`).",
          "enum": [
            "resize"
          ],
          "type": "string"
        },
        {
          "description": "A phone's `ready.videoLimit`: `request` is `{maxWidth, maxHeight}`; the host may capture larger than its frame bound, up to it, and lock a new geometry (Node's `remote.widenVideo(sessionId, limit)`).",
          "enum": [
            "videoLimit"
          ],
          "type": "string"
        }
      ]
    },
    "LocalPageScope": {
      "description": "What a `host/localPage/url` lease covers; absent means `project`.",
      "enum": [
        "file",
        "project"
      ],
      "type": "string"
    },
    "ModelProxyExecuteParams": {
      "description": "Server core → a connection with `capabilities.modelProxy`: run one model call with this machine's accounts. Completion is the response; losing the connection resolves the call `cancelled`.",
      "properties": {
        "call": {
          "$ref": "#/definitions/ProxyCall"
        }
      },
      "required": [
        "call"
      ],
      "type": "object"
    },
