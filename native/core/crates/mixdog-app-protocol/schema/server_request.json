    "HostVisualizeCommandParams": {
      "description": "Params of `host/visualize/command` (core → host): the loopback bridge's request body. The result is the service's object (`{text, tabs?, path?, …}`), `null` when it returns nothing (`visualizeCommand`: `(await visualize.command(…)) ?? null`).",
      "properties": {
        "action": {
          "$ref": "#/definitions/VisualizeAction"
        },
