          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sharedCachePrefixCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "temperature": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "thread": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProxyThread"
            },
            {
              "type": "null"
            }
          ]
        },
        "toolChoice": {
          "type": [
            "string",
            "null"
          ]
        },
        "verbosity": {
          "type": [
            "string",
            "null"
          ]
        },
        "xaiResponsesCacheScope": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "fast",
        "hostedTools",
        "iteration"
      ],
      "type": "object"
