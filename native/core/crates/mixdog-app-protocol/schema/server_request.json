    },
    "ProxyOptions": {
      "description": "`RequestOptions` field for field. The connection scope and the model's output ceiling are the PC's to derive, so they are not carried.",
      "properties": {
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "effortProjection": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProxyEffortProjection"
            },
            {
              "type": "null"
            }
          ]
        },
        "fast": {
          "type": "boolean"
        },
        "forkedTransportScope": {
          "default": false,
          "description": "The server forked this request from a session (a side question) and gave it a transport scope of its own (`options.transportScope`). Its string means nothing on this PC, which allocates a scope for the request and releases it when the request ends.",
          "type": "boolean"
        },
        "hostedTools": {
          "items": {
            "$ref": "#/definitions/ProxyHostedTool"
          },
          "type": "array"
        },
        "iteration": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxOutputTokensOverride": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
