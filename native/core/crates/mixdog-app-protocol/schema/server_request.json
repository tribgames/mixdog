    "ProxyBinary": {
      "description": "A file part's bytes. The sender's attachment-store reference means nothing on the PC, so it is never carried: the sender inlines the bytes (under its byte budget), and a reference that stays travels as `unavailable`.",
      "oneOf": [
        {
          "properties": {
            "data": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "base64"
              ],
              "type": "string"
            }
          },
          "required": [
            "data",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "unavailable"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
