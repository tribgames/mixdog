<td align="right"><strong>2.0%</strong></td>
<td align="right">1.9%</td>
<td align="right">3.0%</td>
<td align="right"><strong>−1.0 pts</strong> [−1.3, −0.7]</td>
</tr>
<tr>
<td>Agent steps (n = 1,371): exact</td>
<td align="right"><strong>66.5%</strong></td>
<td align="right">58.1%</td>
<td align="right">57.4%</td>
<td align="right"><strong>+9.1 pts</strong> [5.8, 12.1]</td>
</tr>
<tr>
<td>Agent steps: weighted kappa</td>
<td align="right"><strong>0.543</strong></td>
<td align="right">0.398</td>
