{
  "name": "todo",
  "title": "Todo",
  "description": "The step list for this request; the Lead and each agent keep their own. set replaces the whole plan; init refuses to replace unfinished work. Supply items or phases. advance closes the active step and starts the next pending one. done, start, drop and rm take a 1-based step number or the step's exact wording. done can close several and start another in the same call. append adds steps to an existing list under the named or last phase. set/init and view show the whole list; other mutations acknowledge the change and show the next step, so no view is needed to confirm them.",
  "annotations": {
    "title": "Todo",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "agentHidden": false
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "op": {
        "type": "string",
        "enum": [
          "set",
          "init",
          "advance",
          "done",
          "start",
          "drop",
          "append",
          "rm",
          "view"
        ]
      },
      "items": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "content": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "in_progress",
                    "completed",
                    "abandoned"
                  ]
                }
              },
              "required": [
                "content"
              ],
              "additionalProperties": false
            }
          ]
        },
        "minItems": 1,
        "maxItems": 50,
        "description": "set/init: steps in order as wording or {content, status}; append requires step wordings only."
      },
      "done": {
        "type": "integer",
        "minimum": 0,
        "description": "set: how many of the leading steps are already finished (a plan set again part-way); a step's own status wins."
      },
      "index": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1
          }
        ],
        "description": "done/start/drop/rm: the step number; done also takes a list of them."
      },
      "start": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "string"
          }
        ],
        "description": "done: the step number (or exact wording) to begin in the same call."
      },
      "note": {
        "type": "string",
        "description": "advance/done: one-line evidence; drop: optional one-line reason."
      },
      "phases": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "content": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "pending",
                          "in_progress",
                          "completed",
                          "abandoned"
                        ]
                      }
                    },
                    "required": [
                      "content"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 50
            }
          },
          "required": [
            "name",
            "items"
          ],
          "additionalProperties": false
        },
        "description": "set/init: named phases of steps instead of items."
      },
      "phase": {
        "type": "string",
        "description": "set/init/append: the phase for items (append default: the last; a new name adds one)."
      },
      "item": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        ],
        "description": "done/start/drop/rm: the step's exact wording (instead of index); done also takes a list."
      }
    },
    "required": [
      "op"
    ],
    "additionalProperties": false
  }
}
