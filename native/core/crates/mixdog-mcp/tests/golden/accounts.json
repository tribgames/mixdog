  {
   "name": "last used in the conversation and by the connector",
   "connector": "linear",
   "accounts": [
    {
     "name": "linear",
     "id": "linear|a@example.com",
     "email": "a@example.com",
     "authRequired": false,
     "tools": [
      "search",
      "create"
     ]
    },
    {
     "name": "linear-2",
     "id": "linear-2|b@example.com",
     "email": "b@example.com",
     "authRequired": false,
     "tools": [
      "search",
      "create"
     ]
    }
   ],
   "steps": [
    {
     "op": "init",
     "listed": [
      "search",
      "create"
     ]
    },
    {
     "op": "state",
     "file": "in-use",
     "raw": "{\n  \"linear\": {\n    \"name\": \"linear-2\",\n    \"id\": \"linear-2|b@example.com\"\n  }\n}\n"
    },
    {
     "op": "state",
     "file": "conv",
     "raw": "{\n  \"conv-1\": {\n    \"accounts\": {\n      \"linear\": {\n        \"name\": \"linear-2\",\n        \"id\": \"linear-2|b@example.com\"\n      }\n    }\n  }\n}\n"
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-1",
     "expect": {
      "ok": {
       "name": "linear-2",
       "label": "b@example.com"
      }
     }
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-2",
     "expect": {
      "ok": {
       "name": "linear-2",
       "label": "b@example.com"
      }
     }
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "",
     "expect": {
      "ok": {
       "name": "linear-2",
       "label": "b@example.com"
      }
     }
    },
    {
     "op": "state",
     "file": "in-use",
     "raw": "{\n  \"linear\": {\n    \"name\": \"linear\",\n    \"id\": \"linear|a@example.com\"\n  }\n}\n"
    },
    {
     "op": "state",
     "file": "conv",
     "raw": "{\n  \"conv-1\": {\n    \"accounts\": {\n      \"linear\": {\n        \"name\": \"linear-2\",\n        \"id\": \"linear-2|b@example.com\"\n      }\n    }\n  },\n  \"conv-2\": {\n    \"accounts\": {\n      \"linear\": {\n        \"name\": \"linear\",\n        \"id\": \"linear|a@example.com\"\n      }\n    }\n  }\n}\n"
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-1",
     "expect": {
      "ok": {
       "name": "linear-2",
       "label": "b@example.com"
      }
     }
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-2",
     "expect": {
      "ok": {
       "name": "linear",
       "label": "a@example.com"
      }
     }
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-3",
     "expect": {
      "ok": {
       "name": "linear",
       "label": "a@example.com"
      }
     }
    }
   ],
   "leftover": 0
  },
  {
   "name": "a remembered account is its identity",
   "connector": "linear",
   "accounts": [
    {
     "name": "linear",
     "id": "linear|a@example.com",
     "email": "a@example.com",
     "authRequired": false,
     "tools": [
      "search",
      "create"
     ]
    },
    {
     "name": "linear-2",
     "id": "added-later",
     "email": "new@example.com",
     "authRequired": false,
     "tools": [
      "search",
      "create"
     ]
    }
   ],
   "steps": [
    {
     "op": "init",
     "listed": [
      "search",
      "create"
     ]
    },
    {
     "op": "state",
     "file": "in-use",
     "raw": "{}"
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-l1",
     "expect": {
      "ok": {
       "name": "linear",
       "label": "a@example.com"
      }
     }
    },
    {
     "op": "state",
     "file": "in-use",
     "raw": "{\"linear\":\"linear-2\"}"
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-l3",
     "expect": {
      "error": "The Linear account used last (linear-2) cannot be confirmed as the same account. Usable Linear accounts: a@example.com, new@example.com. Pass one as `account`."
     }
    },
    {
     "op": "state",
     "file": "in-use",
     "raw": "{\"linear\":{\"name\":\"linear-2\",\"id\":\"linear-2|b@example.com\"}}"
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-l2",
     "expect": {
      "error": "The Linear account used last (linear-2 (removed)) is not connected now. Usable Linear accounts: a@example.com, new@example.com. Pass one as `account`."
     }
    },
    {
     "op": "state",
     "file": "in-use",
     "raw": "{\"linear\":{\"name\":\"linear-2\",\"id\":\"added-later\"}}"
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-l2",
     "expect": {
      "ok": {
       "name": "linear-2",
       "label": "new@example.com"
      }
     }
    },
    {
     "op": "state",
     "file": "in-use",
     "raw": "{\"linear\":{\"name\":\"gone\",\"id\":\"x\"}}"
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-l2",
     "expect": {
      "error": "The Linear account used last (gone) is not connected now. Usable Linear accounts: a@example.com, new@example.com. Pass one as `account`."
     }
    },
    {
     "op": "state",
     "file": "in-use",
     "raw": "{\"linear\":{\"name\":\"linear\",\"id\":\"\"}}"
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-l2",
     "expect": {
      "error": "The Linear account used last (linear) cannot be confirmed as the same account. Usable Linear accounts: a@example.com, new@example.com. Pass one as `account`."
     }
    },
    {
     "op": "state",
     "file": "in-use",
     "raw": "{\"linear\":{\"name\":\"\",\"id\":\"x\"},\"#ids\":true}"
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-l2",
     "expect": {
      "ok": {
       "name": "linear",
       "label": "a@example.com"
      }
     }
    },
    {
     "op": "state",
     "file": "in-use",
     "raw": "{\"linear\":7}"
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-l2",
     "expect": {
      "ok": {
       "name": "linear",
       "label": "a@example.com"
      }
     }
    },
    {
     "op": "state",
     "file": "conv",
     "raw": "{\"conv-l9\":{\"accounts\":{\"linear\":{\"name\":\"linear-2\",\"id\":\"linear-2|b@example.com\"}}}}"
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-l9",
     "expect": {
      "error": "The Linear account used last (linear-2 (removed)) is not connected now. Usable Linear accounts: a@example.com, new@example.com. Pass one as `account`."
     }
    },
    {
     "op": "state",
     "file": "conv",
     "raw": "{\"conv-l9\":{\"accounts\":\"x\"}}"
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-l9",
     "expect": {
      "ok": {
       "name": "linear",
       "label": "a@example.com"
      }
     }
    },
    {
     "op": "state",
     "file": "conv",
     "raw": "{\"conv-l9\":\"x\"}"
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "conv-l9",
     "expect": {
      "ok": {
       "name": "linear",
       "label": "a@example.com"
      }
     }
    }
   ],
   "leftover": 0
