{
 "scenarios": [
  {
   "name": "defaults and naming",
   "connector": "linear",
   "accounts": [
    {
     "name": "linear",
     "id": "linear|a@example.com",
     "email": "a@example.com",
     "authRequired": false,
     "tools": [
      "search",
      "create"
     ]
    },
    {
     "name": "linear-2",
     "id": "linear-2|b@example.com",
     "email": "b@example.com",
     "authRequired": false,
     "tools": [
      "search",
      "create"
     ]
    }
   ],
   "steps": [
    {
     "op": "init",
     "listed": [
      "search",
      "create"
     ]
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "",
     "expect": {
      "ok": {
       "name": "linear",
       "label": "a@example.com"
      }
     }
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "",
     "wanted": "linear-2",
     "expect": {
      "ok": {
       "name": "linear-2",
       "label": "b@example.com"
      }
     }
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "",
     "wanted": "LINEAR-2",
     "expect": {
      "ok": {
       "name": "linear-2",
       "label": "b@example.com"
      }
     }
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "",
     "wanted": "  B@Example.com  ",
     "expect": {
      "ok": {
       "name": "linear-2",
       "label": "b@example.com"
      }
     }
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "",
     "wanted": " b@example.com ",
     "expect": {
      "ok": {
       "name": "linear-2",
       "label": "b@example.com"
      }
     }
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "",
     "wanted": "nobody",
     "expect": {
      "error": "No connected Linear account is \"nobody\". Usable Linear accounts: a@example.com, b@example.com. Pass one as `account`."
     }
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "",
     "wanted": 5,
     "expect": {
      "ok": {
       "name": "linear",
       "label": "a@example.com"
      }
     }
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "",
     "wanted": "",
     "expect": {
      "ok": {
       "name": "linear",
       "label": "a@example.com"
      }
     }
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "",
     "wanted": "   ",
     "expect": {
      "ok": {
       "name": "linear",
       "label": "a@example.com"
      }
     }
    },
    {
     "op": "choose",
     "tool": "search",
     "conversation": "",
     "wanted": null,
     "expect": {
      "ok": {
       "name": "linear",
       "label": "a@example.com"
      }
     }
    }
