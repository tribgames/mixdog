{
  "run": {
    "platform": "win32",
    "afterBegin": {
      "files": [
        "process-lifecycle.active",
        "process-lifecycle.jsonl"
      ],
      "markers": [
        "self-<token>.json"
      ],
      "marker": {
        "version": 1,
        "timestamp": true,
        "pid": "self",
        "ppid": "number",
        "token": true,
        "processIdentity": {
          "kind": "start-seconds",
          "method": "uptime",
          "value": "seconds"
        }
      },
      "ledger": [
        {
          "version": 1,
          "timestamp": true,
          "pid": "self",
          "ppid": "number",
          "reason": "process-start",
          "exitCode": null,
          "memory": "rss",
          "cwd": "<cwd>"
        }
      ]
    },
    "afterUpgrade": {
      "marker": {
        "version": 1,
        "timestamp": true,
        "pid": "self",
        "ppid": "number",
        "token": true,
        "processIdentity": {
          "kind": "start-seconds",
          "method": "os",
          "value": "seconds"
        }
      }
    },
    "fatal": true,
    "finish": true,
    "end": {
      "files": [
        "process-lifecycle.active",
        "process-lifecycle.jsonl"
      ],
      "markers": [],
