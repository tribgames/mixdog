{
  "area": "session",
  "description": "The session lifecycle of office-com-session-host.ps1: open and create per format in background and visible mode, attach to a document an application of its own holds, the refusal of an attach on a document that is not open, a background session while a user's Word is running, close with and without a save, the end of stdin with a session open, and an application killed before close. Not covered by the recorder's step kinds: a file locked by another process (the refusal to open a duplicate of a file that appears open) and stdin ending while open_session is still running (both need a step the recorder does not have); tests/session.rs holds those two against a scripted platform.",
  "scenarios": [
    {
      "id": "docx-background-create",
      "description": "A new docx document in a background application of the session host's own, then closed with a save.",
      "steps": [
        {
          "session": "a",
          "start": true
        },
        {
          "send": {
            "session": "a",
            "request": {
              "action": "open_session",
              "session": "s-docx",
              "format": "docx",
              "path": "${work}\\s.docx",
              "mode": "background",
              "create": true
            }
          },
          "label": "open",
          "expect": {
            "contains": "\"ok\":true"
          }
        },
        {
          "send": {
            "session": "a",
            "request": {
              "action": "close_session",
              "session": "s-docx",
              "save": true
            }
          },
          "label": "close",
          "expect": {
            "contains": "\"closed\":true"
          }
        },
        {
          "eof": "a"
        }
      ],
      "collect": [
        "s.docx"
      ]
    },
