{
  "area": "ppt-read",
  "description": "The PowerPoint reader of office-com-host.ps1 (Snapshot-PowerPoint, Snapshot-Selection for pptx, Issues-PowerPoint): decks built by the PowerShell host itself from its own operations, then read whole, paged, by pages and with the selection, and inspected for issues. Recorded on the migration PC with Microsoft PowerPoint (record-office-com.mjs --area ppt-read) and replayed by tests/ppt_read.rs against the fake dispatch object. Not covered by the recorder's step kinds: a selection of text inside a shape (the user is typing), and an installation of PowerPoint in another UI language (layout and design names follow it): the Korean-UI deck is these scenarios recorded on a Korean-UI PC.",
  "scenarios": [
    {
      "id": "snapshot-shapes",
      "description": "A deck of text boxes, a rotated text box, shapes of several geometries, a table, a group, notes, a comment, an animation, a transition and a slide background: the whole snapshot, paged, and by pages.",
      "steps": [
        {
          "copy": "../ppt-read/inputs/pixel.png",
          "as": "pixel.png",
          "prepare": true
        },
        {
          "session": "make",
          "start": true,
          "prepare": true
        },
        {
          "send": {
            "session": "make",
            "request": {
              "action": "open_session",
              "session": "mk",
              "format": "pptx",
              "path": "${work}\\shapes.pptx",
              "mode": "background",
              "create": true
            }
          },
          "expect": {
            "contains": "\"ok\":true"
          },
          "prepare": true
        },
        {
          "send": {
            "session": "make",
            "request": {
              "session": "mk",
              "action": "batch",
              "operations": [
                {
                  "op": "add_slide"
                },
                {
                  "op": "add_slide"
                },
                {
                  "op": "add_slide"
                },
                {
                  "op": "add_textbox",
                  "slide": 1,
                  "text": "Quarterly review",
                  "left": 48,
                  "top": 40,
                  "width": 500,
                  "height": 60,
                  "fontSize": 36,
                  "fontName": "Arial",
                  "color": "1A1A1A"
                },
                {
                  "op": "add_textbox",
                  "slide": 1,
                  "text": "분기 검토 결과 요약",
                  "left": 48,
                  "top": 120,
                  "width": 400,
                  "height": 40,
                  "fontSize": 18,
                  "color": "FFFFFF",
                  "fillColor": "0B5FFF"
                },
                {
                  "op": "add_textbox",
                  "slide": 1,
                  "text": "Rotated label",
                  "left": 300,
                  "top": 300,
                  "width": 160,
                  "height": 40,
                  "fontSize": 14,
                  "properties": {
                    "rotation": 20,
                    "bold": true
                  }
                },
                {
                  "op": "add_shape",
                  "slide": 1,
                  "shapeType": "rect",
                  "left": 600,
                  "top": 40,
                  "width": 120,
                  "height": 80,
                  "fillColor": "FFCC00"
                },
                {
                  "op": "add_shape",
                  "slide": 1,
                  "shapeType": "chevron",
                  "left": 600,
                  "top": 140,
                  "width": 120,
                  "height": 60,
                  "fillColor": "0B5FFF"
                },
                {
                  "op": "add_shape",
                  "slide": 1,
                  "shapeType": "line",
                  "left": 48,
                  "top": 200,
                  "width": 300,
                  "height": 0,
                  "lineColor": "333333"
                },
                {
                  "op": "group_shapes",
                  "slide": 1,
                  "shapes": [
                    4,
                    5
                  ]
                },
                {
                  "op": "add_table",
                  "slide": 2,
                  "values": [
                    [
                      "Item",
                      "Q1",
                      "Q2"
                    ],
                    [
                      "Revenue",
                      "10",
                      "12"
                    ],
                    [
                      "Cost",
                      "7",
                      "8"
                    ]
                  ],
                  "left": 48,
                  "top": 80,
                  "width": 480,
                  "height": 120
                },
                {
                  "op": "add_image",
                  "slide": 2,
                  "path": "${work}\\pixel.png",
                  "left": 560,
                  "top": 80,
                  "width": 120,
                  "height": 120,
                  "altText": "A pixel"
                },
                {
                  "op": "crop_image",
                  "slide": 2,
                  "shape": 2,
                  "left": 0.1,
                  "top": 0.1
                },
                {
                  "op": "add_image",
                  "slide": 2,
                  "path": "${work}\\pixel.png",
                  "left": 560,
                  "top": 240,
                  "width": 120,
                  "height": 120
                },
                {
                  "op": "add_textbox",
                  "slide": 3,
                  "text": "Numbers: 12, 34",
                  "left": 48,
                  "top": 40,
                  "width": 400,
                  "height": 40
                },
                {
                  "op": "set_notes",
                  "slide": 1,
                  "text": "Source: Model!B2"
                },
                {
                  "op": "add_comment",
                  "slide": 1,
                  "text": "Check this",
                  "left": 30,
                  "top": 30
                },
                {
                  "op": "add_animation",
                  "slide": 1,
                  "shape": 1,
                  "effect": "fade",
                  "trigger": "on_click",
                  "duration": 0.5,
                  "delay": 0.2
                },
                {
                  "op": "set_transition",
                  "slide": 1,
                  "effect": "fade",
                  "advanceOnTime": true,
                  "advanceTime": 3
                },
                {
                  "op": "set_slide_background",
                  "slide": 2,
                  "color": "101820"
                },
                {
                  "op": "set_slide_visibility",
                  "slide": 3,
                  "visible": false
                }
              ]
            }
          },
          "expect": {
            "contains": "\"ok\":true"
          },
          "prepare": true
        },
        {
          "send": {
            "session": "make",
            "request": {
              "action": "close_session",
              "session": "mk",
              "save": true
            }
          },
          "expect": {
            "contains": "\"closed\":true"
          },
          "prepare": true
        },
        {
          "eof": "make",
          "prepare": true
        },
        {
          "oneShot": {
            "action": "snapshot",
            "format": "pptx",
            "path": "${work}\\shapes.pptx"
          },
          "label": "full",
          "expect": {
            "contains": "\"ok\":true"
          }
        },
        {
          "oneShot": {
            "action": "snapshot",
            "format": "pptx",
            "path": "${work}\\shapes.pptx",
            "paged": true,
            "offset": 0,
            "limit": 2
          },
          "label": "paged",
          "expect": {
            "contains": "\"ok\":true"
          }
        },
        {
          "oneShot": {
            "action": "snapshot",
            "format": "pptx",
            "path": "${work}\\shapes.pptx",
            "paged": true,
            "offset": 2,
            "limit": 2
          },
          "label": "paged-last",
          "expect": {
            "contains": "\"ok\":true"
          }
        },
        {
          "oneShot": {
            "action": "snapshot",
            "format": "pptx",
            "path": "${work}\\shapes.pptx",
            "pages": [
              3,
              1
            ]
          },
          "label": "pages",
          "expect": {
            "contains": "\"ok\":true"
          }
        },
        {
          "oneShot": {
            "action": "snapshot",
            "format": "pptx",
            "path": "${work}\\shapes.pptx",
            "pages": [
              9
            ]
          },
          "label": "out-of-range",
          "expect": {
            "contains": "PowerPoint slide out of range: 9"
          }
        }
      ],
      "collect": [
        "shapes.pptx"
      ]
    },
    {
      "id": "snapshot-charts",
      "description": "A slide with every chart kind the writer makes (column with value labels, line with a trendline, pie, doughnut, bar, scatter), error bars and a configured value axis; read whole and inspected for issues.",
      "steps": [
        {
          "session": "make",
          "start": true,
          "prepare": true
        },
        {
          "send": {
            "session": "make",
            "request": {
              "action": "open_session",
              "session": "mk",
              "format": "pptx",
              "path": "${work}\\charts.pptx",
              "mode": "background",
