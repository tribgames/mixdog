    {
      "id": "snapshot-selection",
      "description": "A visible session: the snapshot of a deck with the selection of the window (the active slide), whole and paged.",
      "steps": [
        {
          "session": "a",
          "start": true
        },
        {
          "send": {
            "session": "a",
            "request": {
              "action": "open_session",
              "session": "sel",
              "format": "pptx",
              "path": "${work}\\sel.pptx",
              "mode": "visible",
              "create": true
            }
          },
          "label": "open",
          "expect": {
            "contains": "\"ok\":true"
          }
        },
        {
          "send": {
            "session": "a",
            "request": {
              "session": "sel",
              "action": "batch",
              "operations": [
                {
                  "op": "add_slide"
                },
                {
                  "op": "add_slide"
                },
                {
                  "op": "add_textbox",
                  "slide": 2,
                  "text": "One",
                  "left": 60,
                  "top": 60
                },
                {
                  "op": "add_textbox",
                  "slide": 2,
                  "text": "Two",
                  "left": 60,
                  "top": 160
                }
              ]
            }
          },
          "label": "batch",
          "expect": {
            "contains": "\"ok\":true"
          }
        },
        {
          "send": {
            "session": "a",
            "request": {
              "session": "sel",
              "action": "snapshot",
              "includeSelection": true
            }
          },
          "label": "snapshot-with-selection",
          "expect": {
            "contains": "\"selection\""
          }
        },
        {
          "send": {
            "session": "a",
            "request": {
              "session": "sel",
              "action": "snapshot",
              "paged": true,
              "offset": 0,
              "limit": 1,
              "includeSelection": true
            }
          },
          "label": "paged-with-selection",
          "expect": {
            "contains": "\"selection\""
          }
        },
        {
          "send": {
            "session": "a",
            "request": {
              "session": "sel",
              "action": "close_session"
            }
          },
          "label": "close",
          "expect": {
            "contains": "\"closed\":true"
          }
        },
        {
          "eof": "a"
        }
      ],
      "collect": []
    }
  ]
}
