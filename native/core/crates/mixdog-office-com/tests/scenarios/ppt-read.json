                  "left": 40,
                  "top": 40,
                  "width": 320,
                  "height": 220
                },
                {
                  "op": "add_chart",
                  "slide": 1,
                  "chartType": "line",
                  "categories": [
                    "A",
                    "B",
                    "C"
                  ],
                  "series": [
                    {
                      "name": "S1",
                      "values": [
                        1,
                        4,
                        9
                      ]
                    }
                  ],
                  "left": 380,
                  "top": 40,
                  "width": 320,
                  "height": 220
                },
                {
                  "op": "add_chart",
                  "slide": 1,
                  "chartType": "pie",
                  "categories": [
                    "A",
                    "B"
                  ],
                  "series": [
                    {
                      "name": "P",
                      "values": [
                        60,
                        40
                      ]
                    }
                  ],
                  "left": 40,
                  "top": 280,
                  "width": 240,
                  "height": 200
                },
                {
                  "op": "add_chart",
                  "slide": 1,
                  "chartType": "doughnut",
                  "categories": [
                    "A",
                    "B"
                  ],
                  "series": [
                    {
                      "name": "D",
                      "values": [
                        30,
                        70
                      ]
                    }
                  ],
                  "left": 300,
                  "top": 280,
                  "width": 200,
                  "height": 200
                },
                {
                  "op": "add_chart",
                  "slide": 1,
                  "chartType": "bar",
                  "categories": [
                    "A",
                    "B",
                    "C"
                  ],
                  "series": [
                    {
                      "name": "B",
                      "values": [
                        5,
                        3,
                        1
                      ]
                    }
                  ],
                  "left": 520,
                  "top": 280,
                  "width": 200,
                  "height": 200
                },
                {
                  "op": "add_chart",
                  "slide": 1,
                  "chartType": "scatter",
                  "categories": [
                    1,
                    2,
                    3
                  ],
                  "series": [
                    {
                      "name": "X",
                      "values": [
                        2,
                        4,
                        8
                      ]
                    }
                  ],
                  "left": 40,
                  "top": 40,
                  "width": 200,
                  "height": 160
                },
                {
                  "op": "set_chart_trendline",
                  "slide": 1,
                  "shape": 2,
                  "series": 1,
                  "type": "linear",
                  "displayEquation": true
                },
                {
                  "op": "set_chart_error_bars",
                  "slide": 1,
                  "shape": 1,
                  "series": 1,
                  "amount": 0.5
                },
                {
                  "op": "set_chart_axis",
                  "slide": 1,
                  "shape": 1,
                  "axis": "value",
                  "title": "Units",
                  "minimum": 0,
                  "maximum": 10,
                  "majorUnit": 2,
                  "numberFormat": "0.0"
                }
              ]
            }
          },
          "expect": {
            "contains": "\"ok\":true"
          },
          "prepare": true
        },
        {
          "send": {
            "session": "make",
            "request": {
              "action": "close_session",
              "session": "mk",
              "save": true
            }
          },
          "expect": {
            "contains": "\"closed\":true"
          },
          "prepare": true
        },
        {
          "eof": "make",
          "prepare": true
        },
        {
          "oneShot": {
            "action": "snapshot",
            "format": "pptx",
            "path": "${work}\\charts.pptx"
          },
          "label": "full",
          "expect": {
            "contains": "\"ok\":true"
          }
        },
        {
          "oneShot": {
            "action": "issues",
            "format": "pptx",
            "path": "${work}\\charts.pptx"
          },
          "label": "issues",
          "expect": {
            "contains": "\"ok\":"
          }
        }
      ],
      "collect": [
        "charts.pptx"
      ]
    },
    {
