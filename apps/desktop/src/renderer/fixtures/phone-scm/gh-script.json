{
  "note": "The scripted GitHub CLI (and its package managers) of the phone-scm recording: every process the Node host spawned for `gh`, `winget`, `soffice.com` and `git --version` is answered from these rules, never run. A rule matches argv token by token ('*' any one token, '**' the rest); the first rule whose `when` holds in the world and whose argv matches answers, then `set` changes the world. An argv no rule matches fails the recording. The Rust side scripts its gh runner with the same rules.",
  "world": {
    "ghInstalled": false,
    "ghAuth": false,
    "wingetMissing": false,
    "wingetFails": false,
    "wingetInstallsGh": true,
    "gitMissing": false,
    "wingetInstallsGit": true,
    "soffice": false,
    "wingetInstallsSoffice": true,
    "starred": false,
    "ghApiDown": false
  },
  "rules": [
    { "tool": "gh", "argv": ["--version"], "reply": { "code": 0, "stdout": "gh version 2.65.0 (2026-01-02)\nhttps://github.com/cli/cli/releases/tag/v2.65.0\n" } },
    { "tool": "gh", "argv": ["auth", "status", "--hostname", "github.com", "--active"], "when": { "ghAuth": true }, "reply": { "code": 0, "stdout": "github.com\n  ✓ Logged in to github.com account octo-dev (keyring)\n  - Active account: true\n" } },
    { "tool": "gh", "argv": ["auth", "status", "--hostname", "github.com", "--active"], "reply": { "code": 1, "stderr": "You are not logged into any GitHub hosts. To log in, run: gh auth login\n" } },
    { "tool": "gh", "argv": ["auth", "setup-git", "--hostname", "github.com"], "reply": { "code": 0 } },
    { "tool": "gh", "argv": ["auth", "logout", "--hostname", "github.com"], "when": { "ghAuth": true }, "set": { "ghAuth": false }, "reply": { "code": 0, "stderr": "✓ Logged out of github.com account octo-dev\n" } },
    { "tool": "gh", "argv": ["auth", "logout", "--hostname", "github.com"], "reply": { "code": 1, "stderr": "not logged in to any hosts\n" } },
    { "tool": "gh", "argv": ["api", "user"], "when": { "ghApiDown": true }, "reply": { "code": 1, "stderr": "error connecting to api.github.com\n" } },
    { "tool": "gh", "argv": ["api", "user"], "when": { "ghAuth": true }, "reply": { "code": 0, "stdout": "{\"login\":\"octo-dev\",\"id\":4242,\"name\":\"Octo Dev\",\"email\":null}\n" } },
    { "tool": "gh", "argv": ["api", "user"], "reply": { "code": 1, "stderr": "gh: To use GitHub CLI, run: gh auth login\n" } },
    { "tool": "gh", "argv": ["api", "user/starred/tribgames/mixdog", "--silent"], "when": { "starred": true }, "reply": { "code": 0 } },
    { "tool": "gh", "argv": ["api", "user/starred/tribgames/mixdog", "--silent"], "when": { "ghApiDown": true }, "reply": { "code": 1, "stderr": "error connecting to api.github.com\n" } },
    { "tool": "gh", "argv": ["api", "user/starred/tribgames/mixdog", "--silent"], "reply": { "code": 1, "stderr": "gh: Not Found (HTTP 404)\n" } },
    { "tool": "gh", "argv": ["api", "-X", "PUT", "user/starred/tribgames/mixdog", "--silent"], "when": { "ghApiDown": true }, "reply": { "code": 1, "stderr": "error connecting to api.github.com\n" } },
    { "tool": "gh", "argv": ["api", "-X", "PUT", "user/starred/tribgames/mixdog", "--silent"], "set": { "starred": true }, "reply": { "code": 0 } },
    { "tool": "gh", "argv": ["repo", "view", "--json", "defaultBranchRef", "--jq", ".defaultBranchRef.name"], "reply": { "code": 0, "stdout": "main\n" } },
    { "tool": "gh", "argv": ["repo", "view", "--json", "nameWithOwner"], "reply": { "code": 0, "stdout": "{\"nameWithOwner\":\"octo/demo\"}\n" } },
    { "tool": "gh", "argv": ["pr", "list", "--search", "is:open author:copilot assignee:@me", "**"], "reply": { "code": 1, "stderr": "GraphQL: Could not resolve to a User with the login of 'copilot'.\n" } },
    { "tool": "gh", "argv": ["pr", "list", "--search", "is:open review-requested:@me", "**"], "reply": { "code": 0, "stdout": "[{\"number\":12,\"title\":\"Add retry\",\"author\":{\"login\":\"ada\"},\"headRefName\":\"retry\",\"baseRefName\":\"main\",\"isDraft\":false,\"state\":\"OPEN\",\"url\":\"https://github.com/octo/demo/pull/12\",\"updatedAt\":\"2026-01-02T03:04:05Z\",\"reviewDecision\":\"REVIEW_REQUIRED\",\"statusCheckRollup\":[{\"conclusion\":\"SUCCESS\"},{\"state\":\"PENDING\"}]}]\n" } },
    { "tool": "gh", "argv": ["pr", "list", "--search", "is:open author:@me", "**"], "reply": { "code": 0, "stdout": "[]\n" } },
    { "tool": "gh", "argv": ["pr", "list", "--search", "is:open", "**"], "reply": { "code": 0, "stdout": "[{\"number\":12,\"title\":\"Add retry\",\"author\":{\"login\":\"ada\"},\"headRefName\":\"retry\",\"baseRefName\":\"main\",\"isDraft\":false,\"state\":\"OPEN\",\"url\":\"https://github.com/octo/demo/pull/12\",\"updatedAt\":\"2026-01-02T03:04:05Z\",\"reviewDecision\":\"REVIEW_REQUIRED\",\"statusCheckRollup\":[]},{\"number\":9,\"title\":\"Fix typo\",\"author\":{\"login\":\"bo\"},\"headRefName\":\"typo\",\"baseRefName\":\"main\",\"isDraft\":true,\"state\":\"OPEN\",\"url\":\"https://github.com/octo/demo/pull/9\",\"updatedAt\":\"2026-01-01T00:00:00Z\",\"reviewDecision\":\"\",\"statusCheckRollup\":null}]\n" } },
    { "tool": "gh", "argv": ["api", "repos/octo/demo/pulls?per_page=5&page=1&state=open", "--hostname", "github.com", "--method", "GET"], "reply": { "code": 0, "stdout": "[{\"number\":12,\"title\":\"Add retry\",\"state\":\"open\",\"user\":{\"login\":\"ada\"}}]\n" } },
    { "tool": "gh", "argv": ["pr", "create", "**"], "reply": { "code": 0, "stdout": "https://github.com/octo/demo/pull/13\n" } },
    { "tool": "gh", "argv": ["pr", "view", "13", "--json", "*"], "reply": { "code": 0, "stdout": "{\"number\":13,\"title\":\"Phone PR\",\"author\":{\"login\":\"octo-dev\"},\"headRefName\":\"phone\",\"baseRefName\":\"main\",\"isDraft\":false,\"state\":\"OPEN\",\"url\":\"https://github.com/octo/demo/pull/13\",\"updatedAt\":\"2026-01-02T03:04:05Z\",\"reviewDecision\":\"\",\"statusCheckRollup\":[]}\n" } },
    { "tool": "gh", "argv": ["pr", "view", "12", "--json", "*"], "reply": { "code": 0, "stdout": "{\"number\":12,\"title\":\"Add retry\",\"author\":{\"login\":\"ada\"},\"headRefName\":\"retry\",\"baseRefName\":\"main\",\"isDraft\":false,\"state\":\"OPEN\",\"url\":\"https://github.com/octo/demo/pull/12\",\"updatedAt\":\"2026-01-02T03:04:05Z\",\"reviewDecision\":\"REVIEW_REQUIRED\",\"statusCheckRollup\":[{\"conclusion\":\"FAILURE\"}],\"body\":\"Retries the call.\",\"additions\":10,\"deletions\":2,\"changedFiles\":2,\"files\":[{\"path\":\"src/a.rs\",\"additions\":8,\"deletions\":1},{\"path\":\"\",\"additions\":1,\"deletions\":1}],\"mergeable\":\"MERGEABLE\",\"mergeStateStatus\":\"CLEAN\",\"createdAt\":\"2026-01-01T00:00:00Z\",\"labels\":[{\"name\":\"bug\"},{\"name\":\"\"}],\"comments\":[{\"body\":\"Looks good\",\"author\":{\"login\":\"bo\"},\"createdAt\":\"2026-01-01T12:00:00Z\"},{\"body\":\"  \",\"author\":{\"login\":\"x\"},\"createdAt\":\"2026-01-01T13:00:00Z\"}],\"reviews\":[{\"state\":\"CHANGES_REQUESTED\",\"body\":\"Please add a test\",\"author\":{\"login\":\"bo\"},\"submittedAt\":\"2026-01-01T14:00:00Z\"},{\"state\":\"COMMENTED\",\"body\":\"\",\"author\":{\"login\":\"cy\"},\"submittedAt\":\"2026-01-01T15:00:00Z\"},{\"state\":\"APPROVED\",\"body\":\"\",\"author\":{\"login\":\"bo\"},\"submittedAt\":\"2026-01-02T01:00:00Z\"}],\"reviewRequests\":[{\"login\":\"dee\"}]}\n" } },
    { "tool": "gh", "argv": ["pr", "view", "404", "--json", "*"], "reply": { "code": 1, "stderr": "GraphQL: Could not resolve to a PullRequest with the number of 404.\n" } },
    { "tool": "gh", "argv": ["pr", "checkout", "12"], "reply": { "code": 0, "stderr": "Switched to branch 'retry'\n" } },
    { "tool": "gh", "argv": ["pr", "checkout", "404"], "reply": { "code": 1, "stderr": "GraphQL: Could not resolve to a PullRequest with the number of 404.\n" } },
    { "tool": "gh", "argv": ["pr", "merge", "12", "--merge"], "reply": { "code": 0, "stdout": "✓ Merged pull request octo/demo#12\n" } },
    { "tool": "gh", "argv": ["pr", "merge", "12", "--squash"], "reply": { "code": 0, "stdout": "✓ Squashed and merged pull request octo/demo#12\n" } },
    { "tool": "gh", "argv": ["pr", "merge", "404", "--merge"], "reply": { "code": 1, "stderr": "GraphQL: Could not resolve to a PullRequest with the number of 404.\n" } },
    { "tool": "gh", "argv": ["pr", "diff", "12"], "reply": { "code": 0, "stdout": "diff --git a/src/a.rs b/src/a.rs\n--- a/src/a.rs\n+++ b/src/a.rs\n@@ -1 +1 @@\n-old\n+new\n" } },
    { "tool": "gh", "argv": ["pr", "diff", "404"], "reply": { "code": 1, "stderr": "GraphQL: Could not resolve to a PullRequest with the number of 404.\n" } },
    { "tool": "winget", "argv": ["**"], "when": { "wingetMissing": true }, "reply": { "code": -1, "stderr": "ENOENT" } },
    { "tool": "winget", "argv": ["**"], "when": { "wingetFails": true }, "reply": { "code": 1, "stdout": "Found Package\nInstaller hash does not match\n", "stderr": "" } },
    { "tool": "winget", "argv": ["install", "--id", "GitHub.cli", "**"], "when": { "wingetInstallsGh": true }, "set": { "ghInstalled": true }, "reply": { "code": 0, "stdout": "Successfully installed\n" } },
    { "tool": "winget", "argv": ["install", "--id", "GitHub.cli", "**"], "reply": { "code": 0, "stdout": "Successfully installed\n" } },
    { "tool": "winget", "argv": ["install", "--id", "Git.Git", "**"], "when": { "wingetInstallsGit": true }, "set": { "gitMissing": false }, "reply": { "code": 0, "stdout": "Successfully installed\n" } },
    { "tool": "winget", "argv": ["install", "--id", "Git.Git", "**"], "reply": { "code": 0, "stdout": "Successfully installed\n" } },
    { "tool": "winget", "argv": ["install", "--id", "TheDocumentFoundation.LibreOffice", "**"], "when": { "wingetInstallsSoffice": true }, "set": { "soffice": true }, "reply": { "code": 0, "stdout": "Successfully installed\n" } },
    { "tool": "winget", "argv": ["install", "--id", "TheDocumentFoundation.LibreOffice", "**"], "reply": { "code": 0, "stdout": "Successfully installed\n" } },
    { "tool": "git", "argv": ["--version"], "when": { "gitMissing": true }, "reply": { "code": -1, "stderr": "ENOENT" } },
    { "tool": "soffice.com", "argv": ["--version"], "when": { "soffice": true }, "reply": { "code": 0, "stdout": "LibreOffice 24.8.4.2 480(Build:2)\n" } },
    { "tool": "soffice.com", "argv": ["--version"], "reply": { "code": -1, "stderr": "ENOENT" } }
  ]
}
