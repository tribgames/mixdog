{
  "name": "@mixdog/desktop",
  "version": "1.3.2",
  "private": true,
  "license": "Apache-2.0",
  "description": "Mixdog desktop host for Windows, macOS, and Linux",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-profile.mjs",
    "dev:fresh": "node scripts/dev-profile.mjs --fresh",
    "dev:isolated": "node scripts/dev-isolated.mjs start",
    "dev:isolated:stop": "node scripts/dev-isolated.mjs stop",
    "dev:isolated:sweep": "node scripts/dev-isolated.mjs sweep",
    "dev:isolated:list": "node scripts/dev-isolated.mjs list",
    "start": "npm run build && node scripts/dev-profile.mjs --preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "test": "node ../../scripts/test.mjs --import ./scripts/test-env.mjs --import tsx",
    "test:desktop-main": "node ../../scripts/test.mjs --import ./scripts/test-env.mjs --import tsx src/main",
    "test:office-approval": "node ../../scripts/test.mjs --import ./scripts/test-env.mjs --import tsx src/renderer/office-approval.test.mjs",
    "test:slow": "node ../../scripts/test.mjs --import ./scripts/test-env.mjs --import tsx --lane slow",
    "test:live": "node ../../scripts/test.mjs --import ./scripts/test-env.mjs --import tsx --lane live",
    "test:all": "node ../../scripts/test.mjs --import ./scripts/test-env.mjs --import tsx --lane all",
    "test:ssh:e2e": "node ../../scripts/test.mjs --import ./scripts/test-env.mjs --import tsx --lane live ssh-remote-docker.e2e",
    "test:daemon:e2e": "node ../../scripts/test.mjs --import ./scripts/test-env.mjs --import tsx --lane live daemon.e2e",
    "verify:packaging-artifact": "node ../../scripts/test.mjs --import ./scripts/test-env.mjs --import tsx --lane live packaging-artifact",
    "test:browser-host:integration": "node scripts/run-browser-host-integration.mjs",
    "test:browser-login-persistence:integration": "node scripts/run-browser-login-persistence-integration.mjs",
    "test:browser-login-popup:integration": "node scripts/run-browser-login-popup-integration.mjs",
    "test:browser-profile-import:integration": "node scripts/run-browser-profile-import-integration.mjs",
    "test:computer-host:integration": "node scripts/run-computer-host-integration.mjs",
    "test:computer-host:scenarios": "node scripts/run-computer-host-scenarios.mjs",
    "test:computer-host:repeats": "node scripts/run-computer-host-scenario-repeats.mjs",
    "merge:computer-host:scenarios": "node scripts/merge-computer-host-scenarios.mjs",
    "test:spec-advisory": "node --max-old-space-size=1024 --import ./scripts/test-env.mjs --import tsx ../../scripts/test-direct.mjs src/renderer/product-spec.test.mjs src/renderer/agent-activity.test.mjs src/renderer/queue-actions.test.mjs src/renderer/turn-review.test.mjs",
    "verify:packaged-runtime": "node scripts/verify-packaged-runtime.mjs",
    "verify:update-metadata": "node scripts/verify-update-metadata.mjs",
    "e2e:direct": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/direct-e2e-windows.ps1",
    "e2e:direct:source": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/direct-e2e-windows.ps1 -SourceMode",
    "update:dev": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev-update-windows.ps1 -ViaUpdater",
    "update:dev:updater": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev-update-windows.ps1 -ViaUpdater",
    "update:dev:fast": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev-fast-snapshot.ps1",
    "update:dev:runtime": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev-update-windows.ps1 -RuntimeOnly",
    "update:dev:reinstall": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev-update-windows.ps1",
    "update:dev:plan": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev-update-windows.ps1 -ViaUpdater -DryRun",
    "update:dev:mac": "bash scripts/dev-update-mac.sh",
    "update:dev:mac:skip-build": "bash scripts/dev-update-mac.sh --skip-build",
    "update:dev:mac:plan": "bash scripts/dev-update-mac.sh --dry-run",
    "verify:live-layout": "node scripts/cdp-layout-probe.mjs --port=9342 --repair",
    "measure:boot": "node scripts/boot-scenario-probe.mjs",
    "acceptance:win": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/acceptance-windows.ps1",
    "verify:renderer": "node ../../scripts/test.mjs --import ./scripts/test-env.mjs --import tsx src/renderer && node src/renderer/verify-renderer.mjs && npm run typecheck:renderer",
    "build": "npm run typecheck && electron-vite build && node scripts/build-daemon.mjs",
    "build:fast": "electron-vite build && node scripts/build-daemon.mjs",
    "capture:ui": "npm run build && node src/renderer/capture-ui.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "prepare:fast-runtime-code": "node scripts/prepare-fast-runtime-code.mjs",
    "brand:win": "node scripts/generate-brand-icons.mjs",
    "build:win": "npm run build && npm run prepare:runtime -- --platform=win32 --arch=x64 && npm run brand:win && electron-builder --win --x64 --publish never && npm run verify:update-metadata",
    "build:win:arm64": "npm run build && npm run prepare:runtime -- --platform=win32 --arch=arm64 && npm run brand:win && electron-builder --win --arm64 --publish never && npm run verify:update-metadata",
    "build:mac": "npm run build && npm run prepare:runtime && electron-builder --mac",
    "build:linux": "npm run build && npm run prepare:runtime && electron-builder --linux",
    "i18n:sync": "node scripts/sync-i18n.mjs",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2",
    "vscode-jsonrpc": "8.2.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@git-diff-view/react": "*",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "3.14.6",
    "@tanstack/virtual-core": "3.17.4",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-code-block-lowlight": "^3.31.4",
    "@tiptap/extension-details": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-mathematics": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "d3-shape": "^3.2.0",
    "dompurify": "^3.4.12",
    "echarts": "6.1.0",
    "electron": "^41.10.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "i18next": "^26.3.6",
    "jsdom": "^27.0.0",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.18.10",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.6",
    "mermaid": "12.2.0",
    "monaco-editor": "^0.55.1",
    "pretendard": "^1.3.9",
    "puppeteer-core": "^25.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-data-grid": "^7.0.0-canary.49",
    "react-dom": "^19.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tldts": "^7.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.2"
  },
  "overrides": {
    "dompurify": "^3.4.12",
    "nanoid": "^3.3.18"
  }
}
