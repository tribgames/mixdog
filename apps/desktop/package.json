{
  "name": "@mixdog/desktop",
  "version": "0.9.133",
  "private": true,
  "description": "Mixdog desktop host for Windows, macOS, and Linux",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "npm run build && electron-vite preview --skipBuild",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "test:renderer": "node --import ./scripts/test-env.mjs --import tsx --test --test-concurrency=1 src/main/folder-explorer.test.mjs src/main/git-cli.test.mjs",
    "test:spec-advisory": "node --import ./scripts/test-env.mjs --import tsx --test --test-concurrency=1 src/renderer/product-spec.test.mjs src/renderer/agent-activity.test.mjs src/renderer/queue-actions.test.mjs src/renderer/turn-review.test.mjs",
    "test:settings": "node --import ./scripts/test-env.mjs --import tsx --test --test-concurrency=1 src/main/settings-store.test.mjs src/main/commit-message.test.mjs src/renderer/settings/git-preference-save.test.mjs",
    "test:packaging": "node scripts/build-daemon.mjs && node --import tsx --test src/main/packaging.test.mjs scripts/verify-update-metadata.test.mjs",
    "test:session-transport": "node scripts/build-daemon.mjs && node --import ./scripts/test-env.mjs --import tsx --test src/main/desktop-service-client.test.mjs src/main/session-transport.test.mjs src/main/daemon.e2e.test.mjs src/main/remote-e2ee.test.mjs",
    "verify:packaged-runtime": "node scripts/verify-packaged-runtime.mjs",
    "verify:update-metadata": "node scripts/verify-update-metadata.mjs",
    "test:updater": "node --import tsx --test src/main/updater-controller.test.mjs",
    "e2e:direct": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/direct-e2e-windows.ps1",
    "e2e:direct:source": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/direct-e2e-windows.ps1 -SourceMode",
    "update:dev": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev-update-windows.ps1 -ViaUpdater",
    "update:dev:updater": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev-update-windows.ps1 -ViaUpdater",
    "update:dev:fast": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev-update-windows.ps1 -FastDirect",
    "update:dev:runtime": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev-update-windows.ps1 -RuntimeOnly",
    "update:dev:reinstall": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev-update-windows.ps1",
    "update:dev:plan": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev-update-windows.ps1 -ViaUpdater -DryRun",
    "verify:live-layout": "node scripts/cdp-layout-probe.mjs --port=9342 --repair --exercise-panel",
    "measure:boot": "node scripts/boot-scenario-probe.mjs",
    "acceptance:win": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/acceptance-windows.ps1",
    "verify:renderer": "npm run test:renderer && node src/renderer/verify-renderer.mjs && npm run typecheck:renderer",
    "build": "npm run typecheck && electron-vite build && node scripts/build-daemon.mjs",
    "capture:ui": "npm run build && node src/renderer/capture-ui.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "brand:win": "node scripts/generate-brand-icons.mjs",
    "build:win": "npm run build && npm run prepare:runtime -- --platform=win32 --arch=x64 && npm run brand:win && electron-builder --win --x64 --publish never && npm run verify:update-metadata",
    "build:win:arm64": "npm run build && npm run prepare:runtime -- --platform=win32 --arch=arm64 && npm run brand:win && electron-builder --win --arm64 --publish never && npm run verify:update-metadata",
    "build:mac": "npm run build && npm run prepare:runtime && electron-builder --mac",
    "build:linux": "npm run build && npm run prepare:runtime && electron-builder --linux",
    "i18n:sync": "node scripts/sync-i18n.mjs",
    "i18n:check": "i18next-cli status && node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "vscode-jsonrpc": "8.2.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@git-diff-view/react": "*",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "3.14.6",
    "@tanstack/virtual-core": "file:./vendor/tanstack-virtual-core",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^40.8.4",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "i18next": "^26.3.6",
    "i18next-cli": "^1.67.4",
    "jsdom": "^27.0.0",
    "jsqr": "^1.4.0",
    "katex": "^0.18.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.55.1",
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.2"
  },
  "overrides": {
    "dompurify": "^3.4.12"
  }
}
