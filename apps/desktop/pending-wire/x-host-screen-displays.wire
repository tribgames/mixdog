# apps/desktop pending wire: x-host-screen-displays
# host/index.ts: add the import after `import { registerHumanOnlyHolds } from './human-only';`
import { registerScreenDisplaysHost } from './screen-displays';
# host/index.ts (createDesktopHost): add after `registerComputerHost(connection, options.computer);`
# The provider is the browser host's own screenDisplays path (remote-browser-methods.ts:
# BrowserHost.remoteScreenDisplays = the screen sources' displays(): refresh, list, summarize;
# "Remote screen is unavailable." where this PC has no screen source), so nothing is duplicated.
  registerScreenDisplaysHost(connection, () => ({
    list: () => options.browser().remote('screenDisplays', []) as Promise<RemoteScreenDisplaySummary[]>,
  }));
# host/index.ts: add the type import after `import type { DesktopRemoteBrowserStreamFrame } from '../../shared/contract';`
import type { RemoteScreenDisplaySummary } from '../../shared/remote-webrtc';
# No HOST_METHOD row: the method name is HOST_SCREEN_DISPLAYS in screen-displays.ts (as computer.ts/files.ts do).
# Routing stays host.browser (server_requests.rs HostScreenDisplays), not host.computer.
