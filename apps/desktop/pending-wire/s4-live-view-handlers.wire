# apps/desktop/src/main/host/index.ts, createDesktopHost, after "const tabs = createBrowserTabsReporter(...)":
# add: import { registerBrowserSurfaceReport } from './browser-surface-report';
registerBrowserSurfaceReport(connection, { onSurfaceChanged: (listener) => options.browser().surfaces.onSurfaceChanged(listener) });
# DesktopHostOptions.browser() gains: surfaces: { onSurfaceChanged(listener: (change: BrowserSurfaceChange) => void): () => void }
# (type exported from ./browser-surface-report).
# apps/desktop/src/main/browser/guest-lifecycle.ts (createBrowserGuestLifecycle returns surface's members) and apps/desktop/src/main/browser/host.ts (the browser host object): expose the createBrowserSurfaceRequests result's onSurfaceChanged as `surfaces: { onSurfaceChanged }` so options.browser().surfaces reaches it.
# HOST_METHOD in connection.ts needs no row: browser-surface-report.ts exports HOST_BROWSER_SURFACE = 'host/browser/surface' (as browser-tabs.ts does for host/state/set). If the lead prefers the table, add browserSurface: 'host/browser/surface' and replace the constant's use.
# DUPLICATE WARNING (review): the old path already sends the same notification: main/index.ts createWindowBrowserHost's onSurfaceRequest -> localService.invokeDesktopOperation('browserRemoteOpen', [request]) -> protocol/desktop-operation-route.ts NOTIFICATION_ROUTES.browserRemoteOpen -> host/browser/surface (filtered by host-pages.ts onSurfaceRequest). Wiring registerBrowserSurfaceReport while that call stays sends every reveal/hide twice (paired clients get ui/openRequested twice).
# So the same wiring change removes that onSurfaceRequest entry in main/index.ts (its only caller of browserRemoteOpen); keep the old path instead if the core connection is not present in every mode where localService routes browserRemoteOpen today.
