# s3-01c desktop wire fragment (applied by DESKTOP-WIRE-G1; locate by symbol, line numbers are stale)
# No HOST_METHOD row is added: host/computer/foregroundLease, internalWindows and pointerFeedback are registered
# inside registerComputerHost (host/computer.ts, owned by s3-01c) through registerComputerLease /
# registerComputerInternalWindows / registerComputerPointer, which take only the HostConnection. The three method
# strings are exported as constants from their own modules (HOST_COMPUTER_FOREGROUND_LEASE, ...INTERNAL_WINDOWS, ...POINTER_FEEDBACK).
# The hunks below are `git diff 08b7df616 wincu-int` of the two hot files, to be applied on mig/int's versions.

diff --git a/apps/desktop/src/main/host/connection.ts b/apps/desktop/src/main/host/connection.ts
index d463645809..163c72770a 100644
--- a/apps/desktop/src/main/host/connection.ts
+++ b/apps/desktop/src/main/host/connection.ts
@@ -62,7 +62,8 @@ export const HOST_CAPABILITIES = {
   media: true,
   updater: true,
   files: true,
-  // `host/computer/capture` and `host/computer/displays` (computer.ts).
+  // `host/computer/*`: capture and displays (computer.ts), foregroundLease, internalWindows and pointerFeedback
+  // (computer-lease.ts, computer-internal-windows.ts, computer-pointer.ts).
   computer: true,
 } as const satisfies HostCapabilities;
 
