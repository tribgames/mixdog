<?xml version="1.0" encoding="utf-8"?>
<!-- Covers the WebView while MixdogReconnect brings a failed relay page back, so
     the browser's error page is never seen: the app's background alone, with no
     text or spinner. Clickable so touches never reach the page underneath. -->
<View xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mixdog_reconnect"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mixdogOfflineFrame"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    android:visibility="gone" />
