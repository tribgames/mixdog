{
  "name": "mixdog",
  "version": "1.5.0",
  "private": false,
  "type": "module",
  "description": "Open-source coding agent that matches Codex on Terminal-Bench 2.1 with 63% fewer tokens.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tribgames/mixdog.git"
  },
  "bugs": {
    "url": "https://github.com/tribgames/mixdog/issues"
  },
  "homepage": "https://mixdog.ai/",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "llm",
    "claude",
    "codex",
    "openai",
    "token-efficiency",
    "terminal-bench",
    "desktop",
    "cli",
    "mcp"
  ],
  "bin": {
    "mixdog": "bin/mixdog.mjs"
  },
  "files": [
    "bin/",
    "README.md",
    "NOTICE.md",
    "LICENSES/",
    "scripts/",
    "!scripts/**/target/**",
    "!scripts/gen-session-method-args.mjs",
    "!scripts/bench/",
    "!scripts/recall-bench-*.txt",
    "!scripts/*-test.mjs",
    "!scripts/**/*.test.mjs",
    "!scripts/*-smoke.mjs",
    "!scripts/*-bench.mjs",
    "!scripts/*bench-*.mjs",
    "!scripts/npm-platforms.mjs",
    "!scripts/stage-npm-native.mjs",
    "!scripts/check-npm-packages.mjs",
    "!scripts/*.ps1",
    "!scripts/*.jsx",
    "src/",
    "!src/**/*.test.mjs",
    "!src/**/*.test-hook.mjs",
    "!src/**/*.test.jsx"
  ],
  "scripts": {
    "postinstall": "node scripts/prune-embedding-runtime.mjs && node bin/native-layout.mjs",
    "check:model-recommendations": "node scripts/check-model-recommendations.mjs",
    "prepublishOnly": "node -e \"if(!process.env.CI){console.error('local npm publish is disabled — run npm run release:patch');process.exit(1)}\"",
    "test": "node scripts/test.mjs",
    "test:slow": "node scripts/test.mjs --lane slow",
    "typecheck:packages": "npm run typecheck --prefix packages/protocol-client && node packages/protocol-client/node_modules/typescript/bin/tsc -p packages/protocol",
    "test:bench-tools": "node scripts/test-direct.mjs --test-force-exit benchmarks/rust-core/recorders/lib/scripted-pty.test.mjs benchmarks/rust-core/recorders/lib/spawned-provenance.test.mjs benchmarks/rust-core/recorders/lib/tmp-mark.test.mjs benchmarks/rust-core/recorders/lib/tool-failure-rows.test.mjs benchmarks/rust-core/recorders/lib/core-stop.test.mjs benchmarks/rust-core/recorders/lib/job-run.test.mjs benchmarks/rust-core/recorders/lib/process-job.test.mjs benchmarks/rust-core/run-slow-replays.test.mjs benchmarks/terminal-bench-2.1/harness/anthropic_oauth_preflight_rust.test.mjs benchmarks/terminal-bench-2.1/harness/prebake-rust.test.mjs",
    "gate:local": "node scripts/gate-local.mjs",
    "test:release-assets": "node scripts/test-direct.mjs scripts/check-release-version.test.mjs scripts/generate-voice-runtime-manifest.test.mjs",
    "test:release-critical": "npm run test:release-assets",
    "test:spec-advisory": "node scripts/run-advisory-spec.mjs && npm run test:spec-advisory --prefix apps/desktop",
    "test:office": "node scripts/test-direct.mjs native/core/crates/mixdog-office-author/assets/page/pptx-cell-runs.test.mjs src/runtime/office/authoring/pptx-script-normalize.test.mjs src/runtime/office/portable/font-provisioner.test.mjs src/runtime/office/portable/portable-xml.test.mjs src/runtime/office/pptx-chart-styling.test.mjs src/runtime/office/pptx-kit-index.test.mjs && npm run test:office-approval --prefix apps/desktop",
    "office:icons": "node scripts/office/build-pptx-icons.mjs",
    "trace:llm": "node scripts/llm-trace-summary.mjs",
    "diag:tools": "node scripts/tool-efficiency-diag.mjs",
    "bench:session": "node scripts/session-bench.mjs",
    "bench:task": "node scripts/task-bench.mjs",
    "bench:corpus": "node scripts/routing-corpus.mjs",
    "build:local": "npm run build:fast --prefix apps/desktop",
    "deploy:local": "npm run update:dev:fast --prefix apps/desktop",
    "deploy:vps": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-remote.ps1",
    "deploy:fast": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-remote.ps1 -FastDirect",
    "release:patch": "gh workflow run deploy.yml --ref main -f bump=patch -f native=auto",
    "release:minor": "gh workflow run deploy.yml --ref main -f bump=minor -f native=auto",
    "release:major": "gh workflow run deploy.yml --ref main -f bump=major -f native=auto",
    "tidy:engines:sync": "node scripts/tidy/sync-engines-manifest.mjs",
    "graph:parity": "node scripts/graph-parity.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@img/sharp-wasm32": "0.35.5",
    "@napi-rs/canvas": "^1.0.8",
    "jszip": "^3.10.1",
    "onnxruntime-node": "1.30.0",
    "pdfjs-dist": "^6.2.108",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.5",
    "strip-ansi": "^7.2.0",
    "unpdf": "^1.8.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "onnxruntime-node": {
      ".": "1.30.0",
      "global-agent": "^4.1.3"
    },
    "sharp": "^0.35.5",
    "pptxgenjs": {
      "image-size": "2.0.3"
    }
  },
  "devDependencies": {
    "acorn": "^8.17.0",
    "esbuild": "^0.28.1",
    "lucide-static": "^1.41.0",
    "tsx": "^4.23.15",
    "@mixdog/protocol": "file:packages/protocol",
    "jsdom": "^27.0.0"
  },
  "directories": {
    "doc": "docs"
  },
  "author": ""
}
