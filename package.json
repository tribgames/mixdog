{
  "name": "mixdog",
  "version": "1.5.0",
  "private": false,
  "type": "module",
  "description": "Open-source coding agent that matches Codex on Terminal-Bench 2.1 with 63% fewer tokens.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tribgames/mixdog.git"
  },
  "bugs": {
    "url": "https://github.com/tribgames/mixdog/issues"
  },
  "homepage": "https://mixdog.ai/",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "llm",
    "claude",
    "codex",
    "openai",
    "token-efficiency",
    "terminal-bench",
    "desktop",
    "cli",
    "mcp"
  ],
  "files": [
    "README.md",
    "NOTICE.md",
    "LICENSES/",
    "scripts/",
    "!scripts/bench/",
    "!scripts/recall-bench-*.txt",
    "!scripts/*-test.mjs",
    "!scripts/**/*.test.mjs",
    "!scripts/tool-contracts/",
    "!scripts/*-smoke.mjs",
    "!scripts/smoke-loop*.mjs",
    "!scripts/*-bench.mjs",
    "!scripts/*bench-*.mjs",
    "!scripts/*.ps1",
    "!scripts/*.jsx",
    "src/",
    "!src/**/*.test.mjs",
    "!src/**/*.test-hook.mjs",
    "!src/**/*.test.jsx"
  ],
  "scripts": {
    "postinstall": "node scripts/prune-embedding-runtime.mjs",
    "check:model-recommendations": "node scripts/check-model-recommendations.mjs",
    "prepublishOnly": "node -e \"if(!process.env.CI){console.error('local npm publish is disabled — run npm run release:patch');process.exit(1)}\"",
    "test": "node scripts/test.mjs",
    "test:slow": "node scripts/test.mjs --lane slow",
    "gate:local": "node scripts/gate-local.mjs",
    "test:live": "npm run build:spawn:test && node scripts/test.mjs --lane live",
    "smoke:loop:final": "node scripts/smoke-loop-report.mjs --require-complete --min-elapsed 5h --min-iterations 400 --max-gap 60s --max-smoke-ms 10000 --max-avg-smoke-ms 8500 --max-step-ms smoke.mjs=4000 --max-step-ms boot-smoke.mjs=8000 --max-rss-mb 140 --max-rss-growth-mb 50",
    "smoke:loop:report": "node scripts/smoke-loop-report.mjs",
    "build:spawn:test": "cargo build --locked --manifest-path native/mixdog-spawn/Cargo.toml",
    "test:tool-contracts": "npm run build:spawn:test && node scripts/test-direct.mjs --test-force-exit \"scripts/tool-contracts/*.test.mjs\"",
    "test:release-assets": "node scripts/test-direct.mjs scripts/check-release-version.test.mjs scripts/generate-voice-runtime-manifest.test.mjs",
    "test:release-critical": "npm run test:release-assets",
    "test:spec-advisory": "node scripts/run-advisory-spec.mjs && npm run test:spec-advisory --prefix apps/desktop",
    "test:office": "node scripts/test-direct.mjs src/runtime/office/office-runtime-contract.test.mjs src/runtime/office/office-runtime-com.test.mjs src/runtime/office/office-runtime-portable.slow.test.mjs src/runtime/office/xlsx-formula-audit.test.mjs src/runtime/office/xlsx-portable-snapshot.test.mjs src/runtime/office/office-runtime-pdf.slow.test.mjs src/runtime/office/office-runtime-design.test.mjs src/runtime/office/office-assurance.slow.test.mjs src/runtime/office/office-design-aesthetics.test.mjs src/runtime/office/portable-authoring.slow.test.mjs src/runtime/office/authoring/pptx-brief.test.mjs src/runtime/office/authoring/pptx-receipt.test.mjs src/runtime/office/quality/render-air.test.mjs && npm run test:office-approval --prefix apps/desktop",
    "test:office:render": "node scripts/test-direct.mjs src/runtime/office/pptx-skill-kit.slow.test.mjs",
    "office:icons": "node scripts/office/build-pptx-icons.mjs",
    "trace:llm": "node scripts/llm-trace-summary.mjs",
    "diag:tools": "node scripts/tool-efficiency-diag.mjs",
    "bench:session": "node scripts/session-bench.mjs",
    "bench:task": "node scripts/task-bench.mjs",
    "bench:corpus": "node scripts/routing-corpus.mjs",
    "build:local": "npm run build:fast --prefix apps/desktop",
    "deploy:local": "npm run update:dev:fast --prefix apps/desktop",
    "deploy:vps": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-remote.ps1",
    "deploy:fast": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-remote.ps1 -FastDirect",
    "release:patch": "gh workflow run deploy.yml --ref main -f bump=patch -f native=auto",
    "release:minor": "gh workflow run deploy.yml --ref main -f bump=minor -f native=auto",
    "release:major": "gh workflow run deploy.yml --ref main -f bump=major -f native=auto",
    "tidy:engines:sync": "node scripts/tidy/sync-engines-manifest.mjs",
    "graph:parity": "node scripts/graph-parity.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@formulajs/formulajs": "^4.6.1",
    "@huggingface/transformers": "^4.3.1",
    "@img/sharp-wasm32": "0.35.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "ajv": "^8.20.0",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "imapflow": "^2.5.7",
    "ink": "https://github.com/tribgames/mixdog/releases/download/ink-runtime-v7.1.0-mixdog.1/ink-7.1.0.tgz",
    "jsdom": "^27.0.0",
    "jszip": "^3.10.1",
    "marked": "^14.1.4",
    "node-cron": "^4.5.0",
    "nodemailer": "^10.1.7",
    "onnxruntime-node": "1.30.0",
    "openai": "^6.44.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^25.2.0",
    "react": "^19.2.7",
    "saxes": "^6.0.0",
    "sharp": "^0.35.5",
    "string-width": "^8.2.1",
    "strip-ansi": "^7.2.0",
    "tesseract.js": "^7.0.0",
    "tldts": "^7.4.18",
    "undici": "^8.10.2",
    "unpdf": "^1.8.0",
    "wrap-ansi": "^10.0.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "onnxruntime-node": {
      ".": "1.30.0",
      "global-agent": "^4.1.3"
    },
    "sharp": "^0.35.5",
    "pptxgenjs": {
      "image-size": "2.0.3"
    }
  },
  "devDependencies": {
    "acorn": "^8.17.0",
    "esbuild": "^0.28.1",
    "eslint-scope": "^9.1.2",
    "lucide-static": "^1.41.0",
    "tsx": "^4.23.15",
    "@mixdog/protocol": "file:packages/protocol"
  },
  "directories": {
    "doc": "docs"
  },
  "author": ""
}
