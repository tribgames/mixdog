{
  "name": "mixdog",
  "version": "0.9.135",
  "private": false,
  "type": "module",
  "description": "Standalone mixdog coding-agent CLI/TUI workspace.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tribgames/mixdog.git"
  },
  "bugs": {
    "url": "https://github.com/tribgames/mixdog/issues"
  },
  "homepage": "https://github.com/tribgames/mixdog#readme",
  "keywords": [
    "agent",
    "cli",
    "tui",
    "coding-agent",
    "mcp"
  ],
  "bin": {
    "mixdog": "src/cli.mjs"
  },
  "files": [
    "README.md",
    "NOTICE.md",
    "LICENSES/",
    "scripts/",
    "!scripts/bench/",
    "!scripts/recall-bench-*.txt",
    "!scripts/*-test.mjs",
    "!scripts/*-smoke.mjs",
    "!scripts/smoke-loop*.mjs",
    "!scripts/*-bench.mjs",
    "!scripts/*bench-*.mjs",
    "!scripts/verify-embedding-runtime.mjs",
    "!scripts/*.ps1",
    "!scripts/*.jsx",
    "src/",
    "!src/tui/dev",
    "vendor/"
  ],
  "scripts": {
    "postinstall": "node scripts/prune-embedding-runtime.mjs && node scripts/prepare-native-assets.mjs",
    "prepack": "npm run build:tui",
    "prepublishOnly": "node -e \"if(!process.env.CI){console.error('local npm publish is disabled — run npm run release:patch');process.exit(1)}\"",
    "start": "node src/cli.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:all": "npm run smoke && npm run smoke:boot && npm run smoke:patch && npm run smoke:compact",
    "smoke:boot": "node scripts/boot-smoke.mjs",
    "smoke:compact": "node scripts/compact-smoke.mjs",
    "test:compact": "node --test scripts/suite-compact-test.mjs",
    "smoke:loop": "node scripts/smoke-loop.mjs",
    "smoke:loop:final": "node scripts/smoke-loop-report.mjs --require-complete --min-elapsed 5h --min-iterations 400 --max-gap 60s --max-smoke-ms 10000 --max-avg-smoke-ms 8500 --max-step-ms smoke.mjs=4000 --max-step-ms boot-smoke.mjs=8000 --max-rss-mb 140 --max-rss-growth-mb 50",
    "smoke:loop:report": "node scripts/smoke-loop-report.mjs",
    "build:spawn:test": "cargo build --locked --manifest-path native/mixdog-spawn/Cargo.toml",
    "test:tool-contracts": "npm run build:spawn:test && node scripts/tool-smoke.mjs",
    "smoke:patch": "node scripts/apply-patch-edit-smoke.mjs",
    "test:shellhardening": "npm run build:spawn:test && node --test scripts/suite-shellhardening-test.mjs scripts/suite-shell-direct-exe-test.mjs",
    "test:providers": "node --test scripts/provider-toolcall-test.mjs scripts/provider-contract-test.mjs scripts/provider-stream-outcome-test.mjs scripts/cursor-provider-test.mjs",
    "test:embedding-runtime:warmup": "node scripts/verify-embedding-runtime.mjs --warmup",
    "test:release-assets": "node --check scripts/verify-release-assets.mjs && node --check scripts/release-gate-test.mjs && node --check scripts/prepare-native-assets.mjs && node --test scripts/release-gate-test.mjs scripts/prepare-native-assets-test.mjs",
    "test:native-edit-wire": "node scripts/native-edit-wire-test.mjs",
    "test:release-focused": "npm run test:release-critical && npm run test:compact && npm run test:shellhardening && npm run test:tool-contracts && npm run test:session && npm run test:session-transport",
    "test:release-critical": "npm run test:release-assets && npm run smoke:patch && npm run test:providers",
    "test:spec-advisory": "node scripts/advisory-spec-test.mjs && npm run test:spec-advisory --prefix apps/desktop",
    "test:session-transport": "node --test scripts/session-transport-test.mjs scripts/daemon-bootstrap-test.mjs",
    "test:session": "node --test scripts/runtime-turn-contract-test.mjs scripts/session-save-fault-store-test.mjs src/runtime/shared/tool-surface.test.mjs",
    "test:media": "node --test src/runtime/media/store.test.mjs src/runtime/media/renditions.test.mjs src/runtime/media/adapters/codex-image.test.mjs",
    "failures": "node scripts/tool-failures.mjs",
    "trace:llm": "node scripts/llm-trace-summary.mjs",
    "diag:sessions": "node scripts/session-diag.mjs",
    "diag:tools": "node scripts/tool-efficiency-diag.mjs",
    "diag:sweep": "node scripts/session-sweep.mjs",
    "bench:session": "node scripts/session-bench.mjs",
    "bench:task": "node scripts/task-bench.mjs",
    "bench:corpus": "node scripts/routing-corpus.mjs",
    "bench:run": "node scripts/bench-run.mjs",
    "bench:recall": "node scripts/recall-bench.mjs",
    "bench:recall:strict": "node scripts/recall-bench.mjs --strict",
    "test:recall-validator": "node --test scripts/recall-bench-test.mjs",
    "bench:tui-load": "node scripts/tui-runtime-load-bench.mjs",
    "bench:output-style": "node scripts/output-style-bench.mjs",
    "bench:session-context": "node scripts/session-context-bench.mjs",
    "bench:session-transport": "node scripts/session-transport-bench.mjs",
    "bench:tool-overhead": "node scripts/tool-overhead-microbench.mjs",
    "bench:internal-comms": "node scripts/internal-comms-bench.mjs",
    "audit:models": "node scripts/model-catalog-audit.mjs",
    "patch:replay": "node scripts/patch-replay.mjs",
    "build:tui": "node scripts/build-tui.mjs",
    "release:patch": "gh workflow run deploy.yml --ref main -f bump=patch -f native=auto",
    "release:minor": "gh workflow run deploy.yml --ref main -f bump=minor -f native=auto",
    "release:major": "gh workflow run deploy.yml --ref main -f bump=major -f native=auto"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "discord.js": "^14.26.4",
    "ink": "^7.1.0",
    "jsdom": "^27.0.0",
    "kiwi-nlp": "^0.21.0",
    "marked": "^14.1.4",
    "node-cron": "^4.5.0",
    "openai": "^6.44.0",
    "pg": "^8.22.0",
    "puppeteer-core": "^25.2.0",
    "react": "^19.2.7",
    "sharp": "^0.35.3",
    "string-width": "^8.2.1",
    "strip-ansi": "^7.2.0",
    "tiktoken": "^1.0.22",
    "unpdf": "^1.8.0",
    "undici": "^8.5.0",
    "wrap-ansi": "^10.0.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "discord.js": {
      "undici": "6.28.0"
    },
    "@discordjs/rest": {
      "undici": "6.28.0"
    },
    "onnxruntime-node": {
      "global-agent": "^4.1.3"
    },
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "acorn": "^8.17.0",
    "esbuild": "^0.28.1",
    "eslint-scope": "^9.1.2"
  },
  "optionalDependencies": {
    "@vscode/ripgrep": "^1.18.0"
  }
}
