apps/desktop/.dev-detached.pid
# Kiwi Korean morph model cache (runtime-downloaded, never committed)
kiwi-model/
**/kiwi-model/

# Environment / secrets
.env
.env.*
!.env.example
# Mixdog's Google OAuth desktop client, written at release packaging by
# scripts/embed-google-oauth-client.mjs from the repository secrets. It ships
# in the npm package and runtime.asar (package.json `files` includes src/) but
# is never committed.
src/runtime/shared/google-oauth-client.generated.json
# Apple code-signing material: exported certificates and API keys stay out of
# the public tree; CI reads them from repository secrets.
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/settings.local.json
*.swp

# Scratch
*.tmp
# Atomic-writer temp files (`<name>.mixdog-tmp-<hex>`) a crashed write leaves.
*.mixdog-tmp-*
tmp/
.tmp-internal-comms-live.*
# Every local probe/profile scratch dir follows the same .tmp- prefix, so one
# rule keeps Electron profiles, flash probes and one-off dumps out of the tree.
.tmp-*/
.tmp-*.txt
# One-off capture dumps from UI/perf probes (regenerated on demand).
artifacts/
build-out*.txt
baseline-dom.txt
/.tm-*.png
apps/desktop/scripts/tmp-*.mjs
benchmarks/terminal-bench-2.1/jobs-*
# Published verification artifacts (analysis/export-raw.mjs) live under
# records/<harness>/<model>/<date>/ and are committed, so they must survive the generic artifacts/
# rule above.
!benchmarks/terminal-bench-2.1/records/**/artifacts/
# One-off probe scripts written during a run investigation; the published
# metric scripts next to them are committed under their own names.
benchmarks/terminal-bench-2.1/analysis/_tmp-*
benchmarks/terminal-bench-2.1/harness/__pycache__/
# Local experiment outputs (quick-run logs, round dumps, scratch Harbor trials).
benchmarks/*.log
benchmarks/terminal-bench-2.1/*-current.txt
benchmarks/terminal-bench-2.1/tb-rounds-analysis*.txt
benchmarks/terminal-bench-2.1/trials/
benchmarks/terminal-bench-2.1/tb-src-snap-*
benchmarks/terminal-bench-2.1/cc-bin/
scratch/

# Tool backups
.codex-backups/

# Runtime data-dir state. These live in ~/.mixdog/data; they only appear at the
